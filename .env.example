# Kopieer naar .env. Niet committen.
# Bestaande website (Sanity) — verplicht in productie:

# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# Content-API voor "Controleer Sanity synchronisatie". De webhook /api/bridge/sanity gebruikt dit niet.
# SANITY_API_TOKEN=
# Alleen voor `sanity deploy` in CI. De website en de bridge lezen deze naam niet.
# SANITY_AUTH_TOKEN=
# Webhook-handtekening. Zelfde waarde als het Sanity-webhookgeheim. Niet in git.
# SANITY_BRIDGE_SECRET=
# RESEND_API_KEY=
# CONTACT_FALLBACK_EMAIL=
# CRON_SECRET=

# Optioneel, bestaande site:
# SITE_PASSWORD=
# CONTACT_BCC_EMAIL=
# NIEUWSBRIEF_PREVIEW_ADRES=
# LIVE_VANAF=

# Beheerplatform — /beheer op Production (lokaal en Preview werken ook zonder).
BEHEER_ENABLED=true
# CONTENT_BRON=
# ALLOW_SUPABASE_CONTENT=
# SUPER_ADMIN_EMAIL=nhoevenaars@gmail.com
# Individuele login (server-side). Service-role nooit in de browser.
# URL en publishable key hebben een standaard voor het project Kerkje van Persingen.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Nodig voor uitnodigen en rechten bewerken. Zet dit in Vercel, niet in git.
# SUPABASE_SERVICE_ROLE_KEY=
# BEHEER_LIVE_SANITY=
