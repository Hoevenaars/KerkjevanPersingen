# Kopieer naar .env. Niet committen.
# Website en beheer lezen en schrijven in Supabase.

# RESEND_API_KEY=
# CONTACT_FALLBACK_EMAIL=
# CRON_SECRET=

# Optioneel, bestaande site:
# SITE_PASSWORD=
# CONTACT_BCC_EMAIL=
# Tijdelijke BCC op mail naar mensen van het kerkje. Standaard nhoevenaars@gmail.com.
# Leeg zetten schakelt alleen die kopie uit.
# kerkjevanpersingenhm@gmail.com blijft BCC op dezelfde interne mail, inclusief aanvraag en contact.
# TOEZICHT_BCC_EMAIL=
# NIEUWSBRIEF_PREVIEW_ADRES=
# LIVE_VANAF=

# Beheerplatform — /beheer op Production (lokaal en Preview werken ook zonder).
BEHEER_ENABLED=true
# Contract en opvolging op het bestaande dossier. Standaard uit.
# Zet pas op true na formele vaststelling, publicatie en een uitgevoerde migratie.
# DOCUMENTENFLOW=
# SUPER_ADMIN_EMAIL=nhoevenaars@gmail.com
# Individuele login (server-side). Service-role nooit in de browser.
# URL en publishable key hebben een standaard voor het project Kerkje van Persingen.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Nodig voor uitnodigen en rechten bewerken. Zet dit in Vercel, niet in git.
# SUPABASE_SERVICE_ROLE_KEY=

# V4 — alleen inschakelen in staging na toepassen en testen van alle migraties.
# V4_ATOMAIR_CONTRACT=false
# V4_AUTOCONTRACT=false
# De automatische voorbereiding vereist een in public.instellingen vastgelegd
# en door het bestuur vastgesteld 'verhuur_autocontract_profielen' JSON-profiel.
# Factuurpakket V3 moet eveneens eerst op staging zijn getest.
# FACTUURPAKKET_V3=false
