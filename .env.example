# Kopieer naar .env. Niet committen.
# Bestaande website (Sanity) — verplicht in productie:

# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=
# RESEND_API_KEY=
# CONTACT_FALLBACK_EMAIL=
# CRON_SECRET=

# Optioneel, bestaande site:
# SITE_PASSWORD=
# CONTACT_BCC_EMAIL=
# NIEUWSBRIEF_PREVIEW_ADRES=
# LIVE_VANAF=

# Beheerplatform — /beheer op Production (lokaal en Preview werken ook zonder).
BEHEER_ENABLED=true
# CONTENT_BRON=
# ALLOW_SUPABASE_CONTENT=
# SUPER_ADMIN_EMAIL=
# Extra slot op /beheer. Zonder dit (én zonder SITE_PASSWORD) blijft /beheer
# op voorbeelddata, zodat persoonsgegevens niet op een open URL komen.
# BEHEER_PASSWORD=
# BEHEER_LIVE_SANITY=
