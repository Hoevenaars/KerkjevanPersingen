---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FooterBanner from '../components/FooterBanner.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description: string;
  /** Pad naar de OG-afbeelding, relatief aan de site-root. */
  image?: string;
  /** Zet op true voor pagina's die nooit geïndexeerd mogen worden. */
  noindex?: boolean;
}

const { title, description, image = '/og-default.jpg', noindex = false } = Astro.props;

const site = 'https://kerkjepersingen.nl';
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === 'home' ? 'Kerkje van Persingen' : `${title} — Kerkje van Persingen`;
const ogImage = new URL(image, site).href;

// 14_SEO_AI_SEARCH.md §2 — structured data die de zichtbare content weerspiegelt.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['HistoricalLandmark', 'EventVenue'],
  name: 'Kerkje van Persingen',
  description:
    'Rijksmonumentaal kerkje uit circa 1350 in de Ooijpolder, te huur voor bruiloften, exposities, concerten en bijeenkomsten.',
  url: site,
  telephone: '+31652668449',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Persingensestraat',
    addressLocality: 'Persingen',
    addressCountry: 'NL',
  },
  isAccessibleForFree: false,
  publicAccess: true,
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kerkje van Persingen" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#4A5235" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Work+Sans:wght@400;500;600&display=swap"
    />

    <!-- Vercel Analytics + Speed Insights: geen cookies, geen consent-banner
         nodig. Analytics telt alleen bezoek op kerkjepersingen.nl zelf — de
         andere vijf domeinen redirecten (308) al vóór deze pagina geladen
         wordt, dus er is geen risico op dubbeltellingen via een oude
         domeinnaam. Speed Insights meet Core Web Vitals via first-party
         /_vercel/speed-insights/* (past in de bestaande CSP). -->
    <Analytics />
    <SpeedInsights />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <FooterBanner />
    <Footer />
  </body>
</html>
