---
import '../styles/global.css';
import '../styles/beheer.css';
import { laadBeheerSnapshot, beheerSnapshotOpties } from '../platform/beheer-bron';
import { leesSanityOproepen } from '../platform/sanity-registratie';
import { BEHEER_MODULES, INSTELLINGEN_PAGINAS, SNEL_NIEUW } from '../platform/modules.ts';
import { magZien } from '../platform/rechten.ts';
import { beheerModus } from '../platform/beheer-sessie.ts';
import { moduleVoorPad } from '../platform/autorisatie.ts';
import { rolWeergaveId } from '../platform/rollen.ts';
import { laadRollen } from '../lib/rollen-opslag.ts';

interface Props {
  titel: string;
}

const { titel } = Astro.props;
const pad = Astro.url.pathname;
const zoekterm = Astro.url.searchParams.get('q') ?? '';
const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const sessie = Astro.locals.beheer;
const rechten = sessie?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const module = moduleVoorPad(pad);
const modus = sessie ? beheerModus(sessie, module === 'auth' || module === 'onbekend' ? null : module) : 'lezen';

const demoLink = new URL(Astro.url);
demoLink.searchParams.set('bron', 'demo');
const supabaseLink = new URL(Astro.url);
supabaseLink.searchParams.set('bron', 'supabase');
const liveLink = new URL(Astro.url);
liveLink.searchParams.delete('bron');
const demoHref = demoLink.pathname + demoLink.search;
const supabaseHref = supabaseLink.pathname + supabaseLink.search;
const liveHref = liveLink.pathname + liveLink.search;
const sanityOproepen = leesSanityOproepen();
const rolAantal = snapshot.relaties.reduce((som, relatie) => som + relatie.rollen.length, 0);

const hoofd = (Object.keys(BEHEER_MODULES) as Array<keyof typeof BEHEER_MODULES>)
  .filter((sleutel) => BEHEER_MODULES[sleutel].groep === 'hoofd' && magZien(rechten, sleutel))
  .map((sleutel) => ({ href: BEHEER_MODULES[sleutel].href, label: BEHEER_MODULES[sleutel].label }));
if (magZien(rechten, 'agenda')) {
  const naPlanning = hoofd.findIndex((item) => item.href === '/beheer/planning/');
  const publiceren = { href: '/beheer/publiceren/', label: 'Publiceren' };
  if (naPlanning >= 0) hoofd.splice(naPlanning + 1, 0, publiceren);
  else hoofd.push(publiceren);
}

if (magZien(rechten, 'instellingen')) {
  hoofd.push({ href: '/beheer/migratie/', label: 'Migratie' });
}

const instellingen = INSTELLINGEN_PAGINAS.filter((item) => magZien(rechten, item.module)).map((item) => ({
  href: item.href,
  label: item.label,
}));

const snelNieuw = SNEL_NIEUW.filter((item) => magZien(rechten, item.module));
let kijkRollen: Awaited<ReturnType<typeof laadRollen>> = [];
if (sessie?.rechten.isSuperAdmin) {
  try {
    kijkRollen = await laadRollen();
  } catch {
    kijkRollen = [];
  }
}

function actief(href: string): boolean {
  if (href === '/beheer/') return pad === '/beheer' || pad === '/beheer/';
  if (href === '/beheer/instellingen/') {
    return pad === '/beheer/instellingen' || pad === '/beheer/instellingen/';
  }
  return pad === href || pad.startsWith(href);
}

const weergaveNaam = sessie?.viewAs?.naam ?? sessie?.gebruiker.naam ?? 'Beheerder';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf8f3" />
    <title>{titel} — Beheer Kerkje van Persingen</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Work+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body data-beheer-modus={modus}>
    {
      sessie?.viewAs && (
        <div class="bh-viewas" role="status">
          <p>
            Je bekijkt Beheer als <strong>{sessie.viewAs.naam}</strong>
            <span>
              {
                sessie.viewAs.id.startsWith('rol:')
                  ? 'Je ziet wat deze rol ziet. Wijzigingen zijn uitgeschakeld.'
                  : 'Previewmodus – wijzigingen zijn uitgeschakeld'
              }
            </span>
          </p>
          <form method="post" action="/api/beheer/view-as">
            <input type="hidden" name="actie" value="stop" />
            <input type="hidden" name="next" value={pad} />
            <button class="bh-btn bh-btn--sec" type="submit">
              Terug naar Super Admin
            </button>
          </form>
        </div>
      )
    }
    <div class="bh-app">
      <nav class="bh-nav" aria-label="Beheer">
        <a class="bh-merk" href="/beheer/">
          Beheer
          <span>Kerkje van Persingen</span>
        </a>
        <form class="bh-zoek" action="/beheer/zoeken/" method="get">
          <label class="visually-hidden" for="bh-q">Zoeken</label>
          <input id="bh-q" name="q" type="search" placeholder="Zoek Jansen, 12 september…" value={zoekterm} />
          <button type="submit">Zoek</button>
        </form>
        <ul class="bh-menu">
          {
            hoofd.map((item) => (
              <li>
                <a href={item.href} aria-current={actief(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        {
          instellingen.length > 0 && (
            <>
              <p class="bh-groep">Instellingen</p>
              <ul class="bh-sub">
                {instellingen.map((item) => (
                  <li>
                    <a href={item.href} aria-current={actief(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        <div class="bh-user">
          {weergaveNaam}
          {sessie?.rechten.isSuperAdmin && !sessie.viewAs ? ' · Super Admin' : ''}
          <form method="post" action="/beheer/uitloggen" class="bh-logout">
            <button type="submit">Uitloggen</button>
          </form>
        </div>
      </nav>

      <div class="bh-werk">
        <header class="bh-werk-kop" id="bh-werk-kop">
          <div class="bh-werk-kop-links">
            <p class="bh-label">Beheer · Kerkje van Persingen</p>
            <p class="bh-werk-datum" id="bh-datum"></p>
          </div>
          <div class="bh-werk-kop-rechts">
            {
              sessie?.rechten.isSuperAdmin && (
                <details class="bh-oog">
                  <summary
                    class="bh-oog-knop"
                    aria-label={sessie.viewAs ? `Je kijkt als ${sessie.viewAs.naam}. Kies een andere rol.` : 'Kijk als een andere rol'}
                  >
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.5 12S6.2 6.5 12 6.5 21.5 12 21.5 12 17.8 17.5 12 17.5 2.5 12 2.5 12Z"
                      ></path>
                      <circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
                    </svg>
                  </summary>
                  <div class="bh-oog-menu" role="group" aria-label="Kijk als">
                    <p>Kijk als</p>
                    <form method="post" action="/api/beheer/view-as">
                      <input type="hidden" name="actie" value="stop" />
                      <input type="hidden" name="next" value={pad} />
                      <button type="submit" aria-current={!sessie.viewAs ? 'true' : undefined}>Super Admin</button>
                    </form>
                    {
                      kijkRollen.map((rol) => (
                        <form method="post" action="/api/beheer/view-as">
                          <input type="hidden" name="actie" value="start" />
                          <input type="hidden" name="id" value={rolWeergaveId(rol.slug)} />
                          <input type="hidden" name="next" value="/beheer/" />
                          <button type="submit" aria-current={sessie.viewAs?.functie === rol.slug ? 'true' : undefined}>
                            {rol.naam}
                          </button>
                        </form>
                      ))
                    }
                  </div>
                </details>
              )
            }
            {
              snelNieuw.length > 0 && modus === 'schrijven' && (
              <div class="bh-fab-wrap">
                <button
                  type="button"
                  class="bh-fab"
                  id="bh-fab"
                  aria-label="Snel naar"
                  aria-expanded="false"
                  aria-controls="bh-fab-menu"
                >
                  +
                </button>
                <div id="bh-fab-menu" class="bh-fab-menu" hidden role="menu" aria-label="Snel naar">
                  {snelNieuw.map((item) => (
                    <a href={item.href} role="menuitem">
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            )
            }
          </div>
        </header>

        <div class="bh-main">
          <p class="bh-demo" role={snapshot.fout ? 'alert' : 'status'} data-beheer-bron={snapshot.bron}>
            {snapshot.banner}
            {
              snapshot.bron === 'sanity' && (
                <>
                  {' '}
                  <a href={supabaseHref}>Toon Supabase-testdata</a>
                  {' · '}
                  <a href={demoHref}>Toon voorbeelddata</a>
                </>
              )
            }
            {
              snapshot.bron === 'demo' && Astro.url.searchParams.get('bron') === 'demo' && (
                <>
                  {' '}
                  <a href={liveHref}>Terug naar live</a>
                </>
              )
            }
            {
              snapshot.bron === 'supabase' && (
                <>
                  {' '}
                  <a href={liveHref}>Terug naar Sanity-weergave</a>
                </>
              )
            }
          </p>
          {
            snapshot.bron === 'supabase' && (
              <p class="bh-demo" data-supabase-telling>
                Relaties {snapshot.relaties.length} · rollen {rolAantal} · boekingen {snapshot.boekingen.length} ·
                betalingen {(snapshot.betalingen ?? []).length} · blokkades {snapshot.intern.length} ·
                gastbegeleiders {(snapshot.toewijzingen ?? []).length}
                {snapshot.fout ? ` · fout: ${snapshot.fout}` : ''}
                {' · '}
                Sanity-calls in dit request: <span data-sanity-oproepen={sanityOproepen.length}>{sanityOproepen.length}</span>
                {sanityOproepen.length > 0 ? ` (${sanityOproepen.map((oproep) => oproep.plek).join(', ')})` : ''}
              </p>
            )
          }
          <slot />
        </div>
      </div>
    </div>

    <aside id="bh-detail" class="bh-detail" aria-hidden="true">
      <button type="button" class="bh-detail-backdrop" id="bh-detail-sluit" aria-label="Sluiten"></button>
      <div class="bh-detail-paneel">
        <button type="button" class="bh-detail-x" id="bh-detail-x" aria-label="Sluiten">&times;</button>
        <div class="bh-detail-inhoud" id="bh-detail-inhoud"></div>
      </div>
    </aside>

    <script src="/beheer.js" defer></script>
    <script is:inline>
      document.getElementById('bh-detail-x')?.addEventListener('click', () => {
        document.getElementById('bh-detail-sluit')?.click();
      });
    </script>
  </body>
</html>
