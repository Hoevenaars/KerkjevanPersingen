---
import '../styles/beheer-concept.css';
import { magZien } from '../platform/rechten.ts';
import { verhuurOverzichtAan } from '../platform/verhuur-vlag.ts';
import { groepeer, hoofditems, hoofdnavAan, padActief, sectieVoorPad, subitems } from '../platform/beheer-hoofdnav.ts';

interface Props {
  titel: string;
  actief: 'verhuur' | 'website';
}

const { titel, actief } = Astro.props;
const pad = Astro.url.pathname;
const sessie = Astro.locals.beheer;
const rechten = sessie?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const naam = sessie?.viewAs?.naam ?? sessie?.gebruiker.naam ?? '';
const toonVerhuur = magZien(rechten, 'boekingen');
const toonWebsite = magZien(rechten, 'agenda');
const eenvoud = hoofdnavAan();
const hoofdOpties = { verhuurAgenda: verhuurOverzichtAan() };
const eenvoudHoofd = eenvoud ? hoofditems(rechten, hoofdOpties) : [];
const eenvoudSectie = eenvoud ? sectieVoorPad(pad) : null;
const eenvoudSub = eenvoud && eenvoudSectie ? groepeer(subitems(eenvoudSectie, rechten, hoofdOpties)) : [];
const merkHref =
  eenvoudHoofd.find((item) => item.sleutel === 'overzicht')?.href ??
  eenvoudHoofd[0]?.href ??
  (toonVerhuur ? '/beheer/verhuur/' : '/beheer/');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf8f3" />
    <title>{titel} — Kerkje van Persingen</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&family=Work+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <div class:list={['kc', { 'kc--eenvoud': eenvoud }]}>
      {
        sessie?.viewAs && (
          <p class="kc-fout" role="status">
            Je bekijkt de omgeving als {sessie.viewAs.naam}. Wijzigen is uitgeschakeld.
          </p>
        )
      }
      <header class="kc-balk">
        <div class="kc-balk-binnen">
          <a class="kc-merk" href={eenvoud ? merkHref : toonVerhuur ? '/beheer/verhuur/' : '/beheer/'}>
            <img src="/favicon.svg" width="37" height="37" alt="" />
            Kerkje van Persingen
          </a>
          <nav class="kc-nav" aria-label="Hoofdmenu">
            {
              eenvoud
                ? eenvoudHoofd.map((item) => (
                    <a href={item.href} aria-current={eenvoudSectie === item.sleutel ? 'page' : undefined}>
                      {item.label}
                    </a>
                  ))
                : (
                    <>
                      {toonVerhuur && (
                        <a href="/beheer/verhuur/" aria-current={actief === 'verhuur' ? 'page' : undefined}>
                          Verhuur
                        </a>
                      )}
                      {toonWebsite && (
                        <a href="/beheer/website/" aria-current={actief === 'website' ? 'page' : undefined}>
                          Website
                        </a>
                      )}
                    </>
                  )
            }
          </nav>
          {
            eenvoud && (
              <form class="kc-zoek" action="/beheer/zoeken/" method="get">
                <label class="kc-sr" for="kc-q">Zoeken</label>
                <input id="kc-q" name="q" type="search" placeholder="Zoek een naam of datum" />
              </form>
            )
          }
          <p class="kc-gebruiker">
            {eenvoud ? (
              naam && <small>{naam}</small>
            ) : (
              <a href="/beheer/">Beheeromgeving</a>
            )}
            {!eenvoud && naam && <small>{naam}</small>}
          </p>
          {
            eenvoud && (
              <form class="kc-uit" method="post" action="/beheer/uitloggen">
                <button type="submit">Uitloggen</button>
              </form>
            )
          }
        </div>
        {
          eenvoud && eenvoudSub.length > 0 && (
            <div class="kc-subbalk">
              {eenvoudSub.map((groep) => (
                <nav aria-label={groep.titel || 'Onderdeel'}>
                  {groep.titel && <p>{groep.titel}</p>}
                  {groep.items.map((item) => (
                    <a href={item.href} aria-current={padActief(pad, item.href) ? 'page' : undefined}>
                      {item.label}
                      {item.toelichting && <small>{item.toelichting}</small>}
                    </a>
                  ))}
                </nav>
              ))}
            </div>
          )
        }
      </header>
      <slot />
    </div>
  </body>
</html>
