---
/*
  Metseltekens — het signature-element van deze site.

  In de muren van het kerkje zitten tekens van vóór 1570 die nooit verklaard zijn:
  ruitvormige ing-runen, een verborgen gezicht, en motieven die ook in Romeins
  metselwerk voorkomen. Die vormen zijn hier teruggebracht tot lijnwerk en doen
  dienst als structuurmarkering.

  Reden dat dit werkt: het bestuur wil geen fotoshoot, dus het beeldmateriaal is
  wisselend van kwaliteit. Deze glyphs geven de site een eigen visuele taal die
  niet van fotografie afhangt en die uit het gebouw zelf komt in plaats van uit
  een iconenbibliotheek.

  Decoratief per definitie -> aria-hidden, nooit als enige informatiedrager.
*/
interface Props {
  variant?: 'ruit' | 'kruis' | 'gezicht' | 'boog';
  size?: number;
  color?: string;
  class?: string;
}

const {
  variant = 'ruit',
  size = 16,
  color = 'currentColor',
  class: className = '',
} = Astro.props;
---

<svg
  class={`mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {variant === 'ruit' && (
    <>
      <path d="M12 3 L20 12 L12 21 L4 12 Z" />
      <path d="M8.5 8.5 L15.5 15.5 M15.5 8.5 L8.5 15.5" />
    </>
  )}
  {variant === 'kruis' && (
    <>
      <path d="M12 2.5 V21.5 M3.5 12 H20.5" />
      <path d="M7 7 L17 17 M17 7 L7 17" opacity="0.45" />
    </>
  )}
  {variant === 'gezicht' && (
    <>
      <path d="M6 4.5 C6 12 6 16 12 21 C18 16 18 12 18 4.5" />
      <path d="M9.5 10 h1.2 M13.3 10 h1.2" />
      <path d="M12 12.5 v2" />
    </>
  )}
  {variant === 'boog' && (
    <>
      <path d="M5 21 V11 C5 6.5 8.2 3 12 3 C15.8 3 19 6.5 19 11 V21" />
      <path d="M12 3 V21" opacity="0.4" />
    </>
  )}
</svg>

<style>
  .mark {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
