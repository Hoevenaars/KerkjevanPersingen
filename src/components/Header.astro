---
const path = Astro.url.pathname;

// Vijf items plus één knop. Organisatie staat niet los in het hoofdmenu, maar
// wel als derde link in het "Het kerkje"-submenu — een compromis tussen
// "niemand kiest een trouwlocatie via Organisatie" en toch vindbaar zijn
// zonder helemaal naar de footer te moeten scrollen.
const nav = [
  { href: '/het-kerkje/', label: 'Het kerkje' },
  { href: '/verhuur/', label: 'Verhuur' },
  { href: '/agenda/', label: 'Agenda' },
  { href: '/steun-ons/', label: 'Steun ons' },
  { href: '/contact/', label: 'Contact' },
];

const FACEBOOK_MENU_URL = 'https://www.facebook.com/share/1LuH8m8ToB/?mibextid=wwXIfr';

const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand">
      <img src="/favicon.svg" width="34" height="34" alt="" class="brand-mark" />
      <span class="brand-name">Kerkje van Persingen</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-button">
      <span class="visually-hidden">Menu openen of sluiten</span>
      <span class="bars" aria-hidden="true"></span>
    </label>

    <nav class="nav" aria-label="Hoofdnavigatie">
      <ul>
        <li class="heeft-submenu">
          <a href="/het-kerkje/" aria-current={isActive('/het-kerkje/') ? 'page' : undefined}>
            Het kerkje
          </a>
          <ul class="submenu">
            <li><a href="/het-kerkje/geschiedenis/">Geschiedenis</a></li>
            <li><a href="/het-kerkje/omgeving/">Omgeving</a></li>
            <li><a href="/organisatie/">Organisatie</a></li>
          </ul>
        </li>
        {
          nav
            .filter((item) => item.href !== '/het-kerkje/')
            .map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
        }
        <li class="facebook-item">
          <a
            class="facebook"
            href={FACEBOOK_MENU_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"
              ></path>
            </svg>
            <span class="visually-hidden">Facebook</span>
          </a>
        </li>
      </ul>
      <a class="reserve" href="/verhuur/aanvragen/">Reserveren</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--cream);
    border-bottom: var(--border);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    padding-block: var(--s-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
  }

  .brand-mark {
    flex: none;
    border-radius: 50%;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-lg);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-8);
  }

  .nav ul {
    display: flex;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 500;
    padding-block: var(--s-2);
    border-bottom: 2px solid transparent;
  }

  .nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--sand);
  }

  .nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--olive);
  }

  .reserve {
    background: var(--brick);
    color: var(--cream) !important;
    padding: var(--s-3) var(--s-5, 1.25rem) !important;
    border-radius: var(--radius);
    font-weight: 600;
    border-bottom: none !important;
  }

  .reserve:hover {
    background: var(--brick-dark);
  }

  /* Klein en gedempt, zodat het niet meedoet met de tekstlinks of de reserveringsknop. */
  .facebook-item {
    display: flex;
    align-items: center;
  }

  .nav a.facebook {
    display: inline-flex;
    align-items: center;
    color: var(--ink-mute);
    border-bottom: none;
    padding-block: 0;
    opacity: 0.72;
    line-height: 0;
  }

  .nav a.facebook:hover {
    color: var(--pine);
    border-bottom-color: transparent;
    opacity: 1;
  }

  .heeft-submenu {
    position: relative;
  }

  /*
    Bewust GEEN display:none/block-toggle. Een element met display:none is niet
    focusbaar via het toetsenbord, dus zou dit submenu voor toetsenbordgebruikers
    permanent onbereikbaar zijn. In plaats daarvan blijft het element altijd
    aanwezig (dus focusbaar), en wisselt alleen zichtbaarheid en klikbaarheid.

    Geen margin tussen link en submenu — dat gaf eerder een "dood gebied" waar de
    muis de hover-status kon verliezen vóór het submenu bereikt werd. De ruimte
    zit nu als padding BINNEN het submenu, zodat de cursor nooit over niets beweegt.
  */
  .submenu {
    position: absolute;
    top: 100%;
    left: 0;
    margin: 0;
    padding: var(--s-3) var(--s-2) var(--s-2);
    min-width: 180px;
    background: var(--cream);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    list-style: none;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s var(--ease);
  }

  .heeft-submenu:hover .submenu,
  .heeft-submenu:focus-within .submenu {
    opacity: 1;
    pointer-events: auto;
  }

  .submenu li {
    display: block;
  }

  .submenu a {
    display: block;
    padding: var(--s-2) var(--s-3);
    border-bottom: none;
    white-space: nowrap;
  }

  .submenu a:hover {
    background: var(--cream-deep);
  }

  /* Mobiel menu zonder JavaScript — 10_FRONTEND_STANDARDS.md §4 */
  .nav-toggle,
  .nav-button {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-button {
      display: block;
      width: 40px;
      height: 40px;
      cursor: pointer;
      position: relative;
    }

    .bars,
    .bars::before,
    .bars::after {
      content: '';
      position: absolute;
      left: 8px;
      width: 24px;
      height: 2px;
      background: var(--ink);
      transition: transform 0.2s var(--ease);
    }
    .bars {
      top: 19px;
    }
    .bars::before {
      top: -7px;
    }
    .bars::after {
      top: 7px;
    }

    .nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--cream);
      border-bottom: var(--border);
      padding: var(--s-4) var(--s-6) var(--s-6);
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
    }

    .nav ul a {
      display: block;
      padding: var(--s-4) 0;
      border-bottom: 1px solid var(--sand);
      font-size: var(--t-base);
    }

    .nav ul a.facebook {
      display: inline-flex;
      width: auto;
      padding: var(--s-4) 0;
      border-bottom: none;
      font-size: 0;
    }

    /* Op mobiel altijd zichtbaar onder "Het kerkje" — geen hover op een telefoon,
       en een extra tik toevoegen is meer moeite dan het waard voor drie links. */
    .submenu {
      position: static;
      opacity: 1;
      pointer-events: auto;
      box-shadow: none;
      border: none;
      background: transparent;
      padding: 0 0 0 var(--s-4);
    }

    .reserve {
      margin-top: var(--s-4);
      text-align: center;
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }

    .nav-toggle:focus-visible + .nav-button {
      outline: 3px solid var(--brick);
      outline-offset: 2px;
    }
  }
</style>
