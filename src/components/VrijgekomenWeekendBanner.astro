---
import Button from './Button.astro';
import {
  VRIJGEKOMEN_EXPOSITIE_WEEKEND,
  aanvraagPadVrijgekomenWeekend,
  toonVrijgekomenWeekendBanner,
} from '../lib/vrijgekomen-weekend';

const zichtbaar = toonVrijgekomenWeekendBanner();
const { titel, tekst, knop } = VRIJGEKOMEN_EXPOSITIE_WEEKEND;
const href = aanvraagPadVrijgekomenWeekend();
---

{
  zichtbaar && (
    <aside class="banner" aria-labelledby="vrijgekomen-weekend-titel">
      <svg class="blad blad--links" viewBox="0 0 160 150" aria-hidden="true" focusable="false">
        <g fill="#7c8460" stroke="none">
          <path d="M22 142 C44 108 54 72 82 18" fill="none" stroke="#6f7758" stroke-width="1.2" stroke-linecap="round" opacity="0.45" />
          <path d="M48 104 C58 88 70 72 86 52" fill="none" stroke="#6f7758" stroke-width="1" stroke-linecap="round" opacity="0.35" />
          <ellipse cx="30" cy="118" rx="18" ry="7" transform="rotate(-56 30 118)" opacity="0.28" />
          <ellipse cx="42" cy="102" rx="20" ry="7.5" transform="rotate(38 42 102)" opacity="0.22" />
          <ellipse cx="38" cy="96" rx="17" ry="6.5" transform="rotate(-50 38 96)" opacity="0.32" />
          <ellipse cx="54" cy="82" rx="19" ry="7" transform="rotate(32 54 82)" opacity="0.24" />
          <ellipse cx="50" cy="74" rx="16" ry="6" transform="rotate(-42 50 74)" opacity="0.3" />
          <ellipse cx="66" cy="60" rx="17" ry="6.5" transform="rotate(28 66 60)" opacity="0.22" />
          <ellipse cx="64" cy="52" rx="15" ry="5.8" transform="rotate(-36 64 52)" opacity="0.28" />
          <ellipse cx="78" cy="38" rx="15" ry="5.5" transform="rotate(22 78 38)" opacity="0.2" />
          <ellipse cx="80" cy="28" rx="14" ry="5.2" transform="rotate(-28 80 28)" opacity="0.26" />
          <ellipse cx="74" cy="58" rx="13" ry="5" transform="rotate(48 74 58)" opacity="0.18" />
          <ellipse cx="88" cy="42" rx="12" ry="4.6" transform="rotate(40 88 42)" opacity="0.2" />
        </g>
      </svg>
      <svg class="blad blad--rechts" viewBox="0 0 160 150" aria-hidden="true" focusable="false">
        <g fill="#7c8460" stroke="none">
          <path d="M22 142 C44 108 54 72 82 18" fill="none" stroke="#6f7758" stroke-width="1.2" stroke-linecap="round" opacity="0.45" />
          <path d="M48 104 C58 88 70 72 86 52" fill="none" stroke="#6f7758" stroke-width="1" stroke-linecap="round" opacity="0.35" />
          <ellipse cx="30" cy="118" rx="18" ry="7" transform="rotate(-56 30 118)" opacity="0.28" />
          <ellipse cx="42" cy="102" rx="20" ry="7.5" transform="rotate(38 42 102)" opacity="0.22" />
          <ellipse cx="38" cy="96" rx="17" ry="6.5" transform="rotate(-50 38 96)" opacity="0.32" />
          <ellipse cx="54" cy="82" rx="19" ry="7" transform="rotate(32 54 82)" opacity="0.24" />
          <ellipse cx="50" cy="74" rx="16" ry="6" transform="rotate(-42 50 74)" opacity="0.3" />
          <ellipse cx="66" cy="60" rx="17" ry="6.5" transform="rotate(28 66 60)" opacity="0.22" />
          <ellipse cx="64" cy="52" rx="15" ry="5.8" transform="rotate(-36 64 52)" opacity="0.28" />
          <ellipse cx="78" cy="38" rx="15" ry="5.5" transform="rotate(22 78 38)" opacity="0.2" />
          <ellipse cx="80" cy="28" rx="14" ry="5.2" transform="rotate(-28 80 28)" opacity="0.26" />
          <ellipse cx="74" cy="58" rx="13" ry="5" transform="rotate(48 74 58)" opacity="0.18" />
          <ellipse cx="88" cy="42" rx="12" ry="4.6" transform="rotate(40 88 42)" opacity="0.2" />
        </g>
      </svg>

      <div class="wrap binnen">
        <div class="icoon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="6" width="16" height="14" rx="2.2" />
            <path d="M8 3.8v4M16 3.8v4M4 10h16" />
          </svg>
        </div>

        <div class="tekstblok">
          <p class="titel" id="vrijgekomen-weekend-titel">{titel}</p>
          <p class="tekst">{tekst}</p>
        </div>

        <div class="knop">
          <Button href={href} variant="primary">
            {knop} <span aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </aside>
  )
}

<style>
  .banner {
    position: relative;
    overflow: hidden;
    background: var(--cream-deep);
    border-bottom: var(--border);
  }

  .blad {
    position: absolute;
    top: 50%;
    width: min(170px, 17vw);
    height: auto;
    pointer-events: none;
    z-index: 0;
  }

  .blad--links {
    left: 0;
    transform: translateY(-50%);
  }

  .blad--rechts {
    right: 0;
    transform: translateY(-50%) scaleX(-1);
  }

  .binnen {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--s-6);
    align-items: center;
    padding-block: var(--s-6);
  }

  .icoon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--sand);
    background: var(--cream);
    color: var(--olive-dark);
    display: grid;
    place-items: center;
  }

  .titel {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 var(--s-2);
    max-width: none;
    text-wrap: balance;
  }

  .tekst {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .knop {
    display: flex;
  }

  @media (max-width: 860px) {
    .blad {
      display: none;
    }

    .binnen {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s-4);
    }

    .icoon {
      width: 44px;
      height: 44px;
    }

    .knop {
      grid-column: 1 / -1;
    }

    .knop :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
