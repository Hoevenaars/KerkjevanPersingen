---
import Button from './Button.astro';
import {
  VRIJGEKOMEN_EXPOSITIE_WEEKEND,
  aanvraagPadVrijgekomenWeekend,
  toonVrijgekomenWeekendBanner,
} from '../lib/vrijgekomen-weekend';

const zichtbaar = toonVrijgekomenWeekendBanner();
const { titel, tekst, knop } = VRIJGEKOMEN_EXPOSITIE_WEEKEND;
const href = aanvraagPadVrijgekomenWeekend();
---

{
  zichtbaar && (
    <aside class="banner" aria-labelledby="vrijgekomen-weekend-titel">
      <svg class="blad blad--links" viewBox="0 0 120 150" aria-hidden="true" focusable="false">
        <g opacity="0.72">
          <path d="M18 142 C38 104 48 68 72 18" fill="none" stroke="#5f6549" stroke-width="1.35" stroke-linecap="round" />
          <path d="M40 108 C52 90 64 74 80 52" fill="none" stroke="#5f6549" stroke-width="1.05" stroke-linecap="round" />
          <path d="M22 128 C8 112 4 96 10 80 C24 86 34 104 22 128Z" fill="#7c8460" />
          <path d="M28 122 C44 108 56 96 58 78 C40 86 30 102 28 122Z" fill="#6a7354" />
          <path d="M36 104 C22 86 20 66 30 50 C46 60 50 84 36 104Z" fill="#8a9270" />
          <path d="M42 98 C58 84 72 70 78 52 C60 60 48 78 42 98Z" fill="#5f6549" />
          <path d="M50 78 C38 58 40 38 52 24 C64 38 66 60 50 78Z" fill="#7c8460" />
          <path d="M56 72 C72 58 86 42 92 26 C76 36 62 54 56 72Z" fill="#6a7354" />
          <path d="M64 52 C56 34 60 16 74 6 C82 22 80 40 64 52Z" fill="#8a9270" />
          <path d="M70 46 C84 34 96 20 104 8 C90 16 78 30 70 46Z" fill="#5f6549" />
          <path d="M62 64 C74 54 88 48 100 38 C88 50 74 58 62 64Z" fill="#7c8460" opacity="0.85" />
        </g>
      </svg>
      <svg class="blad blad--rechts" viewBox="0 0 120 150" aria-hidden="true" focusable="false">
        <g opacity="0.72">
          <path d="M18 142 C38 104 48 68 72 18" fill="none" stroke="#5f6549" stroke-width="1.35" stroke-linecap="round" />
          <path d="M40 108 C52 90 64 74 80 52" fill="none" stroke="#5f6549" stroke-width="1.05" stroke-linecap="round" />
          <path d="M22 128 C8 112 4 96 10 80 C24 86 34 104 22 128Z" fill="#7c8460" />
          <path d="M28 122 C44 108 56 96 58 78 C40 86 30 102 28 122Z" fill="#6a7354" />
          <path d="M36 104 C22 86 20 66 30 50 C46 60 50 84 36 104Z" fill="#8a9270" />
          <path d="M42 98 C58 84 72 70 78 52 C60 60 48 78 42 98Z" fill="#5f6549" />
          <path d="M50 78 C38 58 40 38 52 24 C64 38 66 60 50 78Z" fill="#7c8460" />
          <path d="M56 72 C72 58 86 42 92 26 C76 36 62 54 56 72Z" fill="#6a7354" />
          <path d="M64 52 C56 34 60 16 74 6 C82 22 80 40 64 52Z" fill="#8a9270" />
          <path d="M70 46 C84 34 96 20 104 8 C90 16 78 30 70 46Z" fill="#5f6549" />
          <path d="M62 64 C74 54 88 48 100 38 C88 50 74 58 62 64Z" fill="#7c8460" opacity="0.85" />
        </g>
      </svg>

      <div class="wrap binnen">
        <div class="icoon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="6" width="16" height="14" rx="2.2" />
            <path d="M8 3.8v4M16 3.8v4M4 10h16" />
          </svg>
        </div>

        <div class="tekstblok">
          <p class="titel" id="vrijgekomen-weekend-titel">{titel}</p>
          <p class="tekst">{tekst}</p>
        </div>

        <div class="knop">
          <Button href={href} variant="primary">
            {knop} <span aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </aside>
  )
}

<style>
  .banner {
    position: relative;
    overflow: hidden;
    background: var(--cream-deep);
    border-bottom: var(--border);
  }

  .binnen {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--s-6);
    align-items: center;
    padding-block: var(--s-6);
  }

  .blad {
    position: absolute;
    top: 50%;
    width: 130px;
    height: auto;
    pointer-events: none;
    z-index: 0;
  }

  /* Naast de contentkolom houden, niet tegen de viewport-rand op ultrawide. */
  .blad--links {
    left: max(0px, calc(50% - 620px));
    transform: translateY(-50%);
  }

  .blad--rechts {
    right: max(0px, calc(50% - 620px));
    transform: translateY(-50%) scaleX(-1);
  }

  .binnen > * {
    position: relative;
    z-index: 1;
  }

  .icoon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--sand);
    background: var(--cream);
    color: var(--olive-dark);
    display: grid;
    place-items: center;
  }

  .titel {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 var(--s-2);
    max-width: none;
    text-wrap: balance;
  }

  .tekst {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: none;
  }

  .knop {
    display: flex;
  }

  @media (max-width: 860px) {
    .blad {
      display: none;
    }

    .binnen {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s-4);
      align-items: start;
    }

    .icoon {
      width: 44px;
      height: 44px;
    }

    .titel {
      font-size: var(--t-xl);
    }

    .knop {
      grid-column: 1 / -1;
    }

    .knop :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
