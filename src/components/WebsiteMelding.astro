---
/**
 * Informatiebanner voor een tijdelijke homepage-melding.
 * Geen popup: een balk direct onder de header, alleen op de homepage.
 */
import { leesPubliekeWebsiteMelding } from '../lib/website-melding-lezen';

const opHomepage = Astro.url.pathname === '/';
const melding = opHomepage ? await leesPubliekeWebsiteMelding() : null;
---

{
  melding && (
    <aside class="bereikbaarheid" aria-labelledby="bereikbaarheid-titel">
      <div class="wrap binnen">
        {melding.titel && (
          <p class="titel" id="bereikbaarheid-titel">
            {melding.titel}
          </p>
        )}
        {melding.alinea.map((alinea) => (
          <p class="tekst">{alinea}</p>
        ))}
      </div>
    </aside>
  )
}

<style>
  .bereikbaarheid {
    background: var(--pine);
    color: var(--cream);
    border-bottom: 1px solid var(--olive-dark);
  }

  .binnen {
    padding-block: var(--s-6);
  }

  .titel {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    margin: 0 0 var(--s-3);
    max-width: 42rem;
    text-wrap: balance;
    color: var(--cream);
  }

  .tekst {
    margin: 0 0 var(--s-3);
    max-width: 46rem;
    font-size: var(--t-base);
    line-height: 1.55;
    color: var(--cream);
  }

  .tekst:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .binnen {
      padding-block: var(--s-4);
    }

    .titel {
      font-size: 1.05rem;
    }

    .tekst {
      font-size: 0.975rem;
    }
  }
</style>
