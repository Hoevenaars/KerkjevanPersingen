---
import { groepeerOpProces } from '../../platform/mailtemplates/proces.ts';

interface Props {
  templates: { id: string; naam: string }[];
  ontvanger: string;
  modus: string;
  testadres: string | null;
  replyTo: string;
  preview?: { onderwerp: string; text: string } | null;
  formActie?: string;
  tab?: string;
  titel?: string;
  toelichting?: string;
  gekozenTemplate?: string;
  onderwerp?: string;
  inhoud?: string;
  verzendLabel?: string;
  verbergTemplate?: boolean;
  toonConcept?: boolean;
  contract?: boolean;
}

const {
  templates,
  ontvanger,
  modus,
  testadres,
  replyTo,
  preview = null,
  formActie = '',
  tab = '',
  titel = 'Nieuw mailconcept',
  toelichting = '',
  gekozenTemplate = '',
  onderwerp = '',
  inhoud = '',
  verzendLabel = 'Versturen',
  verbergTemplate = false,
  toonConcept = true,
  contract = false,
} = Astro.props;
const tekst = inhoud;
const onderwerpWaarde = preview?.onderwerp && !contract
  ? preview.onderwerp
  : (onderwerp || preview?.onderwerp || '');
const groepen = groepeerOpProces(templates);
---

<section class="bh-kaart">
  <h2>{titel}</h2>
  {
    toelichting ? (
      <p class="bh-muted">{toelichting}</p>
    ) : (
      <p class="bh-muted">
        Huidige modus: {modus}. Reply-To: {replyTo}. Ontvanger in het dossier: {ontvanger || '—'}.
        {modus === 'Test' && testadres ? ` Testmail wordt verstuurd naar: ${testadres}.` : ''}
        {modus === 'Uit' ? ' Uit doet geen provider-call.' : ''}
      </p>
    )
  }
  <form method="post" action={formActie || undefined} class="bh-form">
    {tab && <input type="hidden" name="tab" value={tab} />}
    {contract && <input type="hidden" name="contract" value="1" />}
    {
      verbergTemplate ? (
        gekozenTemplate && <input type="hidden" name="templateId" value={gekozenTemplate} />
      ) : (
        <>
          <label for="templateId">Template</label>
          <select id="templateId" name="templateId">
            <option value="">Vrije tekst</option>
            {
              groepen.map((groep) => (
                <optgroup label={groep.titel}>
                  {groep.templates.map((item) => (
                    <option value={item.id} selected={item.id === gekozenTemplate}>
                      {item.naam}
                    </option>
                  ))}
                </optgroup>
              ))
            }
          </select>
        </>
      )
    }
    <label for="mailOnderwerp">Onderwerp</label>
    <input id="mailOnderwerp" name="mailOnderwerp" value={onderwerpWaarde} />
    <label for="mailInhoud">{contract ? 'Tekst van de mail' : 'Inhoud'}</label>
    <textarea id="mailInhoud" name="mailInhoud" rows={contract ? 14 : 8}>{tekst}</textarea>
    <div class="bh-acties">
      {toonConcept && <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="mailconcept">Concept bewaren</button>}
      <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="mailpreview">Preview</button>
      <button class="bh-btn" type="submit" name="actie" value="mailverstuur">{verzendLabel}</button>
      {!contract && <p class="bh-muted">Versturen blijft op dit scherm en toont wat er gebeurd is. Uit verstuurt geen mail.</p>}
    </div>
  </form>
  {
    preview && (
      <div>
        <h3>Preview</h3>
        <p><strong>{preview.onderwerp}</strong></p>
        <pre class="bh-muted">{preview.text}</pre>
      </div>
    )
  }
</section>
