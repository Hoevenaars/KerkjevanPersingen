---
import type { ContractOpvolgingWeergave } from '../../platform/documentenflow.ts';

interface Props {
  opvolging: ContractOpvolgingWeergave;
  actie: string;
  betalingToelichting: string;
  toonMaken?: boolean;
  nieuweVersieHref?: string;
  toonOntvangst?: boolean;
  driePdf?: boolean;
}

const { opvolging, actie, betalingToelichting, toonMaken = true, nieuweVersieHref = '', toonOntvangst = true, driePdf = false } = Astro.props;
const proef = opvolging.modus !== 'aan';
---

<section class="bh-kaart" id="contract-opvolging" aria-label="Contract en opvolging">
  <h2>Contract en opvolging</h2>
  {opvolging.fout && <p class="bh-flash">{opvolging.fout}</p>}
  {
    opvolging.aandacht.length > 0 && (
      <div>
        <h3>Aandacht voor het bestuur</h3>
        <p class="bh-muted">Dit blokkeert verzenden niet. Voorwaarden en bedragen zijn niet automatisch aangepast.</p>
        <ul>
          {opvolging.aandacht.map((punt) => <li>{punt}</li>)}
        </ul>
      </div>
    )
  }
  <dl class="bh-dl">
    {
      opvolging.regels.map((regel) => (
        <>
          <dt>{regel.label}</dt>
          <dd>{regel.waarde}</dd>
        </>
      ))
    }
  </dl>
  {betalingToelichting && <p class="bh-muted">{betalingToelichting}</p>}
  {
    toonOntvangst && opvolging.kanOndertekenen && (
      <form method="post" action={actie} class="bh-form" enctype="multipart/form-data">
        <p class="bh-muted">Het getekende contract is binnen. Dit legt dat vast. Er gaat geen mail uit. Is de checklist daarna compleet, dan wordt de boeking definitief.</p>
        <label for="df-getekend-pdf">Ondertekende PDF, als je die hebt</label>
        <input id="df-getekend-pdf" name="bestand" type="file" accept="application/pdf,.pdf" />
        <button class="bh-btn" type="submit" name="actie" value="ondertekening_ontvangen">Contract ondertekend</button>
      </form>
    )
  }
  {
    toonOntvangst && opvolging.kanAanbetaling && (
      <form method="post" action={actie}>
        <p class="bh-muted">De aanbetaling staat op de rekening. De restbetaling blijft open. Er gaat geen mail uit. Is de checklist daarna compleet, dan wordt de boeking definitief.</p>
        <button class="bh-btn" type="submit" name="actie" value="aanbetaling_ontvangen">Aanbetaling ontvangen</button>
      </form>
    )
  }
  {opvolging.versie != null && opvolging.versie > 1 && <p>Eerdere versies gelden niet meer. Alleen deze versie kan worden goedgekeurd en verzonden.</p>}
  {
    nieuweVersieHref && (
      <>
        <p class="bh-acties"><a class="bh-btn" href={nieuweVersieHref}>Nieuwe versie</a></p>
        <p class="bh-muted">U vult de gegevens opnieuw in. Opslaan laat de huidige versie direct vervallen en maakt een nieuwe versie. De tekenlink van de oude versie werkt daarna niet meer. Er gaat geen mail uit.</p>
      </>
    )
  }
  {
    opvolging.redenen.length > 0 && (
      <p>Verzenden blijft dicht. Nog nodig: {opvolging.redenen.join(', ')}.</p>
    )
  }
  {
    opvolging.modus === 'uit' && opvolging.versie && (
      <p>De mailschakelaar staat uit. Een proefmail kan pas als Handmatige template op Test staat. Er gaat niets naar de huurder.</p>
    )
  }

  {
    toonMaken && opvolging.kanMaken && !nieuweVersieHref && (
      <form method="post" action={actie} class="bh-form">
        <input type="hidden" name="actie" value="df_maken" />
        <h3>Gebruiksafspraken</h3>
        <label for="df-van">Gebruik van</label>
        <input id="df-van" name="tijdVan" value={opvolging.afspraken.tijdVan} required maxlength="40" />
        <label for="df-tot">Gebruik tot</label>
        <input id="df-tot" name="tijdTot" value={opvolging.afspraken.tijdTot} required maxlength="40" />
        <label for="df-opbouw">Opbouw</label>
        <input id="df-opbouw" name="opbouw" value={opvolging.afspraken.opbouw} required maxlength="240" />
        <label for="df-afbouw">Afbouw</label>
        <input id="df-afbouw" name="afbouw" value={opvolging.afspraken.afbouw} required maxlength="240" />
        <label for="df-contact">Contactpersoon</label>
        <input id="df-contact" name="contactpersoon" value={opvolging.afspraken.contactpersoon} required maxlength="120" />
        <div class="bh-acties">
          <button class="bh-btn" type="submit">{opvolging.versie ? 'Nieuwe versie' : 'Contract maken'}</button>
        </div>
      </form>
    )
  }

  {driePdf && opvolging.kanGoedkeuren && (
    <form method="post" action={actie} class="bh-form" id="bestuursbesluit-contract">
      <h3>Is dit contractpakket akkoord?</h3>
      <p class="bh-muted">Bekijk de drie documenten. Bij Ja wordt het pakket direct met de tekenlink verzonden; bij Nee gaat het terug ter correctie.</p>
      <div class="bh-acties" aria-label="Voorbeeld van de drie contractdocumenten">
        <a class="bh-btn bh-btn--sec" href={`${actie}?document=overeenkomst&versie=${opvolging.versie}`} target="_blank" rel="noopener noreferrer">1. Overeenkomst (PDF)</a>
        <a class="bh-btn bh-btn--sec" href={`${actie}?document=voorwaarden&versie=${opvolging.versie}`} target="_blank" rel="noopener noreferrer">2. Voorwaarden (PDF)</a>
        <a class="bh-btn bh-btn--sec" href={`${actie}?document=factuur&versie=${opvolging.versie}`} target="_blank" rel="noopener noreferrer">3. Conceptfactuur (PDF)</a>
      </div>
      <input type="hidden" name="versie" value={opvolging.versie ?? ''} />
      <div class="bh-acties">
        <button class="bh-btn" type="submit" name="actie" value="df_ja_en_verzend">Ja, pakket goedkeuren en verzenden</button>
        {opvolging.kanTerug && <button class="bh-btn bh-btn--gevaar" type="submit" name="actie" value="df_nee_contract">Nee, aanpassen</button>}
      </div>
      {opvolging.kanTerug && <><label for="bestuur-toelichting">Toelichting bij Nee (optioneel)</label><textarea id="bestuur-toelichting" name="toelichting" rows="2" maxlength="500"></textarea></>}
    </form>
  )}
  <div class="bh-acties">
    {opvolging.kanBekijken && (!driePdf || !opvolging.kanGoedkeuren) && <a class="bh-btn bh-btn--sec" href={opvolging.bekijkHref}>Contract bekijken</a>}
    {
      !driePdf && opvolging.kanGoedkeuren && (
        <form method="post" action={actie}>
          <input type="hidden" name="actie" value="df_akkoord" />
          <button class="bh-btn" type="submit">Goedkeuren</button>
        </form>
      )
    }
    {
      opvolging.kanVerzenden && (!driePdf || !opvolging.kanGoedkeuren) && (
        <form method="post" action={actie}>
          <input type="hidden" name="actie" value="df_verzend" />
          <input type="hidden" name="proef" value="nee" />
          <input type="hidden" name="poging" value={crypto.randomUUID()} />
          <button class="bh-btn" type="submit">{driePdf ? 'Contractverzending hervatten' : 'Verzenden'}</button>
        </form>
      )
    }
    {
      opvolging.kanOpnieuw && (
        <form method="post" action={actie}>
          <input type="hidden" name="actie" value="df_opnieuw" />
          <input type="hidden" name="poging" value={crypto.randomUUID()} />
          <button class="bh-btn bh-btn--sec" type="submit">Opnieuw verzenden</button>
        </form>
      )
    }
    {
      opvolging.kanProef && (
        <form method="post" action={actie}>
          <input type="hidden" name="actie" value="df_verzend" />
          <input type="hidden" name="proef" value="ja" />
          <input type="hidden" name="poging" value={crypto.randomUUID()} />
          <button class="bh-btn bh-btn--sec" type="submit">Proefmail</button>
        </form>
      )
    }
  </div>
  {
    opvolging.kanTerug && (!driePdf || !opvolging.kanGoedkeuren) && (
      <form method="post" action={actie} class="bh-form">
        {driePdf ? (
          <>
            <input type="hidden" name="versie" value={opvolging.versie ?? ''} />
            <label for="df-terug">Toelichting bij Nee (optioneel)</label>
            <textarea id="df-terug" name="toelichting" rows="2" maxlength="500"></textarea>
            <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="df_nee_contract">Nee, aanpassen</button>
          </>
        ) : (
          <>
            <input type="hidden" name="actie" value="df_terug" />
            <label for="df-terug">Terug voor aanpassing</label>
            <textarea id="df-terug" name="toelichting" rows="3" required maxlength="500"></textarea>
            <button class="bh-btn bh-btn--sec" type="submit">Terug voor aanpassing</button>
          </>
        )}
      </form>
    )
  }
  {
    opvolging.praktischStand && <p>{opvolging.praktischStand}</p>
  }
  {
    opvolging.praktischTekst && (
      <>
        <h3>Kennismakingsmail</h3>
        <pre class="bh-muted">{opvolging.praktischTekst}</pre>
      </>
    )
  }
  {
    opvolging.kanPraktisch && (
      <form method="post" action={actie}>
        <input type="hidden" name="actie" value="df_praktisch" />
        <input type="hidden" name="proef" value={proef ? 'ja' : 'nee'} />
        <input type="hidden" name="poging" value={crypto.randomUUID()} />
        <button class="bh-btn" type="submit">{proef ? 'Proefmail gastbegeleider' : 'Verstuur kennismakingsmail'}</button>
      </form>
    )
  }
  {opvolging.promotieStand && <p>{opvolging.promotieStand}</p>}
  {
    opvolging.kanPromotie && (
      <form method="post" action={actie}>
        <input type="hidden" name="actie" value="df_promotie" />
        <input type="hidden" name="proef" value={proef ? 'ja' : 'nee'} />
        <input type="hidden" name="poging" value={crypto.randomUUID()} />
        <button class="bh-btn bh-btn--sec" type="submit">{proef ? 'Proef van de herinnering' : 'Verstuur herinnering'}</button>
      </form>
    )
  }
  {
    opvolging.kanGereed && (
      <form method="post" action={actie}>
        <input type="hidden" name="actie" value="df_gereed" />
        <input type="hidden" name="poging" value={crypto.randomUUID()} />
        <button class="bh-btn" type="submit">Verstuur definitieve bevestiging</button>
      </form>
    )
  }

  {
    opvolging.lijsten.map((groep) => (
      <div>
        <h3>{groep.lijst.titel}</h3>
        {
          groep.lijst.groepen.map((deel) => (
            <div>
              <p><strong>{deel.titel}</strong></p>
              <ul class="bh-checks">
                {
                  deel.punten.map((punt) => (
                    <li class={groep.aangevinkt[punt.id] ? 'is-klaar' : 'is-open'}>
                      <span>{punt.tekst}</span>
                      {
                        opvolging.kanVinken && opvolging.versie && (
                          <form method="post" action={actie}>
                            <input type="hidden" name="actie" value="df_vink" />
                            <input type="hidden" name="punt" value={punt.id} />
                            <input type="hidden" name="aan" value={groep.aangevinkt[punt.id] ? 'nee' : 'ja'} />
                            <button class="bh-btn bh-btn--sec" type="submit">{groep.aangevinkt[punt.id] ? 'Maak open' : 'Afvinken'}</button>
                          </form>
                        )
                      }
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
        <p>{groep.lijst.slot}</p>
      </div>
    ))
  }
</section>
