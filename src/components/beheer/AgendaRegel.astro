---
import type { StartAgendaItem } from '../../platform/dashboard-start.ts';

interface Props {
  item: StartAgendaItem;
  gasten: string;
}

const { item, gasten } = Astro.props;
---

<li>
  <a class="bh-agendarij" href={item.href}>
    <span class="bh-datumblok">
      <span>{item.datum.week}</span>
      <strong>{item.datum.dagen}</strong>
      <span>{item.datum.maand}</span>
    </span>
    <span class="bh-agendatekst">
      <strong>{item.naam}</strong>
      {(item.soort || item.tijd) && (
        <span class="bh-agenda-soort">
          {item.soort}
          {item.tijd && <span>{item.tijd}</span>}
        </span>
      )}
      {gasten && <span class:list={['bh-gast', { 'bh-gast-mist': item.zonderBegeleider }]}>{gasten}</span>}
    </span>
    <span class="bh-chevron" aria-hidden="true" />
  </a>
</li>
