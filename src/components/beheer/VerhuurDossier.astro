---
import StatusMarkering from './StatusMarkering.astro';
import StukBeoordeling from './StukBeoordeling.astro';
import { staatKleur, type DossierActieZichtbaar, type DossierWeergave } from '../../platform/verhuur-scherm.ts';

interface Props {
  dossier: DossierWeergave;
  sluitHref: string;
  bevestigHref: string;
  formulierActie: string;
  dossierActie: string;
  terug: string;
  magSchrijven: boolean;
  demo: boolean;
  weg: boolean;
  status: string;
  acties: DossierActieZichtbaar;
  incidenten: { id: string; omschrijving: string }[];
  gegevens: { label: string; waarde: string }[];
  betaalregels: { label: string; waarde: string }[];
  geschiedenis: { label: string; waarde: string }[];
  geschiedenisToelichting: string;
  oudHref: string;
}

const {
  dossier,
  sluitHref,
  bevestigHref,
  formulierActie,
  dossierActie,
  terug,
  magSchrijven,
  demo,
  weg,
  status,
  acties,
  incidenten,
  gegevens,
  betaalregels,
  geschiedenis,
  geschiedenisToelichting,
  oudHref,
} = Astro.props;
const aantal = dossier.taken.length;
---

<div class="kc-overlay">
  <a class="kc-achter" href={sluitHref}><span>Sluit het dossier</span></a>
  <aside class="kc-lade" role="dialog" aria-modal="true" aria-labelledby="kc-dossier-naam" tabindex="-1" data-kc-dossier>
    <div class="kc-lade-kop">
      <div class="kc-lade-top">
        <p class="kc-wenkbrauw">Boeking · {dossier.periode}</p>
        <a class="kc-sluit" id="kc-sluit" href={sluitHref} aria-label="Sluit dossier">×</a>
      </div>
      <h2 id="kc-dossier-naam">{dossier.naam}</h2>
      <p class="kc-sub">{dossier.activiteit}</p>
    </div>
    <div class="kc-lade-lichaam">
      <div class="kc-oproep">
        <div aria-hidden="true">{aantal ? '✧' : '✓'}</div>
        <div>
          <strong>{aantal ? `Nog ${aantal} ${aantal === 1 ? 'zaak' : 'zaken'} te controleren` : 'Geen openstaande actie'}</strong>
          <p>
            {
              aantal
                ? dossier.taken.join(' ')
                : 'Er is geen open betaling, geen ontbrekende gastheer en geen inhoud die op beoordeling wacht.'
            }
          </p>
        </div>
      </div>

      {
        gegevens.length > 0 && (
          <section class="kc-kaart">
            <h3>Boeking en beschikbaarheid</h3>
            <div class="kc-kaart-inhoud">
              <div class="kc-rooster">
                {
                  gegevens.map((veld) => (
                    <div>
                      <p class="kc-bijschrift">{veld.label}</p>
                      <p class="kc-waarde">{veld.waarde}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
        )
      }

      <section class="kc-kaart">
        <h3>Gegevens huurder</h3>
        <div class="kc-kaart-inhoud">
          <div class="kc-rooster">
            {
              dossier.velden.map((veld) => (
                <div>
                  <p class="kc-bijschrift">{veld.label}</p>
                  <p class="kc-waarde">{veld.waarde}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Aangeleverde stukken</h3>
        <div class="kc-kaart-inhoud">
          <div class="kc-stuk">
            <div class="kc-stuk-kop">
              <div class="kc-stuk-icoon" aria-hidden="true">▤</div>
              <div>
                <b>Tekst voor de website</b>
                {dossier.versie && <small> · {dossier.versie}</small>}
                <div style="margin-top:7px">
                  <StatusMarkering kleur={staatKleur(dossier.stukken)} tekst={dossier.stukkenLabel} />
                </div>
                {
                  dossier.stukTekst ? (
                    <p>{dossier.stukTekst}</p>
                  ) : (
                    <p>Er is geen aangeleverde tekst gevonden.</p>
                  )
                }
                <StukBeoordeling />
              </div>
            </div>
          </div>
          <div class="kc-stuk">
            <div class="kc-stuk-kop">
              <div class="kc-stuk-icoon" aria-hidden="true">▣</div>
              <div>
                <b>Foto voor de website</b>
                {
                  dossier.fotoUrl ? (
                    <>
                      <img class="kc-foto" src={dossier.fotoUrl} alt="Aangeleverde foto voor de website" />
                      <p><a href={dossier.fotoUrl} target="_blank" rel="noopener noreferrer">Bekijken</a></p>
                    </>
                  ) : (
                    <p>Er is geen publieke foto gekoppeld.</p>
                  )
                }
                <StukBeoordeling />
              </div>
            </div>
          </div>
          {
            dossier.intake.map((bestand) => (
              <div class="kc-stuk">
                <div class="kc-stuk-kop">
                  <div class="kc-stuk-icoon" aria-hidden="true">▣</div>
                  <div>
                    <b>{bestand.naam}</b>
                    <p>Privé aangeleverd bestand. Dit staat niet op de website.</p>
                    {
                      bestand.url ? (
                        <p><a href={bestand.url} target="_blank" rel="noopener noreferrer">Bekijken</a></p>
                      ) : (
                        <p>Geen veilige voorbeeldlink. Het bestand blijft privé.</p>
                      )
                    }
                    <StukBeoordeling />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Contract en documenten</h3>
        <div class="kc-kaart-inhoud">
          <StatusMarkering kleur="unknown" tekst="Onbekend" />
          <p>{dossier.contractTekst}</p>
          {
            dossier.documenten.length === 0 ? (
              <p>Er staat geen document bij deze boeking.</p>
            ) : (
              dossier.documenten.map((document) => (
                <div class="kc-stuk">
                  <b>{document.naam}</b>
                  <p class="kc-bijschrift">{document.soort}{document.datum ? ` · ${document.datum}` : ''}</p>
                  {
                    document.url ? (
                      <p><a href={document.url} target="_blank" rel="noopener noreferrer">Bekijken</a></p>
                    ) : (
                      <p>Geen veilige voorbeeldlink. Het bestand blijft privé.</p>
                    )
                  }
                  <StukBeoordeling />
                </div>
              ))
            )
          }
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Gastheren</h3>
        <div class="kc-kaart-inhoud">
          <p class="kc-bijschrift">Wie ontvangt de bezoekers bij deze activiteit?</p>
          {
            dossier.gastheerNaam ? (
              <span class="kc-pil">{dossier.gastheerNaam}</span>
            ) : (
              <p>Nog geen gastheer gekoppeld.</p>
            )
          }
          {
            dossier.historie.length > 0 && (
              <p>Ook genoemd in de planninghistorie: {dossier.historie.join(', ')}. Die regels wijzigt deze knop niet.</p>
            )
          }
          {
            magSchrijven && dossier.gastheerKeuze.length === 0 ? (
              <p>
                Er zijn geen gastheren om te kiezen.
                <a href="/beheer/instellingen/gastheren/"> Beheer de expositiebegeleiders</a>.
              </p>
            ) : magSchrijven ? (
              <>
                <form class="kc-gastheer-kies" method="post" action={formulierActie} data-kc-bewaar>
                  <input type="hidden" name="actie" value="gastheer" />
                  <input type="hidden" name="boekingId" value={dossier.id} />
                  <input type="hidden" name="terug" value={terug} />
                  <label class="kc-verborgen" for={`gastheer-${dossier.id}`}>Kies een gastheer</label>
                  <select id={`gastheer-${dossier.id}`} name="gastheerId" required>
                    <option value="">Kies een gastheer</option>
                    {
                      dossier.gastheerKeuze.map((gastheer) => (
                        <option value={gastheer.id}>
                          {gastheer.actief ? gastheer.naam : `${gastheer.naam} (niet actief)`}
                        </option>
                      ))
                    }
                  </select>
                  {
                    dossier.gastheerNaam && (
                      <label class="kc-vink">
                        <input type="checkbox" name="bevestig" value="ja" required />
                        Vervang {dossier.gastheerNaam}
                      </label>
                    )
                  }
                  <button class="kc-knop kc-knop--olijf" type="submit">{dossier.gastheerNaam ? 'Vervang' : '+ Toevoegen'}</button>
                </form>
                <p class="kc-bijschrift">
                  Er kan één gastheer op de boeking staan. Iemand die in dezelfde periode al ergens anders staat, wordt niet nog eens gekoppeld. Er gaat geen mail uit.
                  {demo ? ' Dit is een voorbeeld: er wordt niets opgeslagen.' : ''}
                </p>
                {
                  dossier.gastheerNaam && !weg && (
                    <p><a href={bevestigHref}>Gastheer verwijderen</a></p>
                  )
                }
                {
                  dossier.gastheerNaam && weg && (
                    <form method="post" action={formulierActie} data-kc-bewaar>
                      <input type="hidden" name="actie" value="gastheer" />
                      <input type="hidden" name="boekingId" value={dossier.id} />
                      <input type="hidden" name="terug" value={terug} />
                      <input type="hidden" name="gastheerId" value="" />
                      <input type="hidden" name="bevestig" value="ja" />
                      <button class="kc-knop" type="submit">Ja, verwijder {dossier.gastheerNaam}</button>
                    </form>
                  )
                }
              </>
            ) : (
              <p>Je kunt de gastheer bekijken. Wijzigen vraagt schrijfrecht op boekingen.</p>
            )
          }
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Dossieracties</h3>
        <div class="kc-kaart-inhoud">
          <p class="kc-bijschrift">Huidige status: {status || 'onbekend'}</p>
          <p>
            Dit zijn de acties van de bestaande boekingspagina. Zij gebruiken je ingelogde sessie.
            Er gaat geen mail uit en er start geen workflow.
            {demo ? ' Dit is een voorbeeld: er wordt niets opgeslagen.' : ''}
          </p>
          {
            acties.migratie && (
              <p>Een vastgelegde migratieboeking kan niet via deze knoppen definitief worden of terug naar een optie.</p>
            )
          }
          {
            magSchrijven ? (
              <>
                {
                  acties.definitief && (
                    <form class="kc-actie" method="post" action={dossierActie} data-kc-bewaar>
                      <input type="hidden" name="actie" value="definitief" />
                      <input type="hidden" name="boekingId" value={dossier.id} />
                      <input type="hidden" name="terug" value={terug} />
                      <label>
                        Reden bij definitief zetten
                        <input name="reden" type="text" required maxlength="240" />
                      </label>
                      <p class="kc-bijschrift">
                        Aanbetaling is geen voorwaarde. Een bestaande activiteit blijft staan. Ontbreekt die, dan wordt de periode als bezet vastgelegd en niet als pagina op de site.
                      </p>
                      <label class="kc-vink">
                        <input type="checkbox" name="bevestig" value="ja" required />
                        Zet definitief. Er gaat geen mail uit.
                      </label>
                      <button class="kc-knop kc-knop--olijf" type="submit">Zet definitief</button>
                    </form>
                  )
                }
                {
                  acties.verleng && (
                    <form class="kc-actie" method="post" action={dossierActie} data-kc-bewaar>
                      <input type="hidden" name="actie" value="verleng" />
                      <input type="hidden" name="boekingId" value={dossier.id} />
                      <input type="hidden" name="terug" value={terug} />
                      <label class="kc-vink">
                        <input type="checkbox" name="bevestig" value="ja" required />
                        Verleng de optie. Er gaat geen mail uit.
                      </label>
                      <button class="kc-knop kc-knop--olijf" type="submit">Verleng optie</button>
                    </form>
                  )
                }
                {
                  acties.annuleer && (
                    <form class="kc-actie" method="post" action={dossierActie} data-kc-bewaar>
                      <input type="hidden" name="actie" value="annuleer" />
                      <input type="hidden" name="boekingId" value={dossier.id} />
                      <input type="hidden" name="terug" value={terug} />
                      <label>
                        Reden annulering
                        <textarea name="reden" rows="3" maxlength="500" placeholder="Bijvoorbeeld: weg afgesloten"></textarea>
                      </label>
                      <p class="kc-bijschrift">
                        Een gekoppelde activiteit gaat van de publieke agenda. Open betaalregels blijven staan. Er gaat geen mail uit.
                      </p>
                      <label class="kc-vink">
                        <input type="checkbox" name="bevestig" value="ja" required />
                        Annuleer deze boeking.
                      </label>
                      <button class="kc-knop" type="submit">Annuleer</button>
                    </form>
                  )
                }
                <form class="kc-actie" method="post" action={dossierActie} data-kc-bewaar>
                  <input type="hidden" name="actie" value="incident" />
                  <input type="hidden" name="boekingId" value={dossier.id} />
                  <input type="hidden" name="terug" value={terug} />
                  <label>
                    Incident
                    <textarea name="omschrijving" rows="3" required maxlength="500"></textarea>
                  </label>
                  <p class="kc-bijschrift">De boekingsstatus verandert niet. Een open incident houdt afronden tegen. Er gaat geen mail uit.</p>
                  <button class="kc-knop" type="submit">Incident vastleggen</button>
                </form>
                {
                  incidenten.map((incident) => (
                    <form class="kc-actie" method="post" action={dossierActie} data-kc-bewaar>
                      <input type="hidden" name="actie" value="incident_sluiten" />
                      <input type="hidden" name="boekingId" value={dossier.id} />
                      <input type="hidden" name="incidentId" value={incident.id} />
                      <input type="hidden" name="terug" value={terug} />
                      <p>{incident.omschrijving}</p>
                      <button class="kc-knop" type="submit">Incident sluiten</button>
                    </form>
                  ))
                }
                {
                  acties.afronden && incidenten.length > 0 && (
                    <p>Een open incident houdt het dossier open. Sluit het incident eerst. Er gaat geen mail uit.</p>
                  )
                }
                {
                  acties.afronden && incidenten.length === 0 && (
                    <form class="kc-actie" method="post" action={dossierActie} data-kc-bewaar>
                      <input type="hidden" name="actie" value="sluit" />
                      <input type="hidden" name="boekingId" value={dossier.id} />
                      <input type="hidden" name="terug" value={terug} />
                      <label class="kc-vink">
                        <input type="checkbox" name="bevestig" value="ja" required />
                        Rond het dossier af. Er gaat geen mail uit.
                      </label>
                      <button class="kc-knop kc-knop--olijf" type="submit">Dossier afronden</button>
                    </form>
                  )
                }
              </>
            ) : (
              <p>Je kunt deze acties bekijken. Wijzigen vraagt schrijfrecht op boekingen.</p>
            )
          }
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Betalingen</h3>
        <div class="kc-kaart-inhoud">
          {
            dossier.betalingen.map((regel) => (
              <div class="kc-betaling">
                <div>
                  <strong>{regel.label}</strong>
                  {regel.detail && <div class="kc-bijschrift">{regel.detail}</div>}
                </div>
                <StatusMarkering kleur={staatKleur(regel.stand)} tekst={regel.tekst} />
              </div>
            ))
          }
          <p class="kc-bijschrift">{dossier.betaalToelichting}</p>
          {
            betaalregels.length > 0 && (
              <div class="kc-regels">
                {
                  betaalregels.map((regel) => (
                    <p><span class="kc-bijschrift">{regel.label}</span><br /><span class="kc-waarde">{regel.waarde}</span></p>
                  ))
                }
              </div>
            )
          }
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Bijzonderheden</h3>
        <div class="kc-kaart-inhoud">
          <p style="white-space:pre-wrap;margin:0">{dossier.notities}</p>
        </div>
      </section>

      <section class="kc-kaart">
        <h3>Correspondentie en audit</h3>
        <div class="kc-kaart-inhoud">
          {geschiedenisToelichting && <p>{geschiedenisToelichting}</p>}
          {
            geschiedenis.map((regel) => (
              <p><span class="kc-bijschrift">{regel.label}</span><br /><span class="kc-waarde">{regel.waarde}</span></p>
            ))
          }
        </div>
      </section>

      <p><a href={oudHref}>Open dezelfde boeking in de bestaande administratie</a></p>
    </div>
    <div class="kc-lade-voet">
      <span class="kc-bijschrift">{demo ? 'Voorbeeld · niets wordt opgeslagen' : 'Sluiten bewaart je jaar, maand en zoekopdracht.'}</span>
      <a class="kc-knop kc-knop--primair" href={sluitHref}>Sluiten</a>
    </div>
  </aside>
</div>

<style>
  .kc-verborgen {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
