---
import Icoon from './Icoon.astro';

interface Props {
  href: string | null;
  aantal: number;
  waarde?: string;
  label: string;
  icoon: 'post' | 'blad' | 'kalender';
}

const { href, aantal, waarde, label, icoon } = Astro.props;
const tekst = waarde ?? String(aantal);
---

{
  href ? (
    <a class="bh-teller" href={href}>
      <span class="bh-teller-icoon"><Icoon naam={icoon} /></span>
      <span class="bh-teller-tekst">
        <strong class:list={[{ 'bh-teller-woord': Boolean(waarde) }]}>{tekst}</strong>
        <span>{label}</span>
      </span>
      <span class="bh-chevron" aria-hidden="true" />
    </a>
  ) : (
    <span class="bh-teller bh-teller-stil">
      <span class="bh-teller-icoon"><Icoon naam={icoon} /></span>
      <span class="bh-teller-tekst">
        <strong class:list={[{ 'bh-teller-woord': Boolean(waarde) }]}>{tekst}</strong>
        <span>{label}</span>
      </span>
    </span>
  )
}
