---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { behandelTekenpagina, pakketVanDossier } from '../../lib/contract-tekenen.ts';
import { tokenVormGeldig } from '../../platform/contract-tekenen.ts';
import { contractNavHtml, contractWeergaveHtml, leesContractPakket, tekenFoutHtml } from '../../platform/contract-lezen.ts';
import { createHmac } from 'node:crypto';

const token = Astro.params.token ?? '';
const geheim = (process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.CRON_SECRET || '').trim();
const nu = new Date().toISOString();

function ipHash(): string | null {
  const ip = Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;
  if (!ip || !geheim) return null;
  return createHmac('sha256', geheim).update(ip).digest('hex').slice(0, 16);
}

function foutPagina(melding: string): Response {
  return new Response(tekenFoutHtml(melding), {
    status: 404,
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'Cache-Control': 'no-store',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  });
}

if (!tokenVormGeldig(token) || !geheim) {
  Astro.response.status = 404;
  return foutPagina('Deze link is ongeldig.');
}

const cookieNaam = 'kvp_teken';
let melding = '';
let fout = '';
let netGeverifieerd = false;

if (Astro.request.method === 'POST') {
  const formulier = await Astro.request.formData();
  const actie = String(formulier.get('actie') ?? '');
  const stap = actie === 'code'
    ? { soort: 'code' as const, token, nu, geheim }
    : actie === 'controle'
      ? { soort: 'controle' as const, token, nu, geheim, code: String(formulier.get('code') ?? '') }
      : actie === 'onderteken'
        ? {
          soort: 'onderteken' as const,
          token,
          nu,
          geheim,
          naam: String(formulier.get('naam') ?? ''),
          akkoord: String(formulier.get('akkoord') ?? '') === 'ja',
          cookie: Astro.cookies.get(cookieNaam)?.value ?? '',
          ipHash: ipHash(),
          userAgent: Astro.request.headers.get('user-agent') ?? '',
        }
        : null;
  if (!stap) {
    fout = 'Deze actie hoort niet bij het contract.';
  } else {
    const uit = await behandelTekenpagina({ stap });
    if (!uit.ok) fout = uit.melding;
    else {
      melding = uit.melding;
      if (actie === 'controle') netGeverifieerd = true;
      if (uit.cookie) {
        Astro.cookies.set(cookieNaam, uit.cookie, {
          httpOnly: true,
          sameSite: 'lax',
          path: '/tekenen/',
          secure: Astro.url.protocol === 'https:',
          maxAge: 30 * 60,
        });
      }
    }
  }
}

const beeld = await behandelTekenpagina({ stap: { soort: 'bekijk', token, nu } });
if (!beeld.ok) {
  return foutPagina(beeld.melding);
}

if (Astro.url.searchParams.get('bestand') === 'pdf') {
  const bestand = await behandelTekenpagina({ stap: { soort: 'download', token, nu } });
  if (!bestand.ok || !bestand.pdf) {
    return foutPagina('De PDF is niet beschikbaar.');
  }
  const bestandsnaam = beeld.dossier.contractnummer.replace(/[^\w.\-]+/g, '') || 'contract';
  const openen = Astro.url.searchParams.get('open') === '1';
  return new Response(Buffer.from(bestand.pdf), {
    headers: {
      'Content-Type': 'application/pdf',
      'Content-Disposition': `${openen ? 'inline' : 'attachment'}; filename="${bestandsnaam}.pdf"`,
      'Cache-Control': 'private, no-store',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  });
}

const dossier = beeld.dossier;
const tekst = pakketVanDossier(dossier);
const metSjabloon = Boolean(beeld.metSjabloon);
const delen = metSjabloon ? [] : leesContractPakket(tekst);
const geverifieerd = netGeverifieerd || (Boolean(dossier.geverifieerdOp) && Boolean(Astro.cookies.get(cookieNaam)?.value));
const ondertekend = Boolean(dossier.ondertekendOp);
---

<Base title="Contract ondertekenen" description="Onderteken uw huurovereenkomst met het Kerkje van Persingen." noindex={true}>
  <div class="teken">
    <p class="merk">Kerkje van Persingen</p>
    <h1>{ondertekend ? 'Contract ondertekend' : 'Huurovereenkomst'}</h1>
    <p class="versie">{dossier.contractnummer} · documentversie {dossier.versie}</p>
    {melding && <p class="melding">{melding}</p>}
    {fout && <p class="fout">{fout}</p>}
    {
      ondertekend ? (
        <p>Uw elektronische ondertekening is vastgelegd. Dit is geen gekwalificeerde elektronische handtekening. Het contract kan niet meer worden gewijzigd.</p>
      ) : (
        <p>Lees de overeenkomst, de huisregels en de verhuurvoorwaarden. Daarna bevestigt u uw e-mailadres met een code en ondertekent u deze versie.</p>
      )
    }
    {
      delen.length > 0 && (
        <nav class="nav" aria-label="Onderdelen van het contract" set:html={contractNavHtml(delen)} />
      )
    }
    <div class="knoppen">
      <a class="knop knop-lijn" href="?bestand=pdf">Download contract als PDF</a>
      {!ondertekend && <a class="knop" href="#ondertekenen">Onderteken overeenkomst</a>}
    </div>
    {
      !ondertekend && (
        <div class="onderbalk">
          <a href="#voorwaarden">Voorwaarden</a>
          <a href="#huisregels">Huisregels</a>
          <a href="#ondertekenen">Onderteken</a>
        </div>
      )
    }
    {
      metSjabloon ? (
        <section class="pdf-lees" id="contract">
          <h2>Het contract</h2>
          <p>Dit exemplaar is opgemaakt met het contractsjabloon. Open de PDF om de volledige overeenkomst, de huisregels en de verhuurvoorwaarden te lezen. Op uw telefoon kunt u inzoomen.</p>
          <p><a class="knop" href="?bestand=pdf&open=1">Open het contract</a></p>
        </section>
      ) : (
        <div set:html={contractWeergaveHtml(delen)} />
      )
    }
    {
      !metSjabloon && (
        <p class="noot">De PDF is het officiële contractdocument. De tekst hierboven is dezelfde documentversie.</p>
      )
    }
    <section id="ondertekenen">
      <h2>{ondertekend ? 'Ondertekening' : 'Onderteken overeenkomst'}</h2>
      {
        !ondertekend && (
          <form method="post">
            <input type="hidden" name="actie" value="code" />
            <button type="submit">Stuur een code naar mijn e-mailadres</button>
          </form>
        )
      }
      {
        !ondertekend && (
          <form method="post">
            <input type="hidden" name="actie" value="controle" />
            <label for="code">Code uit de e-mail</label>
            <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
            <button type="submit">Bevestig de code</button>
          </form>
        )
      }
      {
        !ondertekend && geverifieerd && (
          <form method="post">
            <input type="hidden" name="actie" value="onderteken" />
            <label for="naam">Volledige naam</label>
            <input id="naam" name="naam" required maxlength="120" value={dossier.huurderNaam} />
            <label class="vink">
              <input type="checkbox" name="akkoord" value="ja" required />
              Ik ga akkoord met de volledige overeenkomst van documentversie {dossier.versie}, inclusief de verhuurvoorwaarden en de huisregels.
            </label>
            <button type="submit">Ondertekenen</button>
            <p class="noot">Dit is een elektronische bevestiging, geen gekwalificeerde elektronische handtekening.</p>
          </form>
        )
      }
    </section>
  </div>
</Base>

<style>
  .teken {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 4rem;
    overflow-wrap: anywhere;
  }
  .merk {
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--pine);
  }
  .versie {
    color: var(--ink-soft);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.5rem 0 1rem;
  }
  .nav :global(a) {
    font-weight: 600;
  }
  .knoppen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
  }
  .knop {
    flex: 1 1 14rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    background: var(--brick);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    text-align: center;
  }
  .knop-lijn {
    background: transparent;
    color: var(--brick);
    border: 1px solid var(--brick);
  }
  .teken :global(.contract section) {
    padding: 0.25rem 0 0.5rem;
    border-top: 1px solid var(--sand);
    scroll-margin-top: 6rem;
  }
  .teken :global(.contract h2) {
    font-size: 1.45rem;
    margin-top: 1rem;
  }
  .teken :global(.contract h3) {
    font-size: 1.15rem;
    margin-top: 1.25rem;
  }
  .teken :global(.contract p) {
    max-width: none;
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }
  .teken :global(.contract .feit) {
    display: grid;
    gap: 0.15rem;
    margin: 0 0 0.85rem;
  }
  .teken :global(.contract .feit span) {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .teken :global(.contract .meta-regel) {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .pdf-lees {
    background: #fff;
    border: 1px solid var(--sand);
    padding: 1rem;
    margin: 0 0 1rem;
  }
  .pdf-lees .knop {
    margin-top: 0.5rem;
  }
  #ondertekenen {
    scroll-margin-top: 6rem;
    margin-top: 1.5rem;
  }
  form {
    display: grid;
    gap: 0.6rem;
    margin: 1rem 0;
  }
  label {
    font-weight: 600;
  }
  input:not([type='checkbox']) {
    font: inherit;
    font-size: 1.0625rem;
    width: 100%;
    padding: 0.75rem;
  }
  button {
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    min-height: 3rem;
    background: var(--brick);
    color: #fff;
    border: 0;
    padding: 0.75rem 1rem;
  }
  .vink {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-weight: 500;
  }
  .melding, .fout {
    padding: 0.7rem 0.8rem;
  }
  .melding { background: #e7efe4; }
  .fout { background: #f8e6e2; }
  .noot {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .onderbalk {
    display: none;
  }
  @media (max-width: 720px) {
    .teken {
      padding-bottom: 5.5rem;
    }
    .onderbalk {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 5;
      gap: 0.5rem;
      padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom));
      background: #fff;
      border-top: 1px solid var(--sand);
    }
    .onderbalk a {
      flex: 1;
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      text-decoration: none;
    }
    .onderbalk a:last-child {
      background: var(--brick);
      color: #fff;
    }
  }
</style>
