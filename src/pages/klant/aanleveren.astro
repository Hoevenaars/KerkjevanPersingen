---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import ExposantVelden from '../../components/ExposantVelden.astro';
import { operationeelSupabase, voerOperationeel } from '../../lib/operatie/runtime';
import { portaalMagPubliceren, portaalTeVaak, valideerAanlevering } from '../../platform/exposant-portaal';
import { valideerIntakeBestand } from '../../platform/intake-foto';
import { bewaarIntakeFoto, dossierVanIntakeToken, leesIntakeFormulier } from '../../lib/intake-opslag';
import { isExpositieType, titelVoorInvoer, titelVoorOpslag } from '../../platform/activiteit-titel';
import { exposantenUitFormulier, parseExposanten, serializeExposanten } from '../../platform/exposanten';

const token = Astro.url.searchParams.get('token') ?? '';
const actief = operationeelSupabase();
let melding = '';
let fout = '';
const context = token && actief ? await leesIntakeFormulier(token) : null;
const soort = context?.ok ? context.soort : '';
const expositie = isExpositieType(soort);

if (Astro.request.method === 'POST' && actief) {
  const data = await Astro.request.formData();
  const tokenWaarde = String(data.get('token') ?? '');
  const dossier = tokenWaarde ? await leesIntakeFormulier(tokenWaarde) : null;
  const soortPost = dossier?.ok ? dossier.soort : '';
  const isExpositie = isExpositieType(soortPost);
  if (portaalTeVaak(Astro.clientAddress || tokenWaarde || 'anoniem')) {
    fout = 'Te veel pogingen. Probeer het later opnieuw.';
  } else if (portaalMagPubliceren()) {
    fout = 'Publiceren vanuit deze link is niet mogelijk.';
  } else {
  const korte = String(data.get('korte') ?? '').trim();
  const lange = String(data.get('lange') ?? data.get('omschrijving') ?? '').trim();
  const titelInvoer = titelVoorOpslag(isExpositie ? 'expositie' : soortPost, String(data.get('titel') ?? ''));
  const exposanten = isExpositie ? serializeExposanten(exposantenUitFormulier(data.getAll('exposant'))) : undefined;
  const hoofd = data.get('hoofdafbeelding');
  const extras = data.getAll('extra').filter((item): item is File => item instanceof File && item.size > 0);
  const bestanden = [
    ...(hoofd instanceof File && hoofd.size > 0 ? [{ file: hoofd, alsHoofd: true }] : []),
    ...extras.map((file) => ({ file, alsHoofd: false })),
  ];
  const controle = valideerAanlevering({
    titel: titelInvoer,
    korteTekst: korte,
    langeTekst: lange,
    praktisch: '',
    hoofdafbeelding: bestanden.some((item) => item.alsHoofd),
    extraFotos: extras.length,
  });
  const bestandFout = bestanden.map((item) => valideerIntakeBestand(item.file)).find((item) => !item.ok);
  if (bestandFout && !bestandFout.ok) {
    fout = bestandFout.reden;
  } else if (!controle.ok) {
    fout = controle.reden;
  } else {
  let hoofdfoto = '';
  if (bestanden.length > 0) {
    const geldig = await dossierVanIntakeToken(tokenWaarde);
    if (!geldig.ok) {
      fout = 'Deze link is ongeldig, verlopen of ingetrokken. Er is niets opgeslagen.';
    } else {
      const opgeslagen = await bewaarIntakeFoto(geldig.boekingId, await Promise.all(bestanden.map(async (item) => ({
        bytes: new Uint8Array(await item.file.arrayBuffer()),
        type: item.file.type,
        size: item.file.size,
        alsHoofd: item.alsHoofd,
      }))));
      if (!opgeslagen.ok) fout = opgeslagen.reden;
      else hoofdfoto = opgeslagen.hoofd;
    }
  }
  if (fout) {
    /* upload of token blokkeert de aanlevering */
  } else {
  const uit = await voerOperationeel(
    {
      soort: 'content_indienen',
      token: tokenWaarde,
      titel: titelInvoer,
      omschrijving: [korte, lange].filter(Boolean).join('\n\n'),
      korteTekst: korte,
      langeTekst: lange,
      ...(exposanten !== undefined ? { exposanten } : {}),
      foto: bestanden.length > 0,
      hoofdfoto,
    },
    {
      actor: { type: 'klant', naam: 'Aanvrager' },
      basisUrl: Astro.url.origin,
    },
  );
  if (uit.ok) melding = `${uit.melding} De activiteit is niet gepubliceerd.`;
  else fout = uit.melding;
  }
  }
  }
}

const titelVeld = context?.ok ? titelVoorInvoer(soort, context.titel) : '';
const exposantNamen = context?.ok ? parseExposanten(context.exposanten) : [];
const korteVeld = context?.ok ? context.korte : '';
const langeVeld = context?.ok ? context.lange : '';
---

<Base
  title="Gegevens aanleveren"
  description="Beveiligde aanlevering voor een activiteit in het Kerkje van Persingen."
  noindex={true}
>
  <article class="wrap prose klant-form">
    <h1>{expositie ? 'Content voor je expositie' : 'Gegevens aanleveren'}</h1>
    <p>
      {expositie
        ? 'Hier lever je de tekst en beelden aan die het Kerkje kan gebruiken. Het Kerkje bepaalt zelf de praktische bezoekersinformatie en wanneer iets online komt. Jij publiceert niets.'
        : 'Deze pagina hoort bij één activiteit. Zonder geldige link slaan we niets op. Je kunt de activiteit niet zelf publiceren.'}
    </p>
    {melding && <p class="klant-ok">{melding}</p>}
    {fout && <p class="klant-fout">{fout}</p>}
    {
      !actief ? (
        <p>Aanleveren is op deze omgeving nog gesloten.</p>
      ) : !token && !melding ? (
        <p>De link is onvolledig.</p>
      ) : (
        <form method="post">
          <input type="hidden" name="token" value={token} />
          {expositie ? (
            <>
              <label for="titel">Titel van de expositie</label>
              <p class="hulp">Vul alleen de naam van de expositie in. 'Expositie:' staat al vast.</p>
              <div class="titel-rij">
                <span class="prefix">Expositie:</span>
                <input id="titel" name="titel" required value={titelVeld} />
              </div>
              <ExposantVelden
                namen={exposantNamen}
                helper="Voeg hier alle exposanten of kunstenaars toe die deelnemen aan deze expositie."
              />
              <label for="korte">Korte tekst</label>
              <p class="hulp">Deze tekst komt op de agenda pagina te staan. Geef in maximaal 5 zinnen een korte en aantrekkelijke omschrijving van de expositie.</p>
              <textarea id="korte" name="korte" rows="4">{korteVeld}</textarea>
              <label for="lange">Uitgebreide tekst</label>
              <p class="hulp">Deze tekst komt op de persoonlijke expositie pagina te staan. Hier kun je uitgebreider vertellen over de expositie, het verhaal erachter, de inspiratie en wat bezoekers kunnen verwachten.</p>
              <textarea id="lange" name="lange" rows="8">{langeVeld}</textarea>
              <label for="hoofdafbeelding">Afbeeldingen</label>
              <p class="hulp">Upload hier de foto's en beelden die gebruikt mogen worden voor de website en communicatie over de expositie. Gebruik bij voorkeur scherpe beelden van goede kwaliteit.</p>
            </>
          ) : (
            <>
              <label for="titel">Publieke titel</label>
              <input id="titel" name="titel" required value={titelVeld} />
              <label for="korte">Korte tekst</label>
              <textarea id="korte" name="korte" rows="3">{korteVeld}</textarea>
              <label for="lange">Lange tekst</label>
              <textarea id="lange" name="lange" rows="6">{langeVeld}</textarea>
              <label for="hoofdafbeelding">Hoofdafbeelding of flyer</label>
            </>
          )}
          <input id="hoofdafbeelding" name="hoofdafbeelding" type="file" accept="image/jpeg,image/png,image/webp" />
          <label for="extra">Extra foto's</label>
          <input id="extra" name="extra" type="file" accept="image/jpeg,image/png,image/webp" multiple />
          <p>Je kunt deze activiteit niet zelf publiceren en je ziet geen andere dossiers.</p>
          <button type="submit">Verstuur</button>
        </form>
      )
    }
  </article>
</Base>

<style>
  .klant-form {
    padding-block: 3rem 4rem;
    max-width: 40rem;
  }
  .klant-form form {
    display: grid;
    gap: 0.5rem;
  }
  .klant-form input,
  .klant-form textarea {
    font: inherit;
    padding: 0.6rem 0.7rem;
    border: 1px solid #1c1917;
    background: #fff;
  }
  .klant-form button[type='submit'] {
    margin-top: 0.75rem;
    justify-self: start;
    font: inherit;
    padding: 0.7rem 1rem;
    background: #1c1917;
    color: #faf7f2;
    border: 0;
  }
  .hulp { margin: 0; color: #4a4a44; font-size: 0.95rem; }
  .titel-rij { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; align-items: center; }
  .prefix { font-weight: 700; }
  .klant-ok,
  .klant-fout { padding: 0.75rem 1rem; }
  .klant-ok { background: #e7f0e4; }
  .klant-fout { background: #f6e4dc; }
</style>
