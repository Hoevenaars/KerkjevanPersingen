---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { operationeelSupabase, voerOperationeel } from '../../lib/operatie/runtime';
import { portaalMagPubliceren, portaalTeVaak, valideerAanlevering } from '../../platform/exposant-portaal';
import { valideerIntakeBestand } from '../../platform/intake-foto';
import { bewaarIntakeFoto, dossierVanIntakeToken } from '../../lib/intake-opslag';

const token = Astro.url.searchParams.get('token') ?? '';
const actief = operationeelSupabase();
let melding = '';
let fout = '';

if (Astro.request.method === 'POST' && actief) {
  const data = await Astro.request.formData();
  const tokenWaarde = String(data.get('token') ?? '');
  if (portaalTeVaak(Astro.clientAddress || tokenWaarde || 'anoniem')) {
    fout = 'Te veel pogingen. Probeer het later opnieuw.';
  } else if (portaalMagPubliceren()) {
    fout = 'Publiceren vanuit deze link is niet mogelijk.';
  } else {
  const korte = String(data.get('korte') ?? '').trim();
  const lange = String(data.get('lange') ?? data.get('omschrijving') ?? '').trim();
  const hoofd = data.get('hoofdafbeelding');
  const extras = data.getAll('extra').filter((item): item is File => item instanceof File && item.size > 0);
  const bestanden = [
    ...(hoofd instanceof File && hoofd.size > 0 ? [{ file: hoofd, alsHoofd: true }] : []),
    ...extras.map((file) => ({ file, alsHoofd: false })),
  ];
  const controle = valideerAanlevering({
    titel: String(data.get('titel') ?? '').trim(),
    korteTekst: korte,
    langeTekst: lange,
    praktisch: String(data.get('praktisch') ?? '').trim(),
    hoofdafbeelding: bestanden.some((item) => item.alsHoofd),
    extraFotos: extras.length,
  });
  const bestandFout = bestanden.map((item) => valideerIntakeBestand(item.file)).find((item) => !item.ok);
  if (bestandFout && !bestandFout.ok) {
    fout = bestandFout.reden;
  } else if (!controle.ok) {
    fout = controle.reden;
  } else {
  let hoofdfoto = '';
  if (bestanden.length > 0) {
    const dossier = await dossierVanIntakeToken(tokenWaarde);
    if (!dossier.ok) {
      fout = 'Deze link is ongeldig, verlopen of ingetrokken. Er is niets opgeslagen.';
    } else {
      const opgeslagen = await bewaarIntakeFoto(dossier.boekingId, await Promise.all(bestanden.map(async (item) => ({
        bytes: new Uint8Array(await item.file.arrayBuffer()),
        type: item.file.type,
        size: item.file.size,
        alsHoofd: item.alsHoofd,
      }))));
      if (!opgeslagen.ok) fout = opgeslagen.reden;
      else hoofdfoto = opgeslagen.hoofd;
    }
  }
  if (fout) {
    /* upload of token blokkeert de aanlevering */
  } else {
  const uit = await voerOperationeel(
    {
      soort: 'content_indienen',
      token: tokenWaarde,
      titel: String(data.get('titel') ?? '').trim(),
      omschrijving: [korte, lange].filter(Boolean).join('\n\n'),
      praktisch: String(data.get('praktisch') ?? '').trim(),
      foto: bestanden.length > 0,
      hoofdfoto,
    },
    {
      actor: { type: 'klant', naam: 'Aanvrager' },
      basisUrl: Astro.url.origin,
    },
  );
  if (uit.ok) melding = `${uit.melding} De activiteit is niet gepubliceerd.`;
  else fout = uit.melding;
  }
  }
  }
}
---

<Base
  title="Gegevens aanleveren"
  description="Beveiligde aanlevering voor een activiteit in het Kerkje van Persingen."
  noindex={true}
>
  <article class="wrap prose klant-form">
    <h1>Gegevens aanleveren</h1>
    <p>Deze pagina hoort bij één activiteit. Zonder geldige link slaan we niets op.</p>
    {melding && <p class="klant-ok">{melding}</p>}
    {fout && <p class="klant-fout">{fout}</p>}
    {
      !actief ? (
        <p>Aanleveren is op deze omgeving nog gesloten.</p>
      ) : !token && !melding ? (
        <p>De link is onvolledig.</p>
      ) : (
        <form method="post">
          <input type="hidden" name="token" value={token} />
          <label for="titel">Publieke titel</label>
          <input id="titel" name="titel" required />
          <label for="korte">Korte tekst</label>
          <textarea id="korte" name="korte" rows="3"></textarea>
          <label for="lange">Lange tekst</label>
          <textarea id="lange" name="lange" rows="6"></textarea>
          <label for="praktisch">Praktische informatie</label>
          <textarea id="praktisch" name="praktisch" rows="4"></textarea>
          <label for="hoofdafbeelding">Hoofdafbeelding of flyer</label>
          <input id="hoofdafbeelding" name="hoofdafbeelding" type="file" accept="image/jpeg,image/png,image/webp" />
          <label for="extra">Extra foto's</label>
          <input id="extra" name="extra" type="file" accept="image/jpeg,image/png,image/webp" multiple />
          <p>Je kunt deze activiteit niet zelf publiceren en je ziet geen andere dossiers.</p>
          <label class="klant-check">
            <input type="checkbox" name="foto" value="ja" />
            Er is een foto aangeleverd
          </label>
          <button type="submit">Verstuur</button>
        </form>
      )
    }
  </article>
</Base>

<style>
  .klant-form {
    padding-block: 3rem 4rem;
    max-width: 40rem;
  }
  .klant-form form {
    display: grid;
    gap: 0.5rem;
  }
  .klant-form input,
  .klant-form textarea {
    font: inherit;
    padding: 0.6rem 0.7rem;
    border: 1px solid #1c1917;
    background: #fff;
  }
  .klant-form button {
    margin-top: 0.75rem;
    justify-self: start;
    font: inherit;
    padding: 0.7rem 1rem;
    background: #1c1917;
    color: #faf7f2;
    border: 0;
  }
  .klant-check {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .klant-ok,
  .klant-fout {
    padding: 0.75rem 1rem;
  }
  .klant-ok {
    background: #e7f0e4;
  }
  .klant-fout {
    background: #f6e4dc;
  }
</style>
