---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { operationeelSupabase, voerOperationeel } from '../../lib/operatie/runtime';

const token = Astro.url.searchParams.get('token') ?? '';
const actief = operationeelSupabase();
let melding = '';
let fout = '';

if (Astro.request.method === 'POST' && actief) {
  const data = await Astro.request.formData();
  const uit = await voerOperationeel(
    {
      soort: 'aanvulling',
      token: String(data.get('token') ?? ''),
      toelichting: String(data.get('toelichting') ?? '').trim(),
    },
    {
      actor: { type: 'klant', naam: 'Aanvrager' },
      basisUrl: Astro.url.origin,
    },
  );
  if (uit.ok) melding = uit.melding;
  else fout = uit.melding;
}
---

<Base
  title="Aanvullende informatie"
  description="Beveiligde aanvulling op een aanvraag voor het Kerkje van Persingen."
  noindex={true}
>
  <article class="wrap prose klant-form">
    <h1>Aanvullende informatie</h1>
    <p>Het bestuur heeft om extra informatie gevraagd. Deze link geldt voor één aanvraag.</p>
    {melding && <p class="klant-ok">{melding}</p>}
    {fout && <p class="klant-fout">{fout}</p>}
    {
      !actief ? (
        <p>Aanvullen is op deze omgeving nog gesloten.</p>
      ) : !token && !melding ? (
        <p>De link is onvolledig.</p>
      ) : (
        <form method="post">
          <input type="hidden" name="token" value={token} />
          <label for="toelichting">Antwoord</label>
          <textarea id="toelichting" name="toelichting" rows="6" required></textarea>
          <button type="submit">Verstuur</button>
        </form>
      )
    }
  </article>
</Base>

<style>
  .klant-form {
    padding-block: 3rem 4rem;
    max-width: 40rem;
  }
  .klant-form form {
    display: grid;
    gap: 0.5rem;
  }
  .klant-form textarea {
    font: inherit;
    padding: 0.6rem 0.7rem;
    border: 1px solid #1c1917;
    background: #fff;
  }
  .klant-form button {
    margin-top: 0.75rem;
    justify-self: start;
    font: inherit;
    padding: 0.7rem 1rem;
    background: #1c1917;
    color: #faf7f2;
    border: 0;
  }
  .klant-ok,
  .klant-fout {
    padding: 0.75rem 1rem;
  }
  .klant-ok {
    background: #e7f0e4;
  }
  .klant-fout {
    background: #f6e4dc;
  }
</style>
