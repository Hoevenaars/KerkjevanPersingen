---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Kalender from '../../../components/Kalender.astro';
import VrijeWeekenden from '../../../components/VrijeWeekenden.astro';
import {
  LEGE_AANVRAAG,
  SOORTEN,
  leesFormulier,
  valideer,
  weekendWaarschuwing,
  teVaak,
  type Aanvraag,
  type Fouten,
} from '../../../lib/aanvraag';
import { bezettingVoorTest, bewaarTestAanvraag, periodeBeschikbaar } from '../../../lib/aanvraag-test';
import { bezetteKalenderDagen } from '../../../lib/datum';
import { kiesTarief } from '../../../platform/finance';
import { tariefIndicatie } from '../../../platform/tarief-indicatie';
import { leesTariefregels } from '../../../lib/tarief-lezen';
import { ymdInAmsterdam } from '../../../platform/datum';
import { MAX_MEDE_EXPOSANTEN, parseMedeExposanten } from '../../../platform/mede-exposanten';
import { AANVRAAG_FOTO_MAX_AANTAL, valideerAanvraagFoto } from '../../../platform/aanvraag-foto';
import { bewaarAanvraagFotos, type FotoInvoer } from '../../../lib/aanvraag-foto-opslag';
import { leesExtraAanvraagOntvanger, uniekeOntvangers } from '../../../lib/aanvraag-ontvangers';

export const prerender = false;

let waarden: Aanvraag = { ...LEGE_AANVRAAG };
let fouten: Fouten = {};
let waarschuwing: string | null = null;
let fotoOpnieuw = false;

const GELDIGE_SOORTEN = SOORTEN.map((s) => s.waarde);

const vooraf = Astro.url.searchParams.get('datum');
if (vooraf && /^\d{4}-\d{2}-\d{2}$/.test(vooraf)) {
  waarden.datum = vooraf;
}
const voorafTot = Astro.url.searchParams.get('datumTot');
if (voorafTot && /^\d{4}-\d{2}-\d{2}$/.test(voorafTot)) {
  waarden.datumTot = voorafTot;
}
const soortVooraf = Astro.url.searchParams.get('soort');
if (soortVooraf && GELDIGE_SOORTEN.includes(soortVooraf as never)) {
  waarden.soort = soortVooraf;
}

const bezet = await bezettingVoorTest();
const tariefregels = await leesTariefregels();
const vandaagTarief = ymdInAmsterdam(new Date());
const bezetteDagen = bezetteKalenderDagen(bezet);

const nu = new Date();
const gevraagdeMaand = Astro.url.searchParams.get('maand') ?? '';
const maand = /^\d{4}-(0[1-9]|1[0-2])$/.test(gevraagdeMaand)
  ? gevraagdeMaand
  : `${nu.getFullYear()}-${String(nu.getMonth() + 1).padStart(2, '0')}`;

function alleYmd(van: string, tot: string): string[] {
  const dagen: string[] = [];
  let loper = van;
  let veiligheid = 0;
  while (loper <= tot && veiligheid < 60) {
    dagen.push(loper);
    const d = new Date(`${loper}T12:00:00Z`);
    d.setUTCDate(d.getUTCDate() + 1);
    loper = d.toISOString().slice(0, 10);
    veiligheid++;
  }
  return dagen;
}

function isDagBruiloft(dagIso: string): boolean {
  return bezet.some((a) => a.soort === 'bruiloft' && bezetteKalenderDagen([a]).has(dagIso));
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();

    if (String(data.get('website_hp') ?? '').length > 0) {
      return Astro.redirect('/verhuur/aanvragen/bedankt/', 303);
    }

    waarden = leesFormulier(data);

    if (teVaak(Astro.clientAddress ?? 'onbekend')) {
      fouten = {
        algemeen: 'Er zijn net veel aanvragen verstuurd. Probeer het over een kwartier opnieuw.',
      };
    } else {
      fouten = valideer(waarden);
      let fotos: FotoInvoer[] = [];
      if (waarden.soort === 'expositie') {
        const gekozen = data.getAll('fotos').filter((item): item is File => item instanceof File && item.size > 0);
        if (gekozen.length > AANVRAAG_FOTO_MAX_AANTAL) {
          fouten.fotos = `Je kunt maximaal ${AANVRAAG_FOTO_MAX_AANTAL} foto's toevoegen.`;
        }
        for (const bestand of gekozen) {
          const bytes = new Uint8Array(await bestand.arrayBuffer());
          const check = valideerAanvraagFoto({ type: bestand.type, size: bestand.size, bytes });
          if (!check.ok) {
            fouten.fotos = check.reden;
            fotos = [];
            break;
          }
          fotos.push({ naam: bestand.name, type: check.mime, bytes });
        }
      }

      if (!fouten.datum && !fouten.datumTot && waarden.datum) {
        const gevraagdeDagen = alleYmd(waarden.datum, waarden.datumTot || waarden.datum);
        const isBezet = gevraagdeDagen.some((dag) => bezetteDagen.has(dag));

        if (isBezet) {
          const veld = waarden.datumTot ? 'datumTot' : 'datum';
          fouten[veld] =
            'Eén of meer dagen in deze periode zijn al bezet. Kies andere data, of bel 06 52 66 84 49.';
        }
      }

      if (Object.keys(fouten).length === 0) {
        waarschuwing = weekendWaarschuwing(waarden, isDagBruiloft);
        if (waarschuwing && waarden.negeerWaarschuwing !== 'ja' && fotos.length > 0) fotoOpnieuw = true;
      }

      if (Object.keys(fouten).length === 0 && (!waarschuwing || waarden.negeerWaarschuwing === 'ja')) {
        const beschikbaar = await periodeBeschikbaar(waarden.datum, waarden.datumTot || waarden.datum);
        if (!beschikbaar) {
          fouten.algemeen =
            'Deze periode is niet beschikbaar. De aanvraag is niet opgeslagen en er is geen mail verstuurd.';
        }
      }

      if (Object.keys(fouten).length === 0 && (!waarschuwing || waarden.negeerWaarschuwing === 'ja')) {
        const uitkomst = await bewaarTestAanvraag(waarden, false);
        if (uitkomst.ok) {
          if (fotos.length > 0) {
            if (!uitkomst.id || !uitkomst.fotoToken) {
              fouten = {
                fotos: 'Je aanvraag is opgeslagen, maar de foto’s konden niet aan deze aanvraag worden gekoppeld. Bel 06 52 66 84 49.',
              };
            } else {
              const opgeslagen = await bewaarAanvraagFotos(uitkomst.id, uitkomst.fotoToken, fotos);
              if (!opgeslagen.ok) {
                fouten = { fotos: `Je aanvraag is opgeslagen, maar de foto’s niet. ${opgeslagen.reden}` };
              } else {
                waarden.fotoNamen = opgeslagen.namen;
              }
            }
          } else if (uitkomst.fotoToken && uitkomst.id) {
            await bewaarAanvraagFotos(uitkomst.id, uitkomst.fotoToken, []);
          }
          if (fouten.fotos) {
            /* Aanvraag staat. Geen tweede mail en geen stille redirect zonder de foto’s. */
          } else {
          const { sendInterneAanvraagMail } = await import('../../../lib/mail-transport.ts');
          const { bestuurMail } = await import('../../../lib/aanvraag.ts');
          const { legVerzendingVast } = await import('../../../lib/communicatie-log.ts');
          const { VAN_ADRES } = await import('../../../lib/mail-adressen.ts');
          const brief = bestuurMail(waarden);
          const primair = process.env.CONTACT_FALLBACK_EMAIL?.trim() || 'contractbeheer.kvp@gmail.com';
          let extra = '';
          try {
            extra = await leesExtraAanvraagOntvanger();
          } catch (error) {
            console.error('[aanvraag] extra ontvanger niet gelezen', error);
          }
          const ontvangers = uniekeOntvangers([primair, extra]);
          for (const bedoelde of ontvangers) {
            let verstuurd = false;
            try {
              const mail = await sendInterneAanvraagMail({
                sleutel: 'aanvraag_bestuur',
                to: bedoelde,
                subject: 'Nieuwe verhuuraanvraag',
                text: brief.text,
                html: brief.html,
                aanvragerEmail: waarden.email,
                aanvragerNaam: waarden.naam,
              });
              verstuurd = mail.providerAangeroepen;
              if (verstuurd || mail.geblokkeerd) {
                await legVerzendingVast({
                  aanvraagId: uitkomst.id ? String(uitkomst.id) : null,
                  templateSleutel: 'internal_booking_review_required',
                  onderwerp: 'Nieuwe verhuuraanvraag',
                  bedoeldeOntvanger: bedoelde,
                  werkelijkeOntvanger: mail.werkelijkeOntvanger || '',
                  afzender: VAN_ADRES,
                  replyTo: waarden.email,
                  richting: 'uitgaand',
                  status: verstuurd ? 'verzonden' : 'geblokkeerd',
                  providerBerichtId: mail.providerBerichtId,
                  foutmelding: verstuurd ? null : mail.melding || mail.besluit.reden,
                  test: mail.besluit.modus === 'test',
                  dedupSleutel: `aanvraag-bestuur:${uitkomst.id ?? waarden.email}:${waarden.datum}:${bedoelde}`,
                });
              }
            } catch (error) {
              if (!verstuurd) console.error('[aanvraag] bestuursnotificatie niet verzonden', error);
              else console.error('[aanvraag] verzendregel niet opgeslagen, mail niet opnieuw verstuurd', error);
            }
          }
          return Astro.redirect('/verhuur/aanvragen/bedankt/', 303);
          }
        } else {
          fouten = uitkomst.fouten ?? {};
        }
      }
    }
  } catch (error) {
    console.error('[aanvraag] onverwachte fout bij verwerken formulier', error);
    fouten = { algemeen: 'Er ging iets mis. Bel 06 52 66 84 49, dan pakken we het direct op.' };
  }
}

const heeftFouten = Object.keys(fouten).length > 0;
const vandaag = new Date().toISOString().split('T')[0];
const tariefTekst = waarden.soort
  ? tariefIndicatie(kiesTarief(tariefregels, waarden.soort, waarden.datum || vandaagTarief))
  : '';
const medeNamen = parseMedeExposanten(waarden.medeExposanten).slice(0, MAX_MEDE_EXPOSANTEN);
---

<Base
  title="Aanvragen"
  description="Vraag het kerkje van Persingen aan voor je bruiloft, expositie, concert of bijeenkomst."
>
  <PageHeader
    eyebrow="Verhuur"
    title="Vertel wat je van plan bent"
    intro="Vul het formulier in, dan kijken we of en hoe het kan. Je hoort van ons wat er mogelijk is en wat het kost."
    mark="boog"
  />

  <div class="wrap-narrow">
    {
      heeftFouten && (
        <div class="samenvatting" role="alert" tabindex="-1" id="foutmelding">
          <h2>Je aanvraag is nog niet verstuurd</h2>
          {fouten.algemeen ? (
            <p>{fouten.algemeen}</p>
          ) : (
            <>
              <p>Controleer het volgende:</p>
              <ul>
                {Object.entries(fouten).map(([veld, melding]) => (
                  <li>
                    <a href={`#${veld}`}>{melding}</a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      )
    }

    {
      !heeftFouten && waarschuwing && (
        <div class="waarschuwing" role="alert" tabindex="-1" id="waarschuwingsmelding">
          <h2>Weet je dit zeker?</h2>
          <p>{waarschuwing}</p>
          <p class="klein">
            Je kunt de aanvraag toch versturen — het bestuur beoordeelt hem sowieso
            handmatig — of eerst je datum aanpassen.
          </p>
          {fotoOpnieuw && (
            <p class="klein">De gekozen foto’s zijn niet bewaard bij deze controle. Voeg ze opnieuw toe voordat je verstuurt.</p>
          )}
        </div>
      )
    }

    <form method="POST" action="/verhuur/aanvragen/" enctype="multipart/form-data">
      <div class="veld">
        <label for="soort">Wat voor bijeenkomst wordt het?</label>
        <select
          id="soort"
          name="soort"
          required
          aria-invalid={fouten.soort ? 'true' : undefined}
          aria-describedby={fouten.soort ? 'fout-soort' : undefined}
        >
          <option value="">Maak een keuze</option>
          {
            SOORTEN.map((s) => (
              <option value={s.waarde} selected={waarden.soort === s.waarde}>
                {s.label}
              </option>
            ))
          }
        </select>
        {fouten.soort && <p class="fout" id="fout-soort">{fouten.soort}</p>}
        <p class="tarief" id="tarief-indicatie" hidden={!tariefTekst} data-regels={JSON.stringify(tariefregels)} data-vandaag={vandaagTarief}>
          <span>Tarief</span>
          <strong id="tarief-waarde">{tariefTekst}</strong>
        </p>
      </div>

      <div class="veld">
        <label for="datum">Gewenste datum</label>
        <input
          type="date"
          id="datum"
          name="datum"
          min={vandaag}
          value={waarden.datum}
          required
          aria-invalid={fouten.datum ? 'true' : undefined}
          aria-describedby={fouten.datum ? 'fout-datum' : undefined}
        />
        {fouten.datum && <p class="fout" id="fout-datum">{fouten.datum}</p>}
      </div>

      <div class="veld">
        <label for="datumTot">
          Tot en met <span class="optioneel">(alleen invullen bij een meerdaagse periode, bijv. een heel weekend)</span>
        </label>
        <input
          type="date"
          id="datumTot"
          name="datumTot"
          min={waarden.datum || vandaag}
          value={waarden.datumTot}
          aria-invalid={fouten.datumTot ? 'true' : undefined}
          aria-describedby={fouten.datumTot ? 'fout-datumTot' : undefined}
        />
        {fouten.datumTot && <p class="fout" id="fout-datumTot">{fouten.datumTot}</p>}
      </div>

      <div class="veld" id="personen-veld">
        <label for="personen">Hoeveel mensen verwacht je?</label>
        <input
          type="number"
          id="personen"
          name="personen"
          min="1"
          max="500"
          inputmode="numeric"
          value={waarden.personen}
          aria-invalid={fouten.personen ? 'true' : undefined}
          aria-describedby={`hint-personen${fouten.personen ? ' fout-personen' : ''}`}
        />
        <p class="hint" id="hint-personen">Een schatting is genoeg.</p>
        {fouten.personen && <p class="fout" id="fout-personen">{fouten.personen}</p>}
      </div>

      <fieldset>
        <legend>Je gegevens</legend>

        <div class="veld">
          <label for="naam">Naam</label>
          <input
            type="text"
            id="naam"
            name="naam"
            autocomplete="name"
            value={waarden.naam}
            required
            aria-invalid={fouten.naam ? 'true' : undefined}
            aria-describedby={fouten.naam ? 'fout-naam' : undefined}
          />
          {fouten.naam && <p class="fout" id="fout-naam">{fouten.naam}</p>}
        </div>

        <div class="adres-rij adres-rij--straat">
          <div class="veld">
            <label for="straat">Straat</label>
            <input
              type="text"
              id="straat"
              name="straat"
              autocomplete="address-line1"
              value={waarden.straat}
              required
              aria-invalid={fouten.straat ? 'true' : undefined}
              aria-describedby={fouten.straat ? 'fout-straat' : undefined}
            />
            {fouten.straat && <p class="fout" id="fout-straat">{fouten.straat}</p>}
          </div>
          <div class="veld">
            <label for="huisnummer">Huisnummer</label>
            <input
              type="text"
              id="huisnummer"
              name="huisnummer"
              inputmode="text"
              value={waarden.huisnummer}
              required
              aria-invalid={fouten.huisnummer ? 'true' : undefined}
              aria-describedby={fouten.huisnummer ? 'fout-huisnummer' : undefined}
            />
            {fouten.huisnummer && <p class="fout" id="fout-huisnummer">{fouten.huisnummer}</p>}
          </div>
          <div class="veld">
            <label for="toevoeging">Toevoeging <span class="optioneel">optioneel</span></label>
            <input
              type="text"
              id="toevoeging"
              name="toevoeging"
              value={waarden.toevoeging}
              maxlength="12"
              aria-invalid={fouten.toevoeging ? 'true' : undefined}
              aria-describedby={fouten.toevoeging ? 'fout-toevoeging' : undefined}
            />
            {fouten.toevoeging && <p class="fout" id="fout-toevoeging">{fouten.toevoeging}</p>}
          </div>
        </div>

        <div class="adres-rij adres-rij--plaats">
          <div class="veld">
            <label for="postcode">Postcode</label>
            <input
              type="text"
              id="postcode"
              name="postcode"
              autocomplete="postal-code"
              value={waarden.postcode}
              required
              aria-invalid={fouten.postcode ? 'true' : undefined}
              aria-describedby={fouten.postcode ? 'fout-postcode' : undefined}
            />
            {fouten.postcode && <p class="fout" id="fout-postcode">{fouten.postcode}</p>}
          </div>
          <div class="veld">
            <label for="woonplaats">Woonplaats</label>
            <input
              type="text"
              id="woonplaats"
              name="woonplaats"
              autocomplete="address-level2"
              value={waarden.woonplaats}
              required
              aria-invalid={fouten.woonplaats ? 'true' : undefined}
              aria-describedby={fouten.woonplaats ? 'fout-woonplaats' : undefined}
            />
            {fouten.woonplaats && <p class="fout" id="fout-woonplaats">{fouten.woonplaats}</p>}
          </div>
        </div>
        {fouten.adres && <p class="fout" id="fout-adres">{fouten.adres}</p>}

        <div class="veld">
          <label for="telefoon">Telefoonnummer</label>
          <input
            type="tel"
            id="telefoon"
            name="telefoon"
            autocomplete="tel"
            value={waarden.telefoon}
            required
            aria-invalid={fouten.telefoon ? 'true' : undefined}
            aria-describedby={fouten.telefoon ? 'fout-telefoon' : undefined}
          />
          {fouten.telefoon && <p class="fout" id="fout-telefoon">{fouten.telefoon}</p>}
        </div>

        <div class="veld">
          <label for="email">E-mailadres</label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            value={waarden.email}
            required
            aria-invalid={fouten.email ? 'true' : undefined}
            aria-describedby={fouten.email ? 'fout-email' : undefined}
          />
          {fouten.email && <p class="fout" id="fout-email">{fouten.email}</p>}
        </div>
      </fieldset>

      <fieldset id="expositie-velden">
        <legend>Voor exposities</legend>

        <div class="veld">
          <label for="website">
            Website <span class="optioneel">optioneel</span>
          </label>
          <input
            type="text"
            id="website"
            name="website"
            value={waarden.website}
            aria-invalid={fouten.website ? 'true' : undefined}
            aria-describedby={fouten.website ? 'fout-website' : undefined}
          />
          {fouten.website && <p class="fout" id="fout-website">{fouten.website}</p>}
        </div>

        <div class="veld">
          <label for="fotos">Foto’s van je werk <span class="optioneel">optioneel</span></label>
          <p class="hint" id="hint-fotos">
            Geen website? Voeg hieronder enkele voorbeelden van je werk toe. JPG, PNG of WebP, maximaal 8 MB per foto.
          </p>
          <input
            type="file"
            id="fotos"
            name="fotos"
            accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
            multiple
            aria-describedby={`hint-fotos${fouten.fotos ? ' fout-fotos' : ''}`}
          />
          <ul class="foto-lijst" id="foto-lijst"></ul>
          <p class="fout" id="foto-client" hidden></p>
          {fouten.fotos && <p class="fout" id="fout-fotos">{fouten.fotos}</p>}
          {fotoOpnieuw && heeftFouten && (
            <p class="hint">De gekozen foto’s zijn niet bewaard bij deze controle. Voeg ze opnieuw toe voordat je verstuurt.</p>
          )}
        </div>

        <div class="veld">
          <label for="eerderGeexposeerd">Heb je hier eerder geëxposeerd?</label>
          <select id="eerderGeexposeerd" name="eerderGeexposeerd">
            <option value="">Maak een keuze</option>
            <option value="ja" selected={waarden.eerderGeexposeerd === 'ja'}>Ja</option>
            <option value="nee" selected={waarden.eerderGeexposeerd === 'nee'}>Nee</option>
          </select>
        </div>

        <div class="veld" id="medeExposanten">
          <p class="mede-kop">Mede-exposanten</p>
          <p class="hint">Je kunt maximaal {MAX_MEDE_EXPOSANTEN} mede-exposanten toevoegen.</p>
          <div id="mede-lijst">
            {medeNamen.map((naam, index) => (
              <div class="mede-rij">
                <label for={`mede-${index}`}>Mede-exposant {index + 1}</label>
                <input id={`mede-${index}`} name="medeExposant" value={naam} maxlength="120" />
                <button type="button" class="tekstknop" data-mede-weg>Verwijderen</button>
              </div>
            ))}
          </div>
          <button type="button" class="tekstknop" id="mede-toevoegen">+ Mede-exposant toevoegen</button>
          {fouten.medeExposanten && <p class="fout" id="fout-medeExposanten">{fouten.medeExposanten}</p>}
        </div>

        <div class="veld veld--checkbox">
          <label class="checkbox-label">
            <input
              type="checkbox"
              id="akkoordVoorwaarden"
              name="akkoordVoorwaarden"
              value="ja"
              checked={waarden.akkoordVoorwaarden === 'ja'}
              aria-invalid={fouten.akkoordVoorwaarden ? 'true' : undefined}
              aria-describedby={fouten.akkoordVoorwaarden ? 'fout-akkoordVoorwaarden' : undefined}
            />
            <span>
              Ik ga akkoord met de{' '}
              <a href="/verhuur/voorwaarden/" target="_blank" rel="noopener">verhuurvoorwaarden en het huishoudelijk reglement</a>
            </span>
          </label>
          {fouten.akkoordVoorwaarden && <p class="fout" id="fout-akkoordVoorwaarden">{fouten.akkoordVoorwaarden}</p>}
        </div>
      </fieldset>

      <div class="veld">
        <label for="toelichting">
          Opmerkingen <span class="optioneel">(mag je leeg laten)</span>
        </label>
        <textarea id="toelichting" name="toelichting" rows="5" aria-describedby="hint-toelichting"
          >{waarden.toelichting}</textarea
        >
        <p class="hint" id="hint-toelichting">
          Bijvoorbeeld de tijden die je in gedachten hebt, of wat je in de ruimte wilt doen.
        </p>
      </div>

      {
        waarschuwing && !heeftFouten && (
          <input type="hidden" name="negeerWaarschuwing" value="ja" />
        )
      }

      <div class="honeypot" aria-hidden="true">
        <label for="website_hp">Website</label>
        <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
      </div>

      <div class="verzendknoppen">
        <button type="submit" class="verstuur">
          {waarschuwing && !heeftFouten ? 'Toch versturen' : 'Verstuur aanvraag'}
        </button>
      </div>
    </form>

    <section class="kalender-sectie" id="kalender">
      <h2>Beschikbaarheid</h2>
      <p>
        Grijs is bezet. Klik op een vrije dag om die datum in het formulier hierboven
        in te vullen.
      </p>
      <div class="kalender-met-lijst">
        <Kalender bezet={bezet} maand={maand} basisPad="/verhuur/aanvragen/" />
        <VrijeWeekenden bezet={bezet} />
      </div>
    </section>
  </div>
</Base>

<script>
  import { kiesTarief } from '../../../platform/finance.ts';
  import { tariefIndicatie } from '../../../platform/tarief-indicatie.ts';

  const MAX_FOTO = 8;
  const MAX_BYTES = 8_000_000;
  const MAX_MEDE = 4;
  const soortSelect = document.getElementById('soort') as HTMLSelectElement | null;
  const expositieVelden = document.getElementById('expositie-velden');
  const personenVeld = document.getElementById('personen-veld');
  const personenInput = document.getElementById('personen') as HTMLInputElement | null;
  const datumInput = document.getElementById('datum') as HTMLInputElement | null;
  const tariefBlok = document.getElementById('tarief-indicatie');
  const tariefWaarde = document.getElementById('tarief-waarde');
  const medeLijst = document.getElementById('mede-lijst');
  const medeKnop = document.getElementById('mede-toevoegen');
  const fotoInput = document.getElementById('fotos') as HTMLInputElement | null;
  const fotoLijst = document.getElementById('foto-lijst');
  const fotoClient = document.getElementById('foto-client');
  const formulier = fotoInput?.form ?? null;
  let fotoBestanden: File[] = [];

  function bijwerken() {
    const isExpositie = soortSelect?.value === 'expositie';
    if (expositieVelden) expositieVelden.style.display = isExpositie ? '' : 'none';
    if (personenVeld) personenVeld.style.display = isExpositie ? 'none' : '';
    if (personenInput) personenInput.required = !isExpositie;
    toonTarief();
  }

  function toonTarief() {
    if (!tariefBlok || !tariefWaarde || !soortSelect) return;
    let regels: { verhuurtype: string; prijstype: 'vast' | 'vanaf' | 'op_aanvraag'; bedrag: number | null; geldigVanaf: string; geldigTot?: string | null }[] = [];
    try {
      regels = JSON.parse(tariefBlok.dataset.regels || '[]') as typeof regels;
    } catch {
      regels = [];
    }
    const datum = datumInput?.value || tariefBlok.dataset.vandaag || '';
    const tekst = soortSelect.value ? tariefIndicatie(kiesTarief(regels, soortSelect.value, datum)) : '';
    tariefWaarde.textContent = tekst;
    tariefBlok.hidden = !tekst;
  }

  function nummerMede() {
    if (!medeLijst) return;
    const rijen = [...medeLijst.querySelectorAll('.mede-rij')];
    rijen.forEach((rij, index) => {
      const label = rij.querySelector('label');
      const input = rij.querySelector('input');
      const id = `mede-${index}`;
      if (label) {
        label.htmlFor = id;
        label.textContent = `Mede-exposant ${index + 1}`;
      }
      if (input) input.id = id;
    });
    if (medeKnop) medeKnop.hidden = rijen.length >= MAX_MEDE;
  }

  function voegMedeToe(naam = '') {
    if (!medeLijst || medeLijst.querySelectorAll('.mede-rij').length >= MAX_MEDE) return;
    const rij = document.createElement('div');
    rij.className = 'mede-rij';
    rij.innerHTML = '<label></label><input name="medeExposant" maxlength="120" /><button type="button" class="tekstknop" data-mede-weg>Verwijderen</button>';
    const input = rij.querySelector('input');
    if (input) input.value = naam;
    medeLijst.append(rij);
    nummerMede();
    input?.focus();
  }

  function fotoFout(tekst: string) {
    if (!fotoClient) return;
    fotoClient.hidden = !tekst;
    fotoClient.textContent = tekst;
  }

  function geldigeFoto(bestand: File): string | null {
    const naam = bestand.name.toLowerCase();
    const typeOk = ['image/jpeg', 'image/png', 'image/webp'].includes(bestand.type)
      || /\.(jpe?g|png|webp)$/.test(naam);
    if (!typeOk) return 'Gebruik een JPG, PNG of WebP.';
    if (bestand.size <= 0) return 'Het bestand is leeg.';
    if (bestand.size > MAX_BYTES) return 'Een foto mag maximaal 8 MB zijn.';
    return null;
  }

  function tekenFotos() {
    if (!fotoLijst) return;
    fotoLijst.replaceChildren();
    fotoBestanden.forEach((bestand, index) => {
      const item = document.createElement('li');
      const naam = document.createElement('span');
      naam.textContent = bestand.name;
      const weg = document.createElement('button');
      weg.type = 'button';
      weg.className = 'tekstknop';
      weg.textContent = 'Verwijderen';
      weg.addEventListener('click', () => {
        fotoBestanden.splice(index, 1);
        tekenFotos();
      });
      if (bestand.type.startsWith('image/')) {
        const beeld = document.createElement('img');
        beeld.alt = '';
        beeld.src = URL.createObjectURL(bestand);
        item.append(beeld);
      }
      item.append(naam, weg);
      fotoLijst.append(item);
    });
  }

  function zetFotoInput() {
    if (!fotoInput || typeof DataTransfer === 'undefined') return;
    const overdracht = new DataTransfer();
    for (const bestand of fotoBestanden) overdracht.items.add(bestand);
    fotoInput.files = overdracht.files;
  }

  soortSelect?.addEventListener('change', bijwerken);
  datumInput?.addEventListener('change', toonTarief);
  bijwerken();
  nummerMede();

  medeKnop?.addEventListener('click', () => voegMedeToe());
  medeLijst?.addEventListener('click', (event) => {
    const doel = event.target;
    if (!(doel instanceof HTMLElement) || !doel.closest('[data-mede-weg]')) return;
    doel.closest('.mede-rij')?.remove();
    nummerMede();
  });

  fotoInput?.addEventListener('change', () => {
    fotoFout('');
    const gekozen = [...(fotoInput.files ?? [])];
    fotoInput.value = '';
    for (const bestand of gekozen) {
      if (fotoBestanden.length >= MAX_FOTO) {
        fotoFout(`Je kunt maximaal ${MAX_FOTO} foto's toevoegen.`);
        break;
      }
      const reden = geldigeFoto(bestand);
      if (reden) {
        fotoFout(reden);
        continue;
      }
      fotoBestanden.push(bestand);
    }
    tekenFotos();
  });

  formulier?.addEventListener('submit', () => zetFotoInput());

  document.getElementById('foutmelding')?.focus();
  document.getElementById('waarschuwingsmelding')?.focus();
</script>

