---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Kalender from '../../../components/Kalender.astro';
import VrijeWeekenden from '../../../components/VrijeWeekenden.astro';
import {
  LEGE_AANVRAAG,
  SOORTEN,
  leesFormulier,
  valideer,
  weekendWaarschuwing,
  verstuurAanvraag,
  teVaak,
  type Aanvraag,
  type Fouten,
} from '../../../lib/aanvraag';
import { getBezetteData } from '../../../lib/sanity';

export const prerender = false;

let waarden: Aanvraag = { ...LEGE_AANVRAAG };
let fouten: Fouten = {};
let waarschuwing: string | null = null;

const GELDIGE_SOORTEN = SOORTEN.map((s) => s.waarde);

const vooraf = Astro.url.searchParams.get('datum');
if (vooraf && /^\d{4}-\d{2}-\d{2}$/.test(vooraf)) {
  waarden.datum = vooraf;
}
const voorafTot = Astro.url.searchParams.get('datumTot');
if (voorafTot && /^\d{4}-\d{2}-\d{2}$/.test(voorafTot)) {
  waarden.datumTot = voorafTot;
}
const soortVooraf = Astro.url.searchParams.get('soort');
if (soortVooraf && GELDIGE_SOORTEN.includes(soortVooraf as never)) {
  waarden.soort = soortVooraf;
}

const bezet = await getBezetteData();

const nu = new Date();
const gevraagdeMaand = Astro.url.searchParams.get('maand') ?? '';
const maand = /^\d{4}-(0[1-9]|1[0-2])$/.test(gevraagdeMaand)
  ? gevraagdeMaand
  : `${nu.getFullYear()}-${String(nu.getMonth() + 1).padStart(2, '0')}`;

function alleDagen(vanIso: string, totIso: string): number[] {
  const dagen: number[] = [];
  const van = new Date(vanIso);
  const tot = new Date(totIso);
  const loper = Date.UTC(van.getUTCFullYear(), van.getUTCMonth(), van.getUTCDate());
  const eind = Date.UTC(tot.getUTCFullYear(), tot.getUTCMonth(), tot.getUTCDate());
  let dag = loper;
  let veiligheid = 0;
  while (dag <= eind && veiligheid < 60) {
    dagen.push(dag);
    dag += 24 * 60 * 60 * 1000;
    veiligheid++;
  }
  return dagen;
}

/** Is een specifieke dag (YYYY-MM-DD) al bezet met een bruiloft? Voor de
 *  weekend-uitzonderingsregel bij exposities. */
function isDagBruiloft(dagIso: string): boolean {
  const dag = Date.UTC(
    Number(dagIso.slice(0, 4)),
    Number(dagIso.slice(5, 7)) - 1,
    Number(dagIso.slice(8, 10))
  );
  return bezet.some((a) => {
    if (a.soort !== 'bruiloft') return false;
    const start = new Date(a.start);
    const startDag = Date.UTC(start.getUTCFullYear(), start.getUTCMonth(), start.getUTCDate());
    const eind = a.eind ? new Date(a.eind) : start;
    const eindDag = Date.UTC(eind.getUTCFullYear(), eind.getUTCMonth(), eind.getUTCDate());
    return startDag <= dag && dag <= eindDag;
  });
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();

    if (String(data.get('website_hp') ?? '').length > 0) {
      return Astro.redirect('/verhuur/aanvragen/bedankt/', 303);
    }

    waarden = leesFormulier(data);

    if (teVaak(Astro.clientAddress ?? 'onbekend')) {
      fouten = {
        algemeen: 'Er zijn net veel aanvragen verstuurd. Probeer het over een kwartier opnieuw.',
      };
    } else {
      fouten = valideer(waarden);

      if (!fouten.datum && !fouten.datumTot && waarden.datum) {
        const gevraagdeDagen = alleDagen(waarden.datum, waarden.datumTot || waarden.datum);

        const isBezet = bezet.some((a) => {
          const start = new Date(a.start);
          const startDag = Date.UTC(start.getUTCFullYear(), start.getUTCMonth(), start.getUTCDate());
          const eind = a.eind ? new Date(a.eind) : start;
          const eindDag = Date.UTC(eind.getUTCFullYear(), eind.getUTCMonth(), eind.getUTCDate());
          return gevraagdeDagen.some((d) => startDag <= d && d <= eindDag);
        });

        if (isBezet) {
          const veld = waarden.datumTot ? 'datumTot' : 'datum';
          fouten[veld] =
            'Eén of meer dagen in deze periode zijn al bezet. Kies andere data, of bel 06 52 66 84 49.';
        }
      }

      if (Object.keys(fouten).length === 0) {
        waarschuwing = weekendWaarschuwing(waarden, isDagBruiloft);
      }

      if (Object.keys(fouten).length === 0 && (!waarschuwing || waarden.negeerWaarschuwing === 'ja')) {
        const uitkomst = await verstuurAanvraag(waarden);
        if (uitkomst.ok) {
          return Astro.redirect('/verhuur/aanvragen/bedankt/', 303);
        }
        fouten = uitkomst.fouten ?? {};
      }
    }
  } catch (error) {
    console.error('[aanvraag] onverwachte fout bij verwerken formulier', error);
    fouten = { algemeen: 'Er ging iets mis. Bel 06 52 66 84 49, dan pakken we het direct op.' };
  }
}

const heeftFouten = Object.keys(fouten).length > 0;
const vandaag = new Date().toISOString().split('T')[0];
---

<Base
  title="Aanvragen"
  description="Vraag het kerkje van Persingen aan voor je bruiloft, expositie, concert of bijeenkomst."
>
  <PageHeader
    eyebrow="Verhuur"
    title="Vertel wat je van plan bent"
    intro="Vul het formulier in, dan kijken we of en hoe het kan. Je hoort van ons wat er mogelijk is en wat het kost."
    mark="boog"
  />

  <div class="wrap-narrow">
    {
      heeftFouten && (
        <div class="samenvatting" role="alert" tabindex="-1" id="foutmelding">
          <h2>Je aanvraag is nog niet verstuurd</h2>
          {fouten.algemeen ? (
            <p>{fouten.algemeen}</p>
          ) : (
            <>
              <p>Controleer het volgende:</p>
              <ul>
                {Object.entries(fouten).map(([veld, melding]) => (
                  <li>
                    <a href={`#${veld}`}>{melding}</a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      )
    }

    {
      !heeftFouten && waarschuwing && (
        <div class="waarschuwing" role="alert" tabindex="-1" id="waarschuwingsmelding">
          <h2>Weet je dit zeker?</h2>
          <p>{waarschuwing}</p>
          <p class="klein">
            Je kunt de aanvraag toch versturen — het bestuur beoordeelt hem sowieso
            handmatig — of eerst je datum aanpassen.
          </p>
        </div>
      )
    }

    <form method="POST" action="/verhuur/aanvragen/">
      <div class="veld">
        <label for="datum">Gewenste datum</label>
        <input
          type="date"
          id="datum"
          name="datum"
          min={vandaag}
          value={waarden.datum}
          required
          aria-invalid={fouten.datum ? 'true' : undefined}
          aria-describedby={fouten.datum ? 'fout-datum' : undefined}
        />
        {fouten.datum && <p class="fout" id="fout-datum">{fouten.datum}</p>}
      </div>

      <div class="veld">
        <label for="datumTot">
          Tot en met <span class="optioneel">(alleen invullen bij een meerdaagse periode, bijv. een heel weekend)</span>
        </label>
        <input
          type="date"
          id="datumTot"
          name="datumTot"
          min={waarden.datum || vandaag}
          value={waarden.datumTot}
          aria-invalid={fouten.datumTot ? 'true' : undefined}
          aria-describedby={fouten.datumTot ? 'fout-datumTot' : undefined}
        />
        {fouten.datumTot && <p class="fout" id="fout-datumTot">{fouten.datumTot}</p>}
      </div>

      <div class="veld">
        <label for="soort">Wat voor bijeenkomst wordt het?</label>
        <select
          id="soort"
          name="soort"
          required
          aria-invalid={fouten.soort ? 'true' : undefined}
          aria-describedby={fouten.soort ? 'fout-soort' : undefined}
        >
          <option value="">Maak een keuze</option>
          {
            SOORTEN.map((s) => (
              <option value={s.waarde} selected={waarden.soort === s.waarde}>
                {s.label}
              </option>
            ))
          }
        </select>
        {fouten.soort && <p class="fout" id="fout-soort">{fouten.soort}</p>}
      </div>

      <div class="veld" id="personen-veld">
        <label for="personen">
          Hoeveel mensen verwacht je?
          <span class="optioneel" data-alleen-niet-expositie>(bij een expositie mag je dit leeg laten)</span>
        </label>
        <input
          type="number"
          id="personen"
          name="personen"
          min="1"
          max="500"
          inputmode="numeric"
          value={waarden.personen}
          aria-invalid={fouten.personen ? 'true' : undefined}
          aria-describedby={`hint-personen${fouten.personen ? ' fout-personen' : ''}`}
        />
        <p class="hint" id="hint-personen">Een schatting is genoeg.</p>
        {fouten.personen && <p class="fout" id="fout-personen">{fouten.personen}</p>}
      </div>

      <fieldset>
        <legend>Je gegevens</legend>

        <div class="veld">
          <label for="naam">Naam</label>
          <input
            type="text"
            id="naam"
            name="naam"
            autocomplete="name"
            value={waarden.naam}
            required
            aria-invalid={fouten.naam ? 'true' : undefined}
            aria-describedby={fouten.naam ? 'fout-naam' : undefined}
          />
          {fouten.naam && <p class="fout" id="fout-naam">{fouten.naam}</p>}
        </div>

        <div class="veld">
          <label for="email">E-mailadres</label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            value={waarden.email}
            required
            aria-invalid={fouten.email ? 'true' : undefined}
            aria-describedby={fouten.email ? 'fout-email' : undefined}
          />
          {fouten.email && <p class="fout" id="fout-email">{fouten.email}</p>}
        </div>

        <div class="veld">
          <label for="adres">Adres <span class="optioneel">(straat, huisnummer, postcode en woonplaats)</span></label>
          <input
            type="text"
            id="adres"
            name="adres"
            autocomplete="street-address"
            value={waarden.adres}
            required
            aria-invalid={fouten.adres ? 'true' : undefined}
            aria-describedby={fouten.adres ? 'fout-adres' : undefined}
          />
          {fouten.adres && <p class="fout" id="fout-adres">{fouten.adres}</p>}
        </div>

        <div class="veld">
          <label for="telefoon">
            Telefoonnummer <span class="optioneel">(mag je leeg laten)</span>
          </label>
          <input
            type="tel"
            id="telefoon"
            name="telefoon"
            autocomplete="tel"
            value={waarden.telefoon}
            aria-invalid={fouten.telefoon ? 'true' : undefined}
            aria-describedby={fouten.telefoon ? 'fout-telefoon' : undefined}
          />
          {fouten.telefoon && <p class="fout" id="fout-telefoon">{fouten.telefoon}</p>}
        </div>
      </fieldset>

      <fieldset id="expositie-velden">
        <legend>Voor exposities</legend>

        <div class="veld">
          <label for="website">
            Website of portfolio <span class="optioneel">(mag je leeg laten)</span>
          </label>
          <input
            type="text"
            id="website"
            name="website"
            value={waarden.website}
            aria-invalid={fouten.website ? 'true' : undefined}
            aria-describedby={`hint-website${fouten.website ? ' fout-website' : ''}`}
          />
          <p class="hint" id="hint-website">
            Geen website? Voeg dan een foto van je werk toe bij de opmerkingen onderaan.
          </p>
          {fouten.website && <p class="fout" id="fout-website">{fouten.website}</p>}
        </div>

        <div class="veld">
          <label for="eerderGeexposeerd">Heb je hier eerder geëxposeerd?</label>
          <select id="eerderGeexposeerd" name="eerderGeexposeerd">
            <option value="">Maak een keuze</option>
            <option value="ja" selected={waarden.eerderGeexposeerd === 'ja'}>Ja</option>
            <option value="nee" selected={waarden.eerderGeexposeerd === 'nee'}>Nee</option>
          </select>
        </div>

        <div class="veld">
         <label for="medeExposanten">
            Mede-exposanten <span class="optioneel">(namen, maximaal 5, als je niet alleen exposeert)</span>
          </label>
          <textarea id="medeExposanten" name="medeExposanten" rows="2">{waarden.medeExposanten}</textarea>
          {fouten.medeExposanten && <p class="fout">{fouten.medeExposanten}</p>}
        </div>

        <div class="veld veld--checkbox">
          <label class="checkbox-label">
            <input
              type="checkbox"
              id="akkoordVoorwaarden"
              name="akkoordVoorwaarden"
              value="ja"
              checked={waarden.akkoordVoorwaarden === 'ja'}
              aria-invalid={fouten.akkoordVoorwaarden ? 'true' : undefined}
              aria-describedby={fouten.akkoordVoorwaarden ? 'fout-akkoordVoorwaarden' : undefined}
            />
            <span>
              Ik ga akkoord met de{' '}
              <a href="/verhuur/voorwaarden/" target="_blank" rel="noopener">verhuurvoorwaarden en het huishoudelijk reglement</a>
            </span>
          </label>
          {fouten.akkoordVoorwaarden && <p class="fout" id="fout-akkoordVoorwaarden">{fouten.akkoordVoorwaarden}</p>}
        </div>
      </fieldset>

      <div class="veld">
        <label for="toelichting">
          Opmerkingen <span class="optioneel">(mag je leeg laten)</span>
        </label>
        <textarea id="toelichting" name="toelichting" rows="5" aria-describedby="hint-toelichting"
          >{waarden.toelichting}</textarea
        >
        <p class="hint" id="hint-toelichting">
          Bijvoorbeeld de tijden die je in gedachten hebt, wat je in de ruimte wilt doen, of
          een link naar foto's van je werk.
        </p>
      </div>

      {
        waarschuwing && !heeftFouten && (
          <input type="hidden" name="negeerWaarschuwing" value="ja" />
        )
      }

      <div class="honeypot" aria-hidden="true">
        <label for="website_hp">Website</label>
        <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
      </div>

      <div class="verzendknoppen">
        <button type="submit" class="verstuur">
          {waarschuwing && !heeftFouten ? 'Toch versturen' : 'Verstuur aanvraag'}
        </button>
      </div>
    </form>

    <section class="kalender-sectie" id="kalender">
      <h2>Beschikbaarheid</h2>
      <p>
        Grijs is bezet. Klik op een vrije dag om die datum in het formulier hierboven
        in te vullen.
      </p>
      <div class="kalender-met-lijst">
        <Kalender bezet={bezet} maand={maand} basisPad="/verhuur/aanvragen/" />
        <VrijeWeekenden />
      </div>
    </section>
  </div>
</Base>

<script>
  const soortSelect = document.getElementById('soort') as HTMLSelectElement | null;
  const expositieVelden = document.getElementById('expositie-velden');
  const personenVeld = document.getElementById('personen-veld');
  const personenInput = document.getElementById('personen') as HTMLInputElement | null;

  function bijwerken() {
    const isExpositie = soortSelect?.value === 'expositie';
    if (expositieVelden) {
      expositieVelden.style.display = isExpositie ? '' : 'none';
    }
    if (personenVeld) {
      personenVeld.classList.toggle('personen-optioneel', isExpositie);
    }
    if (personenInput) {
      personenInput.required = !isExpositie;
    }
  }

  soortSelect?.addEventListener('change', bijwerken);
  bijwerken();

  document.getElementById('foutmelding')?.focus();
  document.getElementById('waarschuwingsmelding')?.focus();
</script>

<style>
  form {
    display: grid;
    gap: var(--s-6);
    max-width: 560px;
  }

  .kalender-sectie {
    margin-top: var(--s-16);
    padding-top: var(--s-12);
    border-top: var(--border);
  }

  .kalender-met-lijst {
    display: grid;
    grid-template-columns: auto 260px;
    gap: var(--s-8);
    align-items: start;
  }

  .samenvatting {
    max-width: 560px;
    background: #fdf2ef;
    border: 1.5px solid var(--error);
    border-radius: var(--radius-lg);
    padding: var(--s-6);
    margin-bottom: var(--s-8);
  }

  .waarschuwing {
    max-width: 560px;
    background: var(--cream-deep);
    border: 1.5px solid var(--olive);
    border-radius: var(--radius-lg);
    padding: var(--s-6);
    margin-bottom: var(--s-8);
  }

  .samenvatting:focus-visible,
  .waarschuwing:focus-visible {
    outline: 3px solid var(--error);
    outline-offset: 3px;
  }

  .samenvatting h2,
  .waarschuwing h2 {
    font-size: var(--t-xl);
    margin: 0 0 var(--s-3);
  }

  .samenvatting p,
  .waarschuwing p {
    margin: 0 0 var(--s-2);
  }

  .samenvatting ul {
    margin: 0;
    padding-left: var(--s-6);
  }

  .samenvatting a {
    color: var(--error);
  }

  .klein {
    font-size: var(--t-sm);
    color: var(--ink-mute);
  }

  fieldset {
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: var(--s-6);
    margin: 0;
    display: grid;
    gap: var(--s-6);
  }

  legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-lg);
    padding-inline: var(--s-2);
  }

  .veld {
    display: grid;
    gap: var(--s-2);
  }

  label {
    font-weight: 500;
  }

  .optioneel {
    font-weight: 400;
    color: var(--ink-mute);
    font-size: var(--t-sm);
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: var(--t-base);
    padding: var(--s-3) var(--s-4);
    border: 1.5px solid var(--sand);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    width: 100%;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--olive);
  }

  input[aria-invalid='true'],
  select[aria-invalid='true'] {
    border-color: var(--error);
    background: #fdf7f6;
  }

  .hint {
    font-size: var(--t-sm);
    color: var(--ink-mute);
    margin: 0;
  }

  .fout {
    font-size: var(--t-sm);
    color: var(--error);
    font-weight: 500;
    margin: 0;
  }

  .veld--checkbox {
    display: block;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    font-weight: 400;
    cursor: pointer;
  }

  .checkbox-label input[type='checkbox'] {
    width: auto;
    margin-top: 3px;
    flex: none;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .verzendknoppen {
    display: flex;
    gap: var(--s-4);
  }

  .verstuur {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--t-base);
    padding: var(--s-4) var(--s-6);
    background: var(--brick);
    color: var(--cream);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .verstuur:hover {
    background: var(--brick-dark);
  }

  @media (max-width: 860px) {
    .kalender-met-lijst {
      grid-template-columns: 1fr;
    }
  }
</style>
