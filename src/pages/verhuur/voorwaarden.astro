---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { HUISREGELS_V1, VOORWAARDEN_V1 } from '../../platform/documenten/teksten-v1.ts';

/*
  Versie 1.0, de tekst die ook in een contract wordt bevroren.
  Vastgesteld op 15 november 2026. De korte samenvatting van augustus
  is deze publicatie.
*/
---

<Base
  title="Verhuurvoorwaarden"
  description="Verhuurvoorwaarden en huisregels van het Kerkje van Persingen, versie 1.0."
>
  <PageHeader
    eyebrow="Verhuur"
    title="Verhuurvoorwaarden en huisregels"
    mark="boog"
  />

  <div class="wrap-narrow prose">
    <p>Versie 1.0, vastgesteld op 15 november 2026.</p>
    <div class="documenttekst">{VOORWAARDEN_V1}</div>
    <div class="documenttekst">{HUISREGELS_V1}</div>
    <p>
      De actuele tarieven staan op de <a href="/verhuur/">verhuurpagina</a>.
      Vragen over de voorwaarden? Neem contact op via het{' '}
      <a href="/contact/">contactformulier</a> of bel{' '}
      <a href="tel:+31652668449">06 52 66 84 49</a>.
    </p>
  </div>
</Base>

<style>
  .documenttekst {
    white-space: pre-wrap;
    margin-top: var(--s-6);
  }
</style>
