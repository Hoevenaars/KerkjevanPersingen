---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/Button.astro';
import Kalender from '../../components/Kalender.astro';
import VrijeWeekenden from '../../components/VrijeWeekenden.astro';
import { getBezetteData } from '../../lib/sanity';

export const prerender = false;

const bezet = await getBezetteData();

const nu = new Date();
const gevraagd = Astro.url.searchParams.get('maand') ?? '';
const maand = /^\d{4}-(0[1-9]|1[0-2])$/.test(gevraagd)
  ? gevraagd
  : `${nu.getFullYear()}-${String(nu.getMonth() + 1).padStart(2, '0')}`;

const soorten = [
  {
    waarde: 'expositie',
    titel: 'Exposities',
    tekst: 'Een expositie verdient een ruimte die inspireert. Al sinds 1978 biedt ons sfeervolle kerkje kunstenaars een bijzondere plek om hun werk te presenteren. Het zachte daglicht, de witte wanden en de rust van het monumentale interieur creëren een tijdloze ambiance waarin bezoekers én kunst optimaal tot hun recht komen.',
    accent: true,
  },
  {
    waarde: 'bruiloft',
    titel: 'Bruiloften',
    tekst: 'Trouwen in een monument vol historie. Geef elkaar het jawoord in een sfeervol kerkje uit 1350, waar het daglicht door negen gotische ramen een onvergetelijk decor creëert.',
  },
  {
    waarde: 'concert',
    titel: 'Concerten',
    tekst: 'Een podium met een uitzonderlijke akoestiek. De eeuwenoude kerk, met het historische Lindsenorgel uit 1861, biedt een intieme concertlocatie waar muziek optimaal tot haar recht komt.',
  },
  {
    waarde: 'diverse',
    titel: 'Diverse bijeenkomsten',
    tekst: 'Een bijzondere plek voor bijzondere momenten. Van herdenkingen en jubilea tot persoonlijke ceremonies: een monumentale locatie die ruimte biedt aan momenten die ertoe doen.',
  },
];

/*
  Tarieven aangeleverd door Nelleke (contractbeheer), augustus 2026 — vervangen de
  eerder van Hans overgenomen bedragen, die niet overeenkwamen met de officiële
  voorwaarden. Twee tijdvakken: "nu" geldt voor huidige boekingen, "vanaf 2029" is
  een reeds vastgelegde toekomstige verhoging.

  Concert-tarief (€300) staat nog LOS van Nelleke's drie categorieën — dat type komt
  niet voor in de officiële voorwaarden/huisregels, en moet nog apart bevestigd
  worden door het bestuur. Zie 24_DECISION_LOG-achtige notitie: niet zomaar verwijderd,
  wel gemarkeerd als onbevestigd.
*/
const tarieven = [
  { titel: 'Expositie', nu: '€ 490', vanaf2029: '€ 525' },
  { titel: 'Bruiloft', nu: '€ 550', vanaf2029: '€ 590' },
  { titel: 'Concert', nu: 'Op aanvraag', vanaf2029: 'Op aanvraag' },
  { titel: 'Diverse bijeenkomsten', nu: 'vanaf € 250', vanaf2029: 'vanaf € 275' },
];
---

<Base
  title="Verhuur"
 description="Het kerkje van Persingen huren voor een expositie, bruiloft, concert of bijeenkomst."
>
  <PageHeader
    eyebrow="Verhuur"
    title="Een gebouw dat al af is"
    intro="De meeste zalen moet je aankleden voordat er iets van te maken valt. Hier hoeft dat niet. Je voelt hier acht eeuwen geschiedenis, een sober wit interieur en zonlicht dat door negen gotische ramen valt."
    mark="boog"
  />

  <div class="wrap">
    <div class="beeld frame frame--wide">
      <img src="/foto/verhuur-ruimte.jpg" alt="Het kerkje van Persingen in de Ooijpolder, met koeien in de wei" width="1200" height="675" />
    </div>

    <section class="section-tight">
      <h2>Geschikt voor</h2>
      <p class="klein">Klik op een mogelijkheid om die vast te kiezen in het aanvraagformulier.</p>
      <ul class="soorten">
        {soorten.map((s) => (
          <li class={s.accent ? 'soort-accent' : ''}>
            <a href={`/verhuur/aanvragen/?soort=${s.waarde}`} class="soort-link">
              <h3>{s.titel}</h3>
              <p>{s.tekst}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="tarieven">
      <div>
        <h2>Tarieven</h2>
     <table class="tarieven-tabel">
          <thead>
            <tr>
              <th scope="col">Type</th>
              <th scope="col">Nu</th>
              <th scope="col">Vanaf 2029</th>
            </tr>
          </thead>
          <tbody>
            {tarieven.map((t) => (
              <tr>
                <td>{t.titel}</td>
                <td class="prijs-cel">{t.nu}</td>
                <td class="prijs-cel">{t.vanaf2029}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="toelichting">
          Bekijk ook de <a href="/verhuur/voorwaarden/">verhuurvoorwaarden</a> voor de
          precieze regels per type. Vraag vrijblijvend aan, dan nemen we contact met je op.
        </p>
        <Button href="/verhuur/aanvragen/" variant="primary">Vraag de ruimte aan</Button>
      </div>
    </section>

    <section class="section-tight" id="kalender">
      <h2>Beschikbaarheid</h2>
      <p>
        Grijs is bezet. Klik op een vrije dag om die datum meteen aan te vragen.
        Reserveringen worden pas definitief na bevestiging door het bestuur.
      </p>
      <div class="kalender-met-lijst">
        <Kalender bezet={bezet} maand={maand} basisPad="/verhuur/" />
        <VrijeWeekenden />
      </div>
    </section>
  </div>
</Base>

<style>
  .beeld { margin-bottom: var(--s-16); }
  .klein { font-size: var(--t-sm); color: var(--ink-mute); margin-top: calc(var(--s-2) * -1); margin-bottom: var(--s-6); }

  .soorten {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
  }
  .soort-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius);
    padding: var(--s-4);
    transition: background-color 0.12s var(--ease);
  }
  .soort-link:hover { background: var(--cream-deep); }
  .soort-link:hover h3 { color: var(--brick); }
  .soorten h3 { margin-bottom: var(--s-2); font-size: var(--t-base); }
  .soorten p { margin: 0; color: var(--ink-soft); font-size: var(--t-sm); line-height: 1.45; }
  .soort-accent { grid-column: 1 / -1; }
  .soort-accent h3 { color: var(--brick); font-size: var(--t-lg); }
  .soort-accent p { font-size: var(--t-base); }

  .tarieven { background: var(--cream-deep); border: var(--border); border-radius: var(--radius-lg); padding: var(--s-12); margin-block: var(--s-8); }
  .tarieven h2 { margin-top: 0; margin-bottom: var(--s-6); }

  .tarieven-tabel {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--s-6);
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tarieven-tabel th {
    text-align: left;
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--border);
  }
  .tarieven-tabel td {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--sand);
  }
  .tarieven-tabel tr:last-child td { border-bottom: none; }
  .prijs-cel { font-weight: 600; color: var(--pine); white-space: nowrap; }
  .klein-cel { font-size: var(--t-sm); color: var(--ink-mute); }

  .kalender-met-lijst {
    display: grid;
    grid-template-columns: auto 260px;
    gap: var(--s-8);
    align-items: start;
  }

  @media (max-width: 720px) {
    .soorten { grid-template-columns: 1fr; }
    .tarieven { padding: var(--s-8); }
    .tarieven-tabel { font-size: var(--t-sm); }
  }
  @media (max-width: 860px) {
    .kalender-met-lijst { grid-template-columns: 1fr; }
  }
</style>
