---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { laadBeheerSnapshot, beheerSnapshotOpties } from '../../../platform/beheer-bron.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const live = snapshot.bron === 'sanity';
const supabase = snapshot.bron === 'supabase';
const vastgelegd = snapshot.boekingen.filter((boeking) => boeking.status === 'migratie_vastgelegd').length;
const migratie = snapshot.migratie;
const steekproefBoekingen = (migratie?.boekingen ?? snapshot.boekingen).slice(0, 8);
const steekproefAanvragen = (migratie?.aanvragen ?? snapshot.aanvragen).slice(0, 5);
const fouten = migratie?.issues.filter((i) => i.ernst === 'fout') ?? [];
const letops = migratie?.issues.filter((i) => i.ernst === 'letop') ?? [];
---

<Beheer titel="Migratie">
  <header class="bh-top">
    <div>
      <p class="bh-label">Voorbereiding</p>
      <h1>Migratie Sanity → beheer</h1>
      <p class="bh-hint">
        Dit scherm schrijft niets en start geen import. Geïmporteerde boekingen met status migratie_vastgelegd blijven beschermd.
      </p>
    </div>
  </header>

  {
    supabase && (
      <section class="bh-kaart">
        <h2>Data staat in Supabase</h2>
        <p class="bh-muted">
          {snapshot.boekingen.length} boekingen, waarvan {vastgelegd} met status migratie_vastgelegd.
          Dit is geen voorbeeldset. Er wordt vanaf dit scherm niets geschreven.
        </p>
      </section>
    )
  }
  {
    snapshot.bron === 'demo' && (
      <section class="bh-kaart">
        <h2>Voorbeelddata</h2>
        <p class="bh-muted">Deze weergave is bewust voorbeelddata via ?bron=demo. Het is niet de geïmporteerde set.</p>
      </section>
    )
  }

  {
    live && migratie && (
      <>
        <section class="bh-kaart">
          <h2>Controlelijst (FO §74)</h2>
          <p class="bh-muted">
            Vandaag {ymdInAmsterdam(new Date())}. Bezette dagen: huidige regel {migratie.bezetteDagenHuidig},
            nieuwe regel {migratie.bezetteDagenNieuw}.
          </p>
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Controle</th>
                <th>Sanity</th>
                <th>Nieuw</th>
                <th>Toelichting</th>
              </tr>
            </thead>
            <tbody>
              {migratie.controles.map((rij) => (
                <tr>
                  <td>{rij.label}</td>
                  <td>{rij.sanity}</td>
                  <td>
                    <span class={rij.sanity === rij.nieuw ? 'bh-badge bh-badge--goedgekeurd' : 'bh-badge bh-badge--optie'}>
                      {rij.nieuw}
                    </span>
                  </td>
                  <td>{rij.toelichting ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="bh-kaart">
          <h2>Aandachtspunten bij mapping</h2>
          {
            fouten.length + letops.length === 0 ? (
              <p class="bh-leeg">Geen opvallende gaten in de mapping.</p>
            ) : (
              <ul class="bh-issues">
                {fouten.map((issue) => (
                  <li>
                    <span class="bh-badge bh-badge--afgewezen">Fout</span>
                    {issue.titel}: {issue.detail}
                  </li>
                ))}
                {letops.slice(0, 40).map((issue) => (
                  <li>
                    <span class="bh-badge bh-badge--optie">Let op</span>
                    {issue.titel}: {issue.detail}
                  </li>
                ))}
              </ul>
            )
          }
          {letops.length > 40 && <p class="bh-muted">Nog {letops.length - 40} waarschuwingen niet getoond.</p>}
        </section>

        <section class="bh-kaart">
          <h2>Steekproef boekingen</h2>
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Nummer</th>
                <th>Titel</th>
                <th>Huurder</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {steekproefBoekingen.map((b) => (
                <tr>
                  <td>
                    <a href={`/beheer/boekingen/${encodeURIComponent(b.id)}/`}>{b.nummer}</a>
                  </td>
                  <td>{b.interneTitel}</td>
                  <td>{b.huurder}</td>
                  <td>{b.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="bh-kaart">
          <h2>Steekproef aanvragen</h2>
          {
            steekproefAanvragen.length === 0 ? (
              <p class="bh-leeg">Geen aanvragen in Sanity.</p>
            ) : (
              <table class="bh-tabel">
                <thead>
                  <tr>
                    <th>Naam</th>
                    <th>Soort</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {steekproefAanvragen.map((a) => (
                    <tr>
                      <td>
                        <a href={`/beheer/aanvragen/${encodeURIComponent(a.id)}/`}>{a.naam}</a>
                      </td>
                      <td>{a.soort}</td>
                      <td>{a.status}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </section>
      </>
    )
  }

  <section class="bh-kaart">
    <h2>Volgorde (ongewijzigd)</h2>
    <ol class="bh-stappen">
      <li>Nieuwe database (Supabase-project — kostbevestiging)</li>
      <li>Beheeromgeving achter vlag — dit scherm</li>
      <li>Sanity-import met legacy_source + legacy_id</li>
      <li>Controle: aantallen + steekproef</li>
      <li>Website leest nieuwe backend — nog niet</li>
      <li>Formulieren schrijven naar nieuwe backend — nog niet</li>
      <li>Nieuwsbrief overzetten — nog niet</li>
      <li>Parallelcontrole, daarna Sanity read-only en uit</li>
    </ol>
    <p class="bh-muted">
      Dry-run lokaal: <code>npm run migratie:dry-run</code>. Snapshot: <code>npm run sanity:snapshot</code>.
    </p>
  </section>
</Beheer>
