---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { BOEKING_LABEL, demoNaActie, formatNl } from '../../../platform/demo-data';
import { laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { actorVanSessie, postAlsSupabase } from '../../../lib/operatie/runtime.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { INITIELE_TARIEVEN } from '../../../platform/finance.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';

if (Astro.request.method === 'POST') {
  const operationeel = await postAlsSupabase({
    request: Astro.request,
    url: Astro.url,
    env: omgevingsRecord(),
    actor: actorVanSessie(Astro.locals.beheer),
    sessie: sessieSupabaseUitAstro(Astro),
  });
  if (operationeel) return operationeel;
  return Astro.redirect(demoNaActie(Astro.url));
}

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const flash = Astro.url.searchParams.get('demo') === '1';
const vanaf = ymdInAmsterdam(new Date());
const tarieven =
  snapshot.bron === 'supabase'
    ? (snapshot.tarieven ?? []).map((t) => ({
        verhuurtype: t.verhuurtype,
        prijstype: t.prijstype,
        bedrag: t.bedrag,
        geldigVanaf: t.geldigVanaf,
        geldigTot: t.geldigTot,
        toelichting: t.toelichting,
      }))
    : INITIELE_TARIEVEN.filter((t) => !t.geldigTot || t.geldigTot >= vanaf).map((t) => ({
        ...t,
        toelichting: '',
      }));
---

<Beheer titel="Finance">
  <header class="bh-top">
    <div>
      <h1>Finance</h1>
      <p class="bh-hint">
        Informatief. Aanbetaling stuurt geen status, planning of publicatie. Geen bankkoppeling en geen herinnering.
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}

  <section class="bh-kaart">
    <h2>Aanbetalingen</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Boeking</th>
          <th>Huurder</th>
          <th>Tarief</th>
          <th>Aanbetaling</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          snapshot.boekingen.map((b) => (
            <tr>
              <td>
                <a href={`/beheer/boekingen/${encodeURIComponent(b.id)}/`}>{b.nummer}</a>
              </td>
              <td>{b.huurder}</td>
              <td>{b.tarief}</td>
              <td>
                {b.aanbetalingBinnen ? 'vlag: ja' : 'vlag: nee, niet leidend'}
              </td>
              <td>
                <span class={`bh-badge bh-badge--${b.status}`}>{BOEKING_LABEL[b.status]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="bh-muted">
      {(snapshot.betalingen ?? []).length} betaalregels blijven bewaard. De vlag aanbetaling_ontvangen is niet beslissend en levert geen openstaande actie. Registreren als “binnen” is nog niet beschikbaar.
    </p>
  </section>

  <section class="bh-kaart">
    <h2>{snapshot.bron === 'supabase' ? 'Tarieven uit Supabase' : 'Tarieven (huidige regels)'}</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Type</th>
          <th>Prijs</th>
          <th>Geldig vanaf</th>
          <th>Geldig tot</th>
        </tr>
      </thead>
      <tbody>
        {
          tarieven.map((t) => (
            <tr>
              <td>{t.verhuurtype}</td>
              <td>
                {t.prijstype === 'op_aanvraag'
                  ? 'Op aanvraag'
                  : t.prijstype === 'vanaf'
                    ? `Vanaf € ${t.bedrag}`
                    : `€ ${t.bedrag}`}
                {t.toelichting ? ` · ${t.toelichting}` : ''}
              </td>
              <td>{formatNl(t.geldigVanaf)}</td>
              <td>{t.geldigTot ? formatNl(t.geldigTot) : '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Beheer>
