---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { laadBeheerSnapshot } from '../../../platform/beheer-bron.ts';

const snapshot = await laadBeheerSnapshot({ url: Astro.url });
---

<Beheer titel="Relaties">
  <header class="bh-top">
    <div>
      <p class="bh-label">Relaties</p>
      <h1>Relaties</h1>
      <p class="bh-hint">
        Huurders en exposanten. Gastheren voor diensten staan onder
        <a href="/beheer/instellingen/gastheren/">Instellingen → Gastheren</a>.
      </p>
    </div>
  </header>

  <table class="bh-tabel">
    <thead>
      <tr>
        <th>Naam</th>
        <th>E-mail</th>
        <th>Rollen</th>
        <th>Reservelijst</th>
      </tr>
    </thead>
    <tbody>
      {
        snapshot.relaties.length === 0 ? (
          <tr>
            <td colspan="4" class="bh-leeg">Geen relaties.</td>
          </tr>
        ) : (
          snapshot.relaties.map((r) => (
            <tr>
              <td>
                <a class="bh-detail-link" href={`/beheer/relaties/${encodeURIComponent(r.id)}/`}>{r.naam}</a>
              </td>
              <td>{r.email}</td>
              <td>{r.rollen.join(', ')}</td>
              <td>{r.reservelijst ? 'Ja' : 'Nee'}</td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>
</Beheer>
