---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { DEMO_RELATIES } from '../../../platform/demo-data';
---

<Beheer titel="Relaties">
  <header class="bh-top">
    <div>
      <h1>Relaties</h1>
      <p class="bh-hint">Huurders, exposanten, gastheren. Los van de vriendenlijst van de website.</p>
    </div>
  </header>

  <table class="bh-tabel">
    <thead>
      <tr>
        <th>Naam</th>
        <th>E-mail</th>
        <th>Rollen</th>
        <th>Reservelijst</th>
      </tr>
    </thead>
    <tbody>
      {
        DEMO_RELATIES.map((r) => (
          <tr>
            <td>
              <a href={`/beheer/relaties/${r.id}/`}>{r.naam}</a>
            </td>
            <td>{r.email}</td>
            <td>{r.rollen.join(', ')}</td>
            <td>{r.reservelijst ? 'Ja' : 'Nee'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Beheer>
