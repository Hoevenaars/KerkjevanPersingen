---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { leesPeriode } from '../../../analytics/periode.ts';
import type { DeviceType, WebsiteTrafficStats } from '../../../analytics/types.ts';
import { getWebsiteTrafficStats } from '../../../platform/analytics-opslag.ts';
import { kerkjeAnalytics } from '../../../platform/analytics-config.ts';

const nu = new Date();
const periode = leesPeriode(Astro.url.searchParams.get('periode'), nu, kerkjeAnalytics.timeZone);
const meer = Astro.url.searchParams.get('meer') === '1';
const resultaat = await getWebsiteTrafficStats(periode);

const MAANDEN = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
const MAANDEN_LANG = [
  'januari',
  'februari',
  'maart',
  'april',
  'mei',
  'juni',
  'juli',
  'augustus',
  'september',
  'oktober',
  'november',
  'december',
];

const APPARAAT: Record<DeviceType, string> = {
  desktop: 'Desktop',
  mobile: 'Mobiel',
  tablet: 'Tablet',
  unknown: 'Onbekend',
};

function kort(ymd: string): string {
  const delen = ymd.split('-');
  return `${Number(delen[2])} ${MAANDEN[Number(delen[1]) - 1] ?? ''}`;
}

function lang(ymd: string): string {
  const delen = ymd.split('-');
  return `${Number(delen[2])} ${MAANDEN_LANG[Number(delen[1]) - 1] ?? ''} ${delen[0]}`;
}

function aandeelTekst(waarde: number): string {
  if (!Number.isFinite(waarde) || waarde <= 0) return '0%';
  return `${new Intl.NumberFormat('nl-NL', { maximumFractionDigits: 1 }).format(waarde)}%`;
}

function periodeHref(dagen: 7 | 30 | 90): string {
  const params = new URLSearchParams();
  params.set('periode', String(dagen));
  if (meer) params.set('meer', '1');
  return `/beheer/analytics/?${params.toString()}`;
}

const stats: WebsiteTrafficStats | null = resultaat.ok ? resultaat.stats : null;
const leeg = Boolean(stats && stats.totalen.pageviews === 0);
const paginas = stats ? (meer ? stats.paginas : stats.paginas.slice(0, 10)) : [];
const maxDag = stats ? Math.max(1, ...stats.dagelijks.map((dag) => dag.pageviews)) : 1;
const verwijzers = stats ? stats.verwijzers.slice(0, 10) : [];
const overigeVerwijzers = stats ? stats.verwijzers.slice(10).reduce((som, rij) => som + rij.pageviews, 0) : 0;
const toonLabels = periode.dagen === 7;
---

<Beheer titel="Analytics">
  <header class="bh-top">
    <div>
      <p class="bh-label">Website</p>
      <h1>Analytics</h1>
      <p class="bh-hint">
        Pageviews van de publieke site, van {lang(periode.van)} t/m {lang(periode.tot)}. Geen
        bezoekersprofiel en geen koppeling met aanvragen of relaties.
      </p>
    </div>
  </header>

  <nav class="bh-tabs" aria-label="Periode">
    <a href={periodeHref(7)} aria-current={periode.dagen === 7 ? 'page' : undefined}>7 dagen</a>
    <a href={periodeHref(30)} aria-current={periode.dagen === 30 ? 'page' : undefined}>30 dagen</a>
    <a href={periodeHref(90)} aria-current={periode.dagen === 90 ? 'page' : undefined}>90 dagen</a>
  </nav>

  {
    !resultaat.ok && resultaat.reden === 'niet-gekoppeld' && (
      <p class="bh-leeg">
        Supabase is nog niet gekoppeld. Paginaweergaven worden bewaard zodra de beheerdatabase
        bereikbaar is. De publieke website blijft gewoon werken.
      </p>
    )
  }
  {
    !resultaat.ok && resultaat.reden === 'mislukt' && (
      <p class="bh-leeg">De statistieken konden niet worden geladen. De publieke website blijft gewoon werken.</p>
    )
  }
  {
    leeg && (
      <p class="bh-leeg">Er is voor deze periode nog geen websiteverkeer geregistreerd.</p>
    )
  }

  {
    stats && !leeg && (
      <>
        {resultaat.ok && resultaat.afgekapt && (
          <p class="bh-hint">Deze periode bevat heel veel pageviews. Het overzicht toont de oudste 50.000.</p>
        )}
        <ul class="bh-analytics-kpi">
          <li>
            <strong>{new Intl.NumberFormat('nl-NL').format(stats.totalen.pageviews)}</strong>
            <span>Pageviews</span>
          </li>
          <li>
            <strong>{new Intl.NumberFormat('nl-NL', { maximumFractionDigits: 1 }).format(stats.totalen.gemiddeldPerDag)}</strong>
            <span>Gemiddeld per dag</span>
          </li>
        </ul>

        <section class="bh-kaart">
          <h2>Verkeer door de tijd</h2>
          <div class="bh-reeks" role="list" aria-label="Pageviews per dag">
            {stats.dagelijks.map((dag) => {
              const hoogte = dag.pageviews === 0 ? 0 : Math.max(6, (dag.pageviews / maxDag) * 100);
              return (
                <div class="bh-reeks-dag" role="listitem" title={`${lang(dag.datum)}: ${dag.pageviews} pageviews`}>
                  <span class="bh-reeks-track">
                    <span class="bh-reeks-staaf" style={`height: ${hoogte}%`}></span>
                  </span>
                  {toonLabels && <span class="bh-reeks-label">{kort(dag.datum)}</span>}
                </div>
              );
            })}
          </div>
          {!toonLabels && (
            <p class="bh-muted">
              {kort(periode.van)} t/m {kort(periode.tot)}. Elke staaf is één dag.
            </p>
          )}
        </section>

        <section class="bh-kaart">
          <h2>Populaire pagina's</h2>
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Pagina</th>
                <th>Pageviews</th>
                <th>% van totaal</th>
              </tr>
            </thead>
            <tbody>
              {paginas.map((pagina) => (
                <tr>
                  <td>
                    {pagina.label}
                    <span class="bh-muted"> {pagina.meerderePaden ? 'meerdere paden' : pagina.path}</span>
                  </td>
                  <td>{pagina.pageviews}</td>
                  <td>{aandeelTekst(pagina.aandeel)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {stats.paginas.length > 10 && !meer && (
            <p>
              <a href={`/beheer/analytics/?periode=${periode.dagen}&meer=1`}>Alle pagina's</a>
            </p>
          )}
        </section>

        <div class="bh-split">
          <section class="bh-kaart">
            <h2>Taal</h2>
            <ul class="bh-verdeling">
              {stats.locales.map((locale) => (
                <li>
                  <span>{locale.label}</span>
                  <span class="bh-verdeling-balk" aria-hidden="true">
                    <span style={`width: ${Math.min(100, locale.aandeel)}%`}></span>
                  </span>
                  <span>
                    {locale.pageviews} · {aandeelTekst(locale.aandeel)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
          <section class="bh-kaart">
            <h2>Apparaat</h2>
            <ul class="bh-verdeling">
              {stats.apparaten.map((apparaat) => (
                <li>
                  <span>{APPARAAT[apparaat.deviceType]}</span>
                  <span class="bh-verdeling-balk" aria-hidden="true">
                    <span style={`width: ${Math.min(100, apparaat.aandeel)}%`}></span>
                  </span>
                  <span>
                    {apparaat.pageviews} · {aandeelTekst(apparaat.aandeel)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        </div>

        <section class="bh-kaart">
          <h2>Verwijzers</h2>
          <p class="bh-hint">Direct is verkeer zonder externe verwijzende website. Alleen het domein wordt bewaard.</p>
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Bron</th>
                <th>Pageviews</th>
                <th>% van totaal</th>
              </tr>
            </thead>
            <tbody>
              {verwijzers.map((rij) => (
                <tr>
                  <td>{rij.label}</td>
                  <td>{rij.pageviews}</td>
                  <td>{aandeelTekst(rij.aandeel)}</td>
                </tr>
              ))}
              {overigeVerwijzers > 0 && (
                <tr>
                  <td>Overige websites</td>
                  <td>{overigeVerwijzers}</td>
                  <td>{aandeelTekst((overigeVerwijzers / stats.totalen.pageviews) * 100)}</td>
                </tr>
              )}
            </tbody>
          </table>
        </section>
      </>
    )
  }
</Beheer>
