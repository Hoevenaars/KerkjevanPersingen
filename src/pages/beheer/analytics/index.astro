---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import AnalyticsOverzicht from '../../../components/beheer/AnalyticsOverzicht.astro';
import { periodeErvoor } from '../../../analytics/periode.ts';
import { getWebsiteVerkeer } from '../../../platform/analytics-opslag.ts';
import { kerkjeAnalytics } from '../../../platform/analytics-config.ts';
import { leesAnalyticsScherm } from '../../../platform/analytics-scherm.ts';

const nu = new Date();
const scherm = leesAnalyticsScherm(Astro.url.searchParams, nu, kerkjeAnalytics.timeZone);
const resultaat = await getWebsiteVerkeer(
  scherm.periode,
  periodeErvoor(scherm.periode, kerkjeAnalytics.timeZone),
  scherm.selectie,
);
---

<Beheer titel="Analytics">
  <AnalyticsOverzicht scherm={scherm} resultaat={resultaat} />
</Beheer>
