---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { formatMaandNl, formatNl, maandRaster, verschuifMaand } from '../../../platform/demo-data';
import { interneStatusVoorDag, type BezettingsItem } from '../../../platform/kalender.ts';
import { laadBeheerSnapshot } from '../../../platform/beheer-bron.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';

const snapshot = await laadBeheerSnapshot({ url: Astro.url });
const fallback = snapshot.bron === 'demo' ? '2026-09' : ymdInAmsterdam(new Date()).slice(0, 7);
const maandParam = Astro.url.searchParams.get('maand') ?? fallback;
const maand = /^\d{4}-\d{2}$/.test(maandParam) ? maandParam : fallback;
const vorige = verschuifMaand(maand, -1);
const volgende = verschuifMaand(maand, 1);
const cellen = maandRaster(maand);

const items: BezettingsItem[] = [
  ...snapshot.aanvragen.filter((a) => a.status === 'nieuw' || a.status === 'in_behandeling').map((a) => ({
    periode: { start: a.start, eind: a.eind },
    status: 'aanvraag' as const,
    blokkeertPubliek: false,
  })),
  ...snapshot.boekingen
    .filter((b) =>
      ['optie', 'optie_verlopen', 'definitief', 'migratie_vastgelegd', 'migratie_aanvraag'].includes(b.status),
    )
    .map((b) => ({
      periode: { start: b.start, eind: b.eind },
      status: b.status,
      blokkeertPubliek: b.status === 'definitief',
    })),
  ...snapshot.intern.map((i) => ({
    periode: { start: i.start, eind: i.eind },
    status: 'interne_blokkade' as const,
    blokkeertPubliek: i.blokkeert,
  })),
];

const STATUS_TEKST: Record<string, string> = {
  vrij: '',
  aanvraag: 'Aanvraag',
  optie: 'Optie',
  optie_verlopen: 'Optie verlopen',
  definitief: 'Definitief',
  interne_activiteit: 'Intern',
  afgerond: 'Afgerond',
};

function hrefVoorDag(ymd: string): string | null {
  const boeking = snapshot.boekingen.find((b) => b.start <= ymd && ymd <= b.eind);
  if (boeking) return `/beheer/boekingen/${encodeURIComponent(boeking.id)}/`;
  const aanvraag = snapshot.aanvragen.find((a) => a.start <= ymd && ymd <= a.eind);
  if (aanvraag) return `/beheer/aanvragen/${encodeURIComponent(aanvraag.id)}/`;
  const intern = snapshot.intern.find((i) => i.start <= ymd && ymd <= i.eind);
  if (intern) return `/beheer/agenda/${encodeURIComponent(intern.id)}/`;
  return null;
}
---

<Beheer titel="Kalender">
  <header class="bh-top">
    <div>
      <h1>Kalender</h1>
      <p class="bh-hint">
        Interne statussen (aanvraag, optie, definitief, intern). Dit is niet de publieke agenda —
        die toont alleen vrij of bezet.
      </p>
    </div>
    <p class="bh-hint">
      <a href={`/beheer/kalender/?maand=${vorige}`}>← {formatMaandNl(vorige)}</a>
      &nbsp;·&nbsp;
      <a href={`/beheer/kalender/?maand=${volgende}`}>{formatMaandNl(volgende)} →</a>
    </p>
  </header>

  <h2>{formatMaandNl(maand)}</h2>
  <p class="bh-legenda">
    <span>Aanvraag</span>
    <span>Optie</span>
    <span>Optie verlopen</span>
    <span>Definitief</span>
    <span>Intern</span>
  </p>

  <div class="bh-kalender" role="grid" aria-label={`Kalender ${formatMaandNl(maand)}`}>
    {['ma', 'di', 'wo', 'do', 'vr', 'za', 'zo'].map((dag) => (
      <div class="kop">{dag}</div>
    ))}
    {
      cellen.map((cel) => {
        if (!cel.ymd) return <div class="dag leeg" />;
        const status = interneStatusVoorDag(cel.ymd, items);
        const label = STATUS_TEKST[status];
        const href = label ? hrefVoorDag(cel.ymd) : null;
        return (
          <div class="dag">
            <span class="cijfer">{cel.dag}</span>
            {label && href ? (
              <a class={`stip ${status}`} href={href}>
                {label}
              </a>
            ) : label ? (
              <span class={`stip ${status}`}>{label}</span>
            ) : null}
            <span class="visually-hidden">{formatNl(cel.ymd)} {label || 'vrij'}</span>
          </div>
        );
      })
    }
  </div>
</Beheer>
