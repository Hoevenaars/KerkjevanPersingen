---
export const prerender = false;

import Beheer from '../../layouts/Beheer.astro';
import {
  DEMO_AANVRAGEN,
  DEMO_BOEKINGEN,
  DEMO_AGENDA,
  DEMO_INTERN,
  AANVRAAG_LABEL,
  BOEKING_LABEL,
  AGENDA_LABEL,
  SOORT_LABEL,
  DASHBOARD_HREF,
  demoDashboardBron,
  formatNl,
} from '../../platform/demo-data';
import { dashboardVoor } from '../../platform/dashboard.ts';

const rechten = { isSuperAdmin: true, perModule: {} };
const kaarten = dashboardVoor(rechten, demoDashboardBron());
const nieuwe = DEMO_AANVRAGEN.filter((a) => a.status === 'nieuw' || a.status === 'in_behandeling');
const opties = DEMO_BOEKINGEN.filter((b) => b.status === 'optie' || b.status === 'optie_verlopen');
---

<Beheer titel="Vandaag">
  <header class="bh-top">
    <div>
      <h1>Vandaag</h1>
      <p class="bh-hint">
        Aandachtspunten uit de voorbeelddata. Klik een kaart of een naam — niets raakt de live site.
      </p>
    </div>
  </header>

  <ul class="bh-kaarten">
    {
      kaarten.map((item) => (
        <li>
          <a href={DASHBOARD_HREF[item.sleutel] ?? '/beheer/'}>
            <strong>{item.aantal}</strong>
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="bh-kaart">
    <h2>Aanvragen die actie vragen</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Naam</th>
          <th>Soort</th>
          <th>Datum</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          nieuwe.map((a) => (
            <tr>
              <td>
                <a href={`/beheer/aanvragen/${a.id}/`}>{a.naam}</a>
              </td>
              <td>{SOORT_LABEL[a.soort] ?? a.soort}</td>
              <td>{formatNl(a.start)}</td>
              <td>
                <span class={`bh-badge bh-badge--${a.status}`}>{AANVRAAG_LABEL[a.status]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="bh-kaart">
    <h2>Opties</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Boeking</th>
          <th>Huurder</th>
          <th>Datum</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          opties.map((b) => (
            <tr>
              <td>
                <a href={`/beheer/boekingen/${b.id}/`}>{b.nummer}</a>
              </td>
              <td>{b.huurder}</td>
              <td>{formatNl(b.start)}</td>
              <td>
                <span class={`bh-badge bh-badge--${b.status}`}>{BOEKING_LABEL[b.status]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="bh-kaart">
    <h2>Agenda en intern</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Wat</th>
          <th>Datum</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          DEMO_AGENDA.map((p) => (
            <tr>
              <td>
                <a href={`/beheer/agenda/${p.id}/`}>{p.titel}</a>
              </td>
              <td>{formatNl(p.start)}</td>
              <td>
                <span class={`bh-badge bh-badge--${p.status}`}>{AGENDA_LABEL[p.status]}</span>
              </td>
            </tr>
          ))
        }
        {
          DEMO_INTERN.map((i) => (
            <tr>
              <td>
                <a href={`/beheer/agenda/${i.id}/`}>{i.titel}</a>
              </td>
              <td>{formatNl(i.start)}</td>
              <td>
                <span class="bh-badge">{i.blokkeert ? 'Blokkeert verhuur' : 'Intern'}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Beheer>
