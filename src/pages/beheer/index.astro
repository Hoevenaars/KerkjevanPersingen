---
export const prerender = false;

import Beheer from '../../layouts/Beheer.astro';
import Startscherm from '../../components/beheer/Startscherm.astro';
import { laadBeheerSnapshot, beheerSnapshotOpties } from '../../platform/beheer-bron.ts';
import { startscherm } from '../../platform/dashboard-start.ts';
import { ymdInAmsterdam } from '../../platform/datum.ts';
import { magZien } from '../../platform/rechten.ts';
import { verhuurOverzichtAan } from '../../platform/verhuur-vlag.ts';
import { dossierHref, metHerkomst } from '../../platform/beheer-hoofdnav.ts';
import { TIJDZONE } from '../../platform/types.ts';

function groetVoor(nu: Date): string {
  const uur = Number(new Intl.DateTimeFormat('nl-NL', {
    timeZone: TIJDZONE,
    hour: 'numeric',
    hourCycle: 'h23',
  }).format(nu));
  if (uur < 6) return 'Goedenacht,';
  if (uur < 12) return 'Goedemorgen,';
  if (uur < 18) return 'Goedemiddag,';
  return 'Goedenavond,';
}

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const vandaag = ymdInAmsterdam(new Date());
const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const zietAanvragen = magZien(rechten, 'aanvragen');
const zietBoekingen = magZien(rechten, 'boekingen');
const zietAgenda = magZien(rechten, 'agenda');
const zietPlanning = magZien(rechten, 'planning');
const agendaAan = verhuurOverzichtAan();

function planningQuery(start: string, extra: Record<string, string>): string {
  const params = new URLSearchParams(extra);
  if (start.length >= 7) {
    params.set('jaar', start.slice(0, 4));
    params.set('maand', String(Number(start.slice(5, 7))));
  }
  return `/beheer/planning/?${params.toString()}`;
}

const scherm = startscherm({
  vandaag,
  aanvragen: snapshot.aanvragen.map((item) => ({
    id: item.id,
    naam: item.naam,
    start: item.start,
    eind: item.eind,
    status: item.status,
    soort: item.soort,
    binnengekomen: item.binnengekomen,
    boekingId: item.boekingId,
  })),
  boekingen: snapshot.boekingen.map((item) => ({
    id: item.id,
    nummer: item.nummer,
    titel: item.interneTitel,
    huurder: item.huurder,
    start: item.start,
    eind: item.eind,
    status: item.status,
    soort: item.soort,
    gastheerId: item.gastheerId,
    optieEind: item.optieEind,
    aanvraagId: item.aanvraagId,
    aanbetalingBinnen: item.aanbetalingBinnen,
  })),
  activiteiten: snapshot.agenda.map((item) => ({
    id: item.id,
    boekingId: item.boekingId,
    titel: item.titel,
    start: item.start,
    eind: item.eind,
    soort: item.soort,
    contentstatus: item.contentstatus,
    inhoudStatus: item.inhoudStatus,
    levenscyclus: item.levenscyclus,
    trigger: item.trigger,
    tabel: item.tabel,
  })),
  intern: snapshot.intern,
  documenten: snapshot.documenten.map((item) => ({
    boekingId: item.boekingId,
    soort: item.soort,
    naam: item.naam,
  })),
  mails: snapshot.communicatie.map((item) => ({
    boekingId: item.boekingId,
    template: item.template,
    status: item.status,
  })),
  faseBetalingen: (snapshot.betalingen ?? []).map((item) => ({
    boekingId: item.boekingId,
    soort: item.soort,
    status: item.status,
  })),
  toewijzingen: (snapshot.toewijzingen ?? []).map((item) => ({
    boekingId: item.boekingId,
    relatieId: item.relatieId,
    relatieNaam: item.relatieNaam,
  })),
  gastheren: snapshot.gastheren.map((item) => ({ id: item.id, naam: item.naam })),
  ziet: {
    aanvragen: zietAanvragen,
    boekingen: zietBoekingen,
    agenda: zietAgenda,
    planning: zietPlanning,
    nieuwsbrief: magZien(rechten, 'nieuwsbrief'),
  },
  nieuwsbrieven: snapshot.nieuwsbrieven.map((item) => ({
    id: item.id,
    week: item.week,
    verstuurd: item.verstuurd,
    overgeslagen: item.overgeslagen,
    goedgekeurd: item.goedgekeurd === true,
  })),
  href: {
    nieuw: '/beheer/aanvragen/?fase=nieuw',
    behandeling: '/beheer/aanvragen/?fase=in_behandeling',
    nieuwsbrief: '/beheer/nieuwsbrief/',
    aanvraag: (id) => metHerkomst(`/beheer/aanvragen/${encodeURIComponent(id)}/`, 'overzicht'),
    boeking: (id) => metHerkomst(dossierHref(id, agendaAan), 'overzicht'),
    activiteit: (id) => metHerkomst(`/beheer/agenda/${encodeURIComponent(id)}/`, 'overzicht'),
    planning: (naam, start) => planningQuery(start, { q: naam }),
  },
});
const groet = groetVoor(new Date());
---

<Beheer titel="Dashboard">
  <Startscherm scherm={scherm} groet={groet} />
</Beheer>
