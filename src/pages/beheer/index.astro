---
export const prerender = false;

import Beheer from '../../layouts/Beheer.astro';
import {
  AANVRAAG_LABEL,
  BOEKING_LABEL,
  AGENDA_LABEL,
  SOORT_LABEL,
  dashboardHref,
  formatNl,
} from '../../platform/demo-data';
import { laadBeheerSnapshot, snapshotDashboard } from '../../platform/beheer-bron.ts';
import { dashboardVoor } from '../../platform/dashboard.ts';
import { ymdInAmsterdam } from '../../platform/datum.ts';
import { magZien } from '../../platform/rechten.ts';

const snapshot = await laadBeheerSnapshot({ url: Astro.url });
const vandaag = ymdInAmsterdam(new Date());
const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const kaarten = dashboardVoor(rechten, snapshotDashboard(snapshot, vandaag));
const zietAanvragen = magZien(rechten, 'aanvragen');
const zietBoekingen = magZien(rechten, 'boekingen');
const zietAgenda = magZien(rechten, 'agenda');
const nieuwe = snapshot.aanvragen.filter((a) => a.status === 'nieuw' || a.status === 'in_behandeling');
const opties = snapshot.boekingen.filter((b) => b.status === 'optie' || b.status === 'optie_verlopen');
const maand = vandaag.slice(0, 7);
const live = snapshot.bron === 'sanity';
const supabase = snapshot.bron === 'supabase';
---

<Beheer titel="Dashboard">
  <header class="bh-top">
    <div>
      <p class="bh-label">Dashboard</p>
      <h1>Dashboard</h1>
      <p class="bh-hint">
        {
          supabase
            ? 'Projectie van de Supabase-dossiers. Dezelfde staat als de keten, niet een aparte dashboardwaarheid.'
            : live
              ? 'Aandachtspunten uit Sanity. Klik een kaart of een naam — schrijven blijft in Studio.'
              : 'Aandachtspunten uit de voorbeelddata. Klik een kaart of een naam — niets raakt de live site.'
        }
      </p>
    </div>
  </header>

  <ul class="bh-kaarten">
    {
      kaarten.length === 0 ? (
        <li>
          <a href={zietAanvragen ? '/beheer/aanvragen/' : '/beheer/'}>
            <strong>0</strong>
            <span>Geen openstaande punten</span>
          </a>
        </li>
      ) : (
        kaarten.map((item) => (
          <li>
            <a href={dashboardHref(item.sleutel, maand)}>
              <strong>{item.aantal}</strong>
              <span>{item.label}</span>
            </a>
          </li>
        ))
      )
    }
  </ul>

  {
    zietAanvragen && (
  <section class="bh-kaart">
    <h2>Aanvragen die actie vragen</h2>
    {
      nieuwe.length === 0 ? (
        <p class="bh-leeg">Geen openstaande aanvragen.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Naam</th>
              <th>Soort</th>
              <th>Datum</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {nieuwe.map((a) => (
              <tr>
                <td>
                  <a class="bh-detail-link" href={`/beheer/aanvragen/${encodeURIComponent(a.id)}/`}>{a.naam}</a>
                </td>
                <td>{SOORT_LABEL[a.soort] ?? a.soort}</td>
                <td>{formatNl(a.start)}</td>
                <td>
                  <span class={`bh-badge bh-badge--${a.status}`}>{AANVRAAG_LABEL[a.status]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
    )
  }

  {
    zietBoekingen && (
  <section class="bh-kaart">
    <h2>Opties</h2>
    {
      opties.length === 0 ? (
        <p class="bh-leeg">Geen lopende opties.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Boeking</th>
              <th>Huurder</th>
              <th>Datum</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {opties.map((b) => (
              <tr>
                <td>
                  <a class="bh-detail-link" href={`/beheer/boekingen/${encodeURIComponent(b.id)}/`}>{b.nummer}</a>
                </td>
                <td>{b.huurder}</td>
                <td>{formatNl(b.start)}</td>
                <td>
                  <span class={`bh-badge bh-badge--${b.status}`}>{BOEKING_LABEL[b.status]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
    )
  }

  {
    zietAgenda && (
  <section class="bh-kaart">
    <h2>Agenda en intern</h2>
    {
      snapshot.agenda.length + snapshot.intern.length === 0 ? (
        <p class="bh-leeg">Geen agenda-items.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Wat</th>
              <th>Datum</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {snapshot.agenda.map((p) => (
              <tr>
                <td>
                  <a class="bh-detail-link" href={`/beheer/agenda/${encodeURIComponent(p.id)}/`}>{p.titel}</a>
                </td>
                <td>{formatNl(p.start)}</td>
                <td>
                  <span class={`bh-badge bh-badge--${p.status}`}>{AGENDA_LABEL[p.status]}</span>
                </td>
              </tr>
            ))}
            {snapshot.intern.map((i) => (
              <tr>
                <td>
                  <a class="bh-detail-link" href={`/beheer/agenda/${encodeURIComponent(i.id)}/`}>{i.titel}</a>
                </td>
                <td>{formatNl(i.start)}</td>
                <td>
                  <span class="bh-badge">{i.blokkeert ? 'Blokkeert verhuur' : 'Intern'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
    )
  }

  {
    supabase && snapshot.signalen && zietBoekingen && (
      <>
        <section class="bh-kaart">
          <h2>Actie nodig</h2>
          {snapshot.technisch ? (
            <p class="bh-flash">Technisch signaal: {snapshot.technisch} verzending wacht op actie na de retrylimiet.</p>
          ) : (
            <p class="bh-muted">Geen open technische verzendfout.</p>
          )}
          {snapshot.signalen.filter((item) => item.uitkomst === 'actie_vereist').length === 0 ? (
            <p class="bh-leeg">Geen dossier met open actie.</p>
          ) : (
            <ul>
              {snapshot.signalen
                .filter((item) => item.uitkomst === 'actie_vereist')
                .map((signaal) => (
                  <li>
                    <a href={`/beheer/boekingen/${encodeURIComponent(signaal.boekingId)}/`}>{signaal.titel}</a>
                    {signaal.issues[0]
                      ? ` — ${signaal.issues[0].oorzaak}. ${signaal.issues[0].eigenaar}. ${signaal.issues[0].actie}`
                      : ''}
                  </li>
                ))}
            </ul>
          )}
        </section>
        <section class="bh-kaart">
          <h2>Op schema</h2>
          {snapshot.signalen.filter((item) => item.uitkomst === 'gereed').length === 0 ? (
            <p class="bh-leeg">Nog geen dossier dat gereed is.</p>
          ) : (
            <ul>
              {snapshot.signalen
                .filter((item) => item.uitkomst === 'gereed')
                .map((signaal) => (
                  <li>
                    <a href={`/beheer/boekingen/${encodeURIComponent(signaal.boekingId)}/`}>{signaal.titel}</a>
                    {' '}
                    Gereed
                  </li>
                ))}
            </ul>
          )}
        </section>
        <section class="bh-kaart">
          <h2>Acties per eigenaar</h2>
          <p class="bh-muted">Afgeleid uit de readiness van dezelfde dossiers. Er is geen aparte takenlijst.</p>
          {snapshot.signalen.flatMap((item) => item.issues).length === 0 ? (
            <p class="bh-leeg">Geen open actie.</p>
          ) : (
            <ul>
              {snapshot.signalen.flatMap((signaal) =>
                signaal.issues.map((issue) => (
                  <li>
                    {issue.eigenaar}: {issue.actie}
                    {issue.deadline ? ` (deadline ${formatNl(issue.deadline)})` : ''}
                    {' — '}
                    <a href={`/beheer/boekingen/${encodeURIComponent(signaal.boekingId)}/`}>{signaal.titel}</a>
                  </li>
                )),
              )}
            </ul>
          )}
        </section>
      </>
    )
  }
</Beheer>
