---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import {
  BOEKING_LABEL,
  SOORT_LABEL,
  demoNaActie,
  formatNl,
  gastheerVan,
  labelVoorCommunicatie,
} from '../../../platform/demo-data';
import { beheerId, laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { herkomstUitQuery } from '../../../platform/beheer-hoofdnav.ts';
import { actorVanSessie, postAlsSupabase } from '../../../lib/operatie/runtime.ts';
import { laadCommunicatieVoorBoeking, laadMailtemplates } from '../../../platform/mailtemplates/store.ts';
import { laadMailtemplatesUitSupabase } from '../../../platform/mailtemplates/supabase-bron.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { statusActieToegestaan } from '../../../platform/status-overgang.ts';
import { behoudTerug, terugLink } from '../../../platform/planning.ts';
import { geplandeMailsVoorBoeking } from '../../../platform/mailtemplates/workflow.ts';
import type { MailCommunicatieRegel, MailCommunicatieStatus, MailTemplateDef } from '../../../platform/mailtemplates/types.ts';
import Mailconcept from '../../../components/beheer/Mailconcept.astro';
import ContractWizard from '../../../components/beheer/ContractWizard.astro';
import { verwerkMailconcept } from '../../../lib/mailconcept-actie.ts';
import { besluitVoor } from '../../../lib/automatisering-register.ts';
import { bewaarDefinitiefContract, leesContractWizardStand } from '../../../lib/operatie/contract-wizard-sessie.ts';
import {
  bouwOpvolging,
  flowActieUit,
  leesInstellingen,
  magContractBeheren,
  type ContractBron,
  type ContractVersie,
} from '../../../platform/documentenflow.ts';
import { leesDocumentenDossier, pasDocumentenflowToe } from '../../../lib/operatie/documentenflow-sessie.ts';
import { verstuurGecontroleerd } from '../../../lib/mail-transport.ts';
import { legVerzendingVast } from '../../../lib/communicatie-log.ts';
import { CONTRACTBEHEER_EMAIL, VAN_ADRES } from '../../../lib/mail-adressen.ts';
import ContractOpvolging from '../../../components/beheer/ContractOpvolging.astro';
import { ymdInAmsterdam } from '../../../platform/datum.ts';
import { contractPakketTekst } from '../../../platform/contract-pakket.ts';
import { pdfBytes } from '../../../platform/documenten/pdf.ts';
import { leesWizardVelden, wizardUitDossier, type ContractWizardVelden } from '../../../platform/contract-wizard.ts';
import { getTestMailRecipient } from '../../../lib/testmail-adres.ts';
import { lijstIntake } from '../../../lib/intake-opslag.ts';
import { gastherenVoorKoppeling } from '../../../platform/gastheer-lijst.ts';
import { labelGastheer } from '../../../platform/aanvraag-weergave.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const id = beheerId(Astro.params.id);
const boeking = snapshot.boekingen.find((b) => b.id === id);

const mailSessie = sessieSupabaseUitAstro(Astro);
let mailPreview: { onderwerp: string; text: string } | null = null;
let mailMelding = '';
let wizardPost: ContractWizardVelden | null = null;
let mailInhoudBehouden = '';
let mailTemplateBehouden = '';
let vroegeTemplates: MailTemplateDef[] = [];
if (mailSessie && boeking) vroegeTemplates = await laadMailtemplatesUitSupabase(mailSessie);

function boekingPad(extra: Record<string, string>): string {
  const params = new URLSearchParams();
  for (const sleutel of ['terug', 'van']) {
    const waarde = Astro.url.searchParams.get(sleutel);
    if (waarde) params.set(sleutel, waarde);
  }
  for (const [sleutel, waarde] of Object.entries(extra)) {
    if (waarde) params.set(sleutel, waarde);
  }
  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
}

if (Astro.request.method === 'POST') {
  const formulier = await Astro.request.formData();
  const actie = String(formulier.get('actie') ?? '');
  const tab = String(formulier.get('tab') ?? '');
  if (boeking && actie.startsWith('df_')) {
    const bestand = formulier.get('bestand');
    const bijlage = bestand instanceof File && bestand.size > 0
      ? { naam: bestand.name, bytes: new Uint8Array(await bestand.arrayBuffer()) }
      : null;
    const flowActie = flowActieUit(actie, formulier);
    const modus = (await besluitVoor('handmatige_template', undefined, omgevingsRecord())).modus;
    const uit = flowActie
      ? await pasDocumentenflowToe({
        client: mailSessie as never,
        env: omgevingsRecord(),
        actor: actorVanSessie(Astro.locals.beheer),
        boekingId: boeking.id,
        actie: flowActie,
        modus: modus === 'aan' || modus === 'test' ? modus : 'uit',
        testadres: await getTestMailRecipient().catch(() => null),
        bestand: bijlage,
        verstuur: async (mail) => {
          const verzonden = await verstuurGecontroleerd(
            {
              sleutel: 'handmatige_template',
              naar: mail.naar,
              onderwerp: mail.onderwerp,
              tekst: mail.tekst,
              richting: 'aanvrager',
              bijlagen: mail.bijlagen.flatMap((deel) => deel.bytes ? [{ bestandsnaam: deel.bestandsnaam, inhoud: deel.bytes }] : []),
              eisBijlagen: mail.soort === 'contract' || mail.soort === 'proef' || mail.soort === 'herhaling',
              idempotentieSleutel: mail.idempotentie,
            },
            {
              modus: mail.teltAlsVerzonden ? 'aan' : 'test',
              testadres: mail.teltAlsVerzonden ? null : mail.naar,
              env: omgevingsRecord(),
            },
          );
          const geaccepteerd = verzonden.providerAangeroepen && Boolean(verzonden.providerBerichtId);
          if (geaccepteerd) {
            await legVerzendingVast({
              aanvraagId: null,
              boekingId: mail.teltAlsVerzonden && (mail.soort === 'contract' || mail.soort === 'herhaling') ? boeking.id : null,
              templateSleutel: mail.soort === 'contract' || mail.soort === 'herhaling' ? 'huurovereenkomst' : mail.soort,
              onderwerp: mail.teltAlsVerzonden ? mail.onderwerp : `[TEST] ${mail.onderwerp}`,
              bedoeldeOntvanger: mail.bedoelde,
              werkelijkeOntvanger: verzonden.werkelijkeOntvanger || mail.naar,
              afzender: VAN_ADRES,
              replyTo: CONTRACTBEHEER_EMAIL,
              richting: 'uitgaand',
              status: 'verzonden',
              providerBerichtId: verzonden.providerBerichtId,
              test: !mail.teltAlsVerzonden,
              dedupSleutel: mail.idempotentie,
              handmatig: true,
            }, omgevingsRecord());
          }
          if (!geaccepteerd) {
            return {
              verzonden: false,
              berichtId: null,
              melding: verzonden.melding || 'De mailprovider heeft de mail niet geaccepteerd. Er is niets als verzonden genoteerd.',
            };
          }
          return {
            verzonden: true,
            berichtId: verzonden.providerBerichtId ?? null,
            melding: 'De mailprovider heeft de mail geaccepteerd. Aflevering is daarmee nog niet bevestigd.',
          };
        },
      })
      : { ok: false, melding: 'Deze actie hoort niet bij het contract.' };
    return Astro.redirect(boekingPad({ tab: 'documenten', [uit.ok ? 'melding' : 'fout']: uit.melding }));
  }
  if (boeking && actie === 'contract_definitief') {
    const velden = leesWizardVelden(formulier);
    if (!Astro.locals.beheer || Astro.locals.beheer.viewAs) {
      return Astro.redirect(boekingPad({
        tab: 'documenten',
        contract: String(formulier.get('nieuwe_versie') ?? '') === 'ja' ? 'nieuw' : 'genereren',
        fout: 'In deze weergave is niets gewijzigd.',
      }));
    }
    if (snapshot.bron !== 'supabase' || !mailSessie || !/^\d+$/.test(boeking.id)) {
      wizardPost = velden;
      mailMelding = 'Dit is de voorbeeldweergave. Het contract is niet opgeslagen en er is geen mail verstuurd.';
    } else {
      const uit = await bewaarDefinitiefContract(mailSessie as never, {
        boekingId: Number(boeking.id),
        aanvraagId: /^\d+$/.test(boeking.aanvraagId ?? '') ? Number(boeking.aanvraagId) : null,
        velden,
        actor: actorVanSessie(Astro.locals.beheer),
        vervang: String(formulier.get('nieuwe_versie') ?? '') === 'ja',
      });
      if (!uit.ok) {
        wizardPost = velden;
        mailMelding = uit.melding;
      } else {
        return Astro.redirect(boekingPad({ tab: 'documenten', melding: uit.melding }));
      }
    }
  } else if (boeking && (actie === 'mailpreview' || actie === 'mailconcept' || actie === 'mailverstuur')) {
    const contractmail = String(formulier.get('contract') ?? '') === '1';
    if (contractmail) {
      return Astro.redirect(boekingPad({
        tab: 'documenten',
        fout: 'Een contractmail zonder het PDF-contractpakket wordt niet verstuurd. Keur de versie goed en gebruik Verzenden.',
      }));
    }
    const template = contractmail
      ? null
      : vroegeTemplates.find((item) => item.id === String(formulier.get('templateId') ?? '')) ?? null;
    try {
      const uit = await verwerkMailconcept({
        actie,
        dossier: { soort: 'boeking', id: boeking.id, ontvanger: boeking.email, naam: boeking.huurder || boeking.interneTitel },
        template,
        logTemplateId: contractmail ? String(formulier.get('templateId') ?? '') || 'contract_begeleiding' : undefined,
        briefAlCompleet: contractmail,
        onderwerp: String(formulier.get('mailOnderwerp') ?? ''),
        inhoud: String(formulier.get('mailInhoud') ?? ''),
        actorNaam: Astro.locals.beheer?.gebruiker.naam ?? 'beheer',
        bewaar: async (regel) => {
          if (!mailSessie) return { error: 'geen sessie' };
          const antwoord = await (mailSessie as unknown as { from: (tabel: string) => { insert: (rij: Record<string, unknown>) => Promise<{ error: { message: string } | null }> } }).from('communicatie_jobs').insert(regel);
          return { error: antwoord.error?.message ?? null };
        },
      });
      if (actie !== 'mailpreview') {
        return Astro.redirect(boekingPad({
          tab: contractmail ? 'documenten' : (tab || 'communicatie'),
          [uit.ok ? 'melding' : 'fout']: uit.melding,
        }));
      }
      mailPreview = uit.preview && !('fout' in uit.preview) ? { onderwerp: uit.preview.onderwerp, text: uit.preview.text } : null;
      mailMelding = uit.melding;
      mailInhoudBehouden = String(formulier.get('mailInhoud') ?? '');
      mailTemplateBehouden = String(formulier.get('templateId') ?? '');
    } catch (error) {
      mailMelding = error instanceof Error ? error.message : 'Versturen mislukt.';
      mailInhoudBehouden = String(formulier.get('mailInhoud') ?? '');
      mailTemplateBehouden = String(formulier.get('templateId') ?? '');
    }
  } else {
    const operationeel = await postAlsSupabase({
      request: Astro.request,
      url: Astro.url,
      env: omgevingsRecord(),
      actor: actorVanSessie(Astro.locals.beheer),
      sessie: mailSessie,
      formulier,
    });
    if (operationeel) return operationeel;
    return Astro.redirect(demoNaActie(Astro.url));
  }
}

if (!boeking) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
}

if (Astro.url.searchParams.get('document') === 'contract') {
  const nietGevonden = new Response('Niet gevonden', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'X-Robots-Tag': 'noindex, nofollow' } });
  if (!mailSessie) return nietGevonden;
  const gelezen = await leesDocumentenDossier(mailSessie as never, boeking.id);
  if (!gelezen.ok) return new Response(gelezen.melding, { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
  const gevraagd = Number(Astro.url.searchParams.get('versie'));
  const versie = gelezen.lading.context.versies.find((item) => item.versie === gevraagd)
    ?? gelezen.lading.context.versies.reduce<ContractVersie | null>((best, item) => (!best || item.versie > best.versie ? item : best), null);
  if (!versie) return nietGevonden;
  const bytes = pdfBytes(contractPakketTekst({
    tekst: versie.tekst,
    voorwaardenTekst: versie.voorwaardenTekst,
    huisregelsTekst: versie.huisregelsTekst,
    plattegrondTekst: versie.plattegrondTekst,
    soort: boeking.soort,
  }));
  return new Response(Buffer.from(bytes), {
    headers: {
      'Content-Type': 'application/pdf',
      'Content-Disposition': `inline; filename="${versie.contractnummer}.pdf"`,
      'Cache-Control': 'private, no-store',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  });
}

const mailBesluit = await besluitVoor('handmatige_template', undefined, omgevingsRecord());
const mailmodusLabel = mailBesluit.modus === 'test' ? 'Test' : mailBesluit.modus === 'aan' ? 'Aan' : 'Uit';
const testadres = mailBesluit.modus === 'test' ? await getTestMailRecipient().catch(() => null) : null;
const intake = snapshot.bron === 'supabase' ? await lijstIntake(boeking.id).catch(() => []) : [];

const aanvraagBijBoeking = snapshot.aanvragen.find((item) => item.boekingId === boeking.id || item.id === boeking.aanvraagId);
const tab = Astro.url.searchParams.get('tab') ?? 'gegevens';
const relatie = snapshot.relaties.find((r) => r.id === boeking.relatieId);
const docs = snapshot.documenten.filter((d) => d.boekingId === boeking.id);
const demoMails = snapshot.communicatie.filter((c) => c.boekingId === boeking.id);
const opgeslagen = snapshot.bron === 'supabase' ? [] : await laadCommunicatieVoorBoeking(boeking.id);
const JOB_STATUSSEN = new Set<MailCommunicatieStatus>(['gepland', 'concept', 'wachtrij', 'verzonden', 'fout', 'geannuleerd']);
function jobAlsRegel(rij: { id: string; boekingId: string; template: string; ontvanger: string; status: string; wanneer: string }): MailCommunicatieRegel | null {
  if (!JOB_STATUSSEN.has(rij.status as MailCommunicatieStatus)) return null;
  return {
    id: rij.id,
    boekingId: rij.boekingId,
    templateId: rij.template,
    templateNaam: rij.template,
    ontvanger: rij.ontvanger,
    onderwerp: '',
    status: rij.status as MailCommunicatieStatus,
    geplandOp: rij.wanneer,
    automatisch: true,
    door: 'systeem',
    test: false,
  };
}
const templates =
  snapshot.bron === 'supabase'
    ? await (async () => {
        const client = sessieSupabaseUitAstro(Astro);
        return client ? laadMailtemplatesUitSupabase(client) : [];
      })()
    : await laadMailtemplates();
const jobRegels = snapshot.bron === 'supabase'
  ? demoMails.flatMap((rij) => {
      const regel = jobAlsRegel(rij);
      return regel ? [regel] : [];
    })
  : opgeslagen;
const verwacht = geplandeMailsVoorBoeking(boeking, templates, jobRegels).map((r) => ({
  id: r.id,
  template: r.templateNaam,
  ontvanger: r.ontvanger,
  wanneer: r.geplandOp ?? '',
  status: 'verwacht',
  automatisch: r.automatisch,
  door: r.door,
  onderwerp: r.onderwerp,
}));
const templateNaam = new Map(templates.map((tpl) => [tpl.id, tpl.naam]));
const jobs = (snapshot.bron === 'supabase'
  ? demoMails.map((r) => ({
      id: r.id,
      template: templateNaam.get(r.template) ?? r.template,
      ontvanger: r.ontvanger,
      wanneer: r.wanneer,
      status: r.status,
      automatisch: undefined as boolean | undefined,
      door: undefined as string | undefined,
      onderwerp: undefined as string | undefined,
    }))
  : [
      ...opgeslagen.map((r: MailCommunicatieRegel) => ({
        id: r.id,
        template: r.templateNaam,
        ontvanger: r.ontvanger,
        wanneer: r.verzondenOp ?? r.geplandOp ?? '',
        status: r.status,
        automatisch: r.automatisch as boolean | undefined,
        door: r.door as string | undefined,
        onderwerp: r.onderwerp,
      })),
      ...demoMails.map((r) => ({
        id: r.id,
        template: r.template,
        ontvanger: r.ontvanger,
        wanneer: r.wanneer,
        status: r.status,
        automatisch: undefined as boolean | undefined,
        door: undefined as string | undefined,
        onderwerp: undefined as string | undefined,
      })),
    ]
).sort((a, b) => (a.wanneer || '').localeCompare(b.wanneer || ''));
const gastheer = gastheerVan(boeking.gastheerId, snapshot.gastheren);
const actieveGastheren = gastherenVoorKoppeling(snapshot.gastheren, boeking.gastheerId);
const verleng = statusActieToegestaan(boeking.status, 'verleng');
const definitief = statusActieToegestaan(boeking.status, 'definitief');
const afronden = statusActieToegestaan(boeking.status, 'afronden');
const toonGastheer = boeking.soort === 'expositie' || Boolean(boeking.gastheerId);
const hostLabel = labelGastheer(boeking.soort);
const flash = Astro.url.searchParams.get('demo') === '1';
const melding = Astro.url.searchParams.get('melding');
const fout = Astro.url.searchParams.get('fout');
const basis = `/beheer/boekingen/${encodeURIComponent(boeking.id)}/`;
const terug = terugLink(Astro.url.searchParams.get('terug'));
const herkomst = herkomstUitQuery(Astro.url.searchParams.get('van'));
const terugWaarde = Astro.url.searchParams.get('terug');
const rechtenNu = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const kanContract = !aanvraagBijBoeking
  && !Astro.locals.beheer?.viewAs
  && magContractBeheren(rechtenNu);
let contractDefinitief = false;
let contractNummer = '';
let bewaardeWizard: Partial<ContractWizardVelden> | null = null;
if (kanContract && mailSessie && /^\d+$/.test(boeking.id)) {
  const stand = await leesContractWizardStand(mailSessie as never, Number(boeking.id));
  if (!('fout' in stand) && !('mist' in stand)) {
    contractDefinitief = stand.definitief;
    contractNummer = stand.nummer;
    bewaardeWizard = stand.velden;
  }
}
let instellingRijen: { sleutel: string; waarde: unknown }[] = [];
if (kanContract && mailSessie) {
  const gelezen = await (mailSessie as unknown as {
    from: (tabel: string) => { select: (kolommen: string) => Promise<{ data: { sleutel: string; waarde: unknown }[] | null }> };
  }).from('instellingen').select('sleutel,waarde');
  instellingRijen = gelezen.data ?? [];
}
const wizardVelden = wizardPost ?? wizardUitDossier({
  boekingId: boeking.id,
  soortLabel: SOORT_LABEL[boeking.soort] ?? boeking.soort,
  activiteit: boeking.interneTitel || boeking.huurder,
  naam: boeking.huurder,
  email: boeking.email,
  telefoon: relatie?.telefoon ?? '',
  adres: relatie?.adres ?? '',
  straat: '',
  huisnummer: '',
  toevoeging: '',
  postcode: '',
  woonplaats: '',
  periodeVan: boeking.start,
  periodeTot: boeking.eind,
  personen: '',
  huurprijs: boeking.tarief,
  aanbetaling: boeking.aanbetaling,
}, leesInstellingen(instellingRijen), bewaardeWizard);
const contractParam = Astro.url.searchParams.get('contract');
const wizardOpen = kanContract && (
  (!contractDefinitief && (wizardPost != null || contractParam === 'genereren' || contractParam === '1'))
  || (contractDefinitief && (wizardPost != null || contractParam === 'nieuw'))
);
const contractLink = `${basis}?tab=documenten&contract=genereren`;
const nieuweVersieLink = `${basis}?tab=documenten&contract=nieuw#contract-wizard`;
let opvolging = null;
let opvolgingBetaling = '';
if (kanContract && contractDefinitief && mailSessie && /^\d+$/.test(boeking.id)) {
  const gelezen = await leesDocumentenDossier(mailSessie as never, boeking.id);
  if (gelezen.ok) {
    const context = gelezen.lading.context;
    const bron: ContractBron = { ...context.bron, boekingStatus: boeking.status };
    opvolgingBetaling = context.betaling.toelichting;
    opvolging = bouwOpvolging({
      rechten: rechtenNu,
      bron,
      instellingen: context.instellingen,
      versies: context.versies,
      betaling: context.betaling,
      vandaag: ymdInAmsterdam(new Date()),
      bekijkHref: `${basis}?tab=documenten&document=contract&versie=${context.versies.reduce((hoogste, item) => Math.max(hoogste, item.versie), 0) || 1}`,
      fout: '',
      modus: mailBesluit.modus === 'aan' || mailBesluit.modus === 'test' ? mailBesluit.modus : 'uit',
    });
  }
}
function tabHref(tabNaam: string): string {
  const params = new URLSearchParams();
  if (tabNaam) params.set('tab', tabNaam);
  return behoudTerug(params.size ? `${basis}?${params}` : basis, terugWaarde);
}
---

<Beheer titel={boeking.interneTitel}>
  <p class="bh-crumb">{herkomst && <><a href={herkomst.href}>{herkomst.label}</a> / </>}<a href={terug?.href ?? '/beheer/boekingen/'}>{terug?.label ?? 'Boekingen'}</a> / {boeking.nummer}</p>
  <header class="bh-top">
    <div>
      <h1>{boeking.interneTitel}</h1>
      <p class="bh-hint">
        {boeking.nummer} · {SOORT_LABEL[boeking.soort] ?? boeking.soort} · {formatNl(boeking.start)}
        · <span class={`bh-badge bh-badge--${boeking.status}`}>{BOEKING_LABEL[boeking.status]}</span>
        {boeking.publiek ? '' : ' · privé (niet in publieke agenda)'}
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {melding && <p class="bh-flash">{melding}</p>}
  {mailMelding && <p class="bh-flash">{mailMelding}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  <nav class="bh-tabs" aria-label="Boekingonderdelen">
    <a href={tabHref('')} aria-current={tab === 'gegevens' ? 'page' : undefined}>Gegevens</a>
    <a href={tabHref('documenten')} aria-current={tab === 'documenten' ? 'page' : undefined}>Documenten</a>
    <a href={tabHref('communicatie')} aria-current={tab === 'communicatie' ? 'page' : undefined}>Communicatie</a>
  </nav>

  {
    tab === 'gegevens' && (
      <div class="bh-split">
        <section class="bh-kaart">
          <h2>Boeking</h2>
          <dl class="bh-dl">
            <dt>Huurder</dt>
            <dd>
              {relatie ? <a href={`/beheer/relaties/${encodeURIComponent(relatie.id)}/`}>{boeking.huurder}</a> : boeking.huurder}
            </dd>
            <dt>E-mail</dt>
            <dd>{boeking.email}</dd>
            <dt>Periode</dt>
            <dd>
              {formatNl(boeking.start)}
              {boeking.eind !== boeking.start ? ` – ${formatNl(boeking.eind)}` : ''}
            </dd>
            <dt>Tarief</dt>
            <dd>{boeking.tarief}</dd>
            <dt>Aanbetaling</dt>
            <dd>
              {boeking.aanbetalingBinnen ? 'vlag: ja' : 'vlag: nee'}. Niet leidend voor status, planning of publicatie.
            </dd>
            {boeking.optieEind && (
              <>
                <dt>Optie tot</dt>
                <dd>{formatNl(boeking.optieEind)}</dd>
              </>
            )}
            <dt>Notities</dt>
            <dd>{boeking.notities}</dd>
            <dt>Status</dt>
            <dd>{BOEKING_LABEL[boeking.status] ?? boeking.status}{boeking.periode ? ` · ${boeking.periode}` : ''}</dd>
            {(snapshot.toewijzingen ?? []).filter((item) => item.boekingId === boeking.id).length > 0 && (
              <>
                <dt>Gastbegeleiders</dt>
                <dd>
                  <ul>
                    {(snapshot.toewijzingen ?? [])
                      .filter((item) => item.boekingId === boeking.id)
                      .map((item) => (
                        <li>
                          {item.relatieNaam} · {item.type} · {item.datum ? formatNl(item.datum) : 'boekingsniveau'}
                        </li>
                      ))}
                  </ul>
                </dd>
              </>
            )}
            {(snapshot.betalingen ?? []).filter((item) => item.boekingId === boeking.id).length > 0 && (
              <>
                <dt>Betalingen</dt>
                <dd>
                  <ul>
                    {(snapshot.betalingen ?? [])
                      .filter((item) => item.boekingId === boeking.id)
                      .map((item) => (
                        <li>
                          {item.soort} · {item.bedrag.toFixed(2)} · {item.status}
                          {item.ontvangenOp ? ` · ontvangen ${formatNl(item.ontvangenOp)}` : ''}
                        </li>
                      ))}
                  </ul>
                </dd>
              </>
            )}
            {toonGastheer && (
              <>
                <dt>{hostLabel}</dt>
                <dd>
                  {gastheer ? `${gastheer.naam} · ${gastheer.telefoon}` : 'Nog niet ingepland'}
                </dd>
              </>
            )}
          </dl>
          {toonGastheer && !snapshot.alleenLezen && (
            <form method="post" class="bh-form">
              <label for="gastheer">{hostLabel}</label>
              <select id="gastheer" name="gastheerId">
                <option value="">Nog niet ingepland</option>
                {actieveGastheren.map((g) => (
                  <option value={g.id} selected={g.id === boeking.gastheerId}>
                    {g.actief ? g.naam : `${g.naam} (niet actief)`}
                  </option>
                ))}
              </select>
              <p class="bh-muted">
                Koppelen schrijft alleen de {hostLabel.toLowerCase()}. De 2-wekenmail is niet actief.
                Dezelfde koppeling staat ook onder <a href="/beheer/planning/">Gastbegeleiders</a>.
              </p>
              <div class="bh-acties">
                <button class="bh-btn" type="submit" name="actie" value="gastheer">
                  Koppel gastheer
                </button>
                <button class="bh-btn bh-btn--sec" type="button" disabled>
                  Concept 2-wekenmail — nog niet beschikbaar
                </button>
              </div>
            </form>
          )}
        </section>
        <section class="bh-kaart">
          <h2>{snapshot.alleenLezen ? 'Alleen lezen' : snapshot.bron === 'supabase' ? 'Dossieracties' : 'Acties (voorbeeld)'}</h2>
          <p class="bh-muted">
            {snapshot.alleenLezen
              ? 'Supabase-testmodus schrijft niets en verstuurt geen mail.'
              : snapshot.bron === 'supabase'
              ? 'Deze acties gebruiken je ingelogde sessie. Er gaat geen mail uit. Annuleren start geen annuleringsmail.'
              : 'Voorbeelddata. Het contract kun je wel doorlezen; er wordt niets verstuurd.'}
          </p>
          {!snapshot.alleenLezen && (
            <>
              <form method="post" class="bh-acties">
                {definitief.ok && definitief.melding !== 'al' && (
                  <>
                    <label for="reden">Reden bij definitief zetten</label>
                    <input id="reden" name="reden" type="text" />
                    <button class="bh-btn" type="submit" name="actie" value="definitief">
                      Zet definitief
                    </button>
                  </>
                )}
                {verleng.ok && (
                  <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="verleng">
                    Verleng optie
                  </button>
                )}
                {!verleng.ok && <p class="bh-muted">{verleng.melding}</p>}
                {!definitief.ok && <p class="bh-muted">{definitief.melding}</p>}
                <p class="bh-muted">Annuleren verstuurt geen mail. Die automation staat uit.</p>
              </form>
              {boeking.status !== 'geannuleerd' && (
                <form method="post" class="bh-form">
                  <label for="annuleer-reden">Reden annulering</label>
                  <textarea id="annuleer-reden" name="reden" rows="3" placeholder="Bijvoorbeeld: weg afgesloten"></textarea>
                  <p class="bh-muted">De gekoppelde activiteit verdwijnt uit de publieke agenda. Er gaat geen mail uit.</p>
                  <button class="bh-btn bh-btn--gevaar" type="submit" name="actie" value="annuleer">
                    Annuleer
                  </button>
                </form>
              )}
            </>
          )}
          {snapshot.bron === 'supabase' && !snapshot.alleenLezen && (
            <>
              <form method="post" class="bh-form">
                <label for="incident">Incident</label>
                <textarea id="incident" name="omschrijving" rows="3"></textarea>
                <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="incident">
                  Incident vastleggen
                </button>
              </form>
              {(snapshot.incidenten ?? [])
                .filter((item) => item.boekingId === boeking.id && item.status !== 'gesloten')
                .map((item) => (
                  <form method="post" class="bh-acties">
                    <p>{item.omschrijving}</p>
                    <input type="hidden" name="incidentId" value={item.id} />
                    <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="incident_sluiten">
                      Incident sluiten
                    </button>
                  </form>
                ))}
              {afronden.ok && afronden.melding !== 'al' && (
                <form method="post" class="bh-acties">
                  <button class="bh-btn" type="submit" name="actie" value="sluit">
                    Dossier afronden
                  </button>
                </form>
              )}
            </>
          )}
        </section>
      </div>
    )
  }

  {
    tab === 'documenten' && (
      <>
      <section class="bh-kaart">
        <h2>Documenten</h2>
        {
          aanvraagBijBoeking ? (
            <p>Het contract maak je bij de aanvraag. <a href={`/beheer/aanvragen/${encodeURIComponent(aanvraagBijBoeking.id)}/?contract=genereren`}>Contract genereren</a>. Een bestaande versie vervangt u onder <a href={`/beheer/aanvragen/${encodeURIComponent(aanvraagBijBoeking.id)}/#contract-opvolging`}>Contract en opvolging</a>. Verzenden gebeurt daar, met het PDF-pakket, na goedkeuring.</p>
          ) : contractDefinitief ? (
            <p>
              Contract {contractNummer} is opgeslagen. Goedkeuren en verzenden staan hieronder. De mail bevat het PDF-pakket.
              {!wizardOpen && <> <a href={nieuweVersieLink}>Nieuwe versie</a>.</>}
            </p>
          ) : (
            <p class="bh-muted">Vul het contract in de wizard. Opslaan verstuurt geen mail.</p>
          )
        }
        {docs.length === 0 ? (
          <p class="bh-leeg">Nog geen documenten bij deze boeking.</p>
        ) : (
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Bestand</th>
                <th>Soort</th>
                <th>Datum</th>
              </tr>
            </thead>
            <tbody>
              {docs.map((d) => (
                <tr>
                  <td>{d.naam}</td>
                  <td>{d.soort}</td>
                  <td>{formatNl(d.datum)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        {
          !aanvraagBijBoeking && kanContract && !contractDefinitief && !wizardOpen && (
            <p class="bh-acties"><a class="bh-btn" href={contractLink}>Contract genereren</a></p>
          )
        }
      </section>
      {
        wizardOpen && (
          <ContractWizard
            actie={`${basis}?tab=documenten`}
            velden={wizardVelden}
            adresHint={relatie?.adres ?? ''}
            vervangt={contractDefinitief}
          />
        )
      }
      {opvolging && (
        <ContractOpvolging
          opvolging={opvolging}
          actie={`${basis}?tab=documenten`}
          betalingToelichting={opvolgingBetaling}
          toonMaken={false}
          nieuweVersieHref={contractDefinitief && kanContract && !wizardOpen ? nieuweVersieLink : ''}
        />
      )}
      </>
    )
  }

  {
    tab === 'communicatie' && (
      <section class="bh-kaart">
        <h2>Communicatie</h2>
        <h3>Verwachte communicatie</h3>
        <p class="bh-muted">
          Verwachte communicatie op basis van de huidige workflow.
          Deze mails worden momenteel niet automatisch verstuurd zolang de betreffende automatisering uit staat.
        </p>
        {verwacht.length === 0 ? (
          <p class="bh-leeg">Geen verwachte mail voor deze boeking.</p>
        ) : (
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Datum</th>
                <th>Template</th>
                <th>Ontvanger</th>
                <th>Onderwerp</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {verwacht.map((c) => (
                <tr>
                  <td>{c.wanneer ? formatNl(c.wanneer.slice(0, 10)) : '—'}</td>
                  <td>{c.template}</td>
                  <td>{c.ontvanger}</td>
                  <td>{c.onderwerp ?? '—'}</td>
                  <td><span class="bh-badge">{labelVoorCommunicatie(c.status, 'verwacht')}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        <h3>Aangeleverde foto's</h3>
        {
          intake.length === 0 ? (
            <p class="bh-leeg">Nog geen privé-aanlevering. Publicatie gebeurt niet vanuit het exposantenportaal.</p>
          ) : (
            <ul>
              {intake.map((foto) => (
                <li>
                  {foto.rol === 'hoofd' ? 'Hoofd' : 'Extra'}:{' '}
                  {foto.url ? <a href={foto.url}>{foto.pad}</a> : foto.pad}
                </li>
              ))}
            </ul>
          )
        }

        <Mailconcept
          templates={(snapshot.bron === 'supabase' ? vroegeTemplates : templates).map((item) => ({ id: item.id, naam: item.naam }))}
          ontvanger={boeking.email}
          modus={mailmodusLabel}
          testadres={testadres}
          replyTo={CONTRACTBEHEER_EMAIL}
          preview={mailPreview}
          formActie={`${basis}?tab=communicatie`}
          tab="communicatie"
          gekozenTemplate={mailTemplateBehouden}
          inhoud={mailInhoudBehouden}
        />

        <h3>Communicatiejobs</h3>
        <p class="bh-muted">
          Alleen echte rijen uit communicatie_jobs. Zonder job is er niets ingepland, verzonden, fout gegaan of geannuleerd.
        </p>
        {jobs.length === 0 ? (
          <p class="bh-leeg">Er is geen communicatiejob voor deze boeking.</p>
        ) : (
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Datum</th>
                <th>Mailtype</th>
                <th>Ontvanger</th>
                <th>Onderwerp</th>
                <th>Status</th>
                <th>Auto / hand</th>
              </tr>
            </thead>
            <tbody>
              {jobs.map((c) => (
                <tr>
                  <td>{c.wanneer ? formatNl(c.wanneer.slice(0, 10)) : '—'}</td>
                  <td>{c.template}</td>
                  <td>{c.ontvanger}</td>
                  <td>{c.onderwerp ?? '—'}</td>
                  <td>
                    <span class={`bh-badge bh-badge--${c.status}`}>{labelVoorCommunicatie(c.status, 'job')}</span>
                  </td>
                  <td>{c.automatisch == null ? '—' : c.automatisch ? 'Automatisch' : `Handmatig (${c.door ?? '—'})`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <p class="bh-muted">
          De bestuursmail van een verhuuraanvraag staat in de communicatietijdlijn van de aanvraag.
        </p>
      </section>
    )
  }
</Beheer>
