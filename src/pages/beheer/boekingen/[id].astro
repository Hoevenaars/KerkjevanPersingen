---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import {
  BOEKING_LABEL,
  SOORT_LABEL,
  demoNaActie,
  formatNl,
  gastheerVan,
  labelVoorCommunicatie,
} from '../../../platform/demo-data';
import { beheerId, laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { actorVanSessie, postAlsSupabase } from '../../../lib/operatie/runtime.ts';
import { laadCommunicatieVoorBoeking, laadMailtemplates } from '../../../platform/mailtemplates/store.ts';
import { laadMailtemplatesUitSupabase } from '../../../platform/mailtemplates/supabase-bron.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { statusActieToegestaan } from '../../../platform/status-overgang.ts';
import { behoudTerug, terugLink } from '../../../platform/planning.ts';
import { geplandeMailsVoorBoeking } from '../../../platform/mailtemplates/workflow.ts';
import type { MailCommunicatieRegel, MailCommunicatieStatus } from '../../../platform/mailtemplates/types.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const id = beheerId(Astro.params.id);
const boeking = snapshot.boekingen.find((b) => b.id === id);

if (Astro.request.method === 'POST') {
  const operationeel = await postAlsSupabase({
    request: Astro.request,
    url: Astro.url,
    env: omgevingsRecord(),
    actor: actorVanSessie(Astro.locals.beheer),
    sessie: sessieSupabaseUitAstro(Astro),
  });
  if (operationeel) return operationeel;
  return Astro.redirect(demoNaActie(Astro.url));
}

if (!boeking) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
}

const tab = Astro.url.searchParams.get('tab') ?? 'gegevens';
const relatie = snapshot.relaties.find((r) => r.id === boeking.relatieId);
const docs = snapshot.documenten.filter((d) => d.boekingId === boeking.id);
const demoMails = snapshot.communicatie.filter((c) => c.boekingId === boeking.id);
const opgeslagen = snapshot.bron === 'supabase' ? [] : await laadCommunicatieVoorBoeking(boeking.id);
const JOB_STATUSSEN = new Set<MailCommunicatieStatus>(['gepland', 'concept', 'wachtrij', 'verzonden', 'fout', 'geannuleerd']);
function jobAlsRegel(rij: { id: string; boekingId: string; template: string; ontvanger: string; status: string; wanneer: string }): MailCommunicatieRegel | null {
  if (!JOB_STATUSSEN.has(rij.status as MailCommunicatieStatus)) return null;
  return {
    id: rij.id,
    boekingId: rij.boekingId,
    templateId: rij.template,
    templateNaam: rij.template,
    ontvanger: rij.ontvanger,
    onderwerp: '',
    status: rij.status as MailCommunicatieStatus,
    geplandOp: rij.wanneer,
    automatisch: true,
    door: 'systeem',
    test: false,
  };
}
const templates =
  snapshot.bron === 'supabase'
    ? await (async () => {
        const client = sessieSupabaseUitAstro(Astro);
        return client ? laadMailtemplatesUitSupabase(client) : [];
      })()
    : await laadMailtemplates();
const jobRegels = snapshot.bron === 'supabase'
  ? demoMails.flatMap((rij) => {
      const regel = jobAlsRegel(rij);
      return regel ? [regel] : [];
    })
  : opgeslagen;
const verwacht = geplandeMailsVoorBoeking(boeking, templates, jobRegels).map((r) => ({
  id: r.id,
  template: r.templateNaam,
  ontvanger: r.ontvanger,
  wanneer: r.geplandOp ?? '',
  status: 'verwacht',
  automatisch: r.automatisch,
  door: r.door,
  onderwerp: r.onderwerp,
}));
const templateNaam = new Map(templates.map((tpl) => [tpl.id, tpl.naam]));
const jobs = (snapshot.bron === 'supabase'
  ? demoMails.map((r) => ({
      id: r.id,
      template: templateNaam.get(r.template) ?? r.template,
      ontvanger: r.ontvanger,
      wanneer: r.wanneer,
      status: r.status,
      automatisch: undefined as boolean | undefined,
      door: undefined as string | undefined,
      onderwerp: undefined as string | undefined,
    }))
  : [
      ...opgeslagen.map((r: MailCommunicatieRegel) => ({
        id: r.id,
        template: r.templateNaam,
        ontvanger: r.ontvanger,
        wanneer: r.verzondenOp ?? r.geplandOp ?? '',
        status: r.status,
        automatisch: r.automatisch as boolean | undefined,
        door: r.door as string | undefined,
        onderwerp: r.onderwerp,
      })),
      ...demoMails.map((r) => ({
        id: r.id,
        template: r.template,
        ontvanger: r.ontvanger,
        wanneer: r.wanneer,
        status: r.status,
        automatisch: undefined as boolean | undefined,
        door: undefined as string | undefined,
        onderwerp: undefined as string | undefined,
      })),
    ]
).sort((a, b) => (a.wanneer || '').localeCompare(b.wanneer || ''));
const gastheer = gastheerVan(boeking.gastheerId, snapshot.gastheren);
const actieveGastheren = snapshot.gastheren.filter((g) => g.actief);
const verleng = statusActieToegestaan(boeking.status, 'verleng');
const definitief = statusActieToegestaan(boeking.status, 'definitief');
const afronden = statusActieToegestaan(boeking.status, 'afronden');
const toonGastheer = boeking.soort === 'expositie' || Boolean(boeking.gastheerId);
const flash = Astro.url.searchParams.get('demo') === '1';
const melding = Astro.url.searchParams.get('melding');
const fout = Astro.url.searchParams.get('fout');
const basis = `/beheer/boekingen/${encodeURIComponent(boeking.id)}/`;
const terug = terugLink(Astro.url.searchParams.get('terug'));
const terugWaarde = Astro.url.searchParams.get('terug');
function tabHref(tabNaam: string): string {
  const pad = tabNaam ? `${basis}?tab=${tabNaam}` : basis;
  return behoudTerug(pad, terugWaarde);
}
---

<Beheer titel={boeking.interneTitel}>
  <p class="bh-crumb"><a href={terug?.href ?? '/beheer/boekingen/'}>{terug?.label ?? 'Boekingen'}</a> / {boeking.nummer}</p>
  <header class="bh-top">
    <div>
      <h1>{boeking.interneTitel}</h1>
      <p class="bh-hint">
        {boeking.nummer} · {SOORT_LABEL[boeking.soort] ?? boeking.soort} · {formatNl(boeking.start)}
        · <span class={`bh-badge bh-badge--${boeking.status}`}>{BOEKING_LABEL[boeking.status]}</span>
        {boeking.publiek ? '' : ' · privé (niet in publieke agenda)'}
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {melding && <p class="bh-flash">{melding}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  <nav class="bh-tabs" aria-label="Boekingonderdelen">
    <a href={tabHref('')} aria-current={tab === 'gegevens' ? 'page' : undefined}>Gegevens</a>
    <a href={tabHref('documenten')} aria-current={tab === 'documenten' ? 'page' : undefined}>Documenten</a>
    <a href={tabHref('communicatie')} aria-current={tab === 'communicatie' ? 'page' : undefined}>Communicatie</a>
  </nav>

  {
    tab === 'gegevens' && (
      <div class="bh-split">
        <section class="bh-kaart">
          <h2>Boeking</h2>
          <dl class="bh-dl">
            <dt>Huurder</dt>
            <dd>
              {relatie ? <a href={`/beheer/relaties/${encodeURIComponent(relatie.id)}/`}>{boeking.huurder}</a> : boeking.huurder}
            </dd>
            <dt>E-mail</dt>
            <dd>{boeking.email}</dd>
            <dt>Periode</dt>
            <dd>
              {formatNl(boeking.start)}
              {boeking.eind !== boeking.start ? ` – ${formatNl(boeking.eind)}` : ''}
            </dd>
            <dt>Tarief</dt>
            <dd>{boeking.tarief}</dd>
            <dt>Aanbetaling</dt>
            <dd>
              {boeking.aanbetalingBinnen ? 'vlag: ja' : 'vlag: nee'}. Niet leidend voor status, planning of publicatie.
            </dd>
            {boeking.optieEind && (
              <>
                <dt>Optie tot</dt>
                <dd>{formatNl(boeking.optieEind)}</dd>
              </>
            )}
            <dt>Notities</dt>
            <dd>{boeking.notities}</dd>
            <dt>Status</dt>
            <dd>{BOEKING_LABEL[boeking.status] ?? boeking.status}{boeking.periode ? ` · ${boeking.periode}` : ''}</dd>
            {(snapshot.toewijzingen ?? []).filter((item) => item.boekingId === boeking.id).length > 0 && (
              <>
                <dt>Gastbegeleiders</dt>
                <dd>
                  <ul>
                    {(snapshot.toewijzingen ?? [])
                      .filter((item) => item.boekingId === boeking.id)
                      .map((item) => (
                        <li>
                          {item.relatieNaam} · {item.type} · {item.datum ? formatNl(item.datum) : 'boekingsniveau'}
                        </li>
                      ))}
                  </ul>
                </dd>
              </>
            )}
            {(snapshot.betalingen ?? []).filter((item) => item.boekingId === boeking.id).length > 0 && (
              <>
                <dt>Betalingen</dt>
                <dd>
                  <ul>
                    {(snapshot.betalingen ?? [])
                      .filter((item) => item.boekingId === boeking.id)
                      .map((item) => (
                        <li>
                          {item.soort} · {item.bedrag.toFixed(2)} · {item.status}
                          {item.ontvangenOp ? ` · ontvangen ${formatNl(item.ontvangenOp)}` : ''}
                        </li>
                      ))}
                  </ul>
                </dd>
              </>
            )}
            {toonGastheer && (
              <>
                <dt>Gastheer</dt>
                <dd>
                  {gastheer ? `${gastheer.naam} · ${gastheer.telefoon}` : 'Nog niet ingepland'}
                </dd>
              </>
            )}
          </dl>
          {toonGastheer && !snapshot.alleenLezen && (
            <form method="post" class="bh-form">
              <label for="gastheer">Gastheer of gastvrouw</label>
              <select id="gastheer" name="gastheerId">
                <option value="">Nog niet ingepland</option>
                {actieveGastheren.map((g) => (
                  <option value={g.id} selected={g.id === boeking.gastheerId}>
                    {g.naam}
                  </option>
                ))}
              </select>
              <p class="bh-muted">
                Koppelen schrijft alleen de gastheer. De 2-wekenmail is niet actief.
                Hans plant hetzelfde onder <a href="/beheer/planning/">Planning</a>.
              </p>
              <div class="bh-acties">
                <button class="bh-btn" type="submit" name="actie" value="gastheer">
                  Koppel gastheer
                </button>
                <button class="bh-btn bh-btn--sec" type="button" disabled>
                  Concept 2-wekenmail — nog niet beschikbaar
                </button>
              </div>
            </form>
          )}
        </section>
        <section class="bh-kaart">
          <h2>{snapshot.alleenLezen ? 'Alleen lezen' : snapshot.bron === 'supabase' ? 'Dossieracties' : 'Acties (voorbeeld)'}</h2>
          <p class="bh-muted">
            {snapshot.alleenLezen
              ? 'Supabase-testmodus schrijft niets en verstuurt geen mail.'
              : snapshot.bron === 'supabase'
              ? 'Deze acties gebruiken je ingelogde sessie. Er gaat geen mail uit. Annuleren start geen annuleringsmail.'
              : 'Geen contractgeneratie, geen echte mail, geen wijziging in Sanity.'}
          </p>
          {!snapshot.alleenLezen && (
            <>
              <form method="post" class="bh-acties">
                {definitief.ok && definitief.melding !== 'al' && (
                  <>
                    <label for="reden">Reden bij definitief zetten</label>
                    <input id="reden" name="reden" type="text" />
                    <button class="bh-btn" type="submit" name="actie" value="definitief">
                      Zet definitief
                    </button>
                  </>
                )}
                {verleng.ok && (
                  <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="verleng">
                    Verleng optie
                  </button>
                )}
                {!verleng.ok && <p class="bh-muted">{verleng.melding}</p>}
                {!definitief.ok && <p class="bh-muted">{definitief.melding}</p>}
                <p class="bh-muted">Annuleren verstuurt geen mail. Die automation staat uit.</p>
              </form>
              {boeking.status !== 'geannuleerd' && (
                <form method="post" class="bh-form">
                  <label for="annuleer-reden">Reden annulering</label>
                  <textarea id="annuleer-reden" name="reden" rows="3" placeholder="Bijvoorbeeld: weg afgesloten"></textarea>
                  <p class="bh-muted">De gekoppelde activiteit verdwijnt uit de publieke agenda. Er gaat geen mail uit.</p>
                  <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="annuleer">
                    Annuleer
                  </button>
                </form>
              )}
            </>
          )}
          {snapshot.bron === 'supabase' && !snapshot.alleenLezen && (
            <>
              <form method="post" class="bh-form">
                <label for="incident">Incident</label>
                <textarea id="incident" name="omschrijving" rows="3"></textarea>
                <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="incident">
                  Incident vastleggen
                </button>
              </form>
              {(snapshot.incidenten ?? [])
                .filter((item) => item.boekingId === boeking.id && item.status !== 'gesloten')
                .map((item) => (
                  <form method="post" class="bh-acties">
                    <p>{item.omschrijving}</p>
                    <input type="hidden" name="incidentId" value={item.id} />
                    <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="incident_sluiten">
                      Incident sluiten
                    </button>
                  </form>
                ))}
              {afronden.ok && afronden.melding !== 'al' && (
                <form method="post" class="bh-acties">
                  <button class="bh-btn" type="submit" name="actie" value="sluit">
                    Dossier afronden
                  </button>
                </form>
              )}
            </>
          )}
        </section>
      </div>
    )
  }

  {
    tab === 'documenten' && (
      <section class="bh-kaart">
        <h2>Documenten</h2>
        <p class="bh-muted">Voorbeeldbestanden. Uploaden of downloaden wijzigt niets op de site.</p>
        {docs.length === 0 ? (
          <p class="bh-leeg">Nog geen documenten bij deze boeking.</p>
        ) : (
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Bestand</th>
                <th>Soort</th>
                <th>Datum</th>
              </tr>
            </thead>
            <tbody>
              {docs.map((d) => (
                <tr>
                  <td>{d.naam}</td>
                  <td>{d.soort}</td>
                  <td>{formatNl(d.datum)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <p class="bh-acties">
          <button class="bh-btn bh-btn--sec" type="button" disabled>Document toevoegen — nog niet beschikbaar</button>
        </p>
      </section>
    )
  }

  {
    tab === 'communicatie' && (
      <section class="bh-kaart">
        <h2>Communicatie</h2>
        <h3>Verwachte communicatie</h3>
        <p class="bh-muted">
          Verwachte communicatie op basis van de huidige workflow.
          Deze mails worden momenteel niet automatisch verstuurd zolang de betreffende automatisering uit staat.
        </p>
        {verwacht.length === 0 ? (
          <p class="bh-leeg">Geen verwachte mail voor deze boeking.</p>
        ) : (
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Datum</th>
                <th>Template</th>
                <th>Ontvanger</th>
                <th>Onderwerp</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {verwacht.map((c) => (
                <tr>
                  <td>{c.wanneer ? formatNl(c.wanneer.slice(0, 10)) : '—'}</td>
                  <td>{c.template}</td>
                  <td>{c.ontvanger}</td>
                  <td>{c.onderwerp ?? '—'}</td>
                  <td><span class="bh-badge">{labelVoorCommunicatie(c.status, 'verwacht')}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        <h3>Communicatiejobs</h3>
        <p class="bh-muted">
          Alleen echte rijen uit communicatie_jobs. Zonder job is er niets ingepland, verzonden, fout gegaan of geannuleerd.
        </p>
        {jobs.length === 0 ? (
          <p class="bh-leeg">Er is geen communicatiejob voor deze boeking.</p>
        ) : (
          <table class="bh-tabel">
            <thead>
              <tr>
                <th>Datum</th>
                <th>Mailtype</th>
                <th>Ontvanger</th>
                <th>Onderwerp</th>
                <th>Status</th>
                <th>Auto / hand</th>
              </tr>
            </thead>
            <tbody>
              {jobs.map((c) => (
                <tr>
                  <td>{c.wanneer ? formatNl(c.wanneer.slice(0, 10)) : '—'}</td>
                  <td>{c.template}</td>
                  <td>{c.ontvanger}</td>
                  <td>{c.onderwerp ?? '—'}</td>
                  <td>
                    <span class={`bh-badge bh-badge--${c.status}`}>{labelVoorCommunicatie(c.status, 'job')}</span>
                  </td>
                  <td>{c.automatisch == null ? '—' : c.automatisch ? 'Automatisch' : `Handmatig (${c.door ?? '—'})`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        <p class="bh-muted">
          De directe mail naar het bestuur bij een verhuuraanvraag staat hier niet bij. Die schrijft geen communicatiejob en geen verzendregel.
        </p>
        <p class="bh-acties">
          <button class="bh-btn" type="button" disabled>Maak mailconcept — nog niet beschikbaar</button>
        </p>
      </section>
    )
  }
</Beheer>
