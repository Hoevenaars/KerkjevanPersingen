---
export const prerender = false;

import Beheer from '../../../../layouts/Beheer.astro';
import {
  STANDAARD_AUTOMATISERINGEN,
  auditregel,
  isStatus,
  gekoppeldeFlow,
  kanExternVersturen,
  magAutomatiseringUitvoeren,
  planStatuswijziging,
  functioneleStatus,
  statusLabel,
  type Automatisering,
} from '../../../../platform/automatisering.ts';
import { verstuurAutomatiseringTestmails } from '../../../../lib/automatisering-testmail.ts';
import { maakBeheerAdminClient } from '../../../../lib/supabase.ts';
import { getTestMailRecipient } from '../../../../lib/testmail-adres.ts';
import { vatTestmailsSamen } from '../../../../platform/automatisering-testmail.ts';
import { STANDAARD_MAILTEMPLATES } from '../../../../platform/mailtemplates/catalog.ts';
import { laadMailtemplatesUitSupabase } from '../../../../platform/mailtemplates/supabase-bron.ts';
import type { MailTemplateDef } from '../../../../platform/mailtemplates/types.ts';
import { GEEN_TESTMAILADRES, normaliseerTestmailadres, TESTMAIL_SLEUTEL } from '../../../../platform/testmail.ts';
import { controleerInstellingen, instellingRijen, leesInstellingen, legeInstellingen } from '../../../../platform/documentenflow.ts';
import { magSchrijven } from '../../../../platform/rechten.ts';

type Rij = {
  sleutel: string;
  naam: string;
  omschrijving: string;
  categorie: Automatisering['categorie'];
  status: Automatisering['status'];
  mailcategorie: string;
  trigger_tekst: string;
  actieve_trigger: boolean;
  ontvangerstype: string;
  risicovol: boolean;
  laatste_run: string | null;
  laatste_resultaat: string | null;
  gewijzigd_door: string | null;
  gewijzigd_op: string | null;
};

function vanRij(rij: Rij): Automatisering {
  return {
    sleutel: rij.sleutel,
    naam: rij.naam,
    omschrijving: rij.omschrijving,
    categorie: rij.categorie,
    status: rij.status,
    mailcategorie: rij.mailcategorie,
    trigger: rij.trigger_tekst,
    actieveTrigger: rij.actieve_trigger !== false,
    ontvangerstype: rij.ontvangerstype,
    risicovol: rij.risicovol,
    laatsteRun: rij.laatste_run,
    laatsteResultaat: rij.laatste_resultaat,
    gewijzigdDoor: rij.gewijzigd_door,
    gewijzigdOp: rij.gewijzigd_op,
  };
}

const client = maakBeheerAdminClient();
type OngetypedeQuery = {
  select: (kolommen: string) => {
    order: (kolom: string) => {
      order: (kolom: string) => Promise<{ data: Rij[] | null; error: { message: string } | null }>;
    };
  };
  upsert: (waarden: unknown, opties?: { onConflict?: string }) => Promise<{ error: { message: string } | null }>;
  insert: (rij: Record<string, unknown>) => Promise<{ error: { message: string } | null }>;
  update: (waarden: Record<string, unknown>) => {
    eq: (kolom: string, waarde: string) => Promise<{ error: { message: string } | null }>;
  };
};
type Ongetypeerd = {
  from: (tabel: string) => OngetypedeQuery;
  rpc: (fn: string, args: Record<string, string>) => Promise<{ error: { message: string } | null }>;
};
const db = client as unknown as Ongetypeerd | null;
let lijst = STANDAARD_AUTOMATISERINGEN;
let fout = '';
let melding = '';
let bevestiging: { sleutel: string; status: 'actief' } | null = null;

async function lees(): Promise<Automatisering[]> {
  if (!db) return STANDAARD_AUTOMATISERINGEN;
  const { data, error } = await db.from('automatiseringen').select('sleutel,naam,omschrijving,categorie,status,mailcategorie,trigger_tekst,actieve_trigger,ontvangerstype,risicovol,laatste_run,laatste_resultaat,gewijzigd_door,gewijzigd_op').order('categorie').order('naam');
  if (error) throw new Error(error.message);
  const rijen = (data ?? []) as Rij[];
  return rijen.length > 0 ? rijen.map(vanRij) : STANDAARD_AUTOMATISERINGEN;
}

let testmailadres = await getTestMailRecipient().catch(() => null);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('actie') ?? '') === 'testmailadres') {
    const superAdmin = Astro.locals.beheer?.rechten.isSuperAdmin === true;
    const nieuw = normaliseerTestmailadres(String(form.get('testmailadres') ?? ''));
    if (!superAdmin) fout = 'Alleen een super admin mag het testmailadres wijzigen.';
    else if (!nieuw.ok) fout = 'Ongeldig testmailadres. Vul één adres in, zonder komma of puntkomma.';
    else if (!db) fout = 'Geen databaseclient. Er is niets opgeslagen.';
    else {
      const opgeslagen = await db.from('instellingen').upsert(
        { sleutel: TESTMAIL_SLEUTEL, groep: 'mail', waarde: nieuw.adres, toelichting: 'Alle echte testmails gaan uitsluitend naar dit adres.' },
        { onConflict: 'sleutel' },
      );
      if (opgeslagen.error) fout = opgeslagen.error.message;
      else {
        await db.from('auditlog').insert({
          actor_naam: Astro.locals.beheer?.gebruiker.naam || 'super admin',
          actor_type: 'gebruiker',
          onderwerp_type: 'instelling',
          onderwerp_id: TESTMAIL_SLEUTEL,
          actie: 'testmailadres',
          van: testmailadres,
          naar: nieuw.adres,
          dedup_sleutel: `testmailadres:${testmailadres}:${nieuw.adres}:${Date.now()}`,
        });
        testmailadres = nieuw.adres;
        melding = 'Testmailadres opgeslagen.';
      }
    }
  } else if (String(form.get('actie') ?? '') === 'documentenflow') {
    const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
    const instellingen = {
      ...legeInstellingen(),
      bestuursakkoordVerplicht: String(form.get('bestuur') ?? '') !== 'nee',
      gereedRegel: String(form.get('gereed') ?? '') === 'ondertekend' || String(form.get('gereed') ?? '') === 'ondertekend_en_aanbetaling'
        ? String(form.get('gereed') ?? '') as 'ondertekend' | 'ondertekend_en_aanbetaling'
        : '' as const,
      ondertekenaarNaam: String(form.get('ondertekenaarNaam') ?? '').trim(),
      ondertekenaarFunctie: String(form.get('ondertekenaarFunctie') ?? '').trim(),
      iban: String(form.get('iban') ?? '').replace(/\s+/g, '').toUpperCase(),
      tenaamstelling: String(form.get('tenaamstelling') ?? '').trim(),
      voorwaardenVastgesteldOp: String(form.get('voorwaardenVastgesteldOp') ?? '').trim(),
      huisregelsVastgesteldOp: String(form.get('huisregelsVastgesteldOp') ?? '').trim(),
      coordinatorContact: String(form.get('coordinator') ?? '').trim(),
      publicatieRoute: String(form.get('publicatie') ?? '').trim(),
    };
    const controle = controleerInstellingen(instellingen);
    if (!magSchrijven(rechten, 'instellingen')) fout = 'Geen recht om deze instellingen te bewaren.';
    else if (!db) fout = 'Geen databaseclient. Er is niets opgeslagen.';
    else if (controle) fout = controle;
    else {
      const opgeslagen = await db.from('instellingen').upsert(instellingRijen(instellingen), { onConflict: 'sleutel' });
      if (opgeslagen.error) fout = opgeslagen.error.message;
      else {
        await db.from('auditlog').insert({
          actor_naam: Astro.locals.beheer?.gebruiker.naam || 'beheer',
          actor_type: 'gebruiker',
          onderwerp_type: 'instelling',
          onderwerp_id: 'documentenflow',
          actie: 'documentenflow_instellingen',
          naar: instellingen.gereedRegel || 'geen-gereed-regel',
          dedup_sleutel: `documentenflow:${Date.now()}`,
        });
        melding = 'Documentenflow-instellingen opgeslagen. Lege velden blijven de veilige stand.';
      }
    }
  } else if (String(form.get('actie') ?? '') === 'verstuur_testmails') {
    const superAdmin = Astro.locals.beheer?.rechten.isSuperAdmin === true;
    if (!superAdmin) fout = 'Alleen een super admin mag testmails versturen.';
    else if (!testmailadres) fout = `${GEEN_TESTMAILADRES} Er is niets verstuurd.`;
    else {
      try {
        const register = await lees();
        let templates: MailTemplateDef[] = STANDAARD_MAILTEMPLATES;
        if (client) {
          try {
            const uitSupabase = await laadMailtemplatesUitSupabase(client as never);
            if (uitSupabase.length > 0) templates = uitSupabase;
          } catch {
            templates = STANDAARD_MAILTEMPLATES;
          }
        }
        const resultaten = await verstuurAutomatiseringTestmails({
          register,
          testadres: testmailadres,
          templates,
        });
        const samen = vatTestmailsSamen(resultaten, testmailadres);
        melding = samen.melding;
        fout = samen.fout;
        if (db) {
          const nu = new Date().toISOString();
          for (const regel of resultaten) {
            const bijgewerkt = await db.from('automatiseringen').update({
              laatste_run: nu,
              laatste_resultaat: (regel.verzonden ? `testmail naar ${testmailadres}` : regel.reden).slice(0, 240),
            }).eq('sleutel', regel.sleutel);
            if (bijgewerkt.error) fout = fout || bijgewerkt.error.message;
          }
        }
      } catch (error) {
        fout = error instanceof Error ? error.message : 'Testmails versturen mislukt.';
      }
    }
  } else {
    const sleutel = String(form.get('sleutel') ?? '');
    const status = String(form.get('status') ?? '');
    const bevestigd = String(form.get('bevestig') ?? '') === 'ja';
    const gebruiker = Astro.locals.beheer?.gebruiker.naam || 'beheer';
    try {
      const huidig = (await lees()).find((item) => item.sleutel === sleutel);
      if (!huidig) fout = 'Automatisering niet gevonden.';
      else {
        const plan = planStatuswijziging(huidig, status, bevestigd);
        if (plan.soort === 'bevestiging' && isStatus(status)) {
          bevestiging = { sleutel, status };
        } else if (plan.soort === 'weigering') {
          fout = plan.reden ?? 'Status niet gewijzigd.';
        } else if (plan.soort === 'wijziging' && isStatus(status) && db) {
          const regel = auditregel(huidig, status, gebruiker);
          const opgeslagen = await db.rpc('zet_automatisering_status', {
            p_sleutel: regel.automatisering,
            p_status: regel.nieuweStatus,
            p_gebruiker: regel.gebruiker,
          });
          if (opgeslagen.error) throw new Error(opgeslagen.error.message);
          melding = `${huidig.naam} staat op ${statusLabel(status)}.`;
        } else if (plan.soort === 'wijziging' && !db) {
          fout = 'Geen Supabase-client. De status is niet opgeslagen.';
        }
      }
    } catch (error) {
      fout = error instanceof Error ? error.message : 'Opslaan mislukt.';
    }
  }
}

try {
  lijst = await lees();
} catch (error) {
  fout = fout || (error instanceof Error ? error.message : 'Laden mislukt.');
  lijst = STANDAARD_AUTOMATISERINGEN;
}

let documentenInstellingen = leesInstellingen([]);
const magDocumenten = magSchrijven(
  Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} },
  'instellingen',
);
if (magDocumenten && db) {
  const gelezen = await db.from('instellingen').select('sleutel,waarde').order('sleutel').order('sleutel');
  if (!gelezen.error) {
    documentenInstellingen = leesInstellingen((gelezen.data ?? []) as { sleutel: string; waarde: unknown }[]);
  }
}

const groepen = [
  ['transactioneel', 'Transactioneel'],
  ['automatisering', 'Automatiseringen'],
  ['handmatig', 'Handmatig'],
] as const;
---

<Beheer titel="Automatiseringen">
  <header class="bh-top">
    <div>
      <h1>Automatiseringen</h1>
      <p class="bh-hint">
        Schakelaar is de opgeslagen stand Aan, Test of Uit. Functioneel is wat er nu echt gebeurt. Alleen een nieuwe verhuuraanvraag naar het bestuur is actief. Een schakelaar op Aan zonder caller verstuurt niets.
      </p>
    </div>
  </header>

  <section class="bh-kaart">
    <h2>Testmailadres</h2>
    <p>Alle echte testmails worden uitsluitend naar dit adres verstuurd. De oorspronkelijke ontvanger ontvangt tijdens een test niets.</p>
    <p><strong>{testmailadres || 'Geen geldig testmailadres ingesteld.'}</strong></p>
    {
      Astro.locals.beheer?.rechten.isSuperAdmin ? (
        <form method="post" class="bh-form">
          <label for="testmailadres">Testmailadres</label>
          <input id="testmailadres" name="testmailadres" type="email" required value={testmailadres ?? ''} />
          <div class="bh-acties">
            <button class="bh-btn" type="submit" name="actie" value="testmailadres">Testmailadres bewaren</button>
            <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="verstuur_testmails" onclick="return confirm('Alle automatiseringen die op Test staan, versturen een mail naar het opgeslagen testmailadres. Doorgaan?')">Versturen testmails</button>
          </div>
          <p class="bh-muted">Versturen testmails stuurt één mail per automatisering op Test, alleen naar het opgeslagen adres. Aan en Uit blijven stil.</p>
        </form>
      ) : (
        <p class="bh-muted">Alleen een super admin kan dit adres wijzigen.</p>
      )
    }
  </section>

  {
    magDocumenten && (
      <section class="bh-kaart">
        <h2>Contract en opvolging</h2>
        <p>De velden staan gevuld met wat al op de site staat: Nelleke van der Pol als contractbeheer, en het rekeningnummer van Steun ons. Pas een veld aan als de huur ergens anders hoort. Een boeking wordt definitief zodra de checklist compleet is. Ontbreekt deze regel, dan blokkeert dat die overgang niet.</p>
        <form method="post" class="bh-form">
          <label for="df-bestuur">Bestuursakkoord voor nieuwe contracten</label>
          <select id="df-bestuur" name="bestuur">
            <option value="ja" selected={documentenInstellingen.bestuursakkoordVerplicht}>Verplicht</option>
            <option value="nee" selected={!documentenInstellingen.bestuursakkoordVerplicht}>Uit, alleen voor nieuwe contracten</option>
          </select>
          <label for="df-gereed">Wanneer een boeking definitief mag</label>
          <select id="df-gereed" name="gereed">
            <option value="" selected={documentenInstellingen.gereedRegel === ''}>Checklist, ook zonder opgeslagen regel</option>
            <option value="ondertekend" selected={documentenInstellingen.gereedRegel === 'ondertekend'}>Na ondertekening</option>
            <option value="ondertekend_en_aanbetaling" selected={documentenInstellingen.gereedRegel === 'ondertekend_en_aanbetaling'}>Na ondertekening en ontvangen aanbetaling</option>
          </select>
          <label for="df-naam">Bevoegde ondertekenaar</label>
          <input id="df-naam" name="ondertekenaarNaam" value={documentenInstellingen.ondertekenaarNaam} maxlength="120" />
          <label for="df-functie">Functie</label>
          <input id="df-functie" name="ondertekenaarFunctie" value={documentenInstellingen.ondertekenaarFunctie} maxlength="120" />
          <label for="df-iban">IBAN</label>
          <input id="df-iban" name="iban" value={documentenInstellingen.iban} maxlength="34" autocapitalize="characters" />
          <label for="df-naam-rekening">Tenaamstelling</label>
          <input id="df-naam-rekening" name="tenaamstelling" value={documentenInstellingen.tenaamstelling} maxlength="160" />
          <label for="df-voorwaarden">Voorwaarden vastgesteld op</label>
          <input id="df-voorwaarden" name="voorwaardenVastgesteldOp" value={documentenInstellingen.voorwaardenVastgesteldOp} placeholder="JJJJ-MM-DD" maxlength="10" />
          <label for="df-huisregels">Huisregels vastgesteld op</label>
          <input id="df-huisregels" name="huisregelsVastgesteldOp" value={documentenInstellingen.huisregelsVastgesteldOp} placeholder="JJJJ-MM-DD" maxlength="10" />
          <label for="df-coordinator">Contact coördinator</label>
          <input id="df-coordinator" name="coordinator" value={documentenInstellingen.coordinatorContact} maxlength="200" />
          <label for="df-publicatie">Aanleverroute promotiemateriaal</label>
          <input id="df-publicatie" name="publicatie" value={documentenInstellingen.publicatieRoute} maxlength="200" />
          <button class="bh-btn" type="submit" name="actie" value="documentenflow">Instellingen bewaren</button>
        </form>
      </section>
    )
  }

  {melding && <p class="bh-flash">{melding}</p>}
  {fout && <p class="bh-flash" role="alert">{fout}</p>}
  {
    bevestiging && (
      <form method="post" class="bh-kaart">
        <p>Deze automatisering activeren? Hierdoor kan automatische mail naar ontvangers worden verstuurd.</p>
        <input type="hidden" name="sleutel" value={bevestiging.sleutel} />
        <input type="hidden" name="status" value={bevestiging.status} />
        <input type="hidden" name="bevestig" value="ja" />
        <button class="bh-btn" type="submit">Ja, activeren</button>
      </form>
    )
  }

  {
    groepen.map(([categorie, titel]) => (
      <section class="bh-kaart">
        <h2>{titel}</h2>
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Naam</th>
              <th>Schakelaar</th>
              <th>Functioneel</th>
              <th>Trigger</th>
              <th>Flow</th>
              <th>Provider</th>
              <th>Extern</th>
              <th>Laatste run</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {lijst.filter((item) => item.categorie === categorie).map((item) => {
              const functie = functioneleStatus(item);
              return (
              <tr>
                <td>
                  <strong>{item.naam}</strong>
                  <div class="bh-muted">{item.sleutel}</div>
                  <div class="bh-muted">{item.omschrijving}</div>
                </td>
                <td>{statusLabel(item.status)}</td>
                <td>
                  <span class={`bh-badge bh-badge--fn-${functie.status}`}>{functie.label}</span>
                  <div class="bh-muted">{functie.toelichting}</div>
                </td>
                <td>
                  {item.actieveTrigger ? 'Ja' : 'Nee'}
                  <div class="bh-muted">{item.actieveTrigger ? item.trigger : 'Geen actieve trigger'}</div>
                </td>
                <td>{gekoppeldeFlow(item.sleutel)}</td>
                <td>
                  {item.actieveTrigger && magAutomatiseringUitvoeren(item.sleutel, lijst).provider ? 'Ja' : 'Nee'}
                  {!item.actieveTrigger ? <div class="bh-muted">Geen caller</div> : null}
                </td>
                <td>{kanExternVersturen(item, lijst) ? 'Ja' : 'Nee'}</td>
                <td>
                  {item.laatsteRun ? item.laatsteRun.slice(0, 16).replace('T', ' ') : '—'}
                  {item.laatsteResultaat ? <div class="bh-muted">{item.laatsteResultaat}</div> : null}
                </td>
                <td>
                  <form method="post" class="bh-acties">
                    <input type="hidden" name="sleutel" value={item.sleutel} />
                    <select name="status" aria-label={`Schakelaar van ${item.naam}`}>
                      <option value="actief" selected={item.status === 'actief'}>Aan</option>
                      <option value="test" selected={item.status === 'test'}>Test</option>
                      <option value="uit" selected={item.status === 'uit'}>Uit</option>
                    </select>
                    <button class="bh-btn" type="submit">Instellen</button>
                  </form>
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    ))
  }
</Beheer>
