---
export const prerender = false;

import Beheer from '../../../../layouts/Beheer.astro';
import {
  RECONCILIATIE_ZONDER_TOKEN,
  WEBHOOK_ENDPOINT,
  bridgeLeesfout,
  controleerSanitySynchronisatie,
  sanityLezenGeconfigureerd,
  verwerkAfwijkendeDocumenten,
  type ControleRij,
} from '../../../../lib/sanity-bridge-sync.ts';
import { maakBeheerAdminClient } from '../../../../lib/supabase.ts';

type LogRij = {
  sanity_document_id: string;
  document_type: string;
  action: string;
  received_at: string;
  status: string;
  target_table: string | null;
  target_id: string | null;
  error: string | null;
};

type SchaduwRij = { sanity_id: string; datum_start: string | null; datum_eind: string | null };

const client = maakBeheerAdminClient();
let logs: LogRij[] = [];
let schaduw: SchaduwRij[] = [];
let fout = '';
let melding = '';
let controle: ControleRij[] = [];
const bridgeGeconfigureerd = Boolean(process.env.SANITY_BRIDGE_SECRET?.trim());
const reconciliatieBeschikbaar = sanityLezenGeconfigureerd();

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const actie = String(form.get('actie') ?? '');
  if (!reconciliatieBeschikbaar) {
    melding = RECONCILIATIE_ZONDER_TOKEN;
  } else if (!client) {
    fout = 'SUPABASE_SERVICE_ROLE_KEY ontbreekt. De controle kan niet schrijven.';
  } else if (actie === 'controle' || (actie === 'verwerk' && form.get('bevestig') === 'ja')) {
    try {
      if (actie === 'controle') {
        const rijen = await controleerSanitySynchronisatie(client);
        if (!rijen) melding = RECONCILIATIE_ZONDER_TOKEN;
        else controle = rijen;
      } else {
        const uitkomst = await verwerkAfwijkendeDocumenten(client);
        melding = uitkomst.fout
          ? uitkomst.fout
          : `Verwerkt ${uitkomst.verwerkt}, overgeslagen ${uitkomst.overgeslagen}. Niets teruggeschreven naar Sanity.`;
      }
    } catch (error) {
      fout = error instanceof Error ? error.message : 'Sanity-controle mislukt.';
    }
  }
}

if (!client) {
  fout = fout || 'SUPABASE_SERVICE_ROLE_KEY ontbreekt. De bridgelog kan niet worden gelezen.';
} else {
  const db = client as unknown as {
    from: (tabel: string) => {
      select: (kolommen: string) => {
        order: (kolom: string, opties: { ascending: boolean }) => {
          limit: (n: number) => Promise<{ data: LogRij[] | null; error: { message: string } | null }>;
        };
        eq: (kolom: string, waarde: boolean) => {
          limit: (n: number) => Promise<{ data: SchaduwRij[] | null; error: { message: string } | null }>;
        };
      };
    };
  };
  const logantwoord = await db
    .from('bridge_sync_log')
    .select('sanity_document_id,document_type,action,received_at,status,target_table,target_id,error')
    .order('received_at', { ascending: false })
    .limit(30);
  if (logantwoord.error) fout = bridgeLeesfout(logantwoord.error.message);
  else logs = logantwoord.data ?? [];

  const schaduwantwoord = await db
    .from('sanity_bridge_agenda')
    .select('sanity_id,datum_start,datum_eind')
    .eq('actief', true)
    .limit(30);
  if (schaduwantwoord.error) fout = fout || bridgeLeesfout(schaduwantwoord.error.message);
  else schaduw = schaduwantwoord.data ?? [];
}

const succes = logs.filter((rij) => rij.status === 'success').length;
const overgeslagen = logs.filter((rij) => rij.status === 'skipped').length;
const review = logs.filter((rij) => rij.status === 'review').length;
const fouten = logs.filter((rij) => rij.status === 'error').length;
const laatste = logs[0];
const laatsteSucces = logs.find((rij) => rij.status === 'success');

function label(status: string): string {
  if (status === 'success') return 'Gesynchroniseerd';
  if (status === 'skipped') return 'Overgeslagen';
  if (status === 'review') return 'Nakijken';
  return 'Fout';
}

function tijd(waarde: string | null | undefined): string {
  return waarde ? waarde.slice(0, 16).replace('T', ' ') : '—';
}
---

<Beheer titel="Sanity bridge">
  <header class="bh-top">
    <div>
      <h1>Sanity bridge</h1>
      <p class="bh-hint">
        Sanity blijft een invoerkanaal. Wijzigingen lopen alleen naar Supabase. Er gaat niets terug en er wordt geen mail verstuurd.
      </p>
    </div>
  </header>
  {fout && <p class="bh-flash" role="alert">{fout}</p>}
  <section class="bh-kaart">
    <p>Bridge geconfigureerd: {bridgeGeconfigureerd ? 'Ja' : 'Nee, SANITY_BRIDGE_SECRET ontbreekt'}</p>
    <p>Webhook: POST {WEBHOOK_ENDPOINT}</p>
    <p>Status: {logs.length === 0 ? 'Wacht op eerste synchronisatie' : `${laatste.document_type} · ${label(laatste.status)}`}</p>
    <p>Laatste succesvolle sync: {tijd(laatsteSucces?.received_at)}</p>
    <p>Succes {succes} · overgeslagen {overgeslagen} · nakijken {review} · fout {fouten}</p>
    <p>Actieve shadow-records: {schaduw.length}</p>
    {!reconciliatieBeschikbaar && <p>{RECONCILIATIE_ZONDER_TOKEN}</p>}
    <form method="post" class="bh-acties">
      <button class="bh-btn" type="submit" name="actie" value="controle" disabled={!reconciliatieBeschikbaar}>Controleer Sanity synchronisatie</button>
    </form>
    {melding && <p>{melding}</p>}
    {controle.length > 0 && (
      <table class="bh-tabel">
        <thead>
          <tr><th>Type</th><th>Sanity-id</th><th>Oordeel</th><th>Toelichting</th></tr>
        </thead>
        <tbody>
          {controle.map((rij) => (
            <tr>
              <td>{rij.documentType}</td>
              <td>{rij.sanityId}</td>
              <td>{rij.oordeel}</td>
              <td>{rij.toelichting ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    <form method="post" class="bh-acties">
      <input type="hidden" name="actie" value="verwerk" />
      <label><input type="checkbox" name="bevestig" value="ja" disabled={!reconciliatieBeschikbaar} /> Alleen ontbrekende of hash-afwijkende records naar Supabase schrijven</label>
      <button class="bh-btn" type="submit" disabled={!reconciliatieBeschikbaar}>Verwerk afwijkingen</button>
    </form>
  </section>
  <section class="bh-kaart">
    <h2>Recente bridge-events</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Type</th>
          <th>Actie</th>
          <th>Tijd</th>
          <th>Resultaat</th>
          <th>Doel</th>
          <th>Fout</th>
        </tr>
      </thead>
      <tbody>
        {logs.length === 0 && <tr><td colspan="6">Wacht op eerste synchronisatie</td></tr>}
        {logs.map((rij) => (
          <tr>
            <td>{rij.document_type}</td>
            <td>{rij.action}</td>
            <td>{tijd(rij.received_at)}</td>
            <td>
              {label(rij.status)}
              {rij.document_type === 'activiteit' && rij.target_table === 'sanity_bridge_agenda' ? <div class="bh-muted">Bron: Sanity · Alleen bezetting</div> : null}
            </td>
            <td>{rij.target_table ? `${rij.target_table} ${rij.target_id ?? ''}` : '—'}</td>
            <td>{rij.error ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Beheer>
