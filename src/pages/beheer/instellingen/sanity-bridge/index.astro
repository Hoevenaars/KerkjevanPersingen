---
export const prerender = false;

import Beheer from '../../../../layouts/Beheer.astro';

if (Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD') {
  return new Response('De Sanity-brug is verwijderd. Er is niets gelezen of opgeslagen.', {
    status: 405,
    headers: { 'Cache-Control': 'no-store' },
  });
}
---

<Beheer titel="Sanity-brug">
  <header class="bh-top">
    <div>
      <p class="bh-label">Instellingen</p>
      <h1>Sanity-brug uit</h1>
      <p class="bh-hint">
        Deze pagina leest Sanity niet en schrijft niets naar Supabase. Synchroniseren is niet meer mogelijk vanuit de applicatie.
      </p>
    </div>
  </header>
  <p>Website, agenda en verhuur blijven op de bestaande Supabase-gegevens. Het Sanity-project zelf wordt pas verwijderd na een aparte vrijgave.</p>
</Beheer>
