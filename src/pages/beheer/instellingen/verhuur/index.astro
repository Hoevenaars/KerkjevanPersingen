---
export const prerender = false;

import Beheer from '../../../../layouts/Beheer.astro';
import { laadBeheerSnapshot, beheerSnapshotOpties, schrijfActieFlash } from '../../../../platform/beheer-bron.ts';
import { STANDAARD_VERHUURTYPEN } from '../../../../platform/types.ts';

if (Astro.request.method === 'POST') {
  return Astro.redirect('/beheer/instellingen/verhuur/?fout=nog-niet-beschikbaar');
}

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const flash = Astro.url.searchParams.get('demo') === '1';
const fout = Astro.url.searchParams.get('fout');
---

<Beheer titel="Verhuurinstellingen">
  <header class="bh-top">
    <div>
      <h1>Verhuur</h1>
      <p class="bh-hint">Typen, optietermijn en dagregels. Niet gekoppeld aan het aanvraagformulier.</p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {fout && <p class="bh-flash bh-flash--fout">Verhuurinstellingen bewaren is nog niet beschikbaar. Er is niets opgeslagen.</p>}

  <section class="bh-kaart">
    <h2>Verhuurtypen</h2>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Type</th>
          <th>Dagregel</th>
        </tr>
      </thead>
      <tbody>
        {
          STANDAARD_VERHUURTYPEN.map((t) => (
            <tr>
              <td>{t.naam}</td>
              <td>{t.dagregel === 'expositie_weekend' ? 'Zaterdag + zondag' : 'Maandag t/m vrijdag'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="bh-kaart">
    <h2>Optie</h2>
    <form method="post" class="bh-form">
      <label for="optie">Optietermijn (dagen)</label>
      <input id="optie" name="optietermijn" type="number" value={snapshot.instellingen.optietermijn} />
      <div class="bh-acties">
        <button class="bh-btn" type="button" disabled>Verhuurinstellingen bewaren — nog niet beschikbaar</button>
      </div>
    </form>
  </section>
</Beheer>
