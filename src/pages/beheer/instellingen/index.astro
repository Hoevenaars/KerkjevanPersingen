---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { demoNaActie } from '../../../platform/demo-data';
import { laadBeheerSnapshot, beheerSnapshotOpties, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { bewaarInstellingen } from '../../../platform/beheer-supabase-schrijf.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { huidigeContentBron, standaardBronnen } from '../../../platform/bron.ts';

const supabaseTest = Astro.url.searchParams.get('bron') !== 'demo';
let schrijfFout = '';

if (Astro.request.method === 'POST') {
  if (!supabaseTest) {
    return Astro.redirect(demoNaActie(Astro.url));
  }
  const form = await Astro.request.formData();
  const client = sessieSupabaseUitAstro(Astro);
  if (!client) {
    schrijfFout = 'Geen Supabase-sessie. Instellingen zijn niet opgeslagen en er is niet teruggeschreven naar Sanity.';
  } else {
    try {
      await bewaarInstellingen(client as never, {
        openingVan: String(form.get('openingVan') ?? ''),
        openingTot: String(form.get('openingTot') ?? ''),
        contractbeheerder: String(form.get('contractbeheerder') ?? ''),
        ontvangstAdres: String(form.get('ontvangstAdres') ?? ''),
        extraOntvangstAdres: String(form.get('extraOntvangstAdres') ?? ''),
        penningmeesterAdres: String(form.get('penningmeesterAdres') ?? ''),
      });
      return Astro.redirect('/beheer/instellingen/?bron=supabase&bewaard=1');
    } catch (error) {
      schrijfFout = error instanceof Error ? error.message : 'Opslaan in Supabase mislukt.';
    }
  }
}

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const flash = Astro.url.searchParams.get('demo') === '1' || Astro.url.searchParams.get('bewaard') === '1';
const bronnen = standaardBronnen();
const cutover = huidigeContentBron() === 'supabase';
const inst = snapshot.instellingen;
---

<Beheer titel="Instellingen">
  <header class="bh-top">
    <div>
      <h1>Algemeen</h1>
      <p class="bh-hint">
        {
          supabaseTest
            ? 'Instellingen worden gelezen en geschreven in Supabase. Een fout valt niet terug op Sanity.'
            : 'Voorbeelddata. Bewaren slaat niets op.'
        }
      </p>
    </div>
  </header>

  {flash && !schrijfFout && <p class="bh-flash">{supabaseTest && Astro.url.searchParams.get('bewaard') === '1' ? 'Opgeslagen in Supabase.' : schrijfActieFlash(snapshot.bron)}</p>}
  {schrijfFout && <p class="bh-flash bh-flash--fout" role="alert">{schrijfFout}</p>}

  <section class="bh-kaart">
    <h2>{snapshot.instellingenHerkomst === 'supabase' ? 'Instellingen uit Supabase' : 'Openingstijden (voorbeeld)'}</h2>
    <form method="post" class="bh-form">
      <label for="van">Open vanaf</label>
      <input id="van" name="openingVan" value={inst.openingVan} />
      <label for="tot">Open tot</label>
      <input id="tot" name="openingTot" value={inst.openingTot} />
      <label for="beheerder">Contractbeheerder</label>
      <input id="beheerder" name="contractbeheerder" value={inst.contractbeheerder} />
      {
        supabaseTest || inst.ontvangstAdres ? (
          <>
            <label for="ontvangst">Ontvangstadres aanvragen</label>
            <input id="ontvangst" name="ontvangstAdres" value={inst.ontvangstAdres} readonly={!supabaseTest} />
            <label for="extra">Extra ontvangstadres</label>
            <input id="extra" name="extraOntvangstAdres" value={inst.extraOntvangstAdres} readonly={!supabaseTest} />
            <label for="penningmeester">Penningmeester</label>
            <input id="penningmeester" name="penningmeesterAdres" value={inst.penningmeesterAdres} readonly={!supabaseTest} />
          </>
        ) : null
      }
      {supabaseTest ? (
        <div class="bh-acties">
          <button class="bh-btn" type="submit">Bewaar in Supabase</button>
        </div>
      ) : !snapshot.alleenLezen ? (
        <div class="bh-acties">
          <button class="bh-btn" type="submit">Bewaar (voorbeeld)</button>
        </div>
      ) : null}
    </form>
  </section>

  <section class="bh-kaart">
    <h2>Schrijvende bron (nu)</h2>
    <p class="bh-muted">
      {
        cutover
          ? 'Supabase is de enige schrijvende bron. De databasewaarde heet beheer. Er is geen dual-write naar Sanity.'
          : 'De vlaggen staan nog op de rollbackbron Sanity.'
      }
    </p>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Datatype</th>
          <th>Bron</th>
        </tr>
      </thead>
      <tbody>
        {
          Object.entries(bronnen).map(([type, bron]) => (
            <tr>
              <td>{type}</td>
              <td>{bron === 'beheer' ? 'supabase' : bron}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Beheer>
