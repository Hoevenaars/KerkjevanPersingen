---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { demoNaActie } from '../../../platform/demo-data';
import { laadBeheerSnapshot, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { standaardBronnen } from '../../../platform/bron.ts';

if (Astro.request.method === 'POST') {
  return Astro.redirect(demoNaActie(Astro.url));
}

const snapshot = await laadBeheerSnapshot({ url: Astro.url });
const flash = Astro.url.searchParams.get('demo') === '1';
const bronnen = standaardBronnen();
const inst = snapshot.instellingen;
---

<Beheer titel="Instellingen">
  <header class="bh-top">
    <div>
      <h1>Algemeen</h1>
      <p class="bh-hint">
        Sanity blijft de schrijvende bron. Bewaren slaat niets op.
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}

  <section class="bh-kaart">
    <h2>Openingstijden (voorbeeld)</h2>
    <form method="post" class="bh-form">
      <label for="van">Open vanaf</label>
      <input id="van" name="openingVan" value={inst.openingVan} />
      <label for="tot">Open tot</label>
      <input id="tot" name="openingTot" value={inst.openingTot} />
      <label for="beheerder">Contractbeheerder</label>
      <input id="beheerder" name="contractbeheerder" value={inst.contractbeheerder} />
      {
        inst.ontvangstAdres ? (
          <>
            <label for="ontvangst">Ontvangstadres aanvragen (Sanity)</label>
            <input id="ontvangst" name="ontvangstAdres" value={inst.ontvangstAdres} readonly />
          </>
        ) : null
      }
      <div class="bh-acties">
        <button class="bh-btn" type="submit">Bewaar (voorbeeld)</button>
      </div>
    </form>
  </section>

  <section class="bh-kaart">
    <h2>Schrijvende bron (nu)</h2>
    <p class="bh-muted">Alles staat op Sanity tot een bewuste cutover. Dit scherm wijzigt dat niet.</p>
    <table class="bh-tabel">
      <thead>
        <tr>
          <th>Datatype</th>
          <th>Bron</th>
        </tr>
      </thead>
      <tbody>
        {
          Object.entries(bronnen).map(([type, bron]) => (
            <tr>
              <td>{type}</td>
              <td>{bron}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Beheer>
