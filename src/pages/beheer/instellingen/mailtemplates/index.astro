---
export const prerender = false;

import Beheer from '../../../../layouts/Beheer.astro';
import { laadMailtemplates } from '../../../../platform/mailtemplates/store.ts';
import { laadMailtemplatesUitSupabase } from '../../../../platform/mailtemplates/supabase-bron.ts';
import { gekoppeldeSupabaseClient } from '../../../../platform/sanity-registratie.ts';
import { maakBeheerAdminClient } from '../../../../lib/supabase.ts';

const supabaseTest = Astro.url.searchParams.get('bron') !== 'demo';
let templates;
let supabaseFout = '';
if (supabaseTest) {
  const client = gekoppeldeSupabaseClient() ?? maakBeheerAdminClient();
  if (!client) {
    templates = [];
    supabaseFout = 'Geen Supabase-sessie. De code-catalogus wordt niet getoond.';
  } else {
    try {
      templates = await laadMailtemplatesUitSupabase(client);
    } catch (error) {
      templates = [];
      supabaseFout = error instanceof Error ? error.message : 'Supabase-templates niet gelezen.';
    }
  }
} else {
  templates = await laadMailtemplates();
}
const gesorteerd = [...templates].sort((a, b) => a.categorie.localeCompare(b.categorie, 'nl') || a.naam.localeCompare(b.naam, 'nl'));

function verzendLabel(w: string): string {
  if (w === 'automatisch') return 'Automatisch';
  if (w === 'besluit') return 'Besluit';
  if (w === 'escalatie') return 'Escalatie';
  return 'Handmatig';
}

function termijn(t: (typeof templates)[0]): string {
  if (t.trigger.offsetWaarde == null) return '—';
  return `${t.trigger.offsetWaarde} ${t.trigger.offsetEenheid ?? ''}`.trim();
}
---

<Beheer titel="Mailtemplates">
  <header class="bh-top">
    <div>
      <h1>Mailtemplates</h1>
      <p class="bh-hint">
        {
          supabaseTest
            ? 'Teksten komen uit Supabase. Opslaan schrijft een nieuwe versie. Er wordt geen mail verstuurd.'
            : "Procesmails voor aanvraag, betaling, content, planning en nazorg. Teksten zijn volledig bewerkbaar; template-ID's blijven vast."
        }
      </p>
    </div>
  </header>

  {supabaseFout && <p class="bh-flash bh-flash--fout" role="alert">{supabaseFout}</p>}

  <table class="bh-tabel">
    <thead>
      <tr>
        <th>Naam</th>
        <th>Ontvanger</th>
        <th>Categorie</th>
        <th>Trigger</th>
        <th>Verzendwijze</th>
        <th>Actief</th>
        <th>Laatst gewijzigd</th>
      </tr>
    </thead>
    <tbody>
      {
        gesorteerd.map((t) => (
          <tr>
            <td>
              <a href={`/beheer/instellingen/mailtemplates/${encodeURIComponent(t.id)}/`}>{t.naam}</a>
              <span class="bh-muted bh-klein">{t.id}</span>
            </td>
            <td>{t.ontvanger}</td>
            <td>{t.categorie}</td>
            <td>
              {t.trigger.beschrijving}
              {termijn(t) !== '—' ? ` · ${termijn(t)}` : ''}
            </td>
            <td>{verzendLabel(t.verzendwijze)}</td>
            <td>{t.actief ? 'Ja' : 'Nee'}</td>
            <td>{(t as { bijgewerktOp?: string }).bijgewerktOp?.slice(0, 10) ?? 'Standaard'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Beheer>
