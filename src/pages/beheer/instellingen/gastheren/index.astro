---
export const prerender = false;

import Beheer from '../../../../layouts/Beheer.astro';
import { laadBeheerSnapshot, beheerSnapshotOpties, schrijfActieFlash } from '../../../../platform/beheer-bron.ts';
import { actorVanSessie } from '../../../../lib/operatie/runtime.ts';
import { voegGastheerToe } from '../../../../lib/operatie/gastheer-stam.ts';
import { sessieSupabaseUitAstro } from '../../../../lib/supabase.ts';

if (Astro.request.method === 'POST') {
  const doel = new URL('/beheer/instellingen/gastheren/', Astro.url.origin);
  const sessie = sessieSupabaseUitAstro(Astro);
  if (!sessie) {
    doel.searchParams.set('fout', 'Geen ingelogde sessie. Er is niets opgeslagen.');
  } else {
    const uit = await voegGastheerToe(sessie as never, await Astro.request.formData(), actorVanSessie(Astro.locals.beheer));
    doel.searchParams.set(uit.ok ? 'melding' : 'fout', uit.melding);
  }
  return Astro.redirect(doel.toString());
}

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const flash = Astro.url.searchParams.get('demo') === '1';
const fout = Astro.url.searchParams.get('fout');
const melding = Astro.url.searchParams.get('melding');
---

<Beheer titel="Gastheren">
  <header class="bh-top">
    <div>
      <h1>Gastheren</h1>
      <p class="bh-hint">
        Administratie van gastheren en gastvrouwen. Hans gebruikt deze lijst in Planning.
        De 2-wekenmail naar de gastheer is niet actief.
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {melding && <p class="bh-flash">{melding}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  <table class="bh-tabel">
    <thead>
      <tr>
        <th>Naam</th>
        <th>E-mail</th>
        <th>Telefoon</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {
        snapshot.gastheren.map((g) => (
          <tr>
            <td>
              <a href={`/beheer/instellingen/gastheren/${encodeURIComponent(g.id)}/`}>{g.naam}</a>
            </td>
            <td>{g.email}</td>
            <td>{g.telefoon}</td>
            <td>
              <span class={`bh-badge ${g.actief ? 'bh-badge--actief' : 'bh-badge--verborgen'}`}>
                {g.actief ? 'Actief' : 'Inactief'}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <section class="bh-kaart">
    <h2>Nieuwe gastheer</h2>
    <form method="post" class="bh-form">
      <label for="naam">Naam</label>
      <input id="naam" name="naam" />
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" />
      <label for="telefoon">Telefoon</label>
      <input id="telefoon" name="telefoon" />
      <label for="relatieId">Bestaande relatie-id, optioneel</label>
      <input id="relatieId" name="relatieId" inputmode="numeric" />
      <div class="bh-acties">
        <button class="bh-btn" type="submit">Gastheer toevoegen</button>
      </div>
    </form>
  </section>
</Beheer>
