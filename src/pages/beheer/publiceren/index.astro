---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { demoNaActie, formatNl } from '../../../platform/demo-data';
import { bewaarVrijgekomenWeekendBanner } from '../../../platform/beheer-supabase-schrijf.ts';
import { bezetteKalenderDagen } from '../../../lib/datum.ts';
import { leesBezetteData } from '../../../lib/publiek-lezen.ts';
import {
  STANDAARD_VRIJGEKOMEN_WEEKEND,
  VRIJGEKOMEN_WEEKEND_SLEUTEL,
  bannerUitFormulier,
  bannerZichtbaar,
  bezetteDagenUitBronnen,
  parseVrijgekomenWeekend,
  volledigVrijeWeekenden,
} from '../../../lib/vrijgekomen-weekend.ts';
import { laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord } from '../../../platform/beheer-bron.ts';
import { actorVanSessie } from '../../../lib/operatie/runtime.ts';
import { voerPublicatie } from '../../../lib/activiteit-schrijf.ts';
import { uploadPublicatieFoto } from '../../../lib/publicatie-foto.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { directeFotoUrl } from '../../../lib/agenda-zichtbaarheid.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';
import { nuZichtbaarOpWebsite } from '../../../lib/agenda-zichtbaarheid.ts';
import {
  WERKSTATUS,
  contentCompleet,
  leesVensterStap,
  publicatieBesluit,
  publicatieChecks,
  publicatieDossierHref,
  publicatieUitBoekingen,
  publicatieWerklijst,
  slugBijPublicatie,
  slugNaPublicatie,
  urlVoorstelZonderContentverlies,
  websiteUrl,
  werkstatus,
  type PublicatieBron,
} from '../../../platform/publiceren.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const vandaag = ymdInAmsterdam(new Date());
const stap = leesVensterStap(Astro.url.searchParams.get('stap'));
const openId = Astro.url.searchParams.get('open') ?? '';
const slugLetOp = Astro.url.searchParams.get('slugletop') ?? '';

const bronnen: PublicatieBron[] = snapshot.agenda.map((activiteit) => ({
  id: activiteit.id,
  start: activiteit.start,
  eind: activiteit.eind,
  titel: activiteit.titel,
  exposanten: activiteit.exposanten || '',
  organisatie: activiteit.exposanten || '',
  korteOmschrijving: activiteit.korteOmschrijving || '',
  volledigeOmschrijving: activiteit.volledigeOmschrijving || '',
  omschrijving: activiteit.omschrijving || '',
  praktisch: activiteit.praktisch || '',
  fotoPad: activiteit.fotoPad || '',
  slug: activiteit.slug || '',
  soort: activiteit.soort || '',
  publicatiestatus: activiteit.publicatiestatus ?? null,
  geannuleerd: activiteit.levenscyclus === 'geannuleerd',
  tabel: activiteit.tabel,
  legacyId: activiteit.legacyId,
  boekingId: activiteit.boekingId,
  trigger: activiteit.trigger,
}));
const verhuur = publicatieUitBoekingen(
  snapshot.boekingen.map((boeking) => ({
    id: boeking.id,
    start: boeking.start,
    eind: boeking.eind,
    titel: boeking.interneTitel,
    huurder: boeking.huurder,
    status: boeking.status,
    soort: boeking.soort,
  })),
  bronnen,
);
const { venster, items } = publicatieWerklijst([...bronnen, ...verhuur], vandaag, stap);
const bezetteSlugs = new Set(snapshot.agenda.map((activiteit) => activiteit.slug).filter((slug): slug is string => Boolean(slug)));

function bezettingUitSnapshot(): Set<string> {
  return bezetteDagenUitBronnen({
    boekingen: snapshot.boekingen,
    blokkades: snapshot.intern,
    agenda: snapshot.agenda,
  }, bezetteKalenderDagen);
}

let bezetteDagen: Set<string>;
if (snapshot.bron === 'demo') {
  bezetteDagen = bezettingUitSnapshot();
} else {
  try {
    bezetteDagen = bezetteKalenderDagen(await leesBezetteData());
  } catch {
    bezetteDagen = bezettingUitSnapshot();
  }
}
const vrijeWeekenden = volledigVrijeWeekenden(bezetteDagen);
const vrijeZaterdagen = new Set(vrijeWeekenden.map((weekend) => weekend.zaterdag));

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const actie = String(data.get('actie') ?? '');
  if (actie === 'vrij_weekend_banner') {
    const terugBanner = new URL(Astro.url.pathname, Astro.url.origin);
    const bron = Astro.url.searchParams.get('bron');
    if (bron) terugBanner.searchParams.set('bron', bron);
    if (snapshot.bron === 'demo') return Astro.redirect(demoNaActie(Astro.url));
    try {
      const formulier = bannerUitFormulier(data, vrijeZaterdagen);
      const schrijver = sessieSupabaseUitAstro(Astro);
      if (!schrijver) {
        terugBanner.searchParams.set('fout', 'Je bent niet ingelogd. De banner is niet opgeslagen.');
        return Astro.redirect(terugBanner.toString());
      }
      await bewaarVrijgekomenWeekendBanner(schrijver as never, formulier);
      terugBanner.searchParams.set('melding', 'De vrij-weekendbanner is opgeslagen.');
      return Astro.redirect(terugBanner.toString());
    } catch (error) {
      terugBanner.searchParams.set('fout', error instanceof Error ? error.message : 'Opslaan van de banner mislukt.');
      return Astro.redirect(terugBanner.toString());
    }
  }
  const id = String(data.get('id') ?? '');
  const item = items.find((kandidaat) => kandidaat.id === id) ?? bronnen.find((kandidaat) => kandidaat.id === id);
  const terug = new URL(Astro.url.pathname, Astro.url.origin);
  if (stap) terug.searchParams.set('stap', String(stap));
  terug.searchParams.set('open', id);
  if (!item) {
    terug.searchParams.set('fout', 'Activiteit niet gevonden in deze werklijst.');
    return Astro.redirect(terug.toString());
  }
  const exposanten = String(data.get('exposanten') ?? item.exposanten ?? '');
  const titel = String(data.get('titel') ?? item.titel);
  const concept: PublicatieBron = {
    ...item,
    titel,
    exposanten,
    korteOmschrijving: String(data.get('korte_omschrijving') ?? ''),
    volledigeOmschrijving: String(data.get('volledige_omschrijving') ?? ''),
    praktisch: String(data.get('praktische_informatie') ?? ''),
    fotoPad: String(data.get('foto_pad') ?? ''),
    slug: String(data.get('slug') ?? item.slug ?? ''),
  };
  const fotoBestand = data.get('foto_bestand');
  if (fotoBestand instanceof File && fotoBestand.size > 0) {
    const sessieVoorFoto = sessieSupabaseUitAstro(Astro);
    if (!sessieVoorFoto) {
      terug.searchParams.set('fout', 'Je bent niet ingelogd. De afbeelding is niet opgeslagen.');
      return Astro.redirect(terug.toString());
    }
    const geupload = await uploadPublicatieFoto(sessieVoorFoto, fotoBestand, id);
    if (!geupload.ok) {
      terug.searchParams.set('fout', geupload.melding);
      return Astro.redirect(terug.toString());
    }
    concept.fotoPad = geupload.fotoPad;
  }
  if (actie === 'genereer') {
    const voorstel = urlVoorstelZonderContentverlies(concept, bezetteSlugs, data.get('slug_bewust') === 'ja');
    concept.slug = voorstel.item.slug;
    concept.titel = voorstel.item.titel;
    concept.exposanten = voorstel.item.exposanten;
    concept.korteOmschrijving = voorstel.item.korteOmschrijving;
    concept.volledigeOmschrijving = voorstel.item.volledigeOmschrijving;
    concept.praktisch = voorstel.item.praktisch;
    concept.fotoPad = voorstel.item.fotoPad;
  }
  const checks = publicatieChecks(concept);
  const publiceren = actie === 'publiceer' || actie === 'toch_publiceren';
  const besluit = publicatieBesluit(checks, actie === 'toch_publiceren');
  if (publiceren && !besluit.mag) {
    terug.searchParams.set('fout', besluit.melding);
    return Astro.redirect(terug.toString());
  }
  if (publiceren && item.geannuleerd) {
    terug.searchParams.set('fout', 'Een geannuleerde activiteit wordt niet gepubliceerd.');
    return Astro.redirect(terug.toString());
  }
  if (publiceren && !concept.slug?.trim()) {
    concept.slug = slugBijPublicatie({
      exposanten,
      titel,
      slug: '',
      start: concept.start,
      bezet: bezetteSlugs,
    });
  }
  const slugBesluit = slugNaPublicatie(item, concept.slug ?? '', data.get('slug_bewust') === 'ja');
  if (slugBesluit.waarschuwing && data.get('slug_bewust') !== 'ja' && concept.slug && concept.slug !== item.slug) {
    terug.searchParams.set('slugletop', slugBesluit.waarschuwing);
    terug.searchParams.set('fout', slugBesluit.waarschuwing);
    return Astro.redirect(terug.toString());
  }
  const actor = actorVanSessie(Astro.locals.beheer);
  const rij = snapshot.agenda.find((kandidaat) => kandidaat.id === item.id);
  const opgeslagen = await voerPublicatie(omgevingsRecord(), {
    tabel: item.tabel || 'publieke_activiteiten',
    id: item.tabel === 'boekingen' ? item.id : (rij?.activiteitId || item.id.replace(/^bron:/, '')),
    actie: actie === 'verberg' ? 'verberg' : publiceren ? 'publiceer' : 'bewaar',
    payload: {
      titel: concept.titel,
      exposanten: concept.exposanten,
      korte_omschrijving: concept.korteOmschrijving,
      volledige_omschrijving: concept.volledigeOmschrijving,
      praktische_informatie: concept.praktisch,
      foto_pad: concept.fotoPad,
      slug: slugBesluit.slug,
      slug_bewust: data.get('slug_bewust') === 'ja' ? 'true' : 'false',
      force_publish: besluit.force ? 'true' : 'false',
      ontbrekend: besluit.ontbrekend,
    },
    actorNaam: actor.naam,
    actorId: actor.id,
  }, sessieSupabaseUitAstro(Astro));
  terug.searchParams.set(opgeslagen.ok ? 'melding' : 'fout', opgeslagen.melding);
  return Astro.redirect(terug.toString());
}

const melding = Astro.url.searchParams.get('melding');
const fout = Astro.url.searchParams.get('fout');

let weekendInstelling = { ...STANDAARD_VRIJGEKOMEN_WEEKEND };
let weekendGelezen = false;
const weekendLezer = sessieSupabaseUitAstro(Astro);
if (weekendLezer && snapshot.bron !== 'demo') {
  const { data, error } = await weekendLezer
    .from('instellingen')
    .select('waarde')
    .eq('sleutel', VRIJGEKOMEN_WEEKEND_SLEUTEL)
    .maybeSingle();
  if (!error && data?.waarde) {
    const geparsed = parseVrijgekomenWeekend(data.waarde);
    if (geparsed) {
      weekendInstelling = geparsed;
      weekendGelezen = true;
    }
  }
}
const gekozenWeekend = vrijeWeekenden.find((weekend) => weekend.zaterdag === weekendInstelling.zaterdag) ?? null;
const bannerNuZichtbaar = bannerZichtbaar(weekendInstelling, new Date(), bezetteDagen);
const terugvalTekst = !weekendGelezen && bannerZichtbaar(STANDAARD_VRIJGEKOMEN_WEEKEND, new Date())
  ? ' Nog niet opgeslagen; tot die tijd geldt 17 en 18 oktober 2026.'
  : !weekendGelezen
    ? ' Nog niet opgeslagen.'
    : '';
function stapHref(volgende: number): string {
  const params = new URLSearchParams();
  if (volgende !== 0) params.set('stap', String(volgende));
  const query = params.toString();
  return query ? `/beheer/publiceren/?${query}` : '/beheer/publiceren/';
}
---

<Beheer titel="Publiceren">
  <header class="bh-top">
    <div>
      <h1>Publiceren</h1>
      <p class="bh-hint">Te publiceren komende 8 weken. {formatNl(venster.van)} t/m {formatNl(venster.tot)}. Zien, aanvullen, een URL maken en publiceren.</p>
    </div>
  </header>
  {melding && <p class="bh-flash">{melding}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  <section class="bh-kaart" id="vrij-weekend-banner">
    <h2>Vrij weekend</h2>
    <p class="bh-hint">
      Banner onder de kop van de website, ook op de homepage. Zet hem aan of uit en kies een weekend dat vrij is.
      De datum en de periode worden automatisch uit dat weekend gehaald. Na het weekend verdwijnt de banner vanzelf.
    </p>
    <p class="bh-muted">
      {bannerNuZichtbaar ? 'Deze banner is nu zichtbaar.' : 'Deze banner staat nu niet op de website.'}
      {terugvalTekst}
    </p>
    {!gekozenWeekend && weekendInstelling.zaterdag && (
      <p class="bh-flash bh-flash--fout">Het gekozen weekend is niet meer vrij. Kies een ander weekend of zet de banner uit.</p>
    )}
    <form method="post" class="bh-form">
      <input type="hidden" name="actie" value="vrij_weekend_banner" />
      <input type="hidden" name="actief" value="0" />
      <label class="bh-check">
        <input type="checkbox" name="actief" value="1" checked={weekendInstelling.actief} />
        <span>Banner tonen</span>
      </label>
      <label for="vrij-weekend">Weekend</label>
      {vrijeWeekenden.length === 0 ? (
        <p class="bh-leeg">Er is geen vrij weekend om te kiezen.</p>
      ) : (
        <select id="vrij-weekend" name="zaterdag">
          <option value="" selected={!gekozenWeekend}>Kies een vrij weekend</option>
          {vrijeWeekenden.map((weekend) => (
            <option
              value={weekend.zaterdag}
              selected={weekend.zaterdag === weekendInstelling.zaterdag}
              data-periode={weekend.periode}
            >
              {weekend.label}
            </option>
          ))}
        </select>
      )}
      <p class="bh-muted" id="vrij-weekend-periode">
        {gekozenWeekend
          ? `Periode: ${gekozenWeekend.periode}`
          : 'Kies een vrij weekend. De periode wordt daarna automatisch ingevuld.'}
      </p>
      <div class="bh-acties">
        <button class="bh-btn" type="submit">{snapshot.bron === 'demo' ? 'Bewaar (voorbeeld)' : 'Bewaar banner'}</button>
      </div>
    </form>
  </section>

  <nav class="bh-jaar" aria-label="Periode van 8 weken">
    <a href={stapHref(stap - 1)}>‹ Vorige 8 weken</a>
    {stap !== 0 && <a href={stapHref(0)}>Vanaf vandaag</a>}
    <a href={stapHref(stap + 1)}>Volgende 8 weken ›</a>
  </nav>

  {items.length === 0 ? (
    <p class="bh-leeg">Geen activiteiten in deze acht weken.</p>
  ) : (
    items.map((item) => {
      const checks = publicatieChecks(item);
      const status = werkstatus(item, checks);
      const compleet = contentCompleet(checks);
      const slugVeld = item.slug || '';
      const nuZichtbaar = nuZichtbaarOpWebsite({
        zichtbaarheid: item.publicatiestatus,
        geannuleerd: item.geannuleerd,
        start: item.start,
        eind: item.eind,
        trigger: item.trigger,
        vandaag,
        viaPubliekeAgenda: item.tabel === 'publieke_activiteiten',
      });
      return (
        <details class="bh-kaart" open={openId === item.id}>
          <summary>
            <strong>{formatNl(item.start)}{item.eind !== item.start ? ` – ${formatNl(item.eind)}` : ''}</strong>
            {' · '}{item.titel || 'Zonder titel'}
            {' · '}{item.exposanten || item.organisatie || 'Geen exposant'}
            {' · '}<span class={`bh-badge bh-badge--${status}`}>{WERKSTATUS[status]}</span>
          </summary>
          <p class="bh-hint">
            Content compleet: {compleet ? 'ja' : 'nee'}.
            Afbeelding: {item.fotoPad ? 'eigen afbeelding' : 'standaardafbeelding wordt gebruikt'}.
            URL: {item.slug ? 'gereed' : 'wordt automatisch gemaakt'}.
            Nu zichtbaar op website: {nuZichtbaar ? 'ja' : 'nee'}.
          </p>
          <ul class="bh-checks">
            {checks.map((check) => (
              <li>
                {check.rol === 'automatisch'
                  ? check.label
                  : `${check.ok ? '✓' : '⚠'} ${check.ok ? check.label : check.label.replace('aanwezig', 'ontbreekt')}`}
              </li>
            ))}
          </ul>
          {!compleet && status !== 'geannuleerd' && (
            <p class="bh-hint">Deze activiteit is nog niet volledig. Je kunt hem wel publiceren.</p>
          )}
          {openId === item.id && melding && <p class="bh-flash">{melding}</p>}
          {openId === item.id && fout && <p class="bh-flash bh-flash--fout">{fout}</p>}
          {openId === item.id && slugLetOp && <p class="bh-flash bh-flash--fout">{slugLetOp}</p>}
          <form method="post" enctype="multipart/form-data" class="bh-form">
            <input type="hidden" name="id" value={item.id} />
            <label for={`titel-${item.id}`}>Titel</label>
            <input id={`titel-${item.id}`} name="titel" value={item.titel} />
            <label for={`exposanten-${item.id}`}>Exposant(en)</label>
            <input id={`exposanten-${item.id}`} name="exposanten" value={item.exposanten || ''} />
            <label for={`kort-${item.id}`}>Korte omschrijving</label>
            <textarea id={`kort-${item.id}`} name="korte_omschrijving" rows="3">{item.korteOmschrijving || ''}</textarea>
            <label for={`lang-${item.id}`}>Volledige omschrijving</label>
            <textarea id={`lang-${item.id}`} name="volledige_omschrijving" rows="6">{item.volledigeOmschrijving || ''}</textarea>
            <label for={`praktisch-${item.id}`}>Openingstijden en praktische informatie</label>
            <textarea id={`praktisch-${item.id}`} name="praktische_informatie" rows="3">{item.praktisch || ''}</textarea>
            <label for={`foto-bestand-${item.id}`}>Hoofdafbeelding / flyer</label>
            <input id={`foto-bestand-${item.id}`} name="foto_bestand" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            <input type="hidden" name="foto_pad" value={item.fotoPad || ''} />
            {directeFotoUrl(item.fotoPad) ? (
              <img src={directeFotoUrl(item.fotoPad) ?? ''} alt="Huidige hoofdafbeelding" width="240" />
            ) : (
              <p class="bh-muted">Standaardafbeelding wordt gebruikt. Kies een foto van je computer, of laat dit leeg.</p>
            )}
            <label for={`slug-${item.id}`}>Website-URL</label>
            <input id={`slug-${item.id}`} name="slug" value={slugVeld} placeholder="evelien-bannenberg" />
            <p class="bh-flash bh-flash--fout" data-slug-letop hidden></p>
            <p class="bh-muted">
              Website:{' '}
              {slugVeld && status === 'gepubliceerd' ? (
                <a href={websiteUrl(slugVeld)}>{websiteUrl(slugVeld).replace('https://', '')}</a>
              ) : (
                slugVeld ? websiteUrl(slugVeld).replace('https://', '') : 'nog geen URL'
              )}
            </p>
            {status === 'gepubliceerd' && (
              <label class="bh-check">
                <input type="checkbox" name="slug_bewust" value="ja" />
                Ik wil de gepubliceerde URL bewust wijzigen
              </label>
            )}
            <p><a href={publicatieDossierHref(item)}>{item.tabel === 'boekingen' ? 'Open de boeking' : 'Open het activiteitdossier'}</a></p>
            <div class="bh-form-rij">
              <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="bewaar">Opslaan</button>
              <button
                class="bh-btn bh-btn--sec"
                type="button"
                data-genereer-url
                data-id={item.id}
                data-start={item.start}
                data-eind={item.eind}
                data-huidige-slug={item.slug || ''}
                data-status={item.publicatiestatus || ''}
              >Genereer URL</button>
              {status !== 'geannuleerd' && compleet && (
                <button class="bh-btn" type="submit" name="actie" value="publiceer">{status === 'gepubliceerd' ? 'Wijzigingen publiceren' : 'Publiceer'}</button>
              )}
              {status !== 'geannuleerd' && !compleet && (
                <button class="bh-btn" type="submit" name="actie" value="toch_publiceren" onclick="return confirm('Deze activiteit is nog niet volledig. Toch publiceren?')">{status === 'gepubliceerd' ? 'Wijzigingen publiceren' : 'Toch publiceren'}</button>
              )}
              {status === 'gepubliceerd' && (
                <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="verberg">Verbergen</button>
              )}
            </div>
          </form>
        </details>
      );
    })
  )}
  <script type="application/json" id="bezette-slugs" set:html={JSON.stringify([...bezetteSlugs])} />
</Beheer>

<script>
  import { urlVoorstelZonderContentverlies, type PublicatieBron } from '../../../platform/publiceren.ts';

  const bezet = new Set<string>(JSON.parse(document.getElementById('bezette-slugs')?.textContent || '[]'));

  document.querySelectorAll<HTMLButtonElement>('[data-genereer-url]').forEach((knop) => {
    knop.addEventListener('click', () => {
      const form = knop.closest('form');
      if (!form) return;
      const waarde = (naam: string) =>
        form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${naam}"]`)?.value ?? '';
      const status = knop.dataset.status;
      const bron: PublicatieBron = {
        id: knop.dataset.id || '',
        start: knop.dataset.start || '',
        eind: knop.dataset.eind || '',
        titel: waarde('titel'),
        exposanten: waarde('exposanten'),
        korteOmschrijving: waarde('korte_omschrijving'),
        volledigeOmschrijving: waarde('volledige_omschrijving'),
        praktisch: waarde('praktische_informatie'),
        fotoPad: waarde('foto_pad'),
        slug: knop.dataset.huidigeSlug || waarde('slug'),
        publicatiestatus: status === 'publiek' || status === 'verborgen' || status === 'bezet' ? status : null,
      };
      const bewust = form.querySelector<HTMLInputElement>('[name="slug_bewust"]')?.checked ?? false;
      const besluit = urlVoorstelZonderContentverlies(bron, bezet, bewust);
      const slugVeld = form.querySelector<HTMLInputElement>('[name="slug"]');
      if (slugVeld) slugVeld.value = besluit.item.slug || '';
      const letop = form.querySelector<HTMLElement>('[data-slug-letop]');
      if (letop) {
        letop.textContent = besluit.waarschuwing;
        letop.hidden = !besluit.waarschuwing;
      }
    });
  });

  const weekendKeuze = document.getElementById('vrij-weekend');
  const weekendPeriode = document.getElementById('vrij-weekend-periode');
  weekendKeuze?.addEventListener('change', () => {
    if (!(weekendKeuze instanceof HTMLSelectElement) || !weekendPeriode) return;
    const periode = weekendKeuze.selectedOptions[0]?.dataset.periode;
    weekendPeriode.textContent = periode
      ? `Periode: ${periode}`
      : 'Kies een vrij weekend. De periode wordt daarna automatisch ingevuld.';
  });
</script>

