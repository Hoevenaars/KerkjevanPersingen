---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { formatNl } from '../../../platform/demo-data';
import { beheerId, laadBeheerSnapshot, beheerSnapshotOpties, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { bouwNieuwsbriefHtml, SFEER_URL } from '../../../lib/nieuwsbrief-html';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const id = beheerId(Astro.params.id);
const brief = snapshot.nieuwsbrieven.find((n) => n.id === id);

if (Astro.request.method === 'POST') {
  const doel = new URL(Astro.url.pathname, Astro.url.origin);
  doel.searchParams.set('fout', 'Nieuwsbrief bewaren en verzenden zijn nog niet beschikbaar. Er is geen mail verstuurd.');
  return Astro.redirect(doel.toString());
}

if (!brief) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
}

const flash = Astro.url.searchParams.get('demo') === '1';
const fout = Astro.url.searchParams.get('fout');
const kortNieuws = Astro.url.searchParams.has('kort')
  ? (Astro.url.searchParams.get('kort') ?? '')
  : brief.kortNieuws;
const donatieTekst = Astro.url.searchParams.has('donatie')
  ? (Astro.url.searchParams.get('donatie') ?? '')
  : brief.donatieUpdate;
const extraTitel = Astro.url.searchParams.get('extraTitel') ?? '';
const extraTekst = Astro.url.searchParams.get('extraTekst') ?? '';
const donatieAan = Astro.url.searchParams.get('donatieAan') === '1';
const extraBlokken =
  extraTitel.trim() || extraTekst.trim()
    ? [{ titel: extraTitel, tekst: extraTekst }]
    : undefined;

const html = bouwNieuwsbriefHtml(
  {
    kortNieuws: kortNieuws || undefined,
    donatieUpdate: donatieAan ? donatieTekst || undefined : undefined,
    extraBlokken,
  },
  snapshot.agenda.filter((p) => p.omschrijving).map((p) => ({
    titel: p.titel,
    datumTekst: formatNl(p.start),
    omschrijving: p.omschrijving,
    fotoUrl: SFEER_URL,
    fotoAlt: p.titel,
    agendaUrl: 'https://kerkjepersingen.nl/agenda/',
    kop: 'Komende activiteiten',
    isExpositie: true,
  })),
  'https://kerkjepersingen.nl/vrienden/afmelden',
  {
    kop: 'Nieuwsbrief',
    intro: 'Voorbeeldpreview — deze mail gaat nergens heen.',
    onderwerp: `Voorbeeld · week ${formatNl(brief.week)}`,
    agendaKop: 'Komende activiteiten',
    legeAgendaTekst: 'Deze week geen activiteiten in deze bron.',
  },
);
---

<Beheer titel={`Nieuwsbrief ${formatNl(brief.week)}`}>
  <p class="bh-crumb"><a href="/beheer/nieuwsbrief/">Nieuwsbrief</a> / {formatNl(brief.week)}</p>
  <header class="bh-top">
    <div>
      <h1>Week van {formatNl(brief.week)}</h1>
      <p class="bh-hint">Voorbeeld op dit scherm. Bewaren en verzenden zijn niet beschikbaar. Er gaat geen nieuwsbrief uit.</p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  <div class="bh-split">
    <section class="bh-kaart">
      <h2>Inhoud</h2>
      <form method="post" class="bh-form">
        <label for="kort">Kort nieuws</label>
        <textarea id="kort" name="kortNieuws">{kortNieuws}</textarea>

        <label class="bh-check" for="donatieAan">
          <input id="donatieAan" name="donatieAan" type="checkbox" value="1" checked={donatieAan} />
          <span>Donatie-update in deze mail (niet standaard)</span>
        </label>
        <label for="donatie">Donatie-update</label>
        <textarea id="donatie" name="donatieUpdate" class="kort">{donatieTekst}</textarea>
        <p class="bh-muted">Alleen in de preview en de mail als het vinkje aan staat.</p>

        <label for="extraTitel">Extra blok (optioneel)</label>
        <input id="extraTitel" name="extraTitel" value={extraTitel} placeholder="Kop, bijvoorbeeld Vrijwilligers" />
        <label for="extraTekst">Tekst extra blok</label>
        <textarea id="extraTekst" name="extraTekst" class="kort">{extraTekst}</textarea>

        <div class="bh-acties">
          <button class="bh-btn bh-btn--sec" type="button" disabled>Nieuwsbrief bewaren — nog niet beschikbaar</button>
          <button class="bh-btn" type="button" disabled>Nieuwsbrief verzenden — nog niet beschikbaar</button>
        </div>
      </form>
    </section>
    <section class="bh-kaart">
      <h2>Preview</h2>
      <iframe class="bh-preview-frame" title="Voorbeeld nieuwsbrief" srcdoc={html}></iframe>
    </section>
  </div>
</Beheer>
