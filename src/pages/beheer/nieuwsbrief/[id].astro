---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { formatNl } from '../../../platform/demo-data';
import { beheerId, laadBeheerSnapshot, beheerSnapshotOpties, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { bronnenVoorWeek, nieuwsbriefVoorbeeldHtml } from '../../../lib/nieuwsbrief-voorbeeld.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { magSchrijven } from '../../../platform/rechten.ts';
import NieuwsbriefBereik from '../../../components/beheer/NieuwsbriefBereik.astro';
import { bereikVanRijen } from '../../../lib/nieuwsbrief-bereik.ts';
import { bereikVoorBeheer } from '../../../lib/nieuwsbrief-bereik-opslag.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const id = beheerId(Astro.params.id);
const brief = snapshot.nieuwsbrieven.find((n) => n.id === id);

if (Astro.request.method === 'POST') {
  const formulier = await Astro.request.formData();
  const terug = String(formulier.get('terug') ?? '');
  const doel = terug === 'lijst'
    ? new URL('/beheer/nieuwsbrief/', Astro.url.origin)
    : terug === 'preview'
      ? new URL(`/beheer/nieuwsbrief/${encodeURIComponent(id)}/voorbeeld/`, Astro.url.origin)
      : new URL(Astro.url.pathname, Astro.url.origin);
  if (String(formulier.get('actie') ?? '') !== 'goedkeuren') {
    doel.searchParams.set('fout', 'Nieuwsbrief bewaren en verzenden zijn nog niet beschikbaar. Er is geen mail verstuurd.');
    return Astro.redirect(doel.toString());
  }
  const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
  if (!brief) {
    return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
  }
  if (Astro.locals.beheer?.viewAs || !magSchrijven(rechten, 'nieuwsbrief')) {
    doel.searchParams.set('fout', 'Goedkeuren vraagt schrijfrecht op de nieuwsbrief. Er is niets opgeslagen.');
    return Astro.redirect(doel.toString());
  }
  if (brief.verstuurd) {
    doel.searchParams.set('fout', 'Een verstuurde nieuwsbrief kan niet meer worden goedgekeurd.');
    return Astro.redirect(doel.toString());
  }
  if (snapshot.bron !== 'supabase') {
    doel.searchParams.set('fout', 'Goedkeuren kan alleen op de live lijst. Er is niets opgeslagen.');
    return Astro.redirect(doel.toString());
  }
  const client = sessieSupabaseUitAstro(Astro);
  if (!client) {
    doel.searchParams.set('fout', 'De verbinding ontbreekt. Er is niets opgeslagen.');
    return Astro.redirect(doel.toString());
  }
  const { data, error } = await client
    .from('nieuwsbrieven')
    .update({ goedgekeurd: true, goedgekeurd_op: new Date().toISOString() })
    .eq('id', Number(brief.id))
    .eq('verstuurd', false)
    .select('id');
  if (error || !data?.length) {
    doel.searchParams.set('fout', 'De week is niet goedgekeurd. Er is niets opgeslagen.');
    return Astro.redirect(doel.toString());
  }
  doel.searchParams.set('melding', 'Goedgekeurd. Deze week kan woensdag om 11.30 worden verstuurd.');
  return Astro.redirect(doel.toString());
}

if (!brief) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
}

const flash = Astro.url.searchParams.get('demo') === '1';
const fout = Astro.url.searchParams.get('fout');
const melding = Astro.url.searchParams.get('melding');
const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const kanGoedkeuren = Boolean(brief)
  && !brief.verstuurd
  && !brief.goedgekeurd
  && !Astro.locals.beheer?.viewAs
  && magSchrijven(rechten, 'nieuwsbrief');
const extraTitel = Astro.url.searchParams.get('extraTitel') ?? '';
const extraTekst = Astro.url.searchParams.get('extraTekst') ?? '';
const extraBlokken =
  extraTitel.trim() || extraTekst.trim()
    ? [{ titel: extraTitel, tekst: extraTekst }]
    : undefined;

const voorbeeld = nieuwsbriefVoorbeeldHtml({
  weekMaandag: brief.week,
  inhoud: { extraBlokken },
  bronnen: bronnenVoorWeek(snapshot),
});
const voorbeeldParams = new URLSearchParams(Astro.url.search);
voorbeeldParams.set('brief', '1');
const voorbeeldUrl = `/beheer/nieuwsbrief/${encodeURIComponent(brief.id)}/voorbeeld/?${voorbeeldParams.toString()}`;
const bereik = brief.verstuurd && snapshot.bron === 'supabase'
  ? await bereikVoorBeheer(sessieSupabaseUitAstro(Astro))
  : { rijen: [], fout: false };
const overzicht = bereikVanRijen(bereik.rijen, brief.id);
const meting = bereik.fout ? 'fout' : snapshot.bron === 'supabase' ? 'live' : 'voorbeeld';
---

<Beheer titel={`Nieuwsbrief ${formatNl(brief.week)}`}>
  <p class="bh-crumb"><a href="/beheer/nieuwsbrief/">Nieuwsbrief</a> / {formatNl(brief.week)}</p>
  <header class="bh-top">
    <div>
      <h1>Week van {formatNl(brief.week)}</h1>
      <p class="bh-hint">Het voorbeeld is de brief van deze week. Goedkeuren bewaart alleen die keuze. De mail gaat woensdag om 11.30 de deur uit als de week is goedgekeurd.</p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {melding && <p class="bh-flash">{melding}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  {
    brief.verstuurd ? (
      <NieuwsbriefBereik overzicht={overzicht} meting={meting} />
    ) : (
      <p class="bh-hint">Na verzending staat hier wie de brief opende, wie dat niet deed, en wie op de agenda-activiteit klikte.</p>
    )
  }

  <section class="bh-kaart">
    <div class="bh-top">
      {brief.goedgekeurd ? (
        <p class="bh-hint">Goedgekeurd</p>
      ) : kanGoedkeuren ? (
        <form method="post">
          <input type="hidden" name="actie" value="goedkeuren" />
          <button class="bh-btn" type="submit">Goedkeuren</button>
        </form>
      ) : (
        <p class="bh-hint">Nog niet goedgekeurd</p>
      )}
      <h2>Preview</h2>
      <p class="bh-hint">{voorbeeld.onderwerp}</p>
      <a href={`/beheer/nieuwsbrief/${encodeURIComponent(brief.id)}/voorbeeld/`}>Open de preview</a>
    </div>
    <iframe class="bh-preview-frame" title={`Preview nieuwsbrief ${formatNl(brief.week)}`} src={voorbeeldUrl}></iframe>
  </section>

  <section class="bh-kaart">
      <h2>Inhoud</h2>
      <form method="get" class="bh-form">
        <label for="extraTitel">Extra blok (optioneel)</label>
        <input id="extraTitel" name="extraTitel" value={extraTitel} placeholder="Kop, bijvoorbeeld Vrijwilligers" />
        <label for="extraTekst">Tekst extra blok</label>
        <textarea id="extraTekst" name="extraTekst" class="kort">{extraTekst}</textarea>

        <div class="bh-acties">
          <button class="bh-btn" type="submit">Toon in de preview</button>
        </div>
      </form>
  </section>
</Beheer>
