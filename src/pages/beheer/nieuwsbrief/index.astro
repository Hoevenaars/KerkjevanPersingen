---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { formatNl } from '../../../platform/demo-data';
import { laadBeheerSnapshot } from '../../../platform/beheer-bron.ts';

const snapshot = await laadBeheerSnapshot({ url: Astro.url });
---

<Beheer titel="Nieuwsbrief">
  <header class="bh-top">
    <div>
      <h1>Nieuwsbrief</h1>
      <p class="bh-hint">
        Weken uit {snapshot.bron === 'sanity' ? 'Sanity' : 'de voorbeelddata'}. Openen, bewerken en
        “verzenden” raakt de echte vriendenmail niet.
      </p>
    </div>
  </header>

  <table class="bh-tabel">
    <thead>
      <tr>
        <th>Week</th>
        <th>Kort nieuws</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {
        snapshot.nieuwsbrieven.length === 0 ? (
          <tr>
            <td colspan="3" class="bh-leeg">Geen nieuwsbriefweken.</td>
          </tr>
        ) : (
          snapshot.nieuwsbrieven.map((n) => (
            <tr>
              <td>
                <a href={`/beheer/nieuwsbrief/${encodeURIComponent(n.id)}/`}>{formatNl(n.week)}</a>
              </td>
              <td>{n.kortNieuws || '—'}</td>
              <td>
                <span class={`bh-badge ${n.verstuurd ? 'bh-badge--definitief' : n.overgeslagen ? 'bh-badge--verborgen' : 'bh-badge--optie'}`}>
                  {n.verstuurd ? 'Verstuurd' : n.overgeslagen ? 'Overgeslagen' : 'Concept'}
                </span>
              </td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>
</Beheer>
