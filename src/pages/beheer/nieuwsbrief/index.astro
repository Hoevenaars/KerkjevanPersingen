---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { formatNl } from '../../../platform/demo-data';
import { ymdInAmsterdam } from '../../../platform/datum.ts';
import { conceptStatusLabel, nieuwsbrievenOpDatum, verzendMoment } from '../../../lib/nieuwsbrief-concepten.ts';
import { laadBeheerSnapshot, beheerSnapshotOpties } from '../../../platform/beheer-bron.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { bereikVanRijen } from '../../../lib/nieuwsbrief-bereik.ts';
import { bereikVoorBeheer } from '../../../lib/nieuwsbrief-bereik-opslag.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const vandaag = ymdInAmsterdam(new Date());
const brieven = nieuwsbrievenOpDatum(snapshot.nieuwsbrieven, vandaag);
const moment = verzendMoment(vandaag);
const verzendDatum = formatNl(moment.vrijdag);
const verstuurd = snapshot.nieuwsbrieven
  .filter((brief) => brief.verstuurd)
  .sort((a, b) => b.week.localeCompare(a.week));
const bereik = snapshot.bron === 'supabase'
  ? await bereikVoorBeheer(sessieSupabaseUitAstro(Astro))
  : { rijen: [], fout: false };
---

<Beheer titel="Nieuwsbrief">
  <header class="bh-top">
    <div>
      <h1>Nieuwsbrief</h1>
      <p class="bh-hint">
        Controle voor {verzendDatum}. Verzenden op {verzendDatum} om {moment.uur}. Je kunt meerdere weken vooruit goedkeuren.
      </p>
    </div>
  </header>

  <table class="bh-tabel">
    <thead>
      <tr>
        <th>Week</th>
        <th>Kort nieuws</th>
        <th>Status</th>
        <th>Preview</th>
      </tr>
    </thead>
    <tbody>
      {
        brieven.length === 0 ? (
          <tr>
            <td colspan="4" class="bh-leeg">Geen open nieuwsbrieven.</td>
          </tr>
        ) : (
          brieven.map((n) => {
            const status = conceptStatusLabel({ ...n, vandaag });
            return (
            <tr>
              <td>
                <a href={`/beheer/nieuwsbrief/${encodeURIComponent(n.id)}/`}>{formatNl(n.week)}</a>
              </td>
              <td>{n.kortNieuws || '—'}</td>
              <td>
                <span class={`bh-badge ${n.verstuurd ? 'bh-badge--definitief' : n.overgeslagen ? 'bh-badge--verborgen' : 'bh-badge--optie'}`}>
                  {status}
                </span>
              </td>
              <td>
                <a href={`/beheer/nieuwsbrief/${encodeURIComponent(n.id)}/voorbeeld/`}>Preview</a>
              </td>
            </tr>
            );
          })
        )
      }
    </tbody>
  </table>

  {
    verstuurd.length > 0 && (
      <section class="bh-bereik">
        <h2>Verstuurd</h2>
        <p class="bh-hint">
          Per week: hoeveel vrienden de brief openden, wie dat niet deed, en wie op “Bekijk in de agenda” klikte.
        </p>
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Week</th>
              <th>Verstuurd</th>
              <th>Geopend</th>
              <th>Niet geopend</th>
              <th>Activiteit</th>
            </tr>
          </thead>
          <tbody>
            {verstuurd.map((brief) => {
              const telling = bereikVanRijen(bereik.rijen, brief.id);
              const leeg = snapshot.bron !== 'supabase' || bereik.fout || telling.verstuurd === 0;
              return (
                <tr>
                  <td>
                    <a href={`/beheer/nieuwsbrief/${encodeURIComponent(brief.id)}/`}>{formatNl(brief.week)}</a>
                  </td>
                  <td>{leeg ? '—' : telling.verstuurd}</td>
                  <td>{leeg ? '—' : telling.geopend}</td>
                  <td>{leeg ? '—' : telling.nietGeopend}</td>
                  <td>{leeg ? '—' : telling.activiteit}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {snapshot.bron !== 'supabase' && <p class="bh-hint">In het voorbeeld staan geen echte ontvangers.</p>}
        {bereik.fout && <p class="bh-hint">De openingen konden niet worden gelezen.</p>}
      </section>
    )
  }
</Beheer>
