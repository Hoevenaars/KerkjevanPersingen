---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { zoekInBron } from '../../../platform/demo-data';
import { laadBeheerSnapshot } from '../../../platform/beheer-bron.ts';

const snapshot = await laadBeheerSnapshot({ url: Astro.url });
const q = Astro.url.searchParams.get('q') ?? '';
const treffers = zoekInBron(snapshot, q);
const bronLabel = snapshot.bron === 'sanity' ? 'Sanity' : 'de voorbeelddata';
---

<Beheer titel="Zoeken">
  <header class="bh-top">
    <div>
      <h1>Zoeken</h1>
      <p class="bh-hint">
        {q.trim()
          ? `Resultaten voor “${q.trim()}” in ${bronLabel}.`
          : 'Typ een naam of datum in de zoekbalk, bijvoorbeeld Jansen of 12 september.'}
      </p>
    </div>
  </header>

  {
    q.trim() && treffers.length === 0 && (
      <p class="bh-leeg">Geen treffers in {bronLabel}.</p>
    )
  }

  {
    treffers.length > 0 && (
      <table class="bh-tabel">
        <thead>
          <tr>
            <th>Soort</th>
            <th>Titel</th>
            <th>Extra</th>
          </tr>
        </thead>
        <tbody>
          {treffers.map((t) => (
            <tr>
              <td>{t.soort}</td>
              <td>
                <a href={t.href}>{t.titel}</a>
              </td>
              <td>{t.extra}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</Beheer>
