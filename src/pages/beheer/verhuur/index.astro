---
export const prerender = false;

import BeheerConcept from '../../../layouts/BeheerConcept.astro';
import StatusMarkering from '../../../components/beheer/StatusMarkering.astro';
import VerhuurDossier from '../../../components/beheer/VerhuurDossier.astro';
import { beheerUitResponse } from '../../../platform/beheer-gate.ts';
import { laadBeheerSnapshot, beheerSnapshotOpties } from '../../../platform/beheer-bron.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';
import { BOEKING_LABEL, formatMaandNl } from '../../../platform/demo-data.ts';
import { magSchrijven, magZien } from '../../../platform/rechten.ts';
import { verhuurOverzichtAan, verhuurVerzoekToegestaan } from '../../../platform/verhuur-vlag.ts';
import { maakVerhuurOverzicht, type DossierSporen, type OverzichtBron } from '../../../platform/verhuur-overzicht.ts';
import { leesDossierSporen } from '../../../platform/verhuur-dossier-lees.ts';
import {
  bouwSchermRijen,
  dossierActiesZichtbaar,
  dossierUitBron,
  leesSchermFilter,
  maakDossierWeergave,
  mobielStatus,
  staatKleur,
  verhuurQuery,
  type SchermActiviteit,
  type SchermRij,
} from '../../../platform/verhuur-scherm.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { lijstIntake } from '../../../lib/intake-opslag.ts';
import { documentLinks } from '../../../lib/verhuur-document-link.ts';

if (!verhuurOverzichtAan()) return beheerUitResponse();
if (!verhuurVerzoekToegestaan(Astro.request.method)) {
  return new Response('Dit scherm wijzigt niets. Een gastheer kies je via de aparte knop in het dossier.', {
    status: 405,
    headers: { 'Cache-Control': 'no-store', 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const magGastheer = magSchrijven(rechten, 'boekingen') && !Astro.locals.beheer?.viewAs;
const vandaag = ymdInAmsterdam(new Date());

function adres(wijziging: Parameters<typeof verhuurQuery>[1] = {}): string {
  return verhuurQuery(Astro.url.searchParams, wijziging);
}

const betaalregelsZichtbaar = magZien(rechten, 'finance');
const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const filter = leesSchermFilter(Astro.url.searchParams, vandaag);
const bronnen: OverzichtBron[] = snapshot.agenda
  .filter((item) => item.tabel === 'activiteit_bron')
  .map((item) => ({
    id: item.activiteitId || item.id,
    titel: item.titel,
    start: item.start,
    eind: item.eind,
    zichtbaarheid: item.publicatiestatus ?? null,
    levenscyclus: item.levenscyclus === 'geannuleerd' ? 'geannuleerd' : 'actief',
  }));
const blokkades = snapshot.intern.map((item) => ({
  id: item.id,
  titel: item.titel,
  start: item.start,
  eind: item.eind,
  blokkeert: item.blokkeert,
  notities: item.notities ?? '',
}));
const overzicht = maakVerhuurOverzicht({
  jaar: filter.jaar,
  maand: filter.maand,
  boekingen: snapshot.boekingen,
  betalingen: snapshot.betalingen ?? [],
  betaalregelsZichtbaar,
  blokkades,
  bronnen,
  aanvragen: snapshot.aanvragen,
  documenten: snapshot.documenten.map((item) => ({
    boekingId: item.boekingId,
    naam: item.naam,
    soort: item.soort,
    datum: item.datum,
  })),
});
const activiteiten: SchermActiviteit[] = snapshot.agenda;
const schermBron = {
  boekingen: snapshot.boekingen,
  gastheren: snapshot.gastheren,
  toewijzingen: (snapshot.toewijzingen ?? []).map((item) => ({
    boekingId: item.boekingId,
    relatieId: item.relatieId,
    relatieNaam: item.relatieNaam,
  })),
  activiteiten,
};
const scherm = bouwSchermRijen({
  overzicht,
  ...schermBron,
  zoek: filter.zoek,
  alleenAandacht: filter.aandacht,
  toonGeannuleerd: filter.geannuleerd,
  toonVrij: filter.vrij,
  sort: filter.sort,
  dir: filter.dir,
});

const dossierId = Astro.url.searchParams.get('dossier');
const rijSleutel = Astro.url.searchParams.get('rij');
let dossierRij: SchermRij | null = scherm.rijen.find((rij) => rij.boekingId === dossierId) ?? null;
if (dossierId && !dossierRij) {
  const buiten = maakVerhuurOverzicht({
    jaar: filter.jaar,
    maand: null,
    boekingen: snapshot.boekingen,
    betalingen: snapshot.betalingen ?? [],
    betaalregelsZichtbaar,
    blokkades,
    bronnen,
    aanvragen: snapshot.aanvragen,
    documenten: [],
  });
  dossierRij = bouwSchermRijen({
    overzicht: buiten,
    ...schermBron,
    zoek: '',
    alleenAandacht: false,
    toonGeannuleerd: true,
    toonVrij: true,
  }).rijen.find((rij) => rij.boekingId === dossierId) ?? null;
}
const paneelRij = !dossierRij && rijSleutel ? scherm.rijen.find((rij) => rij.sleutel === rijSleutel) ?? null : null;
const boeking = dossierRij?.boekingId ? snapshot.boekingen.find((item) => item.id === dossierRij?.boekingId) ?? null : null;
const activiteit = boeking
  ? snapshot.agenda.find((item) => item.boekingId === boeking.id && item.tabel !== 'activiteit_bron') ?? null
  : null;
const relatie = boeking ? snapshot.relaties.find((item) => item.id === boeking.relatieId) ?? null : null;

let dossier = null;
let bronWeergave: ReturnType<typeof dossierUitBron> | null = null;
if (boeking && dossierRij) {
  const docs = snapshot.documenten.filter((item) => item.boekingId === boeking.id);
  const links = snapshot.bron === 'supabase' ? await documentLinks(sessieSupabaseUitAstro(Astro), docs) : {};
  const intake = snapshot.bron === 'supabase'
    ? (await lijstIntake(boeking.id).catch(() => [])).map((bestand, index) => ({
        naam: bestand.rol === 'hoofd' ? 'Hoofdfoto, privé aangeleverd' : `Extra bestand ${index + 1}`,
        url: bestand.url,
      }))
    : [];
  const relatieKaart = relatie
    ? {
        naam: relatie.naam,
        organisatie: relatie.organisatie ?? '',
        email: relatie.email,
        telefoon: relatie.telefoon,
        adres: relatie.adres ?? '',
      }
    : null;
  dossier = maakDossierWeergave({
    rij: dossierRij,
    boeking,
    relatie: relatieKaart,
    activiteit,
    gastheren: snapshot.gastheren,
    toewijzingen: schermBron.toewijzingen.filter((item) => item.boekingId === boeking.id),
    documenten: docs.map((item) => ({ ...item, url: links[item.id] ?? null })),
    betalingen: (snapshot.betalingen ?? []).filter((item) => item.boekingId === boeking.id),
    betaalregelsZichtbaar,
    intake,
  });
  const auditZichtbaar = Boolean(Astro.locals.beheer?.rechten.isSuperAdmin && !Astro.locals.beheer.viewAs);
  const leeg: DossierSporen = { verzendingen: [], verzendingFout: null, audit: [], auditFout: null, auditZichtbaar };
  const sporen = snapshot.bron === 'supabase'
    ? await leesDossierSporen(sessieSupabaseUitAstro(Astro), boeking.id, auditZichtbaar)
    : leeg;
  bronWeergave = dossierUitBron({
    boeking,
    invoer: {
      jaar: filter.jaar,
      maand: filter.maand,
      boekingen: snapshot.boekingen,
      betalingen: snapshot.betalingen ?? [],
      betaalregelsZichtbaar,
      blokkades,
      bronnen,
      aanvragen: snapshot.aanvragen,
      documenten: snapshot.documenten.map((item) => ({
        boekingId: item.boekingId,
        naam: item.naam,
        soort: item.soort,
        datum: item.datum,
      })),
    },
    relatie: relatieKaart,
    activiteit: activiteit
      ? {
          titel: activiteit.titel,
          zichtbaarheid: activiteit.publicatiestatus ?? '',
          levenscyclus: activiteit.levenscyclus ?? 'actief',
        }
      : null,
    sporen,
  });
}

const maanden = Array.from({ length: 12 }, (_, index) => {
  const nummer = index + 1;
  const sleutel = `${filter.jaar}-${String(nummer).padStart(2, '0')}`;
  return { waarde: String(nummer), label: formatMaandNl(sleutel).replace(` ${filter.jaar}`, '') };
});
const melding = Astro.url.searchParams.get('melding');
const fout = Astro.url.searchParams.get('fout');
const bronParam = Astro.url.searchParams.get('bron');
const sluitHref = adres({ dossier: null, rij: null, weg: null });
const filterAantal = [filter.aandacht, filter.geannuleerd, filter.vrij].filter(Boolean).length;

function sorteerHref(kolom: typeof filter.sort): string {
  const dir = filter.sort === kolom && filter.dir === 'asc' ? 'desc' : 'asc';
  return adres({ sort: kolom, dir, dossier: null, rij: null, weg: null });
}

function sorteerLabel(kolom: typeof filter.sort): string {
  if (filter.sort !== kolom) return '';
  return filter.dir === 'asc' ? ' ↑' : ' ↓';
}
---

<BeheerConcept titel="Verhuuragenda" actief="verhuur">
  <main class="kc-pagina" id="kc-lijst">
    <div class="kc-kop">
      <div>
        <p class="kc-wenkbrauw">Beheer · Kerkje van Persingen</p>
        <h1>Verhuuragenda</h1>
        <p class="kc-inleiding">Activiteiten die doorgaan. Klik op een huurder om het dossier te openen.</p>
      </div>
      {magGastheer && <a class="kc-knop kc-knop--primair" href="/beheer/boekingen/nieuw/">+ Nieuwe boeking</a>}
    </div>

    {melding && <p class="kc-melding" role="status">{melding}</p>}
    {fout && <p class="kc-fout" role="alert">{fout}</p>}

    <form class="kc-filters" method="get" action="/beheer/verhuur/">
      {bronParam === 'demo' && <input type="hidden" name="bron" value="demo" />}
      <div class="kc-veld">
        <label for="jaar">Jaar</label>
        <select id="jaar" name="jaar" onchange="this.form.requestSubmit()">
          {overzicht.jaren.map((jaar) => (
            <option value={jaar} selected={jaar === filter.jaar}>{jaar}</option>
          ))}
        </select>
      </div>
      <div class="kc-veld">
        <label for="maand">Maand</label>
        <select id="maand" name="maand" onchange="this.form.requestSubmit()">
          <option value="alle" selected={filter.maand == null}>Heel het jaar</option>
          {maanden.map((maand) => (
            <option value={maand.waarde} selected={String(filter.maand ?? '') === maand.waarde}>{maand.label}</option>
          ))}
        </select>
      </div>
      <div class="kc-veld kc-veld--zoek">
        <label for="query">Zoek huurder of activiteit</label>
        <input id="query" class="kc-zoek" name="q" type="search" placeholder="Bijvoorbeeld: Marieke Jansen" value={filter.zoek} />
      </div>
      {filter.sort !== 'weekend' && <input type="hidden" name="sort" value={filter.sort} />}
      {filter.dir === 'desc' && <input type="hidden" name="dir" value="desc" />}
      <details class="kc-filter">
        <summary>Filter{filterAantal > 0 ? ` (${filterAantal})` : ''}</summary>
        <div class="kc-filter-paneel">
          <label class="kc-vink">
            <input type="checkbox" name="aandacht" value="1" checked={filter.aandacht} onchange="this.form.requestSubmit()" />
            Aandachtspunten
          </label>
          <label class="kc-vink">
            <input type="checkbox" name="geannuleerd" value="1" checked={filter.geannuleerd} onchange="this.form.requestSubmit()" />
            Toon ook geannuleerd
          </label>
          <label class="kc-vink">
            <input type="checkbox" name="vrij" value="1" checked={filter.vrij} onchange="this.form.requestSubmit()" />
            Toon vrije weekenden
          </label>
        </div>
      </details>
      <button class="kc-knop" type="submit">Toon</button>
    </form>

    <div class="kc-lijst">
      <div class="kc-koprij">
        <a href={sorteerHref('weekend')} aria-sort={filter.sort === 'weekend' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Weekend{sorteerLabel('weekend')}</a>
        <a href={sorteerHref('huurder')} aria-sort={filter.sort === 'huurder' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Huurder / activiteit{sorteerLabel('huurder')}</a>
        <a href={sorteerHref('contract')} aria-sort={filter.sort === 'contract' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Contract{sorteerLabel('contract')}</a>
        <a href={sorteerHref('stukken')} aria-sort={filter.sort === 'stukken' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Content{sorteerLabel('stukken')}</a>
        <a href={sorteerHref('aanbetaling')} aria-sort={filter.sort === 'aanbetaling' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Aanbetaling{sorteerLabel('aanbetaling')}</a>
        <a href={sorteerHref('rest')} aria-sort={filter.sort === 'rest' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Restant{sorteerLabel('rest')}</a>
        <a class="kc-gastheer-kolom" href={sorteerHref('gastheer')} aria-sort={filter.sort === 'gastheer' ? (filter.dir === 'asc' ? 'ascending' : 'descending') : 'none'}>Gastheer{sorteerLabel('gastheer')}</a>
        <span></span>
      </div>
      {
        scherm.rijen.length === 0 ? (
          <p class="kc-leeg">Geen activiteiten in deze periode. Pas de maand of de zoekopdracht aan, of zet in Filter geannuleerde dossiers of vrije weekenden aan.</p>
        ) : (
          scherm.rijen.map((rij) => {
            const open = rij.boekingId ? adres({ dossier: rij.boekingId, rij: null, weg: null }) : adres({ rij: rij.sleutel, dossier: null, weg: null });
            const gekozen = rij.boekingId === dossierId || rij.sleutel === rijSleutel;
            return (
              <a
                class:list={[
                  'kc-rij',
                  rij.herkomst === 'vrij' && 'kc-rij--vrij',
                  rij.herkomst === 'winterstop' && 'kc-rij--winter',
                  rij.archief && 'kc-rij--geannuleerd',
                  gekozen && 'kc-rij--open',
                ]}
                href={open}
                data-kc-open
                aria-current={gekozen ? 'true' : undefined}
                aria-label={`Open ${rij.huurder}, ${rij.datum}`}
              >
                <span class="kc-datum">{rij.datum}<small>{rij.jaar}</small></span>
                <span class="kc-huurder">
                  {rij.huurder}
                  <small>{rij.activiteit}</small>
                  <small class="kc-mobiel">{mobielStatus(rij)}</small>
                </span>
                <span class="kc-kolom">
                  {rij.herkomst === 'boeking' ? <StatusMarkering kleur={staatKleur(rij.contract)} tekst={rij.contractTekst} /> : '—'}
                </span>
                <span class="kc-kolom">
                  {rij.herkomst === 'boeking' ? <StatusMarkering kleur={staatKleur(rij.stukken)} tekst={rij.stukkenTekst} /> : '—'}
                </span>
                <span class="kc-kolom">
                  {rij.herkomst === 'boeking' ? <StatusMarkering kleur={staatKleur(rij.aanbetaling)} tekst={rij.aanbetalingTekst} /> : '—'}
                </span>
                <span class="kc-kolom">
                  {rij.herkomst === 'boeking' ? <StatusMarkering kleur={staatKleur(rij.rest)} tekst={rij.restTekst} /> : '—'}
                </span>
                <span class="kc-kolom kc-gastheer-kolom">{rij.herkomst === 'boeking' ? (rij.gastheer || 'Nog kiezen') : '—'}</span>
                <span class="kc-pijl" aria-hidden="true">›</span>
              </a>
            );
          })
        )
      }
    </div>

    <div class="kc-legenda">
      <span><i style="background:#6b9562"></i> Afgerond</span>
      <span><i style="background:#d7a14d"></i> Actie nodig</span>
      <span><i style="background:#8f8b82"></i> Onbekend</span>
      <span><i style="background:#b8cab3"></i> Vrij weekend</span>
    </div>
  </main>

  {
    dossier && (
      <VerhuurDossier
        dossier={dossier}
        sluitHref={sluitHref}
        bevestigHref={adres({ dossier: dossier.id, weg: '1', rij: null })}
        formulierActie="/beheer/verhuur/gastheer"
        dossierActie="/beheer/verhuur/dossier"
        terug={adres({ dossier: dossier.id, weg: null, rij: null })}
        magSchrijven={magGastheer}
        demo={snapshot.bron !== 'supabase'}
        weg={Astro.url.searchParams.get('weg') === '1'}
        status={(boeking && BOEKING_LABEL[boeking.status]) || boeking?.status || 'onbekend'}
        acties={dossierActiesZichtbaar(boeking?.status ?? '')}
        incidenten={(snapshot.incidenten ?? [])
          .filter((item) => item.boekingId === boeking?.id && item.status !== 'gesloten')
          .map((item) => ({ id: item.id, omschrijving: item.omschrijving }))}
        gegevens={bronWeergave?.gegevens ?? []}
        betaalregels={bronWeergave?.betaling ?? []}
        geschiedenis={bronWeergave?.geschiedenis ?? []}
        geschiedenisToelichting={bronWeergave?.geschiedenisToelichting ?? ''}
        oudHref={`/beheer/boekingen/${encodeURIComponent(dossier.id)}/`}
      />
    )
  }

  {
    paneelRij && (
      <div class="kc-overlay">
        <a class="kc-achter" href={sluitHref}><span>Sluit</span></a>
        <aside class="kc-lade" role="dialog" aria-modal="true" aria-labelledby="kc-vrij-naam" tabindex="-1" data-kc-dossier>
          <div class="kc-lade-kop">
            <div class="kc-lade-top">
              <p class="kc-wenkbrauw">{paneelRij.datum} {paneelRij.jaar}</p>
              <a class="kc-sluit" id="kc-sluit" href={sluitHref} aria-label="Sluit">×</a>
            </div>
            <h2 id="kc-vrij-naam">{paneelRij.huurder}</h2>
            <p class="kc-sub">{paneelRij.activiteit}</p>
          </div>
          <div class="kc-lade-lichaam">
            <div class="kc-oproep">
              <div>
                <strong>{paneelRij.herkomst === 'vrij' ? 'Dit weekend is vrij' : paneelRij.huurder}</strong>
                <p>{paneelRij.bijzonderheden || 'Er is geen boeking op deze periode.'}</p>
              </div>
            </div>
            {paneelRij.herkomst === 'vrij' && magGastheer && (
              <p><a class="kc-knop kc-knop--primair" href="/beheer/boekingen/nieuw/">+ Nieuwe boeking</a></p>
            )}
          </div>
          <div class="kc-lade-voet">
            <span class="kc-bijschrift">Niets wordt gewijzigd.</span>
            <a class="kc-knop kc-knop--primair" href={sluitHref}>Sluiten</a>
          </div>
        </aside>
      </div>
    )
  }

  <script>
    const sleutel = 'kc-verhuur-scroll';
    const lade = document.querySelector('[data-kc-dossier]');
    const opgeslagen = sessionStorage.getItem(sleutel);
    if (!lade && opgeslagen) {
      const y = Number(opgeslagen);
      if (Number.isFinite(y)) requestAnimationFrame(() => window.scrollTo(0, y));
      sessionStorage.removeItem(sleutel);
    }
    const bewaar = () => sessionStorage.setItem(sleutel, String(window.scrollY));
    document.querySelectorAll('[data-kc-open]').forEach((element) => {
      element.addEventListener('click', bewaar);
    });
    document.querySelectorAll('form[data-kc-bewaar]').forEach((element) => {
      element.addEventListener('submit', bewaar);
    });
    if (lade instanceof HTMLElement) lade.focus();
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') document.getElementById('kc-sluit')?.click();
    });
  </script>
</BeheerConcept>
