---
export const prerender = false;

import { beheerUitResponse } from '../../../platform/beheer-gate.ts';
import { beheerId } from '../../../platform/beheer-bron.ts';
import { verhuurOverzichtAan, verhuurVerzoekToegestaan } from '../../../platform/verhuur-vlag.ts';
import { verhuurQuery } from '../../../platform/verhuur-scherm.ts';

if (!verhuurOverzichtAan()) return beheerUitResponse();
if (!verhuurVerzoekToegestaan(Astro.request.method)) {
  return new Response('Open het dossier vanuit de verhuuragenda.', {
    status: 405,
    headers: { 'Cache-Control': 'no-store', 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const doel = verhuurQuery(Astro.url.searchParams, {
  dossier: beheerId(Astro.params.id),
  rij: null,
  weg: null,
});
return Astro.redirect(doel);
---
