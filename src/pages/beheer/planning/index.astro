---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { demoNaActie, formatNl } from '../../../platform/demo-data';
import { laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { actorVanSessie, postAlsSupabase } from '../../../lib/operatie/runtime.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { metTerug } from '../../../platform/planning.ts';
import {
  deelGastbegeleiderPlanning,
  gastheerIdsVanPersoon,
  leesbareTitel,
  type PlanningBoeking,
} from '../../../platform/verhuur-classificatie.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';
import { gastherenVoorKoppeling } from '../../../platform/gastheer-lijst.ts';
import { magSchrijven } from '../../../platform/rechten.ts';

if (Astro.request.method === 'POST') {
  const operationeel = await postAlsSupabase({
    request: Astro.request,
    url: Astro.url,
    env: omgevingsRecord(),
    actor: actorVanSessie(Astro.locals.beheer),
    sessie: sessieSupabaseUitAstro(Astro),
  });
  if (operationeel) return operationeel;
  return Astro.redirect(demoNaActie(Astro.url));
}

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const flash = Astro.url.searchParams.get('demo') === '1';
const melding = Astro.url.searchParams.get('melding');
const fout = Astro.url.searchParams.get('fout');
const vandaag = ymdInAmsterdam(new Date());
const bronParam = Astro.url.searchParams.get('bron') ?? '';
const rechten = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const magIndelen = magSchrijven(rechten, 'planning') || magSchrijven(rechten, 'boekingen');
const persoon = Astro.locals.beheer?.gebruiker;
const eigenIds = gastheerIdsVanPersoon(snapshot.gastheren, {
  email: persoon?.email ?? '',
  naam: persoon?.naam ?? '',
});
const delen = deelGastbegeleiderPlanning({
  boekingen: snapshot.boekingen.map((boeking) => ({
    id: boeking.id,
    start: boeking.start,
    eind: boeking.eind,
    titel: boeking.interneTitel,
    huurder: boeking.huurder,
    soort: boeking.soort,
    status: boeking.status,
    gastheerId: boeking.gastheerId,
  })),
  vandaag,
  eigenIds,
  toewijzingen: (snapshot.toewijzingen ?? []).map((item) => ({
    boekingId: item.boekingId,
    relatieId: item.relatieId,
  })),
});
const lijstPad = bronParam ? `/beheer/planning/?bron=${encodeURIComponent(bronParam)}` : '/beheer/planning/';

function periode(boeking: PlanningBoeking): string {
  if (boeking.eind && boeking.eind !== boeking.start) return `${formatNl(boeking.start)} – ${formatNl(boeking.eind)}`;
  return formatNl(boeking.start);
}
---

<Beheer titel="Planning">
  <header class="bh-top">
    <h1>Planning</h1>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {melding && <p class="bh-flash">{melding}</p>}
  {fout && <p class="bh-flash bh-flash--fout">{fout}</p>}

  <section class="bh-kaart">
    <h2>Eigen planning</h2>
    {
      delen.eigen.length === 0 ? (
        <p class="bh-leeg">Geen diensten op jouw naam.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Datum</th>
              <th>Activiteit</th>
            </tr>
          </thead>
          <tbody>
            {delen.eigen.map((boeking) => (
              <tr>
                <td>{periode(boeking)}</td>
                <td>
                  <a href={metTerug(`/beheer/boekingen/${encodeURIComponent(boeking.id)}/`, lijstPad)}>
                    {leesbareTitel(boeking.titel, boeking.huurder)}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>

  <section class="bh-kaart">
    <h2>Open diensten</h2>
    {
      delen.open.length === 0 ? (
        <p class="bh-leeg">Geen open diensten.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Datum</th>
              <th>Activiteit</th>
              {magIndelen && <th>Indelen</th>}
            </tr>
          </thead>
          <tbody>
            {delen.open.map((boeking) => (
              <tr>
                <td>{periode(boeking)}</td>
                <td>
                  <a href={metTerug(`/beheer/boekingen/${encodeURIComponent(boeking.id)}/`, lijstPad)}>
                    {leesbareTitel(boeking.titel, boeking.huurder)}
                  </a>
                </td>
                {magIndelen && (
                  <td>
                    <form method="post" class="bh-form bh-form-rij">
                      <input type="hidden" name="boekingId" value={boeking.id} />
                      <label class="visually-hidden" for={`g-${boeking.id}`}>
                        Begeleider voor {leesbareTitel(boeking.titel, boeking.huurder)}
                      </label>
                      <select id={`g-${boeking.id}`} name="gastheerId" required>
                        <option value="">Kies een begeleider</option>
                        {gastherenVoorKoppeling(snapshot.gastheren).map((gast) => (
                          <option value={gast.id}>{gast.naam}</option>
                        ))}
                      </select>
                      <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="bewaar">Bewaar</button>
                    </form>
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
</Beheer>
