---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { AANVRAAG_LABEL, SOORT_LABEL } from '../../../platform/demo-data';
import {
  leesAanvraagSortering,
  sorteerAanvragen,
  type AanvraagSortering,
} from '../../../platform/aanvraag-weergave';
import {
  beoordeelAanvraag,
  leesAanvraagFilter,
  pastInFilter,
  type FaseAanvraag,
  type FaseFilter,
  type FaseWereld,
} from '../../../platform/aanvraag-fase';
import { periodeLabel } from '../../../platform/verhuur-overzicht';
import { laadBeheerSnapshot, beheerSnapshotOpties } from '../../../platform/beheer-bron.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const filter = leesAanvraagFilter(Astro.url.searchParams);
const sort = leesAanvraagSortering(Astro.url.searchParams.get('sort'));
const dir = Astro.url.searchParams.get('dir') === 'desc' ? 'desc' : 'asc';

const wereld: FaseWereld = {
  aanvragen: snapshot.aanvragen.map((item) => ({
    id: item.id,
    status: item.status,
    naam: item.naam,
    start: item.start,
    eind: item.eind,
    boekingId: item.boekingId,
  })),
  boekingen: snapshot.boekingen.map((item) => ({
    id: item.id,
    nummer: item.nummer,
    status: item.status,
    start: item.start,
    eind: item.eind,
    titel: item.interneTitel,
    huurder: item.huurder,
    aanbetalingBinnen: item.aanbetalingBinnen,
    aanvraagId: item.aanvraagId,
  })),
  documenten: snapshot.documenten.map((item) => ({ boekingId: item.boekingId, soort: item.soort, naam: item.naam })),
  mails: snapshot.communicatie.map((item) => ({ boekingId: item.boekingId, template: item.template, status: item.status })),
  betalingen: (snapshot.betalingen ?? []).map((item) => ({ boekingId: item.boekingId, soort: item.soort, status: item.status })),
  blokkades: snapshot.intern.map((item) => ({
    id: item.id,
    titel: item.titel,
    start: item.start,
    eind: item.eind,
    blokkeert: item.blokkeert,
  })),
  activiteiten: snapshot.agenda
    .filter((item) => item.tabel === 'activiteit_bron')
    .map((item) => ({
      id: item.id,
      titel: item.titel,
      start: item.start,
      eind: item.eind,
      zichtbaarheid: item.publicatiestatus ?? '',
      levenscyclus: item.levenscyclus ?? 'actief',
    })),
};

function alsFase(item: (typeof snapshot.aanvragen)[number]): FaseAanvraag {
  return {
    id: item.id,
    status: item.status,
    naam: item.naam,
    start: item.start,
    eind: item.eind,
    boekingId: item.boekingId,
  };
}

const beelden = new Map(snapshot.aanvragen.map((item) => [item.id, beoordeelAanvraag(alsFase(item), wereld)]));
const ongefilterd = snapshot.aanvragen.filter((item) => {
  const beeld = beelden.get(item.id);
  return beeld ? pastInFilter(beeld.fase, filter, item.status) : false;
});
const lijst = sorteerAanvragen(ongefilterd, sort, dir, (soort) => SOORT_LABEL[soort] ?? soort);

function query(wijziging: { fase?: FaseFilter | null; sort?: string | null; dir?: string | null }): string {
  const volgende = new URLSearchParams();
  if (wijziging.fase === undefined && filter.modus === 'technisch' && filter.technisch) {
    volgende.set('status', filter.technisch);
  } else {
    const fase = wijziging.fase === undefined ? (filter.modus === 'fase' ? filter.fase : null) : wijziging.fase;
    if (fase && fase !== 'alle') volgende.set('fase', fase);
  }
  const sortWaarde = wijziging.sort === undefined ? sort : wijziging.sort;
  const dirWaarde = wijziging.dir === undefined ? (sort ? dir : null) : wijziging.dir;
  if (sortWaarde) volgende.set('sort', sortWaarde);
  if (sortWaarde && dirWaarde) volgende.set('dir', dirWaarde);
  const tekst = volgende.toString();
  return tekst ? `/beheer/aanvragen/?${tekst}` : '/beheer/aanvragen/';
}

function kolomHref(kolom: AanvraagSortering): string {
  const volgende = sort === kolom && dir === 'asc' ? 'desc' : 'asc';
  return query({ sort: kolom, dir: volgende });
}

function pijl(kolom: AanvraagSortering): string {
  if (sort !== kolom) return '';
  return dir === 'asc' ? ' ↑' : ' ↓';
}

function ariaSort(kolom: AanvraagSortering): 'ascending' | 'descending' | 'none' {
  if (sort !== kolom) return 'none';
  return dir === 'asc' ? 'ascending' : 'descending';
}

const tabs: { fase: FaseFilter; label: string }[] = [
  { fase: 'alle', label: 'Open' },
  { fase: 'nieuw', label: 'Nieuw' },
  { fase: 'in_behandeling', label: 'In behandeling' },
  { fase: 'gereed', label: 'Gereed' },
  { fase: 'afgesloten', label: 'Afgewezen / Gesloten' },
];

function periodeVan(start: string, eind: string): string {
  if (!start) return '—';
  return periodeLabel(start, eind || start);
}
---

<Beheer titel="Aanvragen">
  <header class="bh-top">
    <div>
      <p class="bh-label">Aanvragen</p>
      <h1>Aanvragen</h1>
      <p class="bh-hint">Klik een aanvraag om het dossier te openen. Open toont alleen wat nog moet gebeuren. Een definitieve boeking, een afwijzing of een gesloten aanvraag staat daar niet bij.</p>
    </div>
  </header>

  {Astro.url.searchParams.get('melding') && <p class="bh-flash" role="status">{Astro.url.searchParams.get('melding')}</p>}
  {Astro.url.searchParams.get('fout') && <p class="bh-flash" role="alert">{Astro.url.searchParams.get('fout')}</p>}
  {filter.melding && <p class="bh-flash" role="status">{filter.melding}</p>}
  {
    filter.modus === 'technisch' && filter.technisch && (
      <p class="bh-flash" role="status">
        Oude filter: {AANVRAAG_LABEL[filter.technisch]}. <a href="/beheer/aanvragen/">Toon de open aanvragen</a>
      </p>
    )
  }

  <nav class="bh-tabs" aria-label="Filter aanvragen">
    {
      tabs.map((tab) => (
        <a href={query({ fase: tab.fase })} aria-current={filter.modus === 'fase' && filter.fase === tab.fase ? 'page' : undefined}>
          {tab.label}
        </a>
      ))
    }
  </nav>

  <table class="bh-tabel">
    <thead>
      <tr>
        <th aria-sort={ariaSort('naam')}>
          <a class="bh-sorteer" href={kolomHref('naam')}>Aanvraag{pijl('naam')}</a>
        </th>
        <th aria-sort={ariaSort('datum')}>
          <a class="bh-sorteer" href={kolomHref('datum')}>Periode{pijl('datum')}</a>
        </th>
        <th>Fase</th>
        <th>Volgende actie</th>
      </tr>
    </thead>
    <tbody>
      {
        lijst.length === 0 ? (
          <tr>
            <td colspan="4" class="bh-leeg">Geen aanvragen in deze filter.</td>
          </tr>
        ) : (
          lijst.map((item) => {
            const beeld = beelden.get(item.id);
            return (
              <tr>
                <td>
                  <a class="bh-detail-link" href={`/beheer/aanvragen/${encodeURIComponent(item.id)}/`}>{item.naam}</a>
                  <small class="bh-fase-sub">{SOORT_LABEL[item.soort] ?? item.soort}</small>
                </td>
                <td>{periodeVan(item.start, item.eind)}</td>
                <td>
                  <span class={`bh-badge bh-fase bh-fase--${beeld?.toon ?? 'oranje'}`}>{beeld?.faseLabel ?? 'Nieuw'}</span>
                </td>
                <td class={`bh-fase bh-fase--${beeld?.toon ?? 'oranje'}`}>{beeld?.volgendeActie ?? '—'}</td>
              </tr>
            );
          })
        )
      }
    </tbody>
  </table>
</Beheer>
