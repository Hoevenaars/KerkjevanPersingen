---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { SOORT_LABEL, demoNaActie, formatNl } from '../../../platform/demo-data';
import { beoordeelAanvraag, type FaseWereld } from '../../../platform/aanvraag-fase';
import { periodeLabel } from '../../../platform/verhuur-overzicht';
import { labelAkkoordVoorwaarden } from '../../../platform/aanvraag-weergave';
import { toonMedeExposanten } from '../../../platform/mede-exposanten';
import { lijstAanvraagFotos } from '../../../lib/aanvraag-foto-opslag';
import { beheerId, laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { herkomstUitQuery } from '../../../platform/beheer-hoofdnav.ts';
import { actorVanSessie, postAlsSupabase } from '../../../lib/operatie/runtime.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { laadTijdlijn } from '../../../lib/communicatie-log.ts';
import { briefMeerInformatie } from '../../../lib/operatie/informatievraag.ts';
import { getTestMailRecipient } from '../../../lib/testmail-adres.ts';
import { CONTRACTBEHEER_EMAIL } from '../../../lib/mail-adressen.ts';
import Mailconcept from '../../../components/beheer/Mailconcept.astro';
import { verwerkMailconcept } from '../../../lib/mailconcept-actie.ts';
import { magAutomatiseringUitvoeren } from '../../../platform/automatisering.ts';
import { laadMailtemplatesUitSupabase } from '../../../platform/mailtemplates/supabase-bron.ts';
import type { MailTemplateDef } from '../../../platform/mailtemplates/types.ts';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const id = beheerId(Astro.params.id);
const aanvraag = snapshot.aanvragen.find((a) => a.id === id);

const mailSessie = sessieSupabaseUitAstro(Astro);
const mailtemplates: MailTemplateDef[] = mailSessie ? await laadMailtemplatesUitSupabase(mailSessie) : [];
let mailPreview: { onderwerp: string; text: string } | null = null;
let mailMelding = '';

if (Astro.request.method === 'POST') {
  const formulier = await Astro.request.formData();
  const actie = String(formulier.get('actie') ?? '');
  if (aanvraag && (actie === 'mailpreview' || actie === 'mailconcept' || actie === 'mailverstuur')) {
    const template = mailtemplates.find((item) => item.id === String(formulier.get('templateId') ?? '')) ?? null;
    const uit = await verwerkMailconcept({
      actie,
      dossier: { soort: 'aanvraag', id: aanvraag.id, ontvanger: aanvraag.email, naam: aanvraag.naam },
      template,
      onderwerp: String(formulier.get('mailOnderwerp') ?? ''),
      inhoud: String(formulier.get('mailInhoud') ?? ''),
      actorNaam: Astro.locals.beheer?.gebruiker.naam ?? 'beheer',
      bewaar: async (regel) => {
        if (!mailSessie) return { error: 'geen sessie' };
        const antwoord = await (mailSessie as unknown as { from: (tabel: string) => { insert: (rij: Record<string, unknown>) => Promise<{ error: { message: string } | null }> } }).from('communicatie_jobs').insert(regel);
        return { error: antwoord.error?.message ?? null };
      },
    });
    if (actie !== 'mailpreview') {
      const doel = new URL(Astro.url.pathname, Astro.url.origin);
      doel.searchParams.set(uit.ok ? 'melding' : 'fout', uit.melding);
      return Astro.redirect(doel.toString());
    }
    mailPreview = uit.preview && !('fout' in uit.preview) ? { onderwerp: uit.preview.onderwerp, text: uit.preview.text } : null;
    mailMelding = uit.melding;
  } else {
    const operationeel = await postAlsSupabase({
      request: Astro.request,
      url: Astro.url,
      env: omgevingsRecord(),
      actor: actorVanSessie(Astro.locals.beheer),
      sessie: mailSessie,
      formulier,
    });
    if (operationeel) return operationeel;
    return Astro.redirect(demoNaActie(Astro.url));
  }
}

if (!aanvraag) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
}

const relatie =
  snapshot.relaties.find((r) => aanvraag.relatieId && r.id === aanvraag.relatieId) ??
  snapshot.relaties.find((r) => r.email && r.email === aanvraag.email);
const flash = Astro.url.searchParams.get('demo') === '1';
const sessieClient = sessieSupabaseUitAstro(Astro);
const tijdlijn = aanvraag && sessieClient
  ? await laadTijdlijn(sessieClient as never, { aanvraagId: aanvraag.id })
  : [];
const testadres = await getTestMailRecipient().catch(() => null);
const mailmodus = magAutomatiseringUitvoeren('handmatige_template').modus;
const mailmodusLabel = mailmodus === 'test' ? 'Test' : mailmodus === 'aan' ? 'Aan' : 'Uit';
const voorbeeld = aanvraag?.informatievraag ? briefMeerInformatie(aanvraag.naam, aanvraag.informatievraag) : null;
const fotos = aanvraag && sessieClient ? await lijstAanvraagFotos(sessieClient as never, aanvraag.id) : [];
const medeTekst = toonMedeExposanten(aanvraag?.medeExposanten);
const herkomst = herkomstUitQuery(Astro.url.searchParams.get('van'));
const wereld: FaseWereld = {
  aanvragen: snapshot.aanvragen.map((item) => ({
    id: item.id,
    status: item.status,
    naam: item.naam,
    start: item.start,
    eind: item.eind,
    boekingId: item.boekingId,
  })),
  boekingen: snapshot.boekingen.map((item) => ({
    id: item.id,
    nummer: item.nummer,
    status: item.status,
    start: item.start,
    eind: item.eind,
    titel: item.interneTitel,
    huurder: item.huurder,
    aanbetalingBinnen: item.aanbetalingBinnen,
    aanvraagId: item.aanvraagId,
  })),
  documenten: snapshot.documenten.map((item) => ({ boekingId: item.boekingId, soort: item.soort, naam: item.naam })),
  mails: snapshot.communicatie.map((item) => ({ boekingId: item.boekingId, template: item.template, status: item.status })),
  betalingen: (snapshot.betalingen ?? []).map((item) => ({ boekingId: item.boekingId, soort: item.soort, status: item.status })),
  blokkades: snapshot.intern.map((item) => ({
    id: item.id,
    titel: item.titel,
    start: item.start,
    eind: item.eind,
    blokkeert: item.blokkeert,
  })),
  activiteiten: snapshot.agenda
    .filter((item) => item.tabel === 'activiteit_bron')
    .map((item) => ({
      id: item.id,
      titel: item.titel,
      start: item.start,
      eind: item.eind,
      zichtbaarheid: item.publicatiestatus ?? '',
      levenscyclus: item.levenscyclus ?? 'actief',
    })),
};
const beeld = beoordeelAanvraag({
  id: aanvraag.id,
  status: aanvraag.status,
  naam: aanvraag.naam,
  start: aanvraag.start,
  eind: aanvraag.eind,
  boekingId: aanvraag.boekingId,
}, wereld);
const kanGoedkeuren = beeld.geschikt && beeld.beschikbaarheid.uitkomst === 'beschikbaar' && beeld.fase === 'nieuw';
const toonBeoordeling = beeld.fase === 'nieuw';
const toonChecklist = beeld.fase === 'in_behandeling' || beeld.fase === 'gereed';
---

<Beheer titel={aanvraag.naam}>
  <p class="bh-crumb">{herkomst && <><a href={herkomst.href}>{herkomst.label}</a> / </>}<a href="/beheer/aanvragen/">Aanvragen</a> / {aanvraag.naam}</p>
  <header class="bh-top">
    <div>
      <h1>{aanvraag.naam}</h1>
      <p class="bh-hint">
        {SOORT_LABEL[aanvraag.soort] ?? aanvraag.soort} · {formatNl(aanvraag.start)}
        {aanvraag.eind !== aanvraag.start ? ` – ${formatNl(aanvraag.eind)}` : ''} ·
        <span class={`bh-badge bh-fase bh-fase--${beeld.toon}`}>{beeld.faseLabel}</span>
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {Astro.url.searchParams.get('melding') && <p class="bh-flash">{Astro.url.searchParams.get('melding')}</p>}
  {mailMelding && <p class="bh-flash">{mailMelding}</p>}
  {Astro.url.searchParams.get('fout') && <p class="bh-flash">{Astro.url.searchParams.get('fout')}</p>}

  <section class="bh-kaart bh-fase-paneel" aria-label="Fase">
    <p class="bh-label">Fase</p>
    <h2 class={`bh-fase bh-fase--${beeld.toon}`}>{beeld.faseLabel}</h2>
    <p class="bh-volgende">Volgende actie: <strong class={`bh-fase bh-fase--${beeld.toon}`}>{beeld.volgendeActie}</strong></p>
    {
      beeld.fase === 'gereed' && (
        <>
          <h3>Boeking definitief</h3>
          <p>De boeking blijft in het verhuuroverzicht. De restbetaling loopt via de bestaande financiële administratie. Gereed betekent niet dat de hele huursom al binnen is.</p>
          {
            !beeld.checklist.compleet && (
              <p>Deze boeking was al definitief. Ontbrekende contract- of betaalgegevens maken haar niet onvolledig.</p>
            )
          }
        </>
      )
    }
    {
      toonBeoordeling && (
        <>
          <h3>Past deze activiteit in het Kerkje van Persingen?</h3>
          {
            beeld.geschikt ? (
              <p class="bh-fase bh-fase--groen">Ja, geschikt. Afgerond.</p>
            ) : (
              <form method="post" class="bh-acties">
                <button class="bh-btn" type="submit" name="actie" value="geschikt">Ja, geschikt</button>
              </form>
            )
          }
          <form method="post" class="bh-form">
            <label for="reden">Afwijsreden, als de activiteit niet past</label>
            <textarea id="reden" name="reden" rows="3" required></textarea>
            <button class="bh-btn bh-btn--gevaar" type="submit" name="actie" value="weiger">Nee, afwijzen</button>
          </form>
          <h3>Is de ruimte beschikbaar?</h3>
          <p class={`bh-fase bh-fase--${beeld.beschikbaarheid.uitkomst === 'beschikbaar' ? 'groen' : beeld.beschikbaarheid.uitkomst === 'aanvraag' ? 'oranje' : 'rood'}`}>
            <strong>{beeld.beschikbaarheid.kop}.</strong> {beeld.beschikbaarheid.tekst}
          </p>
          {
            beeld.beschikbaarheid.blokkades.map((regel) => (
              <p>
                <a href={regel.href}>{regel.naam}</a>
                {' '}· {regel.periode} · {regel.tekst}
              </p>
            ))
          }
          {
            beeld.beschikbaarheid.aanvragen.map((regel) => (
              <p>
                <a href={regel.href}>{regel.naam}</a>
                {' '}· {regel.periode} · {regel.tekst}
              </p>
            ))
          }
          {
            kanGoedkeuren && (
              <form method="post" class="bh-acties">
                <button class="bh-btn" type="submit" name="actie" value="akkoord">Goedkeuren en in behandeling nemen</button>
              </form>
            )
          }
        </>
      )
    }
    {
      toonChecklist && (
        <>
          <h3>Contract en aanbetaling</h3>
          <ul class="bh-checks">
            <li class={beeld.checklist.verzonden ? 'is-klaar' : 'is-open'}>
              <span>Contract verzonden</span>
              <strong>{beeld.checklist.verzonden ? 'Afgerond' : beeld.fase === 'gereed' ? 'Niet vastgelegd' : 'Nog niet'}</strong>
            </li>
            <li class={beeld.checklist.ondertekend ? 'is-klaar' : 'is-open'}>
              <span>Contract ondertekend</span>
              <strong>{beeld.checklist.ondertekend ? 'Afgerond' : beeld.fase === 'gereed' ? 'Niet vastgelegd' : 'Nog niet'}</strong>
            </li>
            <li class={beeld.checklist.aanbetaling ? 'is-klaar' : 'is-open'}>
              <span>Aanbetaling ontvangen</span>
              <strong>{beeld.checklist.aanbetaling ? beeld.checklist.aanbetalingTekst : beeld.fase === 'gereed' ? 'Niet vastgelegd' : beeld.checklist.aanbetalingTekst}</strong>
            </li>
          </ul>
          {
            beeld.boeking && (
              <p>
                Boeking <a href={`/beheer/boekingen/${encodeURIComponent(beeld.boeking.id)}/`}>{beeld.boeking.nummer}</a>
                {' '}· {periodeLabel(beeld.boeking.start, beeld.boeking.eind || beeld.boeking.start)}
              </p>
            )
          }
          {
            beeld.fase === 'in_behandeling' && !beeld.checklist.verzonden && beeld.boeking && (
              <p>Het contract verstuur je met het bestaande mailformulier hieronder. Er komt geen tweede verzendknop bij.</p>
            )
          }
          {
            beeld.fase === 'in_behandeling' && beeld.checklist.ondertekend && !beeld.checklist.aanbetaling && beeld.boeking && (
              <p>De aanbetaling blijft in de bestaande administratie. <a href={`/beheer/boekingen/${encodeURIComponent(beeld.boeking.id)}/`}>Open de boeking</a>.</p>
            )
          }
        </>
      )
    }
  </section>

  <div class="bh-split">
    <section class="bh-kaart">
      <h2>Gegevens</h2>
      <dl class="bh-dl">
        <dt>E-mail</dt>
        <dd>{aanvraag.email}</dd>
        <dt>Telefoon</dt>
        <dd>{aanvraag.telefoon}</dd>
        <dt>Adres</dt>
        <dd>{aanvraag.adres || '—'}</dd>
        <dt>Personen</dt>
        <dd>{aanvraag.personen || '—'}</dd>
        <dt>Website</dt>
        <dd>{aanvraag.website || '—'}</dd>
        {(aanvraag.soort === 'expositie' || medeTekst) && (
          <>
            <dt>Mede-exposanten</dt>
            <dd>{medeTekst || '—'}</dd>
          </>
        )}
        <dt>Algemene voorwaarden</dt>
        <dd>{labelAkkoordVoorwaarden(aanvraag.soort, aanvraag.akkoordVoorwaarden)}</dd>
        <dt>Toelichting</dt>
        <dd>{aanvraag.toelichting}</dd>
        {
          aanvraag.status === 'afgewezen' && (
            <>
              <dt>Afwijsreden</dt>
              <dd>{aanvraag.afwijsreden || '—'}</dd>
            </>
          )
        }
        {
          relatie && (
            <>
              <dt>Relatie</dt>
              <dd>
                <a href={`/beheer/relaties/${encodeURIComponent(relatie.id)}/`}>{relatie.naam}</a>
              </dd>
            </>
          )
        }
        {
          aanvraag.boekingId && (
            <>
              <dt>Boeking</dt>
              <dd>
                <a href={`/beheer/boekingen/${encodeURIComponent(aanvraag.boekingId)}/`}>{aanvraag.boekingId}</a>
              </dd>
            </>
          )
        }
      </dl>
    </section>

    {
      ((beeld.fase === 'in_behandeling' && snapshot.bron === 'supabase') || voorbeeld) && (
        <section class="bh-kaart">
          <h2>Vraag aan de aanvrager</h2>
          {
            beeld.fase === 'in_behandeling' && snapshot.bron === 'supabase' && (
              <form method="post" class="bh-form">
                <label for="vraag">Vraag</label>
                <textarea id="vraag" name="vraag" rows="5" required>{aanvraag.informatievraag ?? ''}</textarea>
                <p class="bh-muted">Reply-To blijft {CONTRACTBEHEER_EMAIL}. Concept, opslaan en preview doen geen provider-call.</p>
                <div class="bh-acties">
                  <button class="bh-btn" type="submit" name="actie" value="meer">Concept opslaan</button>
                </div>
              </form>
            )
          }
          {
            voorbeeld && (
              <>
                <h3>Preview</h3>
                <p><strong>{voorbeeld.onderwerp}</strong></p>
                <pre class="bh-muted">{voorbeeld.text}</pre>
                <form method="post">
                  <p>Testmail wordt verstuurd naar: {testadres || 'geen geldig testmailadres ingesteld'} zolang de schakelaar op Test staat. Uit verstuurt niets.</p>
                  <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="meer_verstuur">Verstuur vraag</button>
                </form>
              </>
            )
          }
        </section>
      )
    }
  </div>

  {
    beeld.fase === 'in_behandeling' && beeld.boeking && (
      <div id="contract-mail">
        <Mailconcept
          templates={mailtemplates.map((item) => ({ id: item.id, naam: item.naam }))}
          ontvanger={aanvraag.email}
          modus={mailmodusLabel}
          testadres={testadres}
          replyTo={CONTRACTBEHEER_EMAIL}
          preview={mailPreview}
        />
      </div>
    )
  }

  {fotos.length > 0 && (
    <section class="bh-kaart">
      <h2>Foto’s van het werk</h2>
      <ul class="bh-fotolijst">
        {fotos.map((foto) => (
          <li>
            {foto.url ? <img src={foto.url} alt="" width="160" height="160" /> : null}
            {foto.url ? (
              <a href={foto.url} target="_blank" rel="noopener noreferrer">{foto.naam}</a>
            ) : (
              foto.naam
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="bh-kaart">
    <h2>Communicatie</h2>
    {
      tijdlijn.length === 0 ? (
        <p class="bh-leeg">Nog geen verzendregel of communicatiejob bij deze aanvraag.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Wanneer</th>
              <th>Richting</th>
              <th>Template</th>
              <th>Onderwerp</th>
              <th>Bedoeld</th>
              <th>Werkelijk</th>
              <th>Status</th>
              <th>Provider</th>
            </tr>
          </thead>
          <tbody>
            {tijdlijn.map((regel) => (
              <tr>
                <td>{regel.op ? formatNl(regel.op.slice(0, 10)) : '—'}</td>
                <td>{regel.richting}</td>
                <td>{regel.template || '—'}</td>
                <td>{regel.onderwerp || '—'}</td>
                <td>{regel.bedoeldeOntvanger || '—'}</td>
                <td>{regel.werkelijkeOntvanger || '—'}</td>
                <td>{regel.status}{regel.foutmelding ? ` — ${regel.foutmelding}` : ''}</td>
                <td>{regel.providerBerichtId || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
</Beheer>

<style>
  .bh-fotolijst {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bh-fotolijst li {
    display: grid;
    gap: 0.35rem;
    max-width: 10rem;
    font-size: 0.9rem;
  }

  .bh-fotolijst img {
    width: 10rem;
    height: 10rem;
    object-fit: cover;
    background: #f4f1ea;
  }
</style>
