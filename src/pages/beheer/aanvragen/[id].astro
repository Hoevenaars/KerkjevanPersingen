---
export const prerender = false;

import Beheer from '../../../layouts/Beheer.astro';
import { SOORT_LABEL, demoNaActie, formatNl } from '../../../platform/demo-data';
import { beoordeelAanvraag, type FaseWereld } from '../../../platform/aanvraag-fase';
import { periodeLabel } from '../../../platform/verhuur-overzicht';
import { labelAangevraagdOp, labelAkkoordVoorwaarden } from '../../../platform/aanvraag-weergave';
import { toonMedeExposanten } from '../../../platform/mede-exposanten';
import { lijstAanvraagFotos } from '../../../lib/aanvraag-foto-opslag';
import { beheerId, laadBeheerSnapshot, beheerSnapshotOpties, omgevingsRecord, schrijfActieFlash } from '../../../platform/beheer-bron.ts';
import { herkomstUitQuery } from '../../../platform/beheer-hoofdnav.ts';
import { actorVanSessie, postAlsSupabase } from '../../../lib/operatie/runtime.ts';
import { sessieSupabaseUitAstro } from '../../../lib/supabase.ts';
import { laadTijdlijn } from '../../../lib/communicatie-log.ts';
import { briefMeerInformatie } from '../../../lib/operatie/informatievraag.ts';
import { getTestMailRecipient } from '../../../lib/testmail-adres.ts';
import { CONTRACTBEHEER_EMAIL } from '../../../lib/mail-adressen.ts';
import Mailconcept from '../../../components/beheer/Mailconcept.astro';
import { verwerkMailconcept } from '../../../lib/mailconcept-actie.ts';
import { besluitVoor } from '../../../lib/automatisering-register.ts';
import { magAanvraagWijzigen } from '../../../platform/aanvraag.ts';
import { magSchrijven } from '../../../platform/rechten.ts';
import { zetReservelijstViaAanvraag } from '../../../lib/operatie/aanvraag-reservelijst.ts';
import { laadMailtemplatesUitSupabase } from '../../../platform/mailtemplates/supabase-bron.ts';
import type { MailTemplateDef } from '../../../platform/mailtemplates/types.ts';
import {
  bouwOpvolging,
  flowActieUit,
  geldUitAdministratie,
  legeInstellingen,
  leesInstellingen,
  magContractBeheren,
  betalingStand,
  type ContractBron,
  type ContractVersie,
} from '../../../platform/documentenflow.ts';
import ContractWizard from '../../../components/beheer/ContractWizard.astro';
import { leesWizardVelden, wizardUitDossier, type ContractWizardVelden } from '../../../platform/contract-wizard.ts';
import { bewaarDefinitiefContract, leesContractWizardStand } from '../../../lib/operatie/contract-wizard-sessie.ts';
import { ymdInAmsterdam } from '../../../platform/datum.ts';
import { documentenflowAan } from '../../../platform/documentenflow-vlag.ts';
import { contractPakketTekst } from '../../../platform/contract-pakket.ts';
import { pdfBytes } from '../../../platform/documenten/pdf.ts';
import { leesDocumentenDossier, pasDocumentenflowToe } from '../../../lib/operatie/documentenflow-sessie.ts';
import { verstuurGecontroleerd } from '../../../lib/mail-transport.ts';
import { legVerzendingVast } from '../../../lib/communicatie-log.ts';
import { VAN_ADRES } from '../../../lib/mail-adressen.ts';
import ContractOpvolging from '../../../components/beheer/ContractOpvolging.astro';

const snapshot = await laadBeheerSnapshot(beheerSnapshotOpties(Astro));
const id = beheerId(Astro.params.id);
const aanvraag = snapshot.aanvragen.find((a) => a.id === id);

const mailSessie = sessieSupabaseUitAstro(Astro);
const mailtemplates: MailTemplateDef[] = mailSessie ? await laadMailtemplatesUitSupabase(mailSessie) : [];
let mailPreview: { onderwerp: string; text: string } | null = null;
let mailMelding = '';
let wizardPost: ContractWizardVelden | null = null;

if (Astro.request.method === 'POST') {
  const formulier = await Astro.request.formData();
  const actie = String(formulier.get('actie') ?? '');
  if (aanvraag && actie.startsWith('df_')) {
    const bestand = formulier.get('bestand');
    const bijlage = bestand instanceof File && bestand.size > 0
      ? { naam: bestand.name, bytes: new Uint8Array(await bestand.arrayBuffer()) }
      : null;
    const flowActie = flowActieUit(actie, formulier);
    const modus = (await besluitVoor('handmatige_template', undefined, omgevingsRecord())).modus;
    const uit = flowActie
      ? await pasDocumentenflowToe({
        client: mailSessie as never,
        env: omgevingsRecord(),
        actor: actorVanSessie(Astro.locals.beheer),
        boekingId: aanvraag.boekingId ?? '',
        actie: flowActie,
        promotieAanwezig: Boolean(aanvraag.website?.trim()),
        modus: modus === 'aan' || modus === 'test' ? modus : 'uit',
        testadres: await getTestMailRecipient().catch(() => null),
        bestand: bijlage,
        verstuur: async (mail) => {
          const verzonden = await verstuurGecontroleerd(
            {
              sleutel: 'handmatige_template',
              naar: mail.naar,
              onderwerp: mail.onderwerp,
              tekst: mail.tekst,
              richting: 'aanvrager',
              bijlagen: mail.bijlagen.flatMap((deel) => deel.bytes ? [{ bestandsnaam: deel.bestandsnaam, inhoud: deel.bytes }] : []),
              eisBijlagen: mail.soort === 'contract' || mail.soort === 'proef' || mail.soort === 'herhaling',
              idempotentieSleutel: mail.idempotentie,
            },
            {
              modus: mail.teltAlsVerzonden ? 'aan' : 'test',
              testadres: mail.teltAlsVerzonden ? null : mail.naar,
              env: omgevingsRecord(),
            },
          );
          const geaccepteerd = verzonden.providerAangeroepen && Boolean(verzonden.providerBerichtId);
          if (geaccepteerd) {
            await legVerzendingVast({
              aanvraagId: aanvraag.id,
              boekingId: mail.teltAlsVerzonden && (mail.soort === 'contract' || mail.soort === 'herhaling') ? aanvraag.boekingId : null,
              templateSleutel: mail.soort === 'contract' || mail.soort === 'herhaling' ? 'huurovereenkomst' : mail.soort,
              onderwerp: mail.teltAlsVerzonden ? mail.onderwerp : `[TEST] ${mail.onderwerp}`,
              bedoeldeOntvanger: mail.bedoelde,
              werkelijkeOntvanger: verzonden.werkelijkeOntvanger || mail.naar,
              afzender: VAN_ADRES,
              replyTo: CONTRACTBEHEER_EMAIL,
              richting: 'uitgaand',
              status: 'verzonden',
              providerBerichtId: verzonden.providerBerichtId,
              test: !mail.teltAlsVerzonden,
              dedupSleutel: mail.idempotentie,
              handmatig: true,
            }, omgevingsRecord());
          }
          if (!geaccepteerd) {
            return {
              verzonden: false,
              berichtId: null,
              melding: verzonden.melding || 'De mailprovider heeft de mail niet geaccepteerd. Er is niets als verzonden genoteerd.',
            };
          }
          return {
            verzonden: true,
            berichtId: verzonden.providerBerichtId ?? null,
            melding: 'De mailprovider heeft de mail geaccepteerd. Aflevering is daarmee nog niet bevestigd.',
          };
        },
      })
      : { ok: false, melding: 'Deze actie hoort niet bij het contract.' };
    const doel = new URL(Astro.url.pathname, Astro.url.origin);
    doel.searchParams.set(uit.ok ? 'melding' : 'fout', uit.melding);
    return Astro.redirect(doel.toString());
  }
  if (aanvraag && (actie === 'mailpreview' || actie === 'mailconcept' || actie === 'mailverstuur')) {
    const contractmail = String(formulier.get('contract') ?? '') === '1';
    const template = contractmail
      ? null
      : mailtemplates.find((item) => item.id === String(formulier.get('templateId') ?? '')) ?? null;
    const uit = await verwerkMailconcept({
      actie,
      dossier: {
        soort: 'aanvraag',
        id: aanvraag.id,
        ontvanger: aanvraag.email,
        naam: aanvraag.naam,
        boekingId: aanvraag.boekingId,
      },
      template,
      logTemplateId: contractmail ? String(formulier.get('templateId') ?? '') || 'contract_begeleiding' : undefined,
      briefAlCompleet: contractmail,
      onderwerp: String(formulier.get('mailOnderwerp') ?? ''),
      inhoud: String(formulier.get('mailInhoud') ?? ''),
      actorNaam: Astro.locals.beheer?.gebruiker.naam ?? 'beheer',
      bewaar: async (regel) => {
        if (!mailSessie) return { error: 'geen sessie' };
        const antwoord = await (mailSessie as unknown as { from: (tabel: string) => { insert: (rij: Record<string, unknown>) => Promise<{ error: { message: string } | null }> } }).from('communicatie_jobs').insert(regel);
        return { error: antwoord.error?.message ?? null };
      },
    });
    if (actie !== 'mailpreview') {
      const params = new URLSearchParams();
      params.set(uit.ok ? 'melding' : 'fout', uit.melding);
      return Astro.redirect(`${Astro.url.pathname}?${params}`);
    }
    mailPreview = uit.preview && !('fout' in uit.preview) ? { onderwerp: uit.preview.onderwerp, text: uit.preview.text } : null;
    mailMelding = uit.melding;
  } else if (aanvraag && (actie === 'reservelijst_aan' || actie === 'reservelijst_uit')) {
    const doel = new URL(Astro.url.pathname, Astro.url.origin);
    if (!Astro.locals.beheer || Astro.locals.beheer.viewAs) {
      doel.searchParams.set('fout', 'In deze weergave is niets gewijzigd.');
    } else if (snapshot.bron !== 'supabase' || !mailSessie) {
      doel.searchParams.set('fout', 'Dit is de voorbeeldweergave. Er is niets opgeslagen en er is geen mail verstuurd.');
    } else {
      const uit = await zetReservelijstViaAanvraag(
        mailSessie as never,
        Number(aanvraag.id),
        actie === 'reservelijst_aan',
        actorVanSessie(Astro.locals.beheer),
      );
      doel.searchParams.set(uit.ok ? 'melding' : 'fout', uit.melding);
    }
    return Astro.redirect(doel.toString());
  } else if (aanvraag && actie === 'contract_definitief') {
    const velden = leesWizardVelden(formulier);
    const doel = new URL(Astro.url.pathname, Astro.url.origin);
    for (const sleutel of ['bron', 'van']) {
      const waarde = Astro.url.searchParams.get(sleutel);
      if (waarde) doel.searchParams.set(sleutel, waarde);
    }
    if (!Astro.locals.beheer || Astro.locals.beheer.viewAs) {
      doel.searchParams.set('contract', 'genereren');
      doel.searchParams.set('fout', 'In deze weergave is niets gewijzigd.');
      return Astro.redirect(doel.toString());
    }
    if (snapshot.bron !== 'supabase' || !mailSessie || !aanvraag.boekingId || !/^\d+$/.test(aanvraag.boekingId)) {
      wizardPost = velden;
      mailMelding = 'Dit is de voorbeeldweergave. Het contract is niet opgeslagen en er is geen mail verstuurd.';
    } else {
      const uit = await bewaarDefinitiefContract(mailSessie as never, {
        boekingId: Number(aanvraag.boekingId),
        aanvraagId: /^\d+$/.test(aanvraag.id) ? Number(aanvraag.id) : null,
        velden,
        actor: actorVanSessie(Astro.locals.beheer),
      });
      if (!uit.ok) {
        wizardPost = velden;
        mailMelding = uit.melding;
      } else {
        doel.searchParams.set('melding', uit.melding);
        return Astro.redirect(doel.toString());
      }
    }
  } else {
    const operationeel = await postAlsSupabase({
      request: Astro.request,
      url: Astro.url,
      env: omgevingsRecord(),
      actor: actorVanSessie(Astro.locals.beheer),
      sessie: mailSessie,
      formulier,
    });
    if (operationeel) return operationeel;
    return Astro.redirect(demoNaActie(Astro.url));
  }
}

if (!aanvraag) {
  return new Response(null, { status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow' } });
}

if (Astro.url.searchParams.get('document') === 'contract') {
  const nietGevonden = new Response('Niet gevonden', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'X-Robots-Tag': 'noindex, nofollow' } });
  if (!aanvraag.boekingId || !mailSessie) return nietGevonden;
  const gelezen = await leesDocumentenDossier(mailSessie as never, aanvraag.boekingId);
  if (!gelezen.ok) return new Response(gelezen.melding, { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
  const gevraagd = Number(Astro.url.searchParams.get('versie'));
  const versie = gelezen.lading.context.versies.find((item) => item.versie === gevraagd)
    ?? gelezen.lading.context.versies.reduce<ContractVersie | null>((best, item) => (!best || item.versie > best.versie ? item : best), null);
  if (!versie) return nietGevonden;
  const bytes = pdfBytes(contractPakketTekst({
    tekst: versie.tekst,
    voorwaardenTekst: versie.voorwaardenTekst,
    huisregelsTekst: versie.huisregelsTekst,
    plattegrondTekst: versie.plattegrondTekst,
    soort: aanvraag.soort,
  }));
  return new Response(Buffer.from(bytes), {
    headers: {
      'Content-Type': 'application/pdf',
      'Content-Disposition': `inline; filename="${versie.contractnummer}.pdf"`,
      'Cache-Control': 'private, no-store',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  });
}

const dossierPad = `/beheer/aanvragen/${encodeURIComponent(aanvraag.id)}/`;
const kanBeoordelen = !Astro.locals.beheer?.viewAs && magAanvraagWijzigen(
  Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} },
);

const emailNorm = aanvraag.email.trim().toLowerCase();
const gekoppeldeRelatie = aanvraag.relatieId
  ? snapshot.relaties.find((r) => r.id === aanvraag.relatieId)
  : undefined;
const relatiesOpEmail = snapshot.relaties.filter((r) => r.email.trim().toLowerCase() === emailNorm);
const relatie = gekoppeldeRelatie ?? (relatiesOpEmail.length === 1 ? relatiesOpEmail[0] : undefined);
const meerdereRelaties = !gekoppeldeRelatie && relatiesOpEmail.length > 1;
const kanReservelijst = !Astro.locals.beheer?.viewAs
  && magSchrijven(Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} }, 'relaties')
  && magSchrijven(Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} }, 'aanvragen');
const flash = Astro.url.searchParams.get('demo') === '1';
const sessieClient = sessieSupabaseUitAstro(Astro);
const tijdlijn = aanvraag && sessieClient
  ? await laadTijdlijn(sessieClient as never, { aanvraagId: aanvraag.id })
  : [];
const testadres = await getTestMailRecipient().catch(() => null);
const mailmodus = (await besluitVoor('handmatige_template', undefined, omgevingsRecord())).modus;
const mailmodusLabel = mailmodus === 'test' ? 'Test' : mailmodus === 'aan' ? 'Aan' : 'Uit';
const voorbeeld = aanvraag?.informatievraag ? briefMeerInformatie(aanvraag.naam, aanvraag.informatievraag) : null;
const fotos = aanvraag && sessieClient ? await lijstAanvraagFotos(sessieClient as never, aanvraag.id) : [];
const medeTekst = toonMedeExposanten(aanvraag?.medeExposanten);
const herkomst = herkomstUitQuery(Astro.url.searchParams.get('van'));
const wereld: FaseWereld = {
  aanvragen: snapshot.aanvragen.map((item) => ({
    id: item.id,
    status: item.status,
    naam: item.naam,
    start: item.start,
    eind: item.eind,
    boekingId: item.boekingId,
  })),
  boekingen: snapshot.boekingen.map((item) => ({
    id: item.id,
    nummer: item.nummer,
    status: item.status,
    start: item.start,
    eind: item.eind,
    titel: item.interneTitel,
    huurder: item.huurder,
    aanbetalingBinnen: item.aanbetalingBinnen,
    aanvraagId: item.aanvraagId,
  })),
  documenten: snapshot.documenten.map((item) => ({ boekingId: item.boekingId, soort: item.soort, naam: item.naam })),
  mails: snapshot.communicatie.map((item) => ({ boekingId: item.boekingId, template: item.template, status: item.status })),
  betalingen: (snapshot.betalingen ?? []).map((item) => ({ boekingId: item.boekingId, soort: item.soort, status: item.status })),
  blokkades: snapshot.intern.map((item) => ({
    id: item.id,
    titel: item.titel,
    start: item.start,
    eind: item.eind,
    blokkeert: item.blokkeert,
  })),
  activiteiten: snapshot.agenda
    .filter((item) => item.tabel === 'activiteit_bron')
    .map((item) => ({
      id: item.id,
      titel: item.titel,
      start: item.start,
      eind: item.eind,
      zichtbaarheid: item.publicatiestatus ?? '',
      levenscyclus: item.levenscyclus ?? 'actief',
    })),
};
const beeld = beoordeelAanvraag({
  id: aanvraag.id,
  status: aanvraag.status,
  naam: aanvraag.naam,
  start: aanvraag.start,
  eind: aanvraag.eind,
  boekingId: aanvraag.boekingId,
}, wereld);
const flowAan = documentenflowAan();
const flowBoeking = snapshot.boekingen.find((item) => item.id === beeld.boeking?.id) ?? null;
let opvolging = null;
let opvolgingBetaling = '';
if (flowBoeking && (beeld.fase === 'in_behandeling' || beeld.fase === 'gereed')) {
  const regels = (snapshot.betalingen ?? [])
    .filter((regel) => regel.boekingId === flowBoeking.id)
    .map((regel) => ({ soort: regel.soort, bedrag: regel.bedrag, status: regel.status, vervaldatum: regel.vervaldatum }));
  const geld = geldUitAdministratie({ huurprijs: null, aanbetaling: null, regels });
  const gast = snapshot.gastheren.find((item) => item.id === flowBoeking.gastheerId);
  const bron: ContractBron = {
    boekingId: flowBoeking.id,
    soort: aanvraag.soort,
    soortLabel: SOORT_LABEL[aanvraag.soort] ?? aanvraag.soort,
    activiteit: flowBoeking.interneTitel || aanvraag.naam,
    toelichting: aanvraag.toelichting,
    periodeVan: aanvraag.start,
    periodeTot: aanvraag.eind,
    geboektOp: aanvraag.binnengekomen.slice(0, 10),
    huurderNaam: aanvraag.naam,
    straat: aanvraag.straat ?? '',
    huisnummer: aanvraag.huisnummer ?? '',
    toevoeging: aanvraag.toevoeging ?? '',
    postcode: aanvraag.postcode ?? '',
    woonplaats: aanvraag.woonplaats ?? '',
    email: aanvraag.email,
    telefoon: aanvraag.telefoon,
    personen: aanvraag.personen,
    huurprijsCent: geld.huurprijsCent,
    aanbetalingCent: geld.aanbetalingCent,
    aanbetalingVerval: geld.aanbetalingVerval,
    restCent: geld.restCent,
    restVerval: geld.restVerval,
    gastNaam: gast?.naam ?? '',
    gastEmail: gast?.email ?? '',
    gastTelefoon: gast?.telefoon ?? '',
    promotieAanwezig: Boolean(aanvraag.website?.trim() || fotos.length),
    boekingStatus: flowBoeking.status,
  };
  let versies: ContractVersie[] = [];
  let instellingen = legeInstellingen();
  let betaling = betalingStand({ vlag: flowBoeking.aanbetalingBinnen, regels });
  let fout = '';
  if (sessieClient && /^\d+$/.test(flowBoeking.id)) {
    const gelezen = await leesDocumentenDossier(sessieClient as never, flowBoeking.id, bron.promotieAanwezig);
    if (!gelezen.ok) fout = gelezen.melding;
    else {
      versies = gelezen.lading.context.versies;
      instellingen = gelezen.lading.context.instellingen;
      betaling = gelezen.lading.context.betaling;
      Object.assign(bron, gelezen.lading.context.bron);
    }
  }
  opvolgingBetaling = betaling.toelichting;
  opvolging = bouwOpvolging({
    rechten: Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} },
    bron,
    instellingen,
    versies,
    betaling,
    vandaag: ymdInAmsterdam(new Date()),
    bekijkHref: `${dossierPad}?document=contract&versie=${versies.reduce((hoogste, item) => Math.max(hoogste, item.versie), 0) || 1}`,
    fout,
    modus: mailmodus === 'aan' || mailmodus === 'test' ? mailmodus : 'uit',
  });
}
const rechtenNu = Astro.locals.beheer?.effectieveRechten ?? { isSuperAdmin: false, perModule: {} };
const kanContract = !Astro.locals.beheer?.viewAs
  && magContractBeheren(rechtenNu)
  && !flowAan
  && beeld.fase === 'in_behandeling'
  && Boolean(beeld.boeking)
  && !beeld.checklist.verzonden;
let contractDefinitief = false;
let contractNummer = '';
let bewaardeWizard: Partial<ContractWizardVelden> | null = null;
if (kanContract && sessieClient && beeld.boeking && /^\d+$/.test(beeld.boeking.id)) {
  const stand = await leesContractWizardStand(sessieClient as never, Number(beeld.boeking.id));
  if (!('fout' in stand) && !('mist' in stand)) {
    contractDefinitief = stand.definitief;
    contractNummer = stand.nummer;
    bewaardeWizard = stand.velden;
  }
}
let instellingRijen: { sleutel: string; waarde: unknown }[] = [];
if (kanContract && sessieClient) {
  const gelezen = await (sessieClient as unknown as {
    from: (tabel: string) => { select: (kolommen: string) => Promise<{ data: { sleutel: string; waarde: unknown }[] | null }> };
  }).from('instellingen').select('sleutel,waarde');
  instellingRijen = gelezen.data ?? [];
}
const wizardVelden = wizardPost ?? wizardUitDossier({
  boekingId: beeld.boeking?.id ?? '',
  soortLabel: SOORT_LABEL[aanvraag.soort] ?? aanvraag.soort,
  activiteit: flowBoeking?.interneTitel || aanvraag.naam,
  naam: aanvraag.naam,
  email: aanvraag.email,
  telefoon: aanvraag.telefoon,
  adres: aanvraag.adres,
  straat: aanvraag.straat ?? '',
  huisnummer: aanvraag.huisnummer ?? '',
  toevoeging: aanvraag.toevoeging ?? '',
  postcode: aanvraag.postcode ?? '',
  woonplaats: aanvraag.woonplaats ?? '',
  periodeVan: aanvraag.start,
  periodeTot: aanvraag.eind,
  personen: aanvraag.personen,
  huurprijs: flowBoeking?.tarief ?? '',
  aanbetaling: flowBoeking?.aanbetaling ?? '',
}, leesInstellingen(instellingRijen), bewaardeWizard);
const wizardOpen = kanContract && !contractDefinitief && (wizardPost != null || Astro.url.searchParams.get('contract') === 'genereren');
const contractLink = (() => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete('melding');
  params.delete('fout');
  params.delete('demo');
  params.set('contract', 'genereren');
  return `${dossierPad}?${params.toString()}`;
})();
const kanGoedkeuren = beeld.geschikt && beeld.beschikbaarheid.uitkomst === 'beschikbaar' && beeld.fase === 'nieuw';
const toonBeoordeling = beeld.fase === 'nieuw';
const toonChecklist = beeld.fase === 'in_behandeling' || beeld.fase === 'gereed';
---

<Beheer titel={aanvraag.naam}>
  <p class="bh-crumb">{herkomst && <><a href={herkomst.href}>{herkomst.label}</a> / </>}<a href="/beheer/aanvragen/">Aanvragen</a> / {aanvraag.naam}</p>
  <header class="bh-top">
    <div>
      <h1>{aanvraag.naam}</h1>
      <p class="bh-hint">
        {SOORT_LABEL[aanvraag.soort] ?? aanvraag.soort} · {formatNl(aanvraag.start)}
        {aanvraag.eind !== aanvraag.start ? ` – ${formatNl(aanvraag.eind)}` : ''} ·
        <span class={`bh-badge bh-fase bh-fase--${beeld.toon}`}>{beeld.faseLabel}</span>
      </p>
    </div>
  </header>

  {flash && <p class="bh-flash">{schrijfActieFlash(snapshot.bron)}</p>}
  {Astro.url.searchParams.get('melding') && <p class="bh-flash">{Astro.url.searchParams.get('melding')}</p>}
  {mailMelding && <p class="bh-flash">{mailMelding}</p>}
  {Astro.url.searchParams.get('fout') && <p class="bh-flash">{Astro.url.searchParams.get('fout')}</p>}

  <section class="bh-kaart bh-fase-paneel" id="beoordeling" aria-label="Fase">
    <p class="bh-label">Fase</p>
    <h2 class={`bh-fase bh-fase--${beeld.toon}`}>{beeld.faseLabel}</h2>
    <p class="bh-muted">Aangevraagd op {labelAangevraagdOp(aanvraag.binnengekomen)}</p>
    <p class="bh-volgende">Volgende actie: <strong class={`bh-fase bh-fase--${beeld.toon}`}>{beeld.volgendeActie}</strong></p>
    {
      beeld.fase === 'gereed' && (
        <>
          <h3>Boeking definitief</h3>
          <p>De boeking blijft in het verhuuroverzicht. De restbetaling loopt via de bestaande financiële administratie. Gereed betekent niet dat de hele huursom al binnen is.</p>
          {
            !beeld.checklist.compleet && (
              <p>Deze boeking was al definitief. Ontbrekende contract- of betaalgegevens maken haar niet onvolledig.</p>
            )
          }
        </>
      )
    }
    {
      toonBeoordeling && (
        <>
          <h3>Past deze activiteit in het Kerkje van Persingen?</h3>
          {
            !kanBeoordelen ? (
              <p>Je kunt deze aanvraag bekijken. Beoordelen vraagt schrijfrecht op aanvragen.</p>
            ) : beeld.geschikt ? (
              <p class="bh-fase bh-fase--groen">Ja, geschikt. Afgerond.</p>
            ) : (
              <form method="post" action={dossierPad} class="bh-acties">
                <button class="bh-btn" type="submit" name="actie" value="geschikt">Ja, geschikt</button>
              </form>
            )
          }
          {
            kanBeoordelen && (
              <form method="post" action={dossierPad} class="bh-form">
                <label for="reden">Afwijsreden, als de activiteit niet past</label>
                <textarea id="reden" name="reden" rows="3" required></textarea>
                <button class="bh-btn bh-btn--gevaar" type="submit" name="actie" value="weiger">Nee, afwijzen</button>
              </form>
            )
          }
          <h3>Is de ruimte beschikbaar?</h3>
          <p class={`bh-fase bh-fase--${beeld.beschikbaarheid.uitkomst === 'beschikbaar' ? 'groen' : beeld.beschikbaarheid.uitkomst === 'aanvraag' ? 'oranje' : 'rood'}`}>
            <strong>{beeld.beschikbaarheid.kop}.</strong> {beeld.beschikbaarheid.tekst}
          </p>
          {
            beeld.beschikbaarheid.blokkades.map((regel) => (
              <p>
                <a href={regel.href}>{regel.naam}</a>
                {' '}· {regel.periode} · {regel.tekst}
              </p>
            ))
          }
          {
            beeld.beschikbaarheid.aanvragen.map((regel) => (
              <p>
                <a href={regel.href}>{regel.naam}</a>
                {' '}· {regel.periode} · {regel.tekst}
              </p>
            ))
          }
          {
            kanBeoordelen && kanGoedkeuren && (
              <form method="post" action={dossierPad} class="bh-acties">
                <button class="bh-btn" type="submit" name="actie" value="akkoord">Goedkeuren en in behandeling nemen</button>
              </form>
            )
          }
        </>
      )
    }
    {
      toonChecklist && (
        <>
          <h3>Contract en aanbetaling</h3>
          <ul class="bh-checks">
            <li class={beeld.checklist.verzonden ? 'is-klaar' : 'is-open'}>
              <span>Contract verzonden</span>
              <strong>{beeld.checklist.verzonden ? 'Afgerond' : beeld.fase === 'gereed' ? 'Niet vastgelegd' : 'Nog niet'}</strong>
            </li>
            <li class={beeld.checklist.ondertekend ? 'is-klaar' : 'is-open'}>
              <span>Contract ondertekend</span>
              <strong>{beeld.checklist.ondertekend ? 'Afgerond' : beeld.fase === 'gereed' ? 'Niet vastgelegd' : 'Nog niet'}</strong>
            </li>
            <li class={beeld.checklist.aanbetaling ? 'is-klaar' : 'is-open'}>
              <span>Aanbetaling ontvangen</span>
              <strong>{beeld.checklist.aanbetaling ? beeld.checklist.aanbetalingTekst : beeld.fase === 'gereed' ? 'Niet vastgelegd' : beeld.checklist.aanbetalingTekst}</strong>
            </li>
          </ul>
          {
            beeld.boeking && (
              <p>
                Boeking <a href={`/beheer/boekingen/${encodeURIComponent(beeld.boeking.id)}/`}>{beeld.boeking.nummer}</a>
                {' '}· {periodeLabel(beeld.boeking.start, beeld.boeking.eind || beeld.boeking.start)}
              </p>
            )
          }
          {
            kanContract && !contractDefinitief && !wizardOpen && (
              <p class="bh-acties">
                <a class="bh-btn" href={contractLink}>Contract genereren</a>
              </p>
            )
          }
          {
            beeld.fase === 'in_behandeling' && !beeld.checklist.verzonden && beeld.boeking && (
              <p>Na opslaan keurt het bestuur deze versie goed. Verzenden stuurt het PDF-pakket mee. Zonder bijlage wordt er niet gemaild.</p>
            )
          }
          {
            kanContract && contractDefinitief && (
              <p>
                Contract {contractNummer} is opgeslagen. Goedkeuren en verzenden staan bij het contract hieronder.
                {opvolging?.redenen.some((reden) => reden.includes('gewijzigd')) && <> <a href={contractLink}>Nieuwe versie</a>.</>}
              </p>
            )
          }
          {
            beeld.fase === 'in_behandeling' && beeld.checklist.ondertekend && !beeld.checklist.aanbetaling && beeld.boeking && (
              <p>De aanbetaling blijft in de bestaande administratie. <a href={`/beheer/boekingen/${encodeURIComponent(beeld.boeking.id)}/`}>Open de boeking</a>.</p>
            )
          }
        </>
      )
    }
  </section>

  <div class="bh-split">
    <section class="bh-kaart">
      <h2>Gegevens</h2>
      <dl class="bh-dl">
        <dt>E-mail</dt>
        <dd>{aanvraag.email}</dd>
        <dt>Telefoon</dt>
        <dd>{aanvraag.telefoon}</dd>
        <dt>Adres</dt>
        <dd>{aanvraag.adres || '—'}</dd>
        <dt>Personen</dt>
        <dd>{aanvraag.personen || '—'}</dd>
        <dt>Website</dt>
        <dd>{aanvraag.website || '—'}</dd>
        {(aanvraag.soort === 'expositie' || medeTekst) && (
          <>
            <dt>Mede-exposanten</dt>
            <dd>{medeTekst || '—'}</dd>
          </>
        )}
        <dt>Algemene voorwaarden</dt>
        <dd>{labelAkkoordVoorwaarden(aanvraag.soort, aanvraag.akkoordVoorwaarden)}</dd>
        <dt>Toelichting</dt>
        <dd>{aanvraag.toelichting}</dd>
        {
          aanvraag.status === 'afgewezen' && (
            <>
              <dt>Afwijsreden</dt>
              <dd>{aanvraag.afwijsreden || '—'}</dd>
            </>
          )
        }
        {
          relatie && (
            <>
              <dt>Relatie</dt>
              <dd>
                <a href={`/beheer/relaties/${encodeURIComponent(relatie.id)}/`}>{relatie.naam}</a>
              </dd>
            </>
          )
        }
        {
          aanvraag.boekingId && (
            <>
              <dt>Boeking</dt>
              <dd>
                <a href={`/beheer/boekingen/${encodeURIComponent(aanvraag.boekingId)}/`}>{aanvraag.boekingId}</a>
              </dd>
            </>
          )
        }
        {
          (kanReservelijst || relatie || meerdereRelaties) && (
            <>
              <dt>Reservelijst</dt>
              <dd>
                {
                  meerdereRelaties ? (
                    <>
                      <p>Meerdere relaties hebben dit e-mailadres. Kies de juiste relatie.</p>
                      <ul>
                        {relatiesOpEmail.map((kandidaat) => (
                          <li>
                            <a href={`/beheer/relaties/${encodeURIComponent(kandidaat.id)}/`}>{kandidaat.naam}</a>
                            {kandidaat.reservelijst ? ' · staat op de reservelijst' : ''}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <>
                      <p>{relatie?.reservelijst ? 'Staat op de reservelijst.' : 'Staat nog niet op de reservelijst.'}</p>
                      {
                        kanReservelijst && (
                          <form method="post" action={dossierPad}>
                            <p class="bh-muted">Dit kan ook als de aanvraag nog niet definitief is. De status blijft zoals hij is. Er gaat geen mail uit.</p>
                            <button class="bh-btn bh-btn--sec" type="submit" name="actie" value={relatie?.reservelijst ? 'reservelijst_uit' : 'reservelijst_aan'}>
                              {relatie?.reservelijst ? 'Haal van de reservelijst' : 'Zet op de reservelijst'}
                            </button>
                          </form>
                        )
                      }
                    </>
                  )
                }
              </dd>
            </>
          )
        }
      </dl>
    </section>

    {
      ((beeld.fase === 'in_behandeling' && snapshot.bron === 'supabase') || voorbeeld) && (
        <section class="bh-kaart">
          <h2>Vraag aan de aanvrager</h2>
          {
            beeld.fase === 'in_behandeling' && snapshot.bron === 'supabase' && (
              <form method="post" action={dossierPad} class="bh-form">
                <label for="vraag">Vraag</label>
                <textarea id="vraag" name="vraag" rows="5" required>{aanvraag.informatievraag ?? ''}</textarea>
                <p class="bh-muted">Reply-To blijft {CONTRACTBEHEER_EMAIL}. Concept, opslaan en preview doen geen provider-call.</p>
                <div class="bh-acties">
                  <button class="bh-btn" type="submit" name="actie" value="meer">Concept opslaan</button>
                </div>
              </form>
            )
          }
          {
            voorbeeld && (
              <>
                <h3>Preview</h3>
                <p><strong>{voorbeeld.onderwerp}</strong></p>
                <pre class="bh-muted">{voorbeeld.text}</pre>
                <form method="post" action={dossierPad}>
                  <p>Testmail wordt verstuurd naar: {testadres || 'geen geldig testmailadres ingesteld'} zolang de schakelaar op Test staat. Uit verstuurt niets.</p>
                  <button class="bh-btn bh-btn--sec" type="submit" name="actie" value="meer_verstuur">Verstuur vraag</button>
                </form>
              </>
            )
          }
        </section>
      )
    }
  </div>

  {opvolging && <ContractOpvolging opvolging={opvolging} actie={dossierPad} betalingToelichting={opvolgingBetaling} toonMaken={flowAan} />}
  {
    wizardOpen && (
      <ContractWizard
        actie={dossierPad}
        velden={wizardVelden}
        adresHint={!wizardVelden.straat && !wizardVelden.huisnummer ? aanvraag.adres : ''}
      />
    )
  }
  {
    beeld.fase === 'in_behandeling' && beeld.boeking && beeld.checklist.verzonden && (
      <div id="contract-mail">
        <Mailconcept
          templates={mailtemplates.map((item) => ({ id: item.id, naam: item.naam }))}
          ontvanger={aanvraag.email}
          modus={mailmodusLabel}
          testadres={testadres}
          replyTo={CONTRACTBEHEER_EMAIL}
          preview={mailPreview}
          formActie={dossierPad}
        />
      </div>
    )
  }

  {fotos.length > 0 && (
    <section class="bh-kaart">
      <h2>Foto’s van het werk</h2>
      <ul class="bh-fotolijst">
        {fotos.map((foto) => (
          <li>
            {foto.url ? <img src={foto.url} alt="" width="160" height="160" /> : null}
            {foto.url ? (
              <a href={foto.url} target="_blank" rel="noopener noreferrer">{foto.naam}</a>
            ) : (
              foto.naam
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="bh-kaart">
    <h2>Communicatie</h2>
    {
      tijdlijn.length === 0 ? (
        <p class="bh-leeg">Nog geen verzendregel of communicatiejob bij deze aanvraag.</p>
      ) : (
        <table class="bh-tabel">
          <thead>
            <tr>
              <th>Wanneer</th>
              <th>Richting</th>
              <th>Template</th>
              <th>Onderwerp</th>
              <th>Bedoeld</th>
              <th>Werkelijk</th>
              <th>Status</th>
              <th>Provider</th>
            </tr>
          </thead>
          <tbody>
            {tijdlijn.map((regel) => (
              <tr>
                <td>{regel.op ? formatNl(regel.op.slice(0, 10)) : '—'}</td>
                <td>{regel.richting}</td>
                <td>{regel.template || '—'}</td>
                <td>{regel.onderwerp || '—'}</td>
                <td>{regel.bedoeldeOntvanger || '—'}</td>
                <td>{regel.werkelijkeOntvanger || '—'}</td>
                <td>{regel.status}{regel.foutmelding ? ` — ${regel.foutmelding}` : ''}</td>
                <td>{regel.providerBerichtId || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
</Beheer>

<style>
  .bh-fotolijst {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bh-fotolijst li {
    display: grid;
    gap: 0.35rem;
    max-width: 10rem;
    font-size: 0.9rem;
  }

  .bh-fotolijst img {
    width: 10rem;
    height: 10rem;
    object-fit: cover;
    background: #f4f1ea;
  }
</style>
