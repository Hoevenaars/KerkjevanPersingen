---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<Base
  title="Contact"
  description="Vragen over verhuur, exposities of het kerkje zelf? Bel 06 52 66 84 49 of gebruik het formulier."
>
  <PageHeader
    eyebrow="Contact"
    title="Vragen over verhuur of het kerkje?"
   intro="Bel gerust, of gebruik het aanvraagformulier. Je hoort snel van ons."
    mark="gezicht"
  />

  <div class="wrap layout">
    <div>
      <dl class="gegevens">
        <div>
          <dt>Telefoon</dt>
          <dd><a href="tel:+31652668449">06 52 66 84 49</a></dd>
        </div>
        <div>
          <dt>Adres</dt>
          <dd>Persingensestraat 7<br />6575 JA Persingen</dd>
        </div>
        <div>
          <dt>Aanvraag doen</dt>
          <dd><a href="/verhuur/aanvragen/">Via het aanvraagformulier</a></dd>
        </div>
      </dl>

      <p class="uitleg">
        Er staat bewust geen e-mailadres op deze site. Berichten via het formulier komen
        rechtstreeks bij het bestuur binnen.
      </p>

      <Button href="/verhuur/aanvragen/" variant="primary">Vraag de ruimte aan</Button>
    </div>

    <div class="frame frame--photo">
      <img src="/foto/parkeerplaats.jpg" alt="De parkeergelegenheid bij het kerkje van Persingen" width="720" height="540" loading="lazy" />
    </div>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--s-16); align-items: start; }
  .gegevens { margin: 0 0 var(--s-8); display: grid; gap: var(--s-6); }
  .gegevens dt { font-size: var(--t-sm); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: var(--s-1); }
  .gegevens dd { margin: 0; font-family: var(--font-display); font-size: var(--t-lg); }
  .uitleg { color: var(--ink-soft); }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
</style>
