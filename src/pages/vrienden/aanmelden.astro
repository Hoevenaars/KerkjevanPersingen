---
import Base from '../../layouts/Base.astro';
import { maakVriendAan } from '../../lib/sanity';
import { teVaak } from '../../lib/validatie';

export const prerender = false;

let succes = false;
let fout = '';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();

    // Honeypot: bots vullen dit, mensen zien het niet. Stil "succes" zodat
    // een bot niet doorheeft dat de aanmelding is genegeerd.
    if (String(form.get('website_hp') ?? '').length > 0) {
      succes = true;
    } else if (teVaak(Astro.clientAddress ?? 'onbekend')) {
      fout = 'Er zijn net veel aanmeldingen. Probeer het over een kwartier opnieuw.';
    } else {
      const naam = String(form.get('naam') ?? '').trim().slice(0, 120);
      const email = String(form.get('email') ?? '').trim().toLowerCase();

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fout = 'Vul een geldig e-mailadres in.';
      } else {
        // Direct naar Sanity, niet via een interne HTTP-call. Die extra hop
        // faalde achter basic-auth / Vercel (401 of 404) terwijl het formulier
        // zelf wel bereikbaar was.
        await maakVriendAan({ naam, email });
        succes = true;
      }
    }
  } catch (err) {
    console.error('[vrienden] aanmelden mislukt', err);
    fout = 'Er ging iets mis. Probeer het later opnieuw.';
  }
}
---

<Base
  title="Vrienden van het kerkje"
  description="Meld je aan voor het wekelijkse berichtje over het kerkje van Persingen."
  noindex={true}
>
  <div class="wrap-narrow blok">
    <h1>Blijf op de hoogte</h1>
    <p>
      Meld je aan voor een kort, wekelijks berichtje: wat er dat weekend te doen is in het
      kerkje, en waar we mee bezig zijn dankzij de steun van vrienden zoals jij.
    </p>

    {succes ? (
      <div class="succes">
        <p>Bedankt! Je ontvangt vanaf komende week het wekelijkse berichtje.</p>
      </div>
    ) : (
      <form method="POST" class="formulier">
        {fout && <p class="fout">{fout}</p>}
        <label>
          Naam (optioneel)
          <input type="text" name="naam" autocomplete="name" maxlength="120" />
        </label>
        <label>
          E-mailadres
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <div class="honeypot" aria-hidden="true">
          <label for="website_hp">Website</label>
          <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit">Aanmelden</button>
      </form>
    )}
  </div>
</Base>

<style>
  .blok { padding-block: var(--s-16); }
  .formulier { display: grid; gap: var(--s-4); margin-top: var(--s-8); max-width: 420px; position: relative; }
  label { display: grid; gap: var(--s-1); font-size: var(--t-sm); color: var(--ink-mute); }
  input {
    padding: var(--s-3); border: var(--border); border-radius: var(--radius);
    font-size: var(--t-base); font-family: inherit;
  }
  button {
    background: var(--brick); color: white; border: none; padding: var(--s-3) var(--s-6);
    border-radius: var(--radius); font-family: var(--font-display); cursor: pointer;
  }
  .succes { background: var(--cream-deep); padding: var(--s-6); border-radius: var(--radius); }
  .fout { color: var(--brick); font-size: var(--t-sm); }
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
