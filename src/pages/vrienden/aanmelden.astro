---
import Base from '../../layouts/Base.astro';
import { maakVriendAan } from '../../lib/vrienden-supabase.ts';
import { leesVriendAanmelding, type VriendFormulier } from '../../lib/vriend-aanmelding.ts';
import { teVaak } from '../../lib/validatie';
import { ymdInAmsterdam } from '../../platform/datum.ts';
import { zelfdeOorsprong } from '../../lib/beheer-http.ts';
import {
  AANMELD_COOKIE,
  aanmeldCookieOpties,
  aanmeldGeheim,
  aanmeldGlobaalTeVaak,
  besluitAanmelding,
  maakAanmeldbewijs,
  oordeelAanmelding,
} from '../../lib/aanmeld-bewijs.ts';

export const prerender = false;

const geheim = aanmeldGeheim(process.env, import.meta.env.DEV === true);
const binnenkomend = Astro.cookies.get(AANMELD_COOKIE)?.value ?? '';
const nonce = /^[0-9a-f-]{36}$/i.test(binnenkomend) ? binnenkomend : crypto.randomUUID();
Astro.cookies.set(AANMELD_COOKIE, nonce, aanmeldCookieOpties(Astro.url.protocol === 'https:'));
const bewijs = geheim ? await maakAanmeldbewijs(geheim, nonce) : '';

const leeg: VriendFormulier = {
  voornaam: '',
  achternaam: '',
  email: '',
  telefoon: '',
  geboortedatum: '',
  toestemming: false,
};

let succes = false;
let fout = '';
let waarden = leeg;
const vandaag = ymdInAmsterdam(new Date());

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const adres = Astro.clientAddress ?? 'onbekend';
    const gelezen = leesVriendAanmelding({
      voornaam: form.get('voornaam'),
      achternaam: form.get('achternaam'),
      email: form.get('email'),
      telefoon: form.get('telefoon'),
      geboortedatum: form.get('geboortedatum'),
      toestemming: form.get('toestemming'),
    }, vandaag);
    waarden = gelezen.formulier;
    const oordeel = await oordeelAanmelding({
      honeypot: String(form.get('website_hp') ?? ''),
      bewijs: String(form.get('bewijs') ?? ''),
      nonceUitCookie: binnenkomend,
      userAgent: Astro.request.headers.get('user-agent'),
      oorsprongOk: zelfdeOorsprong(Astro.request),
      geheim,
      limietBereikt: () => teVaak(`nieuwsbrief:${adres}`) || aanmeldGlobaalTeVaak(),
    });

    const besluit = besluitAanmelding(oordeel, gelezen.ok ? { ok: true } : { ok: false, fout: gelezen.fout });
    if (besluit.soort === 'stil') {
      succes = true;
    } else if (besluit.soort === 'fout') {
      fout = besluit.melding;
    } else {
      // Direct in Supabase, niet via een interne HTTP-call. Die extra hop
      // faalde achter basic-auth / Vercel (401 of 404) terwijl het formulier
      // zelf wel bereikbaar was.
      await maakVriendAan(gelezen.aanmelding);
      succes = true;
    }
  } catch (err) {
    console.error('[vrienden] aanmelden mislukt', err);
    fout = 'Er ging iets mis. Probeer het later opnieuw.';
  }
}
---

<Base
  title="Vrienden van het kerkje"
  description="Meld je aan voor een kort wekelijks bericht over het kerkje van Persingen."
  noindex={true}
>
  <div class="wrap-narrow blok">
    <h1>Blijf op de hoogte</h1>
    <p>
      Meld je aan voor een kort wekelijks bericht met wat er dat weekend in het kerkje te doen is én waar we achter de schermen aan werken, mede dankzij de steun van vrienden zoals jij.
    </p>

    {succes ? (
      <div class="succes">
        <p>Bedankt! Je ontvangt vanaf komende week het wekelijkse berichtje.</p>
      </div>
    ) : (
      <form method="POST" class="formulier">
        {fout && <p class="fout">{fout}</p>}
        <label>
          Voornaam
          <input type="text" name="voornaam" required autocomplete="given-name" maxlength="80" value={waarden.voornaam} />
        </label>
        <label>
          Achternaam
          <input type="text" name="achternaam" required autocomplete="family-name" maxlength="80" value={waarden.achternaam} />
        </label>
        <label>
          E-mailadres
          <input type="email" name="email" required autocomplete="email" value={waarden.email} />
        </label>
        <label>
          Telefoonnummer <span class="optioneel">(optioneel)</span>
          <input type="tel" name="telefoon" autocomplete="tel" maxlength="40" value={waarden.telefoon} />
        </label>
        <label>
          Geboortedatum <span class="optioneel">(optioneel)</span>
          <input type="date" name="geboortedatum" autocomplete="bday" max={vandaag} value={waarden.geboortedatum} />
          <span class="hint">Dan kunnen we je op je verjaardag feliciteren.</span>
        </label>
        <label class="akkoord">
          <input type="checkbox" name="toestemming" value="ja" required checked={waarden.toestemming} />
          <span>
            Ik ga akkoord met de <a href="/privacyverklaring/" target="_blank" rel="noopener noreferrer">privacyverklaring</a> en ontvang graag de wekelijkse vriendenmail.
          </span>
        </label>
        <div class="honeypot" aria-hidden="true">
          <label for="website_hp">Website</label>
          <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="bewijs" value={bewijs} />
        <button type="submit">Aanmelden</button>
      </form>
    )}
  </div>
</Base>

<style>
  .blok { padding-block: var(--s-16); }
  .formulier { display: grid; gap: var(--s-4); margin-top: var(--s-8); max-width: 420px; position: relative; }
  label { display: grid; gap: var(--s-1); font-size: var(--t-sm); color: var(--ink-mute); }
  input {
    padding: var(--s-3); border: var(--border); border-radius: var(--radius);
    font-size: var(--t-base); font-family: inherit;
  }
  button {
    background: var(--brick); color: white; border: none; padding: var(--s-3) var(--s-6);
    border-radius: var(--radius); font-family: var(--font-display); cursor: pointer;
  }
  .succes { background: var(--cream-deep); padding: var(--s-6); border-radius: var(--radius); }
  .fout { color: var(--brick); font-size: var(--t-sm); }
  .optioneel { font-weight: 400; }
  .hint { font-size: var(--t-sm); }
  .akkoord {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    cursor: pointer;
  }
  .akkoord input {
    width: auto;
    margin-top: 3px;
    flex: none;
  }
  .akkoord a { color: inherit; }
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
