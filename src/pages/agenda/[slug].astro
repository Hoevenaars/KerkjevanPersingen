---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import MasonMark from '../../components/MasonMark.astro';
import { detailTekst, publiekeFotoBron, tekstNaarParagrafen } from '../../lib/activiteit-content';
import { getActiviteitBySlug, imageUrl, formatDatumBereik } from '../../lib/sanity';
import { SECOND_NATURE_POSTER } from '../../lib/second-nature';
import { eventJsonLd } from '../../lib/seo';

const { slug } = Astro.params;
const activiteit = slug ? await getActiviteitBySlug(slug) : null;

if (!activiteit) {
  return Astro.redirect('/agenda/', 302);
}

const fotoBron = publiekeFotoBron(activiteit);
const foto =
  (fotoBron ? imageUrl(fotoBron, 1200, 800) : null) ??
  (activiteit._id === 'fallback-second-nature' ? SECOND_NATURE_POSTER : null) ??
  '/foto/geen-foto.jpg';
const inlineTekst = detailTekst(activiteit);
const paragrafen = inlineTekst ? tekstNaarParagrafen(inlineTekst) : [];
const beschrijving =
  activiteit.omschrijving?.slice(0, 155) ??
  inlineTekst?.slice(0, 155) ??
  `${activiteit.publiekeTitel} in het kerkje van Persingen.`;

const isExpositie = activiteit.soort === 'expositie';

const jsonLdEvent = eventJsonLd({
  ...activiteit,
  imageUrl: foto,
});
---

<Base title={activiteit.publiekeTitel ?? 'Activiteit'} description={beschrijving} image={foto ?? undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdEvent)} is:inline />
  <article class="wrap-narrow artikel">
    <p class="eyebrow"><MasonMark variant="kruis" size={14} /> Agenda</p>
    <h1>{activiteit.publiekeTitel}</h1>
    <p class="datum">{formatDatumBereik(activiteit)}</p>
    {isExpositie && (
      <p class="bezoektijden">Te bezoeken op zaterdag en zondag, van 11.00 tot 17.00 uur.</p>
    )}
    {isExpositie && activiteit.kunstenaars && (
      <p class="kunstenaars">{activiteit.kunstenaars}</p>
    )}

    <div class="frame frame--wide beeld">
      <img src={foto} alt={activiteit.fotoAlt ?? 'Het kerkje van Persingen in de Ooijpolder'} width="1200" height="675" />
    </div>

    {
      paragrafen.length > 0 && (
        <div class="prose">
          {paragrafen.map((alinea) => (
            <p>{alinea}</p>
          ))}
        </div>
      )
    }

    <div class="slot">
      <Button href="/agenda/" variant="text">← Terug naar de agenda</Button>
      <Button href="/verhuur/aanvragen/" variant="secondary">Zelf iets organiseren</Button>
    </div>
  </article>
</Base>

<style>
  .artikel {
    padding-block: var(--s-16);
  }
  .datum {
    font-weight: 600;
    color: var(--olive-dark);
    margin-bottom: var(--s-2);
  }
  .bezoektijden {
    color: var(--ink-soft);
    font-size: var(--t-sm);
    margin-bottom: var(--s-2);
  }
  .kunstenaars {
    color: var(--ink-soft);
    font-size: var(--t-base);
    margin-bottom: var(--s-8);
  }
  .beeld {
    margin-bottom: var(--s-8);
  }
  .slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-6);
    margin-top: var(--s-16);
    padding-top: var(--s-8);
    border-top: var(--border);
  }
</style>
