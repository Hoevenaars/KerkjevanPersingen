---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/Button.astro';
import { getPubliekeAgenda, publiekeFotoUrl, formatDatumBereik } from '../../lib/sanity';
import { kaartTekst } from '../../lib/activiteit-content';
import { STANDAARD_AFBEELDING, kaartVoorWebsite } from '../../platform/publiceren';
import { isSecondNature, secondNaturePoster } from '../../lib/second-nature';
import { toonFotoInHetGeheel } from '../../lib/publicatie-foto.ts';

const activiteiten = await getPubliekeAgenda(80);

/**
 * Maximaal 2 zinnen, met een "…" als er meer volgt. Belangrijk zodra er
 * straks 50 activiteiten op deze pagina staan: zonder afkapping wordt de
 * lijst een oneindige scroll van volledige tekstblokken. Kapt op zinsgrens
 * af (na een punt, uitroepteken of vraagteken), niet halverwege een woord.
 */
function kortOpZinnen(tekst: string, maxZinnen = 2): string {
  const zinnen = tekst.match(/[^.!?]+[.!?]+/g) ?? [tekst];
  if (zinnen.length <= maxZinnen) return tekst;
  return zinnen.slice(0, maxZinnen).join('').trim() + '…';
}
---

<Base title="Agenda" description="Exposities, concerten en bijeenkomsten in het kerkje van Persingen. Exposities te bezoeken op zaterdag en zondag, 11.00-17.00 uur.">
  <PageHeader
    eyebrow="Agenda"
    title="Wat er te zien en te doen is"
    intro="Exposities zijn te bezoeken op zaterdag en zondag, van 11.00 tot 17.00 uur."
    mark="kruis"
  />

  <div class="wrap">
    {
      activiteiten.length > 0 ? (
        <ul class="lijst">
          {activiteiten.map((a) => {
            if (a.soort === 'blokkade') {
              return (
                <li class="kaart kaart--bezet">
                  <div class="kaart-tekst">
                    <p class="datum">{formatDatumBereik(a)}</p>
                    <h2>Bezet</h2>
                    <p>Dit weekend is bezet.</p>
                  </div>
                </li>
              );
            }
            const foto =
              secondNaturePoster(a) ??
              (a.foto ? publiekeFotoUrl(a.foto, 800, 600) : null) ??
              STANDAARD_AFBEELDING;
            const heel = toonFotoInHetGeheel(foto);
            const kaart = kaartTekst(a);
            const kaartWeergave = kaart.tekst
              ? (kaart.letterlijk ? kaart.tekst : kortOpZinnen(kaart.tekst))
              : kaartVoorWebsite({
                korteOmschrijving: a.korteOmschrijving,
                volledigeOmschrijving: a.volledigeOmschrijving,
                omschrijving: a.omschrijving,
              });
            return (
              <li class="kaart">
                <div class:list={['frame', heel ? 'frame--heel' : 'frame--photo', { 'frame--poster': isSecondNature(a) }]}>
                  <img src={foto} alt={a.fotoAlt ?? 'Het kerkje van Persingen in de Ooijpolder'} width={heel ? undefined : 800} height={heel ? undefined : 600} loading="lazy" />
                </div>
                <div class="kaart-tekst">
                  <p class="datum">{formatDatumBereik(a)}</p>
                  <h2>{a.publiekeTitel}</h2>
                  {kaartWeergave && <p>{kaartWeergave}</p>}
                  {a.slug && <a class="meer" href={`/agenda/${a.slug}/`}>Meer over deze activiteit →</a>}
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="leeg">
          <h2>Nog niets gepland</h2>
          <p>Er staat op dit moment niets op de agenda. Wil je zelf iets organiseren?</p>
          <Button href="/verhuur/aanvragen/" variant="primary">Vraag de ruimte aan</Button>
        </div>
      )
    }
  </div>
</Base>

<style>
  .lijst { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-12); }
  .kaart { display: grid; grid-template-columns: 320px 1fr; gap: var(--s-8); align-items: start; padding-bottom: var(--s-12); border-bottom: var(--border); }
  .kaart--bezet { grid-template-columns: 1fr; padding-bottom: var(--s-6); }
  .kaart:last-child { border-bottom: none; }
  .datum { font-weight: 600; color: var(--olive-dark); margin-bottom: var(--s-2); font-size: var(--t-sm); text-transform: uppercase; letter-spacing: 0.06em; }
  .kaart h2 { font-size: var(--t-2xl); margin-bottom: var(--s-3); }
  .meer { font-weight: 600; text-decoration: none; }
  .meer:hover { text-decoration: underline; }
  .leeg { max-width: var(--wrap-narrow); margin-inline: auto; text-align: center; padding: var(--s-16) var(--s-6); border: 1px dashed var(--sand); border-radius: var(--radius-lg); background: var(--white); }
  .leeg p { margin-inline: auto; }
  @media (max-width: 720px) { .kaart { grid-template-columns: 1fr; } }
</style>
